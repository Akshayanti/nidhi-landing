.idea
.claude
.astro
node_modules
dist
.DS_Store
*.log
output/
.env
.env.*
# .env.example carries no secrets and documents required vars; keep it tracked.
!.env.example

# Local newsletter dry-run previews
emails/_preview/

# IndexNow URL hash manifest. Computed during the build job by
# scripts/indexnow.mjs and consumed only by the post-deploy ping job
# (passed between jobs as a workflow artifact, not via git). Never
# checked in.
.indexnow/

# Python bytecode cache produced by helper scripts (e.g. send_newsletter).
scripts/__pycache__/

# Reel pipeline scratch directories. The Remotion bundle reads input JSON
# from `outputs/` and per-reel TTS mp3 + VTT from `public/audio/`; both
# are deleted after a successful render and only ever exist mid-pipeline.
remotion/outputs/
remotion/public/audio/

