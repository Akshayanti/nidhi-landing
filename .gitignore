.idea
.claude/*
# The project's own agents and what they have learnt are versioned with it.
!.claude/agents/
!.claude/agent-memory/
.astro
node_modules
dist
.DS_Store
*.log
output/
.env
.env.*
# .env.example carries no secrets and documents required vars; keep it tracked.
!.env.example

# Local newsletter dry-run previews
emails/_preview/

# IndexNow URL hash manifest. Computed during the build job by
# scripts/indexnow.mjs and consumed only by the post-deploy ping job
# (passed between jobs as a workflow artifact, not via git). Never
# checked in.
.indexnow/

# Python bytecode cache produced by helper scripts (e.g. send_newsletter).
scripts/__pycache__/

# Reel pipeline scratch directories. The Remotion bundle reads input JSON
# from `outputs/` and per-reel TTS mp3 + VTT from `public/audio/`; both
# are deleted after a successful render and only ever exist mid-pipeline.
remotion/outputs/
remotion/public/audio/
# Lesson figures rendered for reels: scripts/lib/prepare-figures.mjs copies
# them here for each render, and they stay on the machine. Four are tracked
# on purpose and named below, so git does not hold a file it also ignores:
# renders of the site's own figures, kept as examples of what the reel
# renderer is given (remotion/src/data.ts names one). A new figure is not
# offered by `git add` unless it is added to this list.
remotion/public/figures/*
!remotion/public/figures/how-to-get-out-of-debt.png
!remotion/public/figures/purchasing-power.png
!remotion/public/figures/saving-vs-investing.png
!remotion/public/figures/saving-vs-investing-reel.png

# Working notes and local output that are not part of the site. Listed so
# that one `git add -A` cannot publish them.
reports/
research_notes/
logs/
.shot-tmp.mjs

# Security and privacy weaknesses of the site: kept on the machine, never in
# this public repository (CLAUDE.md, "Two Projects").
docs/curr_bugs.md

# Mutation testing (stryker.config.mjs): its sandboxes and reports.
.stryker-tmp*/
reports/mutation/
# astro check's own install (tools/astro-check): its lockfile is tracked.
tools/astro-check/node_modules/
