{
  "name": "nidhi-landing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/lint-figures.mjs && node scripts/lint-scoped-styles.mjs",
    "build": "astro build",
    "postbuild": "node scripts/render-email-figures.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "node scripts/lint.mjs",
    "typecheck": "astro sync && tsc --noEmit -p .",
    "typecheck:astro": "astro sync && tools/astro-check/node_modules/.bin/astro-check --root . --tsconfig tsconfig.json",
    "lint:figures": "node scripts/lint-figures.mjs",
    "lint:scoped-styles": "node scripts/lint-scoped-styles.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "audit:text-size": "node scripts/audit-text-size.mjs",
    "verify:tool-privacy": "PUBLIC_ANALYTICS_TEST=1 npm run build && node scripts/verify-tool-privacy.mjs",
    "gs:version": "node scripts/gs-version.mjs",
    "gs:check": "node scripts/gs-version.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "render-ig": "node scripts/render-ig.js",
    "render-figures": "node scripts/render-figures.mjs",
    "render-email-figures": "node scripts/render-email-figures.mjs",
    "render-reels": "node scripts/render-reels.mjs",
    "render-reels:discovery": "node scripts/render-reels.mjs --level discovery",
    "render-reels:building": "node scripts/render-reels.mjs --level building",
    "reels:plan-only": "node scripts/render-reels.mjs --plan-only",
    "render-thumbnails": "node scripts/render-thumbnails.mjs"
  },
  "keywords": [],
  "author": "Akshay Aggarwal",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "description": "",
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "puppeteer@25.18.1": true,
    "esbuild": false,
    "fsevents": false
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@babel/parser": "7.29.9",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jsdom": "30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.1",
    "github-slugger": "^2.0.0",
    "jsdom": "31.0.1",
    "puppeteer": "^25.18.1",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "qs": "6.16.1",
      "minimatch": "11.0.9",
      "glob": "14.0.6"
    },
    "@stryker-mutator/tap-runner": {
      "qs": "6.16.1",
      "minimatch": "11.0.9",
      "glob": "14.0.6"
    }
  }
}
