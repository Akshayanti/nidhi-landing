# Copy to .env for local development. Real production values are injected
# at build time from GitHub Actions secrets of the same name; see
# .github/workflows/deploy.yml. Leaving a value empty locally is safe:
# the feature degrades gracefully (analytics no-op, forms fall back to RSS).

# PostHog project API key (PostHog Cloud, EU instance).
# Production: set as the GitHub Actions secret PUBLIC_POSTHOG_KEY
# (repo Settings > Secrets and variables > Actions). When empty, the
# analytics snippet still loads but posthog.init("") captures nothing.
PUBLIC_POSTHOG_KEY=

# Apps Script Web App /exec URL for the newsletter backend. See
# docs/blog-subscription-setup.md for how to deploy the backend. When
# unset, the subscribe form gracefully falls back to an RSS-only link.
# Production: GitHub Actions secret PUBLIC_NEWSLETTER_ENDPOINT.
PUBLIC_NEWSLETTER_ENDPOINT=

# Apps Script Web App /exec URL for the product-launch waitlist backend.
# See scripts/waitlist.gs for setup instructions. Separate deployment,
# separate sheet tab, same spreadsheet.
# Production: GitHub Actions secret PUBLIC_WAITLIST_ENDPOINT.
PUBLIC_WAITLIST_ENDPOINT=
