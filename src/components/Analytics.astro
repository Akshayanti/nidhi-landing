---
/**
 * PostHog analytics, rendered at the end of <body> so it never blocks
 * HTML parsing or first paint. The snippet was previously inline in
 * <head> (BaseHead.astro), which stalled rendering on every page load:
 * an inline <script> in <head> runs synchronously before the parser can
 * continue, hurting LCP and TTI.
 *
 * The body is unchanged from the previous <head> version: same vendor
 * (PostHog Cloud EU), same project key, same events. Only the load
 * position moved. PUBLIC_POSTHOG_KEY is injected at build time from the
 * GitHub Actions secret of the same name (see .github/workflows/deploy.yml
 * and .env.example); production builds always carry the real key.
 *
 * Capture policy:
 *   Anonymous pageviews + UTM: always (no PII, legitimate interest)
 *   Heatmaps + autocapture: only after consent
 */
import { LOCALES, localePrefix } from '../i18n';
import { scanLabels } from '../utils/analyticsLabels.ts';
import cleanElementsScript from '../utils/shared/cleanElements.js?raw';

// The known locale prefixes (`['/hi']`), built from the locale registry rather
// than spelled out, so the URL backstop below cannot drift from the routes.
const localePrefixes = LOCALES.map(localePrefix).filter(Boolean);

// A test build (PUBLIC_ANALYTICS_TEST=1) runs analytics on any host, so the
// CLAUDE.md browser check can read PostHog payloads on localhost, but it never
// carries the real project key: PostHog rejects anything sent with this one.
const analyticsTest = import.meta.env.PUBLIC_ANALYTICS_TEST === '1';
const posthogKey = analyticsTest ? 'phc_local_test_build_not_a_real_key' : import.meta.env.PUBLIC_POSTHOG_KEY;

// Every click label the site renders, read from the source at build time: a
// click event keeps an element's data-attr only if it is one of these (see
// src/utils/shared/cleanElements.js). The build runs from the repository root.
const { exact, prefixes } = scanLabels(`${process.cwd()}/src`);
const clickLabels = { exact, prefixes };
---

<script is:inline set:html={cleanElementsScript}></script>
<script is:inline define:vars={{ posthogKey, localePrefixes, analyticsTest, clickLabels }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onSessionId setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

  var hasFullConsent = localStorage.getItem('nidhi-cookie-consent') === 'accepted';

  // Backstop for the free tools (CLAUDE.md, "Free tools keep inputs out of
  // URLs"). The tools never write inputs into the address and ToolStateGuard
  // moves shared-link state out of it before this script runs, but should a
  // tool URL ever carry state, no event may send it: every URL property that
  // points at a /free/ page (current URL, referrer, session entry, person
  // properties) keeps only its utm_* parameters and loses its # part.
  //
  // No page writes what is typed into the address: /blog/ only reads ?q=
  // when a search engine sends someone there, then removes it. Should a
  // /blog/ URL still carry ?q= (an old bookmark, a hand-typed link), that
  // parameter is removed from any URL property pointing at it.
  // A locale prefix sits in front of the page path once the Hindi edition
  // exists, so the /free/ and /blog tests below read the path with a known
  // prefix removed. Only prefixes from the locale registry are stripped: a
  // pattern like /^\/[a-z]{2}\// would swallow a real two-letter page segment
  // such as /history-of-money/ and start rewriting a URL that is not a tool.
  function withoutLocale(pathname) {
    for (var i = 0; i < localePrefixes.length; i++) {
      var prefix = localePrefixes[i];
      if (pathname === prefix || pathname.indexOf(prefix + '/') === 0) {
        return pathname.slice(prefix.length) || '/';
      }
    }
    return pathname;
  }
  function cleanUrl(value) {
    if (typeof value !== 'string') return value;
    var isTool = value.indexOf('/free/') !== -1;
    var isBlog = value.indexOf('/blog') !== -1 && value.indexOf('q=') !== -1;
    if (!isTool && !isBlog) return value;
    var u;
    try { u = new URL(value, window.location.origin); } catch (e) { return value; }
    if (u.host !== window.location.host) return value;
    var path = withoutLocale(u.pathname);
    if (path.indexOf('/free/') === 0) {
      var keep = new URLSearchParams();
      u.searchParams.forEach(function (v, k) { if (k.indexOf('utm_') === 0) keep.append(k, v); });
      u.search = keep.toString();
      u.hash = '';
    } else if (path.indexOf('/blog') === 0 && u.searchParams.has('q')) {
      u.searchParams.delete('q');
    } else {
      return value;
    }
    return /^https?:/i.test(value) ? u.toString() : u.pathname + u.search;
  }
  function cleanProps(obj) {
    if (!obj) return;
    for (var key in obj) if (Object.prototype.hasOwnProperty.call(obj, key)) obj[key] = cleanUrl(obj[key]);
  }

  // Click data (autocapture, rage clicks, dead clicks) records every attribute
  // of the clicked element and its ancestors, and text masking does not cover
  // attributes. Two layers keep what a reader typed, or what a tool worked out,
  // out of it. First, PostHog is told never to read the attributes that can
  // hold such text (a remove button's label names the loan offer, a chart's
  // label lists its amounts). Second, before_send rebuilds every element
  // description from a closed vocabulary (cleanElements.js), so an attribute
  // missing from this list, now or after an SDK update, is dropped anyway.
  // The cookie prompt applies the same settings when consent changes.
  var IGNORED_ATTRIBUTES = ['aria-label', 'aria-valuetext', 'aria-valuenow', 'aria-description', 'aria-describedby', 'aria-labelledby', 'title', 'alt', 'placeholder', 'value', 'style', 'href', 'id', 'name', 'for', 'datetime', 'download', 'src', 'action', 'd', 'points', 'x', 'y', 'x1', 'x2', 'y1', 'y2', 'cx', 'cy', 'r', 'width', 'height', 'transform', 'viewBox'];
  window.nidhiClickCapture = { element_attribute_ignorelist: IGNORED_ATTRIBUTES };
  function cleanClicks(event) {
    var props = event && event.properties;
    if (!props || !('$elements_chain' in props || '$elements' in props)) return event;
    // Should the cleaner be missing, a click event is not sent at all.
    if (typeof window.nidhiCleanElements !== 'function') return null;
    window.nidhiCleanElements(props, clickLabels);
    return event;
  }

  // Every capture feature is set explicitly here. A feature left unset falls
  // back to the PostHog project settings, which apply to every visitor and
  // ignore consent: in Oct 2026 that let web vitals and dead clicks fire for
  // visitors who never accepted. Click data (autocapture, heatmaps, dead
  // clicks) follows consent; web vitals and error capture stay off because
  // the privacy policy does not cover them.
  // Analytics restarted in a new PostHog project on Oct 8, 2026 (see the
  // privacy changelog). Before 00:00 UTC that day, PostHog is never
  // initialised: the SDK does not load and calls to the stub above stay
  // queued in the page, so nothing is sent. Safe to remove after that date.
  var ANALYTICS_START = Date.parse('2026-10-08T00:00:00Z');

  // Internal visitors (the team) are never counted. Opening any page with
  // ?internal=1 marks this browser (localStorage nidhi-internal); ?internal=0
  // clears it. The parameter is removed from the address before anything else
  // could read it. A marked browser never starts PostHog: nothing is sent.
  var isInternal = false;
  try {
    var params = new URLSearchParams(window.location.search);
    var flag = params.get('internal');
    if (flag === '1') localStorage.setItem('nidhi-internal', '1');
    if (flag === '0') localStorage.removeItem('nidhi-internal');
    if (flag !== null) {
      params.delete('internal');
      var rest = params.toString();
      history.replaceState(null, '', window.location.pathname + (rest ? '?' + rest : '') + window.location.hash);
    }
    isInternal = localStorage.getItem('nidhi-internal') === '1';
  } catch (e) {}

  // Analytics run only on the live site, matched by its whole origin. A build
  // served anywhere else (localhost, a preview, a saved copy, or a local server
  // a test maps to the nidhi.today name over plain http) never starts PostHog,
  // whatever key it was built with, so a local test cannot add visits to the
  // real numbers, as one built with the real key did in Oct 2026.
  var onLiveSite = window.location.origin === 'https://nidhi.today';

  // The snippet's stub only gains its methods inside init(), so whenever
  // PostHog doesn't start the page gets silent no-ops for every call the site
  // makes.
  var analyticsOn = Date.now() >= ANALYTICS_START && !isInternal && (onLiveSite || analyticsTest);
  if (!analyticsOn) {
    var noop = function () {};
    window.posthog = { capture: noop, identify: noop };
  }
  if (analyticsOn) posthog.init(posthogKey, {
    api_host: 'https://eu.i.posthog.com',
    capture_pageview: true,
    capture_pageleave: true,
    autocapture: hasFullConsent ? window.nidhiClickCapture : false,
    enable_heatmaps: hasFullConsent,
    capture_dead_clicks: hasFullConsent ? window.nidhiClickCapture : false,
    capture_performance: false,
    capture_exceptions: false,
    // Clicks are told apart by their data-attr labels, never by their text:
    // tools show what people type (vendor names, amounts, results), and a
    // click or dead click on that text would otherwise send it.
    mask_all_text: true,
    persistence: 'localStorage',
    disable_session_recording: true,
    before_send: function (event) {
      if (event) { cleanProps(event.properties); cleanProps(event.$set); cleanProps(event.$set_once); }
      return cleanClicks(event);
    },
    // Consent given before the SDK finished loading could not be applied by
    // the cookie prompt (the pre-load stub has no set_config), so apply it here.
    loaded: function(ph) {
      if (!hasFullConsent && localStorage.getItem('nidhi-cookie-consent') === 'accepted') {
        ph.set_config({ autocapture: window.nidhiClickCapture, enable_heatmaps: true, capture_dead_clicks: window.nidhiClickCapture });
      }
      // The learning path's level helper pauses heatmaps while it is open, so
      // no click position shows which answer was picked (LearnHome.tsx).
      if (window.nidhiHeatmapsPaused) ph.set_config({ enable_heatmaps: false });
    },
  })

  // Flag AI-sourced traffic for easy dashboard filtering.
  // PostHog auto-captures $referrer and $referring_domain on every
  // pageview; this adds a dedicated $ai_referrer event so you can
  // create a one-click insight for "AI to site" without manual filters.
  var aiReferrers = ['chatgpt.com', 'chat.openai.com', 'perplexity.ai', 'claude.ai', 'gemini.google.com', 'copilot.microsoft.com', 'you.com', 'bard.google.com', 'deepseek.com', 'grok.com', 'chat.mistral.ai', 'meta.ai', 'copilot.cloud.microsoft', 'aistudio.google.com', 'notebooklm.google.com', 'duck.ai', 'phind.com', 'poe.com', 'chat.qwen.ai', 'kimi.com'];
  var ref = document.referrer;
  try { var refHost = new URL(ref).hostname; } catch(_) { var refHost = ''; }
  var isAI = refHost && aiReferrers.some(function(d) { return refHost === d || refHost.endsWith('.' + d); });
  if (isAI) {
    posthog.capture('$ai_referrer', { ai_referrer_domain: refHost, ai_referrer_full: ref });
  }
</script>
