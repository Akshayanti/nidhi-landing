---
/**
 * The free tools hub, in whichever language it was asked for.
 *
 * English is served from `src/pages/free/index.astro`, which is a short wrapper
 * around this; the other languages come through `src/pages/[locale]/free/`. Both
 * paths render this one component, so the two versions cannot drift apart in
 * markup or in styling.
 *
 * A directory rather than a document: a card per released tool, one explainer
 * block, one line of footer. Depth lives on the tool pages.
 *
 * What stays here rather than in the catalog is what no translator would touch:
 * each card's preview drawing, its `data-attr` label (analytics reads it, and the
 * privacy notice's changelog refers to those labels by name), and the tool
 * addresses, which `localizedPath` prefixes. The words are fetched from
 * `freeHub.tools` by the same key, so a new tool is one row here and one entry in
 * both catalogs.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../../utils/monte-carlo/release.ts';
import { LOCALES, dict, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { freeHub: hub } = dict(locale);

const siteUrl = 'https://nidhi.today';

type Preview = 'donut' | 'bars' | 'browse' | 'fan';
type ToolKey = keyof typeof hub.tools;

interface ToolSpec {
  key: ToolKey;
  url: string;
  preview: Preview;
  dataAttr: string;
}

// The simulator joins the list only once it is released with post 43 (see
// src/utils/monte-carlo/release.ts), and the release gate is shared with its own
// route, so a Hindi hub cannot list a tool that has no Hindi page.
const specs: ToolSpec[] = [
  {
    key: 'multiCurrencyNetWorth',
    url: localizedPath(locale, '/free/multi-currency-net-worth/'),
    preview: 'donut',
    dataAttr: 'free-cta-multi-currency-net-worth',
  },
  {
    key: 'loanComparison',
    url: localizedPath(locale, '/free/loan-comparison/'),
    preview: 'bars',
    dataAttr: 'free-cta-loan-comparison',
  },
  ...((await isMonteCarloReleased())
    ? [
        {
          key: 'monteCarlo' as const,
          url: localizedPath(locale, MONTE_CARLO_URL),
          preview: 'fan' as const,
          dataAttr: 'free-cta-monte-carlo-simulator',
        },
      ]
    : []),
];

const tools = specs.map((spec) => ({ ...spec, ...hub.tools[spec.key] }));

// The hub advertises a simulator only when the page beneath it lists one, so the
// meta description is the one that matches what a reader actually finds.
const description = tools.some((t) => t.key === 'monteCarlo')
  ? hub.meta.description
  : hub.meta.descriptionWithoutSimulator;

const hubUrl = new URL(localizedPath(locale, '/free/'), siteUrl).href;
const homeUrl = new URL(localizedPath(locale, '/'), siteUrl).href;
const blogUrl = localizedPath(locale, '/blog/');
const beliefsUrl = localizedPath(locale, '/beliefs/');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: hub.schema.breadcrumbHome, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: hub.schema.breadcrumbThis, item: hubUrl },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: hub.schema.itemListName,
  description,
  numberOfItems: tools.length,
  itemListOrder: 'https://schema.org/ItemListUnordered',
  itemListElement: tools.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(tool.url, siteUrl).href,
    name: tool.itemName,
  })),
};

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.schema.collectionName,
  description,
  url: hubUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'nidhi',
    url: homeUrl,
  },
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={hub.meta.title}
  description={description}
  jsonLd={[breadcrumbSchema, itemListSchema, collectionPageSchema]}
>
  <section class="ft-page">
    <nav class="ft-breadcrumbs" aria-label={dict(locale).a11y.breadcrumb}>
      <ol>
        <li><a href={localizedPath(locale, '/')}>{hub.breadcrumb.home}</a></li>
        <li aria-current="page">{hub.breadcrumb.this}</li>
      </ol>
    </nav>

    <header class="ft-pageHeader">
      <p class="ft-eyebrow">{hub.eyebrow}</p>
      <h1 class="ft-pageTitle">{hub.title}</h1>
      <p class="ft-pageLead">{hub.lead}</p>
    </header>

    <ul class="ft-toolsGrid" role="list">
      {tools.map((tool) => (
        <li class="ft-toolItem">
          <a href={tool.url} class="ft-toolCard" data-attr={tool.dataAttr}>
            <div class="ft-toolPreview" aria-hidden="true">
              {tool.preview === 'donut' && (
                <svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg">
                  {/* 62/28/10 wedge endpoints derived as
                        (r * sin alpha, -r * cos alpha)
                      at alpha = 223.2 deg and 324 deg. Same pattern used
                      by the donuts on the home page to keep the visual
                      language consistent across pages. */}
                  <g transform="translate(40,30)">
                    <path d="M 0 -22 A 22 22 0 1 1 -15.06 16.04 L 0 0 Z" fill="var(--chart-eur)" />
                    <path d="M -15.06 16.04 A 22 22 0 0 1 -12.93 -17.80 L 0 0 Z" fill="var(--chart-usd)" />
                    <path d="M -12.93 -17.80 A 22 22 0 0 1 0 -22 L 0 0 Z" fill="var(--chart-inr)" />
                    <circle r="12" fill="var(--color-bg-white)" />
                  </g>
                </svg>
              )}
              {tool.preview === 'bars' && (
                <svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg">
                  {/* Two stacked bars of different lengths read as a
                      comparison without text. Earlier revisions had a
                      "Vendor A vs Vendor B" caption that overflowed the
                      viewBox; bars alone do the job at this size. */}
                  <rect x="10" y="18" width="60" height="10" rx="2" fill="var(--chart-eur)" opacity="0.85" />
                  <rect x="10" y="34" width="46" height="10" rx="2" fill="var(--chart-usd)" opacity="0.85" />
                </svg>
              )}
              {tool.preview === 'fan' && (
                <svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg">
                  {/* A widening band around a middle line: the shape of a
                      Monte Carlo fan chart, without text. */}
                  <path d="M 10 46 L 70 10 L 70 40 Z" fill="var(--chart-eur)" opacity="0.25" />
                  <path d="M 10 46 L 70 18 L 70 32 Z" fill="var(--chart-eur)" opacity="0.45" />
                  <path d="M 10 46 L 70 25" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" />
                </svg>
              )}
              {tool.preview === 'browse' && (
                <svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg">
                  <g fill="var(--color-text-muted)">
                    <rect x="14" y="14" width="14" height="14" rx="2" />
                    <rect x="33" y="14" width="14" height="14" rx="2" />
                    <rect x="52" y="14" width="14" height="14" rx="2" />
                    <rect x="14" y="33" width="14" height="14" rx="2" />
                    <rect x="33" y="33" width="14" height="14" rx="2" opacity="0.6" />
                    <rect x="52" y="33" width="14" height="14" rx="2" opacity="0.4" />
                  </g>
                </svg>
              )}
            </div>
            <span class="ft-kicker">{tool.kicker}</span>
            <span class="ft-title">{tool.title}</span>
            <span class="ft-desc">{tool.desc}</span>
            <span class="ft-cta" aria-hidden="true">{hub.cta} &rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="ft-howItWorks" aria-labelledby="ft-how-h">
      <h2 id="ft-how-h" class="ft-sectionTitle">{hub.how.title}</h2>
      <ul class="ft-howList">
        <li>
          <strong>{hub.how.browser.strong}</strong>{hub.how.browser.rest}
        </li>
        <li>
          <strong>{hub.how.rates.strong}</strong>{hub.how.rates.before}<a href="https://www.frankfurter.app" target="_blank" rel="noopener noreferrer">Frankfurter</a>{hub.how.rates.after}
        </li>
        <li>
          <strong>{hub.how.noSignup.strong}</strong>{hub.how.noSignup.rest}
        </li>
        <li>
          <strong>{hub.how.education.strong}</strong>{hub.how.education.rest}
        </li>
      </ul>
    </section>

    <footer class="ft-pageFooter">
      <p>
        {hub.footer.before}<a href={blogUrl}>{hub.footer.blogLink}</a>{hub.footer.middle}<a
          href={beliefsUrl}>{hub.footer.beliefsLink}</a>{hub.footer.after}
      </p>
    </footer>
  </section>
</BaseLayout>

<style>
  /* ----------------------------------------------------------------
     Free tools index page (/free/).
     Scoped to this page; if any of these patterns recur on a future
     page, hoist them into global.css then.
     ---------------------------------------------------------------- */
  .ft-page {
    max-width: 980px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-12);
  }

  .ft-breadcrumbs {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .ft-breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ft-breadcrumbs li + li::before {
    content: "/";
    margin-right: 6px;
    color: var(--color-border);
  }

  .ft-breadcrumbs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .ft-breadcrumbs a:hover {
    color: var(--color-deep-blue);
    text-decoration: underline;
  }

  .ft-pageHeader {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .ft-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  .ft-pageTitle {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.4vw + 0.75rem, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-3);
    font-weight: 700;
    text-wrap: balance;
  }

  .ft-pageLead {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 64ch;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* Tools grid: a single column on phones, two columns from tablet up.
     Cards are quite tall to give the description room without truncation,
     and a CTA row at the bottom that hints "Open the tool" so the entire
     card-as-link affordance is unmistakable. */
  .ft-toolsGrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 720px) {
    .ft-toolsGrid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  .ft-toolItem { display: flex; }

  .ft-toolCard {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ft-toolCard:hover,
  .ft-toolCard:focus-visible {
    border-color: var(--color-deep-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    outline: none;
    text-decoration: none;
    color: inherit;
  }

  .ft-toolPreview {
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2);
  }

  .ft-toolPreview svg { max-width: 100%; max-height: 100%; }

  .ft-kicker {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-teal);
    font-weight: 700;
  }

  .ft-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-deep-blue);
    line-height: 1.3;
  }

  .ft-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .ft-cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-deep-blue);
    transition: transform 0.15s ease;
  }

  .ft-toolCard:hover .ft-cta {
    transform: translateX(2px);
  }

  /* "How these tools work" explainer block. Pulled out of the tool cards
     because every card would otherwise repeat the same privacy stance. One
     statement, four bullets, links to the privacy policy implicitly via
     site footer; explicit links are kept to Frankfurter (where the network
     call goes) and the blog. */
  .ft-howItWorks {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .ft-sectionTitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-4);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .ft-howList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .ft-howList li {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    padding-left: var(--space-4);
    position: relative;
  }

  .ft-howList li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-teal);
    opacity: 0.55;
  }

  .ft-howList li strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .ft-howList a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ft-pageFooter {
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .ft-pageFooter a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 480px) {
    .ft-page { padding: var(--space-5) var(--space-3) var(--space-10); }
    .ft-howItWorks { padding: var(--space-5) var(--space-4); }
    .ft-toolCard { padding: var(--space-4); }
  }
</style>
