/**
 * The privacy notice, in whichever language it was asked for.
 *
 * English is served from `src/pages/privacy.astro`, which is a three line
 * wrapper around this; the other languages come through
 * `src/pages/[locale]/privacy.astro`. Both paths render this one component, so
 * the two editions cannot drift apart in markup, in styling, or in the
 * changelog they carry.
 *
 * This is the one page on the site whose text is a promise rather than a
 * lesson, and the English is the version that governs in every edition. A page
 * that is not English says so under the intro, and says separately, under the
 * changelog heading, that the log below it is kept in English: one copy of the
 * record is the point of it, so the entries are in the component rather than in
 * the catalog and read the same in every language.
 *
 * The "Last updated" date is derived at build time from git's last-commit
 * timestamp of this file, as it was from the page before the extraction. Local
 * dev and shallow CI checkouts fall back to the top changelog entry's date.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { execSync } from 'node:child_process';
import { isMonteCarloReleased, monteCarloReleaseDate } from '../../utils/monte-carlo/release.ts';
import { assertOneEntryPerDate, mergeByDate, type ChangelogEntry } from '../../utils/privacyChangelog.ts';
import { DATE_LOCALE, DEFAULT_LOCALE, LOCALES, LOCALE_META, dict, format, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { privacy } = dict(locale);
const {
  collect,
  newsletter,
  waitlist: waitlistNotice,
  browserStorage,
  why,
  where,
  dontDo,
  retention,
  rights,
  whoWeAre,
  changelog: log,
  lead,
  sections,
} = privacy;

/**
 * The literals the notice asks a reader to recognise: storage keys, addresses,
 * parameter names, and the word that goes in an email subject. They are the
 * same string in every language, which is what makes them this file's rather
 * than the catalog's: a translated key name would be a key name that no longer
 * matches anything in the reader's browser.
 */
const KEY = {
  utmSource: 'utm_source',
  utmMedium: 'utm_medium',
  hello: 'hello@nidhi.today',
  updates: 'updates@nidhi.today',
  rates: 'api.frankfurter.dev',
  cookieConsent: 'nidhi-cookie-consent',
  themeMode: 'nidhi-theme-mode',
  internal: 'nidhi-internal',
  readingProgress: 'nidhi-reading-progress',
  newsletterSubscription: 'nidhi-newsletter-subscription',
  newsletterDismissed: 'nidhi-newsletter-dismissed',
  waitlistSignedUp: 'nidhi-waitlist-signedup',
  /** The word a reader is asked to put in a subject line. One inbox reads every edition. */
  privacyWord: 'privacy',
};

// The Monte Carlo simulator's events, and its changelog entry, appear once the
// tool itself is live (src/utils/monte-carlo/release.ts). The entry is dated
// with the launch, not with the day the code was written.
const showMonteCarlo = await isMonteCarloReleased();
const monteCarloLaunch = await monteCarloReleaseDate();

type ChangelogGroup =
  | { kind: 'single'; entry: ChangelogEntry; open: boolean }
  | { kind: 'month'; label: string; entries: ChangelogEntry[] };

// How many entries after the latest stay open, so the most recent changes
// (including any recent incident and its fix) are read in full.
const OPEN_RECENT = 2;

/**
 * The latest entry is shown in full, the next OPEN_RECENT open below it.
 * Everything older is kept word for word under one collapsed "Earlier
 * changes" section, grouped by month, newest first. Nothing is dropped:
 * the log is a record of what this notice said and when.
 */
function groupChangelog(entries: ChangelogEntry[]): { first: ChangelogEntry | null; recent: ChangelogGroup[]; earlier: ChangelogGroup[]; earlierCount: number } {
  if (entries.length === 0) return { first: null, recent: [], earlier: [], earlierCount: 0 };
  const [first, ...rest] = entries;
  const recent: ChangelogGroup[] = rest.slice(0, OPEN_RECENT).map((entry) => ({ kind: 'single', entry, open: true }));
  const older = rest.slice(OPEN_RECENT);
  const months = new Map<string, ChangelogEntry[]>();
  for (const e of older) {
    const key = new Date(e.iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
    const bucket = months.get(key) ?? [];
    bucket.push(e);
    months.set(key, bucket);
  }
  const earlier: ChangelogGroup[] = [...months].map(([label, items]) => ({ kind: 'month', label, entries: items }));
  return { first, recent, earlier, earlierCount: older.length };
}

// Entries that appear with a launch rather than on the day they were written.
const launchEntries: ChangelogEntry[] = showMonteCarlo && monteCarloLaunch
    ? [
        {
          date: monteCarloLaunch.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
          iso: monteCarloLaunch.toISOString().slice(0, 10),
          material: true,
          summary: 'New free tool: a Monte Carlo simulator.',
          details: [
            'The simulator plays a savings and withdrawal plan forward thousands of times with random yearly returns. The whole simulation runs in your browser (large runs in a background thread of the same page); the amounts, years, fees and stock/bond mix you enter are not sent to us or anyone else.',
            'New anonymous interaction events on /free/monte-carlo-simulator: which currency you select, which return setting you pick (cautious, historical or optimistic), which number of simulated paths you pick, whether you switch withdrawals on or off, whether you open the results table, whether you copy a shareable link, whether you reset the form, and, when you arrive from a shared link, that it was a shared link plus its utm_source. None of them carry the values you typed.',
            'Unlike the other tools, this one does not write your inputs into the page address while you type. They only go into a link when you press "Copy a link to this plan", and then after the # sign, a part of the address browsers never send to a server. When you open such a link, the page moves the values out of the address bar before analytics start, so page-view analytics never record them.',
            'The page links to the early-access list for the planner. Following that link is recorded only through the click data you accept on the cookie banner.',
            'The lesson Introduction to Financial Independence ends with a link to the simulator.',
            'The tool makes no network requests of its own and adds no third parties.',
          ],
        },
      ]
    : [];

/**
 * The notice's changelog. Newest first, one entry per date.
 *
 * It is written and dated in English and is never translated. Everything in it
 * describes what the site did on a day: which events fired, which key was
 * written, which request left a browser. A translation would put a second,
 * slightly different copy of that record into the world, and the record is
 * worth more than the convenience.
 *
 * The top-of-page "Last updated" date comes from git's last commit to this file
 * rather than from the newest entry here, so a change that only moves markup
 * still moves the date. See the doc comment at the top of the frontmatter.
 */
// One entry per date (CLAUDE.md). Add a day's changes to its existing entry.
const writtenChangelog: ChangelogEntry[] = [
  {
    date: 'Oct 10, 2026',
    iso: '2026-10-10',
    material: true,
    summary: 'The site is published in Hindi as well as English. The Hindi edition at /hi/ collects exactly what the English one does, with the same browser storage and no new third-party requests. The lessons stay in English, and a Hindi page says so. Also: two new click labels, one on the learning path and one on the homepage, and five sentences of the Hindi notice corrected to say what this one says.',
    details: [
      'The Hindi edition, at /hi/: the site\'s pages are published in Hindi as well, apart from the lessons (see below) and the pages a subscription email links to, which stay in English. A Hindi page sends the same anonymous pageview and page-leave events an English page sends, through the same PostHog project under the same consent choice. There are no new kinds of event, and no event or property carries anything you type, the same promise the English site makes. The two calculators and the free-tools page behave as their English counterparts do, including the rule that a tool never writes what you type into the page address. Hindi is an address and nothing else: no language is stored in your browser, and no automatic redirect picks one for you from your device settings.',
      'The lessons stay in English, and there is one feed. A Hindi page lists the same lessons, in English, and says in Hindi that they are in English, so a reader is not left to work it out from the headings; opening one takes them to that lesson at its one address, which is the English one and is the same address an English reader gets. Every page, in either language, links the one English feed.',
      'The learning path: an English lesson page now carries a link back to the Hindi learning path, so a reader who prefers Hindi can find it from the lesson they are reading. New data-attr label, recorded only if you accept the cookie banner, as before: post-hindi-path. The lesson cards on a Hindi page keep the labels they already had (blog-card-<lesson> and the rest); what changed is where they lead, which is the lesson\'s one address. Nothing new is stored or sent.',
      'The language picker: the header holds a language control, which opens a short list of the languages a page is published in and leads to the same page in the one you choose. Each choice carries one click label, lang-switch-hi on an English page and lang-switch-en on a Hindi page, recorded only if you accept the cookie banner, like every other click label. Opening the control carries no label of its own, because opening it is not switching language. If you switch language on a tool page, the values on screen come with you, whether you typed them or a share link filled them in, and they travel behind the # sign, the part of an address a browser never sends to a server. They are added to the address only as you leave the page, never written into the link itself, so a recorded click on the language control never includes them. Until then they stay in the open page, which keeps an encoded copy of the current values for this purpose and stores nothing. A tool opened this way does not send its shared-view event again, because the page you came from already sent it.',
      'Browser storage is unchanged: the same keys as before, in both languages, and nidhi-reading-progress is deliberately shared, because the lessons are the same lessons whichever edition you reach them from and your place on the learning path should survive switching. The backstop that removes everything but campaign parameters from a free-tool address before any event is sent now covers /hi/free/... as well as /free/.... The Devanagari typeface is served from nidhi.today like the others, so a Hindi page makes no request an English page does not. The Hindi privacy notice is a translation of this one, and this English notice is the version that governs.',
      'Homepage: a "Two questions suggest where to start" link under the starting routes leads to /blog/#level-helper, which opens the level helper when the page loads. New data-attr label, recorded only if you accept the cookie banner, as before: home-level-helper. The helper works as before: your answers are kept only while the page is open, and are not stored or sent.',
      'Homepage: the "My finances have got complicated" route is now the Optimizing level. Until its first lesson is published it shows as a line without a link; once published, its link keeps the existing label (home-start-complex-door). Nothing new is stored or sent.',
      'The Hindi privacy notice, checked line by line against this one: five sentences said something different and now match. They are the promise that we do not sell, rent, license or syndicate your data (the Hindi had said "share" for syndicate, which would have contradicted the processors this notice names); which changes the log below flags as material (the Hindi had said changes that reveal, not changes that affect, how personal data is handled); that we remove you from the newsletter or the waitlist by hand when you ask; that nothing typed into a free tool goes into the page address; and the "short version" opening line. The rest of the Hindi notice also had smaller wording, grammar and spelling fixes, such as naming what the Monte Carlo simulator never sends as amounts and a portfolio mix rather than "figures" and a "mix"; none of them changes what it promises. No practice changed, and this English notice, which governs, is unchanged.',
