    color: var(--color-text-muted);
    margin: 0 0 var(--space-1);
  }

  /* Override the generic h2 treatment inside this section. It's a meta
     section, not a primary policy chapter, so dial the visual weight back. */
  .changelog-section h2 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-3);
