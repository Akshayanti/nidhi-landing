assertOneEntryPerDate(writtenChangelog);
const changelog = mergeByDate([...launchEntries, ...writtenChangelog]);

const groupedLog = groupChangelog(changelog);
const { first, recent, earlier, earlierCount } = groupedLog;

/**
 * Ask git when this file was last committed. Runs only at build time.
 *
 * We use **author date** (`%aI`) rather than committer date (`%cI`) so the
 * timestamp reflects when the change was actually made, not when it was
 * rebased/cherry-picked onto main. Both are "commit-based" in the sense
 * that both come from `git log`, but author date is the one that stays
 * stable across history rewrites.
 *
 * The path is asked of the runtime rather than written out, so moving this
 * file cannot freeze the date at the day of a move: `git log` on a path that
 * does not exist returns nothing, which the fallbacks below would swallow.
 *
 * We fall back to the newest changelog entry if:
 *  - we're outside a git checkout (e.g. a deployed preview from a tarball)
 *  - the CI checkout is too shallow to see the relevant commit (workflow
 *    uses fetch-depth: 0 in prod precisely to avoid this)
 *  - git isn't on the PATH (weird local setups)
 */
function gitLastCommitDate(filePath: string): { date: string; iso: string } | null {
  try {
    const iso = execSync(
      `git log -1 --format=%aI -- "${filePath}"`,
      { stdio: ['ignore', 'pipe', 'ignore'] },
    ).toString().trim();
    if (!iso) return null;
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return null;
    const display = d.toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    });
    return { date: display, iso: iso.slice(0, 10) };
  } catch {
    return null;
  }
}

// Spelled out rather than read from `import.meta.url`: at build time that URL
// points at the bundled chunk, which git has never seen, so the lookup always
// fell back to the changelog date. Keep this in step if the file moves.
const thisFileRel = 'src/components/pages/PrivacyPage.astro';
const gitMeta = gitLastCommitDate(thisFileRel);

// An entry can appear on a launch date without a commit to this file (the
// Monte Carlo simulator's does), so the newest entry wins when it is later.
const entryIsNewer = !!first && (!gitMeta || first.iso > gitMeta.iso);
const lastUpdated = (entryIsNewer ? first?.date : gitMeta?.date) ?? '';
const lastUpdatedIso = (entryIsNewer ? first?.iso : gitMeta?.iso) ?? '';

// The entries are English in every edition, but the dates around them are the
// page's own chrome, so another language writes them its own way. English keeps
// the strings it always printed.
const localDate = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(iso).toLocaleDateString(DATE_LOCALE[locale], { ...opts, timeZone: 'UTC' });
const lastUpdatedShown =
  locale === DEFAULT_LOCALE || !lastUpdatedIso
    ? lastUpdated
    : localDate(lastUpdatedIso, { year: 'numeric', month: 'long', day: 'numeric' });
const monthLabel = (group: { label: string; entries: ChangelogEntry[] }) =>
  locale === DEFAULT_LOCALE || !group.entries[0]
    ? group.label
    : localDate(group.entries[0].iso, { year: 'numeric', month: 'long' });

// Earliest changelog entry is the publication date; newest is the modified
// date. Both are ISO yyyy-mm-dd already, which is exactly what schema.org
// asks for. Falling back to the git-derived dates keeps the schema valid
// even on a bare checkout where the changelog array is somehow empty.
const earliest = changelog[changelog.length - 1];
const datePublished = earliest?.iso ?? lastUpdatedIso;
const dateModified = first?.iso ?? lastUpdatedIso;

const siteUrl = 'https://nidhi.today';
// Built from the path rather than hardcoded with a locale prefix, so the
// addresses here agree with the canonical link BaseHead emits for the same
// page. `localizedPath` returns '/privacy/' for English, which is what this
// page has always advertised.
const noticeUrl = new URL(localizedPath(locale, '/privacy/'), siteUrl).href;
const homeUrl = new URL(localizedPath(locale, '/'), siteUrl).href;
const beliefsUrl = localizedPath(locale, '/beliefs/');

const privacyWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: privacy.schema.name,
  description: privacy.schema.description,
  url: noticeUrl,
  inLanguage: LOCALE_META[locale].htmlLang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'nidhi',
    url: homeUrl,
  },
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: privacy.schema.breadcrumbHome, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: privacy.schema.breadcrumbThis, item: noticeUrl },
    ],
  },
};

const privacyBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: privacy.schema.breadcrumbHome, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: privacy.schema.breadcrumbThis, item: noticeUrl },
  ],
};

// English is the notice that governs, so only a page that is not English
// carries the two notes that say so.
const englishGoverns = locale === DEFAULT_LOCALE;
const olderCount = format(plural(LOCALE_META[locale].htmlLang, earlierCount, log.countOne, log.countFew, log.countOther), { count: earlierCount });
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={privacy.meta.title}
  description={privacy.meta.description}
  jsonLd={[privacyWebPageSchema, privacyBreadcrumbSchema]}
  robots="index,follow"
>
  <section class="privacy">
    <div class="privacy-container">

      <header class="privacy-hero">
