          {collect.freeTools.before}<strong>{collect.freeTools.strong}</strong>{collect.freeTools.after}
        </li>
        <li>{collect.toolAddresses}</li>
        {showMonteCarlo && (
          <li>
            {collect.monteCarlo.before}<strong>{collect.monteCarlo.strong}</strong>
          </li>
        )}
        <li>
          {collect.campaigns.before}<code>{KEY.utmSource}</code>{collect.campaigns.middle}<code>{KEY.utmMedium}</code>{collect.campaigns.after}
        </li>
      </ul>

      <p><strong>{lead.withConsent}</strong></p>
      <ul>
        <li>{collect.consentClicks}</li>
      </ul>

      <p><strong>{lead.newsletter}</strong></p>
      <ul>
        <li>{newsletter.email}</li>
        <li>{newsletter.page}</li>
        <li>{newsletter.timestamps}</li>
        <li>{newsletter.status}</li>
        <li>
          {newsletter.from.before}<code>{KEY.updates}</code>{newsletter.from.after}
        </li>
      </ul>

      <p><strong>{lead.waitlist}</strong></p>
      <ul>
        <li>{waitlistNotice.email}</li>
        <li>{waitlistNotice.page}</li>
        <li>{waitlistNotice.timestamp}</li>
        <li>{waitlistNotice.singleOptIn}</li>
        <li>
          {waitlistNotice.from.before}<code>{KEY.updates}</code>{waitlistNotice.from.after}
        </li>
      </ul>

      <p><strong>{lead.browserOnly}</strong></p>
      <ul>
        <li>{browserStorage.consent.before}<code>{KEY.cookieConsent}</code>{browserStorage.consent.after}</li>
        <li>{browserStorage.theme.before}<code>{KEY.themeMode}</code>{browserStorage.theme.after}</li>
        <li>{browserStorage.internal.before}<code>{KEY.internal}</code>{browserStorage.internal.after}</li>
        <li>{browserStorage.reading.before}<code>{KEY.readingProgress}</code>{browserStorage.reading.after}</li>
        <li>{browserStorage.subscription.before}<code>{KEY.newsletterSubscription}</code>{browserStorage.subscription.after}</li>
        <li>{browserStorage.dismissed.before}<code>{KEY.newsletterDismissed}</code>{browserStorage.dismissed.after}</li>
        <li>{browserStorage.waitlistSignedUp.before}<code>{KEY.waitlistSignedUp}</code>{browserStorage.waitlistSignedUp.after}</li>
      </ul>

      <p>{privacy.clearsEverything}</p>

      <h2>{sections.why}</h2>
      <ul>
        <li><strong>{why.analytics.lead}</strong>{why.analytics.rest}</li>
        <li><strong>{why.newsletter.lead}</strong>{why.newsletter.rest}</li>
        <li><strong>{why.waitlist.lead}</strong>{why.waitlist.rest}</li>
        <li><strong>{why.localPreferences.lead}</strong>{why.localPreferences.rest}</li>
      </ul>

      <h2>{sections.whereItLives}</h2>
      <ul>
        <li><strong>{where.processors.posthog.name}</strong>{where.processors.posthog.rest}</li>
        <li>
          <strong>{where.processors.google.name}</strong>{where.processors.google.before}<code>{KEY.hello}</code>{where.processors.google.middle}<code>{KEY.updates}</code>{where.processors.google.after}
        </li>
        <li><strong>{where.processors.github.name}</strong>{where.processors.github.rest}</li>
        <li><strong>{where.processors.browser.name}</strong>{where.processors.browser.rest}</li>
      </ul>

      <p>{where.thatIsAll}</p>

      <p>
        <strong>{where.frankfurter.lead}</strong> (<code>{KEY.rates}</code>){where.frankfurter.rest}
      </p>

      <h2>{sections.whatWeDontDo}</h2>
      <ul>
        <li>{dontDo.ads}</li>
        <li>{dontDo.sell}</li>
        <li>{dontDo.crossSite}</li>
        <li>{dontDo.screen}</li>
        <li>{dontDo.replies}</li>
        <li>{dontDo.imports}</li>
      </ul>

      <h2>{sections.retention}</h2>
      <ul>
        <li><strong>{retention.analytics.lead}</strong>{retention.analytics.rest}</li>
        <li><strong>{retention.newsletter.lead}</strong>{retention.newsletter.rest}</li>
        <li><strong>{retention.waitlist.lead}</strong>{retention.waitlist.rest}</li>
        <li><strong>{retention.bounced.lead}</strong>{retention.bounced.rest}</li>
        <li><strong>{retention.localStorage.lead}</strong>{retention.localStorage.rest}</li>
      </ul>

      <h2>{sections.rights}</h2>
      <p>{rights.intro}</p>
      <ul>
        <li>{rights.unsubscribe}</li>
        <li>
          {rights.analytics.before}<strong>{rights.analytics.strong}</strong>{rights.analytics.after}
        </li>
        <li>
          {rights.contact.before}<a href={`mailto:${KEY.hello}?subject=${KEY.privacyWord}`}>{KEY.hello}</a>{rights.contact.middle}<strong>{KEY.privacyWord}</strong>{rights.contact.after}
        </li>
      </ul>

      <h2>{sections.children}</h2>
      <p>{privacy.children}</p>

      <section class="changelog-section" aria-labelledby="changelog">
        <p class="changelog-eyebrow">{log.eyebrow}</p>
        <h2 id="changelog">{log.title}</h2>
        {!englishGoverns && <p class="changelog-intro changelog-intro--note">{log.entriesInEnglish}</p>}
        <p class="changelog-intro">
          {log.intro.before}<strong>{log.materialTag}</strong>{log.intro.after}
        </p>
        <p class="changelog-intro">{log.second}</p>

        <ol class="changelog">
          {/* First (latest) entry: always fully visible, no collapse */}
          {first && (
            <li class="changelog-entry">
              <div class="changelog-marker" aria-hidden="true"></div>
              <div class="changelog-body">
                <div class="changelog-head">
                  <time datetime={first.iso} class="changelog-date">{first.iso}</time>
                  {first.material && (
                    <span class="changelog-tag changelog-tag--material" aria-label={log.materialLabel}>{log.materialTag}</span>
                  )}
                </div>
                <p class="changelog-summary" lang="en">{first.summary}</p>
                {first.details && first.details.length > 0 && (
                  <ul class="changelog-details" lang="en">
                    {first.details.map((d) => <li>{d}</li>)}
                  </ul>
                )}
              </div>
            </li>
          )}

          {/* The next most recent entries, open */}
          {recent.map((group) => group.kind === 'single' && (
              <li class="changelog-entry">
                <details open={group.open} class="changelog-collapse">
                  <summary class="changelog-collapseSummary">
                    <div class="changelog-marker" aria-hidden="true"></div>
                    <div class="changelog-head">
                      <time datetime={group.entry.iso} class="changelog-date">{group.entry.iso}</time>
                      {group.entry.material && (
                        <span class="changelog-tag changelog-tag--material" aria-label={log.materialLabel}>{log.materialTag}</span>
                      )}
                    </div>
                  </summary>
                  <div class="changelog-body">
                    <p class="changelog-summary" lang="en">{group.entry.summary}</p>
                    {group.entry.details && group.entry.details.length > 0 && (
                      <ul class="changelog-details" lang="en">
                        {group.entry.details.map((d) => <li>{d}</li>)}
                      </ul>
                    )}
                  </div>
                </details>
              </li>
          ))}

          {/* Everything older, word for word, under one collapsed section */}
          {earlierCount > 0 && (
            <li class="changelog-entry changelog-entry--group">
              <details class="changelog-collapse">
                <summary class="changelog-collapseSummary">
                  <div class="changelog-marker" aria-hidden="true"></div>
                  <span class="changelog-groupLabel">{log.earlier}</span>
                  <span class="changelog-groupCount">{olderCount}</span>
                </summary>
                {earlier.map((group) => group.kind === 'month' && (
                  <section class="changelog-month" aria-label={monthLabel(group)}>
                    <h3 class="changelog-monthLabel">{monthLabel(group)}</h3>
                    <ol class="changelog-groupEntries">
                      {group.entries.map((entry) => (
                        <li class="changelog-groupEntry">
                          <div class="changelog-head">
                            <time datetime={entry.iso} class="changelog-date">{entry.iso}</time>
                            {entry.material && (
                              <span class="changelog-tag changelog-tag--material" aria-label={log.materialLabel}>{log.materialTag}</span>
                            )}
                          </div>
                          <p class="changelog-summary" lang="en">{entry.summary}</p>
                          {entry.details && entry.details.length > 0 && (
                            <ul class="changelog-details" lang="en">
                              {entry.details.map((d) => <li>{d}</li>)}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
              </details>
            </li>
          )}
        </ol>
      </section>

      <h2>{sections.whoWeAre}</h2>
      <p>{whoWeAre.intro}</p>
      <ul class="contact-list">
        <li><a href={`mailto:${KEY.hello}`}>{KEY.hello}</a>{whoWeAre.contact.hello}</li>
        <li><a href="https://www.instagram.com/nidhi.today" target="_blank" rel="noopener noreferrer">@nidhi.today</a>{whoWeAre.contact.instagram}</li>
        <li><a href={beliefsUrl}>{whoWeAre.contact.beliefsLink}</a>{whoWeAre.contact.beliefsRest}</li>
      </ul>

    </div>
  </section>
</BaseLayout>

<style>
