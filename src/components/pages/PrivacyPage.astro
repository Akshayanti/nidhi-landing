/**
 * The privacy notice, in whichever language it was asked for.
 *
 * English is served from `src/pages/privacy.astro`, which is a three line
 * wrapper around this; the other languages come through
 * `src/pages/[locale]/privacy.astro`. Both paths render this one component, so
 * the two editions cannot drift apart in markup, in styling, or in the
 * changelog they carry.
 *
 * This is the one page on the site whose text is a promise rather than a
 * lesson, and the English is the version that governs in every edition. A page
 * that is not English says so under the intro, and says separately, under the
 * changelog heading, that the log below it is kept in English: one copy of the
 * record is the point of it, so the entries are in the component rather than in
 * the catalog and read the same in every language.
 *
 * The "Last updated" date is derived at build time from git's last-commit
 * timestamp of this file, as it was from the page before the extraction. Local
 * dev and shallow CI checkouts fall back to the top changelog entry's date.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { execSync } from 'node:child_process';
import { isMonteCarloReleased, monteCarloReleaseDate } from '../../utils/monte-carlo/release.ts';
import { assertOneEntryPerDate, mergeByDate, type ChangelogEntry } from '../../utils/privacyChangelog.ts';
import { DATE_LOCALE, DEFAULT_LOCALE, LOCALES, LOCALE_META, dict, format, plural, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { privacy } = dict(locale);
const {
  collect,
  newsletter,
  waitlist: waitlistNotice,
  browserStorage,
  why,
  where,
  dontDo,
  retention,
  rights,
  whoWeAre,
  changelog: log,
  lead,
  sections,
} = privacy;

/**
 * The literals the notice asks a reader to recognise: storage keys, addresses,
 * parameter names, and the word that goes in an email subject. They are the
 * same string in every language, which is what makes them this file's rather
 * than the catalog's: a translated key name would be a key name that no longer
 * matches anything in the reader's browser.
 */
const KEY = {
  utmSource: 'utm_source',
  utmMedium: 'utm_medium',
  hello: 'hello@nidhi.today',
  updates: 'updates@nidhi.today',
  rates: 'api.frankfurter.dev',
  cookieConsent: 'nidhi-cookie-consent',
  themeMode: 'nidhi-theme-mode',
  internal: 'nidhi-internal',
  readingProgress: 'nidhi-reading-progress',
  newsletterSubscription: 'nidhi-newsletter-subscription',
  newsletterDismissed: 'nidhi-newsletter-dismissed',
  waitlistSignedUp: 'nidhi-waitlist-signedup',
  /** The word a reader is asked to put in a subject line. One inbox reads every edition. */
  privacyWord: 'privacy',
};

// The Monte Carlo simulator's events, and its changelog entry, appear once the
// tool itself is live (src/utils/monte-carlo/release.ts). The entry is dated
// with the launch, not with the day the code was written.
const showMonteCarlo = await isMonteCarloReleased();
const monteCarloLaunch = await monteCarloReleaseDate();

type ChangelogGroup =
  | { kind: 'single'; entry: ChangelogEntry; open: boolean }
  | { kind: 'month'; label: string; entries: ChangelogEntry[] };

// How many entries after the latest stay open, so the most recent changes
// (including any recent incident and its fix) are read in full.
const OPEN_RECENT = 2;

/**
 * The latest entry is shown in full, the next OPEN_RECENT open below it.
 * Everything older is kept word for word under one collapsed "Earlier
 * changes" section, grouped by month, newest first. Nothing is dropped:
 * the log is a record of what this notice said and when.
 */
function groupChangelog(entries: ChangelogEntry[]): { first: ChangelogEntry | null; recent: ChangelogGroup[]; earlier: ChangelogGroup[]; earlierCount: number } {
  if (entries.length === 0) return { first: null, recent: [], earlier: [], earlierCount: 0 };
  const [first, ...rest] = entries;
  const recent: ChangelogGroup[] = rest.slice(0, OPEN_RECENT).map((entry) => ({ kind: 'single', entry, open: true }));
  const older = rest.slice(OPEN_RECENT);
  const months = new Map<string, ChangelogEntry[]>();
  for (const e of older) {
    const key = new Date(e.iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
    const bucket = months.get(key) ?? [];
    bucket.push(e);
    months.set(key, bucket);
  }
  const earlier: ChangelogGroup[] = [...months].map(([label, items]) => ({ kind: 'month', label, entries: items }));
  return { first, recent, earlier, earlierCount: older.length };
}

// Entries that appear with a launch rather than on the day they were written.
