---
/**
 * The privacy notice, in whichever language it was asked for.
 *
 * English is served from `src/pages/privacy.astro`, which is a three line
 * wrapper around this; the other languages come through
 * `src/pages/[locale]/privacy.astro`. Both paths render this one component, so
 * the two editions cannot drift apart in markup, in styling, or in the
 * changelog they carry.
 *
 * This is the one page on the site whose text is a promise rather than a
 * lesson, and the English is the version that governs in every edition. A page
 * that is not English says so under the intro, and says separately, under the
 * changelog heading, that the log below it is kept in English: one copy of the
 * record is the point of it, so the entries are in their own module
 * (`src/utils/privacyChangelogEntries.ts`) rather than in the catalog and read the same
 * in every language. The notice shows the latest three; the complete record is
 * on the changelog pages, one per year (#722).
 *
 * The "Last updated" date is derived at build time from git's last-commit
 * timestamp of this file and of the entries' module, as it was from the page
 * before the extraction. Local dev and shallow CI checkouts fall back to the
 * top changelog entry's date.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { execSync } from 'node:child_process';
import { isMonteCarloReleased } from '../../utils/monte-carlo/release.ts';
import { isInvestOrPayOffReleased } from '../../utils/invest-or-pay-off/release.ts';
import { NOTICE_ENTRIES, entryAnchor, entryYear } from '../../utils/privacyChangelog.ts';
import { privacyChangelog } from '../../utils/privacyChangelogSource.ts';
import { DATE_LOCALE, DEFAULT_LOCALE, LOCALES, LOCALE_META, dict, format, plural, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { privacy } = dict(locale);
const {
  collect,
  newsletter,
  waitlist: waitlistNotice,
  volunteers: volunteersNotice,
  browserStorage,
  why,
  where,
  dontDo,
  retention,
  rights,
  whoWeAre,
  changelog: log,
  lead,
  sections,
} = privacy;

/**
 * The literals the notice asks a reader to recognise: storage keys, addresses,
 * parameter names, and the word that goes in an email subject. They are the
 * same string in every language, which is what makes them this file's rather
 * than the catalog's: a translated key name would be a key name that no longer
 * matches anything in the reader's browser.
 */
const KEY = {
  utmSource: 'utm_source',
  utmMedium: 'utm_medium',
  hello: 'hello@nidhi.today',
  updates: 'updates@nidhi.today',
  rates: 'api.frankfurter.dev',
  cookieConsent: 'nidhi-cookie-consent',
  themeMode: 'nidhi-theme-mode',
  internal: 'nidhi-internal',
  readingProgress: 'nidhi-reading-progress',
  newsletterSubscription: 'nidhi-newsletter-subscription',
  newsletterDismissed: 'nidhi-newsletter-dismissed',
  waitlistSignedUp: 'nidhi-waitlist-signedup',
  /** The word a reader is asked to put in a subject line. One inbox reads every edition. */
  privacyWord: 'privacy',
};

// The Monte Carlo simulator's and the invest or pay off calculator's events
// appear in the notice once the tool itself is live (src/utils/*/release.ts).
const showMonteCarlo = await isMonteCarloReleased();
const showInvestOrPayOff = await isInvestOrPayOffReleased();

// The changelog: the hand-written entries and the launch entries of the
// tools that are live, one entry per date, newest first. The entries live in
// src/utils/privacyChangelogEntries.ts; the notice shows the latest NOTICE_ENTRIES and
// links to the complete record, one page per year (#722).
const changelog = await privacyChangelog();
const [first, ...recent] = changelog.slice(0, NOTICE_ENTRIES);

/**
 * Ask git when these files were last committed. Runs only at build time.
 *
 * We use **author date** (`%aI`) rather than committer date (`%cI`) so the
 * timestamp reflects when the change was actually made, not when it was
 * rebased/cherry-picked onto main. Both are "commit-based" in the sense
 * that both come from `git log`, but author date is the one that stays
 * stable across history rewrites.
 *
 * The path is asked of the runtime rather than written out, so moving this
 * file cannot freeze the date at the day of a move: `git log` on a path that
 * does not exist returns nothing, which the fallbacks below would swallow.
 *
 * We fall back to the newest changelog entry if:
 *  - we're outside a git checkout (e.g. a deployed preview from a tarball)
 *  - the CI checkout is too shallow to see the relevant commit (workflow
 *    uses fetch-depth: 0 in prod precisely to avoid this)
 *  - git isn't on the PATH (weird local setups)
 */
function gitLastCommitDate(filePaths: string[]): { date: string; iso: string } | null {
  try {
    const iso = execSync(
      `git log -1 --format=%aI -- ${filePaths.map((p) => `"${p}"`).join(' ')}`,
      { stdio: ['ignore', 'pipe', 'ignore'] },
    ).toString().trim();
    if (!iso) return null;
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return null;
    const display = d.toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    });
    return { date: display, iso: iso.slice(0, 10) };
  } catch {
    return null;
  }
}

// Spelled out rather than read from `import.meta.url`: at build time that URL
// points at the bundled chunk, which git has never seen, so the lookup always
// fell back to the changelog date. Keep this in step if a file moves. The
// entries moved out of this file into their own module (#722), which is asked
// too, so a new entry still moves the date as it did when it was written here.
const noticeSources = ['src/components/pages/PrivacyPage.astro', 'src/utils/privacyChangelogEntries.ts'];
const gitMeta = gitLastCommitDate(noticeSources);

// An entry can appear on a launch date without a commit to this file (the
// Monte Carlo simulator's does), so the newest entry wins when it is later.
const entryIsNewer = !!first && (!gitMeta || first.iso > gitMeta.iso);
const lastUpdated = (entryIsNewer ? first?.date : gitMeta?.date) ?? '';
const lastUpdatedIso = (entryIsNewer ? first?.iso : gitMeta?.iso) ?? '';

// The entries are English in every edition, but the dates around them are the
// page's own chrome, so another language writes them its own way. English keeps
// the strings it always printed.
const localDate = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(iso).toLocaleDateString(DATE_LOCALE[locale], { ...opts, timeZone: 'UTC' });
const lastUpdatedShown =
  locale === DEFAULT_LOCALE || !lastUpdatedIso
    ? lastUpdated
    : localDate(lastUpdatedIso, { year: 'numeric', month: 'long', day: 'numeric' });
const longDate = (iso: string) => localDate(iso, { year: 'numeric', month: 'long', day: 'numeric' });

// Each entry the notice shows links to its permanent place on its year page,
// and the notice ends with a link to the complete record and its date range.
const archivePath = localizedPath(locale, '/privacy/changelog/');
const entryHref = (iso: string) => `${localizedPath(locale, `/privacy/changelog/${entryYear(iso)}/`)}#${entryAnchor(iso)}`;
const entryLinkLabel = (iso: string) => format(log.entryLinkLabel, { date: iso });

// Earliest changelog entry is the publication date; newest is the modified
// date. Both are ISO yyyy-mm-dd already, which is exactly what schema.org
// asks for. Falling back to the git-derived dates keeps the schema valid
// even on a bare checkout where the changelog array is somehow empty.
const earliest = changelog[changelog.length - 1];
const datePublished = earliest?.iso ?? lastUpdatedIso;
const dateModified = first?.iso ?? lastUpdatedIso;

const siteUrl = 'https://nidhi.today';
// Built from the path rather than hardcoded with a locale prefix, so the
// addresses here agree with the canonical link BaseHead emits for the same
// page. `localizedPath` returns '/privacy/' for English, which is what this
// page has always advertised.
const noticeUrl = new URL(localizedPath(locale, '/privacy/'), siteUrl).href;
const homeUrl = new URL(localizedPath(locale, '/'), siteUrl).href;
const beliefsUrl = localizedPath(locale, '/beliefs/');

const privacyWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: privacy.schema.name,
  description: privacy.schema.description,
  url: noticeUrl,
  inLanguage: LOCALE_META[locale].htmlLang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'nidhi',
    url: homeUrl,
  },
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: privacy.schema.breadcrumbHome, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: privacy.schema.breadcrumbThis, item: noticeUrl },
    ],
  },
};

const privacyBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: privacy.schema.breadcrumbHome, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: privacy.schema.breadcrumbThis, item: noticeUrl },
  ],
};

// English is the notice that governs, so only a page that is not English
// carries the two notes that say so.
const englishGoverns = locale === DEFAULT_LOCALE;
const archiveRange = earliest && first
  ? format(log.archiveRange, {
      count: format(plural(LOCALE_META[locale].htmlLang, changelog.length, log.countOne, log.countFew, log.countOther), { count: changelog.length }),
      from: longDate(earliest.iso),
      to: longDate(first.iso),
    })
  : '';
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={privacy.meta.title}
  description={privacy.meta.description}
  jsonLd={[privacyWebPageSchema, privacyBreadcrumbSchema]}
  robots="index,follow"
>
  <section class="privacy">
    <div class="privacy-container">

      <header class="privacy-hero">
        <h1 class="privacy-title">{privacy.title}</h1>
        <p class="privacy-intro">{privacy.intro}</p>
        {!englishGoverns && <p class="privacy-note">{privacy.englishIsAuthoritative}</p>}
        <p class="privacy-updated">
          {privacy.updatedLabel}<time datetime={lastUpdatedIso}>{lastUpdatedShown}</time> ·{' '}
          <a href="#changelog">{privacy.updatedLink}</a>
        </p>
      </header>

      <h2>{sections.collect}</h2>

      <p><strong>{lead.always}</strong></p>
      <ul>
        <li>
          {collect.pageviews.before}<a href="https://posthog.com/eu" target="_blank" rel="noopener noreferrer">{collect.pageviews.link}</a>{collect.pageviews.after}
        </li>
        {/* The home page's tools section links here ("How the tools handle your numbers"). */}
        <li id="free-tools">
          {collect.freeTools.before}<strong>{collect.freeTools.strong}</strong>{collect.freeTools.after}
        </li>
        <li>
          {collect.netWorth.before}<strong>{collect.netWorth.strong}</strong>
        </li>
        <li>{collect.toolAddresses}</li>
        <li>{collect.toolExports}</li>
        {showMonteCarlo && (
          <li>
            {collect.monteCarlo.before}<strong>{collect.monteCarlo.strong}</strong>
          </li>
        )}
        <li>
          {collect.inflation.before}<strong>{collect.inflation.strong}</strong>
        </li>
        {showInvestOrPayOff && (
          <li>
            {collect.investOrPayOff.before}<strong>{collect.investOrPayOff.strong}</strong>
          </li>
        )}
        <li>
          {collect.campaigns.before}<code>{KEY.utmSource}</code>{collect.campaigns.middle}<code>{KEY.utmMedium}</code>{collect.campaigns.after}
        </li>
        <li>{collect.lessonShare}</li>
      </ul>

      <p><strong>{lead.withConsent}</strong></p>
      <ul>
        <li>{collect.consentClicks}</li>
        <li>{collect.consentVisitorId}</li>
      </ul>

      <p><strong>{lead.newsletter}</strong></p>
      <ul>
        <li>{newsletter.email}</li>
        <li>{newsletter.page}</li>
        <li>{newsletter.timestamps}</li>
        <li>{newsletter.status}</li>
        <li>{newsletter.analytics}</li>
        <li>{newsletter.total}</li>
        <li>
          {newsletter.from.before}<code>{KEY.updates}</code>{newsletter.from.after}
        </li>
      </ul>

      <p><strong>{lead.waitlist}</strong></p>
      <ul>
        <li>{waitlistNotice.email}</li>
        <li>{waitlistNotice.page}</li>
        <li>{waitlistNotice.timestamp}</li>
        <li>{waitlistNotice.singleOptIn}</li>
        <li>{waitlistNotice.invites}</li>
        <li>{waitlistNotice.total}</li>
        <li>
          {waitlistNotice.from.before}<code>{KEY.updates}</code>{waitlistNotice.from.after}
        </li>
      </ul>

      <p><strong>{lead.volunteers}</strong></p>
      <ul>
        <li>{volunteersNotice.form}</li>
        <li>{volunteersNotice.answers}</li>
        <li>{volunteersNotice.consent}</li>
        <li>{volunteersNotice.credit}</li>
        <li>{volunteersNotice.agreement}</li>
        <li>{volunteersNotice.review}</li>
        <li>{volunteersNotice.reviewIdentity}</li>
        <li>{volunteersNotice.reviewSubmit}</li>
        <li>{volunteersNotice.reviewShared}</li>
        <li>{volunteersNotice.followUp}</li>
        <li>{volunteersNotice.invites}</li>
        <li>{volunteersNotice.total}</li>
        <li>{volunteersNotice.google}</li>
      </ul>

      <p><strong>{lead.planner}</strong></p>
      <ul>
        <li>{collect.planner.anonymous}</li>
        <li>{collect.planner.consented}</li>
      </ul>
      <p><strong>{lead.consentChoice}</strong></p>
      <ul>
        <li>{collect.consentChoice.before}<code>{KEY.cookieConsent}</code>{collect.consentChoice.after}</li>
        <li>{collect.consentChoice.older}</li>
      </ul>
      <p><strong>{lead.browserOnly}</strong></p>
      <ul>
        <li>{browserStorage.theme.before}<code>{KEY.themeMode}</code>{browserStorage.theme.after}</li>
        <li>{browserStorage.internal.before}<code>{KEY.internal}</code>{browserStorage.internal.after}</li>
        <li>{browserStorage.reading.before}<code>{KEY.readingProgress}</code>{browserStorage.reading.after}</li>
        <li>{browserStorage.subscription.before}<code>{KEY.newsletterSubscription}</code>{browserStorage.subscription.after}</li>
        <li>{browserStorage.dismissed.before}<code>{KEY.newsletterDismissed}</code>{browserStorage.dismissed.after}</li>
        <li>{browserStorage.waitlistSignedUp.before}<code>{KEY.waitlistSignedUp}</code>{browserStorage.waitlistSignedUp.after}</li>
      </ul>

      <p>{privacy.clearsEverything}</p>

      <h2>{sections.why}</h2>
      <ul>
        <li><strong>{why.analytics.lead}</strong>{why.analytics.rest}</li>
        <li><strong>{why.newsletter.lead}</strong>{why.newsletter.rest}</li>
        <li><strong>{why.waitlist.lead}</strong>{why.waitlist.rest}</li>
        <li><strong>{why.volunteers.lead}</strong>{why.volunteers.rest}</li>
        <li><strong>{why.localPreferences.lead}</strong>{why.localPreferences.rest}</li>
      </ul>

      <h2>{sections.whereItLives}</h2>
      <ul>
        <li><strong>{where.processors.posthog.name}</strong>{where.processors.posthog.rest}</li>
        <li>
          <strong>{where.processors.google.name}</strong>{where.processors.google.before}<code>{KEY.hello}</code>{where.processors.google.middle}<code>{KEY.updates}</code>{where.processors.google.after}
        </li>
        <li><strong>{where.processors.planner.name}</strong>{where.processors.planner.rest}</li>
        <li><strong>{where.processors.github.name}</strong>{where.processors.github.rest}</li>
        <li><strong>{where.processors.browser.name}</strong>{where.processors.browser.rest}</li>
      </ul>

      <p>{where.thatIsAll}</p>

      <p>
        <strong>{where.frankfurter.lead}</strong> (<code>{KEY.rates}</code>){where.frankfurter.rest}
      </p>

      <h2>{sections.whatWeDontDo}</h2>
      <ul>
        <li>{dontDo.ads}</li>
        <li>{dontDo.sell}</li>
        <li>{dontDo.crossSite}</li>
        <li>{dontDo.screen}</li>
        <li>{dontDo.replies}</li>
        <li>{dontDo.imports}</li>
      </ul>

      <h2>{sections.retention}</h2>
      <ul>
        <li><strong>{retention.analytics.lead}</strong>{retention.analytics.rest}</li>
        <li><strong>{retention.newsletter.lead}</strong>{retention.newsletter.rest}</li>
        <li><strong>{retention.waitlist.lead}</strong>{retention.waitlist.rest}</li>
        <li><strong>{retention.volunteers.lead}</strong>{retention.volunteers.rest}</li>
        <li><strong>{retention.invites.lead}</strong>{retention.invites.rest}</li>
        <li><strong>{retention.bounced.lead}</strong>{retention.bounced.rest}</li>
        <li><strong>{retention.sendRetry.lead}</strong>{retention.sendRetry.rest}</li>
        <li><strong>{retention.visitorId.lead}</strong>{retention.visitorId.rest}</li>
        <li><strong>{retention.consentCookie.lead}</strong>{retention.consentCookie.rest}</li>
        <li><strong>{retention.localStorage.lead}</strong>{retention.localStorage.rest}</li>
      </ul>

      <h2>{sections.rights}</h2>
      <p>{rights.intro}</p>
      <ul>
        <li>{rights.unsubscribe}</li>
        <li>
          {rights.analytics.before}<strong>{rights.analytics.strong}</strong>{rights.analytics.after}
        </li>
        <li>
          {rights.contact.before}<a href={`mailto:${KEY.hello}?subject=${KEY.privacyWord}`}>{KEY.hello}</a>{rights.contact.middle}<strong>{KEY.privacyWord}</strong>{rights.contact.after}
        </li>
      </ul>

      <h2>{sections.children}</h2>
      <p>{privacy.children}</p>

      <section class="changelog-section" aria-labelledby="changelog">
        <p class="eyebrow eyebrow--muted changelog-eyebrow">{log.eyebrow}</p>
        <h2 id="changelog">{log.title}</h2>
        {!englishGoverns && <p class="changelog-intro changelog-intro--note">{log.entriesInEnglish}</p>}
        <p class="changelog-intro">
          {log.intro.before}<strong>{log.materialTag}</strong>{log.intro.after}
        </p>
        <p class="changelog-intro">{log.second}</p>

        <ol class="changelog">
          {/* First (latest) entry: always fully visible, no collapse */}
          {first && (
            <li class="changelog-entry">
              <div class="changelog-marker" aria-hidden="true"></div>
              <div class="changelog-body">
                <div class="changelog-head">
                  <time datetime={first.iso} class="changelog-date">{first.iso}</time>
                  {first.material && (
                    <span class="changelog-tag changelog-tag--material" aria-label={log.materialLabel}>{log.materialTag}</span>
                  )}
                </div>
                <p class="changelog-summary" lang="en">{first.summary}</p>
                {first.details && first.details.length > 0 && (
                  <ul class="changelog-details" lang="en">
                    {first.details.map((d) => <li>{d}</li>)}
                  </ul>
                )}
                <p class="changelog-permalink"><a href={entryHref(first.iso)} aria-label={entryLinkLabel(first.iso)}>{log.entryLink}</a></p>
              </div>
            </li>
          )}

          {/* The next most recent entries, open */}
          {recent.map((entry) => (
              <li class="changelog-entry">
                <details open class="changelog-collapse">
                  <summary class="changelog-collapseSummary">
                    <div class="changelog-marker" aria-hidden="true"></div>
                    <div class="changelog-head">
                      <time datetime={entry.iso} class="changelog-date">{entry.iso}</time>
                      {entry.material && (
                        <span class="changelog-tag changelog-tag--material" aria-label={log.materialLabel}>{log.materialTag}</span>
                      )}
                    </div>
                  </summary>
                  <div class="changelog-body">
                    <p class="changelog-summary" lang="en">{entry.summary}</p>
                    {entry.details && entry.details.length > 0 && (
                      <ul class="changelog-details" lang="en">
                        {entry.details.map((d) => <li>{d}</li>)}
                      </ul>
                    )}
                    <p class="changelog-permalink"><a href={entryHref(entry.iso)} aria-label={entryLinkLabel(entry.iso)}>{log.entryLink}</a></p>
                  </div>
                </details>
              </li>
          ))}

        </ol>

        {/* The complete record, every entry, on a page per year (#722). */}
        <p class="changelog-archive">
          <a href={archivePath}>{log.archiveLink}</a>
          {archiveRange && <span class="changelog-archiveRange">{archiveRange}</span>}
        </p>
      </section>

      <h2>{sections.whoWeAre}</h2>
      <p>{whoWeAre.intro}</p>
      <ul class="contact-list">
        <li><a href={`mailto:${KEY.hello}`}>{KEY.hello}</a>{whoWeAre.contact.hello}</li>
        <li><a href="https://www.instagram.com/nidhi.today" target="_blank" rel="noopener noreferrer">@nidhi.today</a>{whoWeAre.contact.instagram}</li>
        <li><a href={beliefsUrl}>{whoWeAre.contact.beliefsLink}</a>{whoWeAre.contact.beliefsRest}</li>
      </ul>

    </div>
  </section>
</BaseLayout>

<style>
  .privacy {
    display: flex;
    justify-content: center;
    padding: var(--space-10) var(--layout-gutter);
  }

  .privacy-container {
    max-width: calc(var(--layout-reading) - 2 * var(--layout-gutter));
    width: 100%;
  }

  .privacy-hero {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .privacy-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--title-page);
    line-height: var(--leading-tight);
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .privacy-intro {
    font-size: var(--text-prose);
    color: var(--color-text-primary);
    line-height: 1.65;
    margin: 0 0 var(--space-3);
  }

  /* The note that says the English text governs, and the one about the
     changelog's language. Both are set apart from the copy they qualify:
     a reader who skims the intro or the log should still not miss them. */
  .privacy-note {
    font-size: var(--text-ui);
    color: var(--color-deep-blue);
    line-height: 1.65;
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-border-light);
    border-left: 3px solid var(--color-teal);
    border-radius: var(--radius-sm);
  }

  .privacy-updated {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .privacy-container h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-deep-blue);
    margin: var(--space-8) 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .privacy-container h2:first-of-type {
    margin-top: var(--space-2);
  }

  .privacy-container p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-3);
  }

  .privacy-container ul {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .privacy-container li {
    margin-bottom: var(--space-2);
  }

  .privacy-container li:last-child {
    margin-bottom: 0;
  }

  .privacy-container strong {
    color: var(--color-deep-blue);
    font-weight: 600;
  }

  .privacy-container a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy-container a:hover {
    color: var(--color-teal-dark);
  }

  .privacy-container code {
    background: var(--color-border-light);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    font-family: var(--font-mono);
    color: var(--color-deep-blue);
    /* An address or a storage key wraps at a large text size (#486). */
    overflow-wrap: anywhere;
  }

  .contact-list {
