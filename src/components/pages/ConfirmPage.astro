---
/**
 * The double opt-in confirm page, in whichever language it was asked for.
 *
 * English is served from `src/pages/confirm.astro`, the address the
 * confirmation email links to; the other languages come through
 * `src/pages/[locale]/confirm.astro`. Both render this one component.
 *
 * The inline script cannot import the catalog, so the lines it sets and the
 * address it redirects to are handed over with `define:vars`. Everything else
 * it does (the token, the endpoint, the request body, the localStorage key and
 * the PostHog event) is the same in every language.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, dict, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale).transactional.confirm;

const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
const isDev = import.meta.env.DEV;

const msg = {
  button: t.button,
  confirming: t.confirming,
  missingToken: t.missingToken,
  notConfigured: t.notConfigured,
  error: t.error,
};
const confirmedPath = localizedPath(locale, '/subscription-confirmed');
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={t.meta.title}
  description={t.meta.description}
  robots="noindex,nofollow"
>
  <section class="transactional">
    <div class="transactional-card">
      <div class="transactional-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>

      <h1 class="transactional-title">{t.heading}</h1>
      <p class="transactional-body">
        {t.bodyBefore}<strong>nidhi</strong>{t.bodyAfter}
      </p>

      <button
        id="confirm-button"
        class="transactional-cta"
        type="button"
        disabled
        data-endpoint={endpoint}
      >
        {t.button}
      </button>

      <p id="confirm-status" class="transactional-status" role="status" aria-live="polite"></p>

      <p class="transactional-secondary">
        {t.secondary}
      </p>

      {isDev && !endpoint && (
        <p class="transactional-dev-warning">
          ⚠ <code>PUBLIC_NEWSLETTER_ENDPOINT</code> is not set locally. The button
          will be visible but click submissions will no-op. See
          <code>docs/blog-subscription-setup.md</code>.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ msg, confirmedPath }}>
  (function () {
    var btn = document.getElementById('confirm-button');
    var status = document.getElementById('confirm-status');
    if (!btn || !status) return;

    // Pull the token out of the URL, then immediately strip it so it's not
    // in the address bar, browser history, or accidental screenshots.
    var params = new URLSearchParams(window.location.search);
    var token = params.get('t') || '';
    if (token) {
      try {
        history.replaceState(null, '', window.location.pathname);
      } catch (_) {}
    }

    var endpoint = btn.getAttribute('data-endpoint') || '';

    function setStatus(text, kind) {
      status.textContent = text;
      status.className = 'transactional-status transactional-status--' + kind;
    }

    if (!token) {
      btn.disabled = true;
      setStatus(msg.missingToken, 'error');
      return;
    }
    if (!endpoint) {
      btn.disabled = true;
      setStatus(msg.notConfigured, 'error');
      return;
    }

    btn.disabled = false;

    btn.addEventListener('click', function () {
      btn.disabled = true;
      btn.textContent = msg.confirming;
      setStatus('', 'idle');

      var body = new URLSearchParams();
      body.set('action', 'confirm');
      body.set('t', token);

      // Apps Script doesn't emit CORS headers, so we can't read the
      // response: fire and redirect. Apps Script is authoritative: if
      // the token was valid, the row is now confirmed; if not, nothing
      // changed and the user will see /subscription-invalid/ on retry
      // if they click the original email link a second time.
      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      }).then(function () {
        // Set the subscription flag to confirmed. This is the ONLY place
        // that writes this key: form submit doesn't set it, so the CTA
        // stays visible until the double-opt-in loop is complete. Works
        // regardless of which browser/device the confirm link is opened on.
        // See /privacy for what this stores.
        try {
          localStorage.setItem(
            'nidhi-newsletter-subscription',
            JSON.stringify({ status: 'confirmed', at: Date.now() })
          );
        } catch (_) {}
        if (window.posthog) {
          // Sent at once rather than in the next batch: the page redirects
          // 300 ms later, well inside PostHog's batching window.
          window.posthog.capture('blog_subscribe_confirm_clicked', {}, { send_instantly: true });
        }
        // Delay redirect to let PostHog's async flush complete. Without
        // this the navigation cancels the in-flight capture request.
        setTimeout(function () {
          window.location.replace(confirmedPath);
        }, 300);
      }).catch(function () {
        setStatus(msg.error, 'error');
        btn.disabled = false;
        btn.textContent = msg.button;
      });
    });
  })();
</script>
