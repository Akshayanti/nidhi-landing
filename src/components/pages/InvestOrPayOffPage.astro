---
/**
 * The invest or pay off calculator page, in whichever language it was asked
 * for.
 *
 * English is served from `src/pages/free/invest-or-pay-off/[...path].astro`,
 * the other languages from
 * `src/pages/[locale]/free/invest-or-pay-off/[...path].astro`; both render
 * this one component. Both routes are gated on lesson 49's pubDate
 * (src/utils/invest-or-pay-off/release.ts), so the tool goes live with it.
 *
 * The copy is in the catalog, under `tools.investOrPayOff.page`, and what the
 * tool says under `tools.investOrPayOff.island`, which is handed to the
 * island as a prop: one locale's slice, never `dict(locale)`.
 *
 * Inflation comes from the same World Bank history as the inflation
 * calculator. Only the country the page starts with is embedded (the euro
 * area on the English and Spanish pages, India on the Hindi and Marathi
 * pages, Czechia on the Czech page); the rest is fetched from this site's own
 * origin when a reader picks a country. A page's language is the only thing
 * that choice reads; the tool never detects a reader's location.
 *
 * What stays here rather than in the catalog: the `data-attr` labels, the
 * addresses, the lesson slugs and the English lesson title.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestOrPayOff from '../InvestOrPayOff.tsx';
import type { CountryOption } from '../InflationCalculator.tsx';
import ToolStateGuard from '../ToolStateGuard.astro';
import ToolPageShell from '../ToolPageShell.astro';
import ToolWaitlist from '../ToolWaitlist.astro';
import { getCollection } from 'astro:content';
import data from '../../data/inflation/worldbank.json';
import { COUNTRY_CURRENCY } from '../../utils/inflation/countries.ts';
import { HISTORY_URL, toCompactSeries, type WorldBankFile } from '../../utils/inflation/history.ts';
import { PATHS, REAL_RETURN_BOTTOM, REAL_RETURN_TOP } from '../../utils/invest-or-pay-off/math.ts';
import { INVEST_OR_PAY_OFF_URL } from '../../utils/invest-or-pay-off/release.ts';
import { SHARED_STATE_GLOBAL, STATE_KEY_PATTERN } from '../../utils/invest-or-pay-off/url.ts';
import { TOOL_AMOUNT_LOCALE, TOOL_DEFAULT_CURRENCY } from '../../utils/shared/toolState.ts';
import { CURRENCIES } from '../../utils/loan/math.ts';
import { PROSE_NUMBER_LOCALE } from '../../i18n/config.ts';
import { DATE_LOCALE, LOCALE_META, LOCALES, dict, localizedPath, lessonPath, format, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

/** The country whose inflation the page starts with, by the page's language only. */
const DEFAULT_COUNTRY: Record<Locale, string> = { en: 'EMU', hi: 'IND', es: 'EMU', cs: 'CZE', mr: 'IND' };

const { locale } = Astro.props;
const { investOrPayOff: tool, export: exportStrings } = dict(locale).tools;
const strings = tool.page;
const island = tool.island;
const t = format;
const htmlLang = LOCALE_META[locale].htmlLang;
const file = data as WorldBankFile;

const toolCurrencies = new Set(CURRENCIES.map((c) => c.code));
const regionNames = new Intl.DisplayNames([htmlLang], { type: 'region' });
const countries: CountryOption[] = Object.entries(file.countries)
  .map(([code, entry]) => {
    const named = code === 'EMU' ? island.country.euroArea : regionNames.of(entry.iso2);
    const currency = COUNTRY_CURRENCY[code];
    return {
      code,
      name: named && named !== entry.iso2 ? named : code,
      currency: currency && toolCurrencies.has(currency) ? currency : null,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, htmlLang));

const defaultCountry = DEFAULT_COUNTRY[locale];
const defaultSeries = toCompactSeries(file.countries[defaultCountry]?.years ?? {});
const initialHistory = defaultSeries ? { code: defaultCountry, series: defaultSeries } : null;
// The newest year any country has a figure for: a country whose figures
// stopped well before it gets no default.
const latestYear = Math.max(...Object.values(file.countries).flatMap((c) => Object.keys(c.years).map(Number)));

const proseNumber = (n: number) => n.toLocaleString(PROSE_NUMBER_LOCALE[locale]);
const updated = new Intl.DateTimeFormat(DATE_LOCALE[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(
  new Date(`${file.lastUpdated}T00:00:00Z`),
);

const figures = {
  countries: proseNumber(Object.keys(file.countries).filter((c) => c !== 'EMU').length),
  updated,
  paths: proseNumber(PATHS),
  low: proseNumber(REAL_RETURN_BOTTOM),
  top: proseNumber(REAL_RETURN_TOP),
};

const siteUrl = 'https://nidhi.today';
const canonicalUrl = new URL(localizedPath(locale, INVEST_OR_PAY_OFF_URL), siteUrl).href;
const faqs = strings.faq.items.map((f) => ({ q: t(f.q, figures), a: t(f.a, figures) }));

// The lesson the tool belongs to. Its title is English in every edition.
const LESSON = { slug: 'invest-or-pay-off-debt', title: 'Invest or Pay Off Debt First? How to Decide' };

const RELATED_CANDIDATES: { slug: keyof typeof strings.related.cards; dataAttr: string }[] = [
  { slug: 'invest-or-pay-off-debt', dataAttr: 'related-invest-or-pay-off-debt' },
  { slug: 'how-to-get-out-of-debt', dataAttr: 'related-how-to-get-out-of-debt' },
  { slug: 'purchasing-power', dataAttr: 'related-purchasing-power' },
];

const isDev = import.meta.env.DEV;
const now = new Date();
const publishedSlugs = new Set(
  (await getCollection('blog')).filter((p) => isDev || p.data.pubDate <= now).map((p) => p.data.slug),
);
const lessonPublished = publishedSlugs.has(LESSON.slug);
const related = RELATED_CANDIDATES.filter((c) => publishedSlugs.has(c.slug)).map((c) => ({
  ...c,
  ...strings.related.cards[c.slug],
  url: lessonPath(c.slug),
}));

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  inLanguage: htmlLang,
  name: tool.schema.name,
  alternateName: tool.schema.alternateNames,
  url: canonicalUrl,
  description: tool.meta.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: tool.schema.operatingSystem,
  browserRequirements: tool.schema.browserRequirements,
  isAccessibleForFree: true,
  featureList: tool.schema.featureList.map((f) => t(f, figures)),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'nidhi', url: 'https://nidhi.today/' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumb.home, item: new URL(localizedPath(locale, '/'), siteUrl).href },
    { '@type': 'ListItem', position: 2, name: strings.breadcrumb.freeTools, item: new URL(localizedPath(locale, '/free/'), siteUrl).href },
    { '@type': 'ListItem', position: 3, name: strings.breadcrumb.this, item: canonicalUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: htmlLang,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={tool.meta.title}
  description={tool.meta.description}
  jsonLd={[webAppSchema, breadcrumbSchema, faqSchema]}
  toolStateGlobal={SHARED_STATE_GLOBAL}
>
  <ToolStateGuard slot="head" globalName={SHARED_STATE_GLOBAL} keyPattern={STATE_KEY_PATTERN} />
  {/* Heatmaps record where a click lands, which on this form would say what
      was picked. They are paused here, in the head, so that analytics (at
      the end of the body) never starts them on this page: the tool's own
      effect runs only once the page is interactive, which can be later. */}
  <script is:inline slot="head">window.nidhiHeatmapsPaused = true;</script>
  <ToolPageShell
    locale={locale}
    breadcrumb={strings.breadcrumb}
    eyebrow={strings.eyebrow}
    title={strings.title}
    lead={strings.lead}
    faq={{ heading: strings.faq.heading, items: faqs }}
    related={{ heading: strings.related.heading, cards: related }}
  >

    <InvestOrPayOff
      client:load
      strings={island}
      exportStrings={exportStrings}
      defaultCurrency={TOOL_DEFAULT_CURRENCY[locale]}
      defaultCountry={defaultCountry}
      countries={countries}
      initialHistory={initialHistory}
      historyUrl={HISTORY_URL}
      latestYear={latestYear}
      numberLocale={PROSE_NUMBER_LOCALE[locale]}
      amountLocale={TOOL_AMOUNT_LOCALE[locale]}
    />

    <aside class="toolp-panel toolp-notes" aria-labelledby="toolp-leaves-h">
      <h2 id="toolp-leaves-h" class="toolp-sectionTitle">{strings.leavesOut.heading}</h2>
      <p class="iopp-intro">{strings.leavesOut.intro}</p>
      <ul>
        {Object.values(strings.leavesOut.items).map((item) => (
          <li><strong>{item.lead}</strong>{item.rest}</li>
        ))}
      </ul>
      <p class="iopp-intro">{strings.leavesOut.notAdvice}</p>
      {lessonPublished && (
        <p class="toolp-lesson">
          {strings.lesson.before}<a href={lessonPath(LESSON.slug)} hreflang="en" lang="en" data-attr="free-invest-or-pay-off-lesson-link">{LESSON.title}</a>{strings.lesson.after}
        </p>
      )}
    </aside>

    <ToolWaitlist locale={locale} line={strings.plannerLine} />

    <section class="toolp-panel" aria-labelledby="toolp-method-h">
      <h2 id="toolp-method-h" class="toolp-sectionTitle">{strings.method.heading}</h2>
      <ul>
        {Object.values(strings.method.items).map((item) => (
          <li><strong>{item.lead}</strong>{t(item.rest, figures)}</li>
        ))}
      </ul>
      <p class="iopp-intro">{strings.method.limits}</p>
    </section>

    <section class="toolp-panel" aria-labelledby="toolp-source-h">
      <h2 id="toolp-source-h" class="toolp-sectionTitle">{strings.source.heading}</h2>
      <p class="toolp-source">
        {strings.source.inflationBefore}<a href="https://data.worldbank.org/indicator/FP.CPI.TOTL.ZG" target="_blank" rel="noopener noreferrer">{strings.source.inflationLink}</a>{t(strings.source.inflationAfter, figures)}
      </p>
      <p class="toolp-source">{strings.source.returns}</p>
    </section>
  </ToolPageShell>
</BaseLayout>

<style>
  /* The page's frame and panels are styled by ToolPageShell.astro; these are
     this page's own. */
  .iopp-intro {
    margin: 0 0 var(--space-3);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .toolp-panel ul {
    margin: 0 0 var(--space-3);
  }
  .toolp-source {
    margin: 0 0 var(--space-2);
  }
</style>
