---
/**
 * The page for a confirm or unsubscribe link that is used up, expired or
 * mangled, in whichever language it was asked for.
 *
 * English is served from `src/pages/subscription-invalid.astro`, which is
 * where the Apps Script endpoint redirects with `?reason=confirm` or
 * `?reason=unsubscribe`; the other languages come through
 * `src/pages/[locale]/subscription-invalid.astro`. The inline script swaps the
 * body for the reason's line, which it gets with `define:vars` because it
 * cannot import the catalog.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, dict, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale).transactional.invalid;

const msg = {
  reasonConfirm: t.reasonConfirm,
  reasonUnsubscribe: t.reasonUnsubscribe,
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={t.meta.title}
  description={t.meta.description}
  robots="noindex,nofollow"
>
  <section class="transactional">
    <div class="transactional-card">
      <div class="transactional-icon transactional-icon--warning" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="13"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>

      <h1 class="transactional-title">{t.heading}</h1>
      <p class="transactional-body" id="invalid-copy">
        {t.body}
      </p>

      <div class="transactional-actions">
        <a class="transactional-cta" href={localizedPath(locale, '/blog/')}>{t.cta}</a>
        <a class="transactional-cta transactional-cta--subtle" href={`mailto:hello@nidhi.today?subject=${encodeURIComponent(t.emailSubject)}`}>
          {t.emailUs}
        </a>
      </div>

      <p class="transactional-secondary">
        {t.secondaryBefore}<strong>{t.secondaryStrong}</strong>{t.secondaryAfter}
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ msg }}>
  (function () {
    var copy = document.getElementById('invalid-copy');
    if (!copy) return;
    var reason = new URLSearchParams(window.location.search).get('reason') || '';
    if (reason === 'confirm') {
      copy.textContent = msg.reasonConfirm;
    } else if (reason === 'unsubscribe') {
      copy.textContent = msg.reasonUnsubscribe;
    }
  })();
</script>
