---
/**
 * The loan comparison calculator, in whichever language it was asked for.
 *
 * English is served from `src/pages/free/loan-comparison.astro`, which is a
 * short wrapper around this; the other languages come through
 * `src/pages/[locale]/free/`. Both paths render this one component, so the two
 * versions cannot drift apart in markup or in styling.
 *
 * What stays here rather than in the catalog: the `data-attr` labels (analytics
 * reads them, and the privacy notice's changelog refers to those labels by
 * name), the lesson slugs, which have to match real entries in
 * `src/content/blog`, the seven FAQ group ids, which are the anchors the
 * page's own answers link to, the schema.org enumerations and the price, and
 * the tool's `SHARED_STATE_GLOBAL`, which the island, the head guard and the
 * layout all have to agree on.
 *
 * The related-reading cards come in two halves that are zipped together below:
 * the slug and the analytics label are not sentences and stay here, while the
 * kicker, the title and the description are this page's own words about those
 * lessons and live in the catalog. Both lists are the same length and the same
 * order, and one is indexed by the other.
 *
 * The island is handed its own words as a prop rather than the locale, so that
 * the hydration payload carries one language's strings and not the whole
 * catalog. See the `strings` prop in `LoanCompare.tsx`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoanCompare from '../../components/LoanCompare.tsx';
import ToolStateGuard from '../../components/ToolStateGuard.astro';
import { TOOL_AMOUNT_LOCALE, TOOL_DEFAULT_CURRENCY } from '../../utils/shared/toolState.ts';
import { PROSE_NUMBER_LOCALE } from '../../i18n/config.ts';
import ToolPageShell from '../../components/ToolPageShell.astro';
import ToolWaitlist from '../../components/ToolWaitlist.astro';
import { SHARED_STATE_GLOBAL, STATE_KEY_PATTERN } from '../../utils/loan/url.ts';
import { getCollection } from 'astro:content';
import { LOCALE_META, LOCALES, dict, lessonPath, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tool = dict(locale).tools.loanComparison;
const exportStrings = dict(locale).tools.export;

const siteUrl = 'https://nidhi.today';

// Ordered for the calculator, strongest first: how to read an offer, what to
// have in place before borrowing, then what happens after you sign.
// Unpublished posts (future pubDate) are filtered out at build time but kept
// here so they auto-promote into the visible top three the moment they go
// live (publishedSlugs is rebuilt every build). Slugs MUST match real entries
// in the locale's lesson collection or they silently filter out, that was the
// bug that left a related section blank on another page.
//
// The list is longer than the three slots we render, so a missing candidate
// just lets the next one through. If none is live, the list is empty and the
// whole section is dropped rather than linking three times into nothing.
const RELATED_CANDIDATES = [
  { slug: 'understanding-loan-terms', dataAttr: 'related-loan-terms' },
  { slug: 'emergency-fund', dataAttr: 'related-emergency' },
  { slug: 'appreciation-vs-depreciation', dataAttr: 'related-appreciation' },
  { slug: 'how-to-get-out-of-debt', dataAttr: 'related-debt' },
  { slug: 'liabilities', dataAttr: 'related-liabilities' },
];

const isDev = import.meta.env.DEV;
const now = new Date();
const publishedSlugs = new Set(
  (await getCollection('blog'))
    .filter((post) => isDev || post.data.pubDate <= now)
    .map((post) => post.data.slug),
);
const RELATED = RELATED_CANDIDATES.map((candidate, index) => ({
  ...candidate,
  ...tool.page.related.items[index],
}))
  .filter((candidate) => publishedSlugs.has(candidate.slug))
  .slice(0, 3);

// The FAQ is split into seven groups so a reader can scan to the topic they
// care about (basics, costs, prepayments, and so on) instead of reading one
// flat list of twenty-four answers. Search engines expect a single array, so
// the JSON-LD below flattens the groups back out. The ids are the anchors, and
// they are in the same order as the catalog's groups.
const FAQ_GROUP_IDS = [
  'basics',
  'apr-fees',
  'prepayments-penalties',
  'hybrid',
  'analysis-tabs',
  'sharing-accuracy',
  'currency',
];
const faqSections = tool.page.faq.groups.map((group, index) => ({
  id: FAQ_GROUP_IDS[index],
  ...group,
}));
const faqs = faqSections.flatMap((section) => section.items);

const canonicalUrl = new URL(localizedPath(locale, '/free/loan-comparison/'), siteUrl).href;
const homeUrl = new URL(localizedPath(locale, '/'), siteUrl).href;

// Title and description prioritise the search phrasings real users have typed.
// Primary terms are "loan", "comparison", and "side by side"; "multi-currency"
// is the secondary modifier. Both "comparator" and "comparison" are present
// because they are not interchangeable in search intent: "comparator" trends
// international/UK/IN, "comparison" trends US. Both live in the catalog now.
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  inLanguage: LOCALE_META[locale].htmlLang,
  // One canonical brand name; alternateName collects the other phrasings
  // users actually search for, so brand-search variants ("nidhi loan
  // comparator", "nidhi multi-currency loan calculator") still resolve to the
  // same entity in engines that respect schema.org's alternateName.
  name: tool.schema.name,
  alternateName: tool.schema.alternateNames,
  url: canonicalUrl,
  description: tool.meta.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: tool.schema.operatingSystem,
  browserRequirements: tool.schema.browserRequirements,
  isAccessibleForFree: true,
  // featureList helps Google understand what the app does at a glance, which
  // feeds the rich-result and answer-box surfaces.
  featureList: tool.schema.featureList,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'nidhi',
    url: homeUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tool.page.breadcrumb.home, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: tool.page.breadcrumb.freeTools, item: new URL(localizedPath(locale, '/free/'), siteUrl).href },
    { '@type': 'ListItem', position: 3, name: tool.page.breadcrumb.this, item: canonicalUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LOCALE_META[locale].htmlLang,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  toolStateGlobal={SHARED_STATE_GLOBAL}
  title={tool.meta.title}
  description={tool.meta.description}
  jsonLd={[webAppSchema, breadcrumbSchema, faqSchema]}
>
  <ToolStateGuard slot="head" globalName={SHARED_STATE_GLOBAL} keyPattern={STATE_KEY_PATTERN} />
  {/* The breadcrumb's last item is "Loan comparison calculator" (the primary
      intent phrase), so the visible text agrees with the H1 and the
      structured-data breadcrumb above. Phones hide the title's and the
      lead's secondary phrases; the privacy sentence always shows. */}
  <ToolPageShell
    locale={locale}
    breadcrumb={tool.page.breadcrumb}
    eyebrow={tool.page.eyebrow}
    title={tool.page.title}
    lead={{ before: `${tool.page.lead.before} `, wide: `${tool.page.lead.wide} `, after: tool.page.lead.after }}
    faq={{ heading: tool.page.faq.heading, sections: faqSections }}
    related={{
      heading: tool.page.related.heading,
      cards: RELATED.map((post) => ({ ...post, url: lessonPath(post.slug) })),
    }}
  >

    <LoanCompare client:load strings={tool.island} exportStrings={exportStrings} defaultCurrency={TOOL_DEFAULT_CURRENCY[locale]}
      numberLocale={PROSE_NUMBER_LOCALE[locale]}
      amountLocale={TOOL_AMOUNT_LOCALE[locale]}
    />

    <ToolWaitlist locale={locale} line={tool.page.plannerLine} />

    <p slot="related-footer" class="toolp-relatedFooter">
      <a href={localizedPath(locale, '/blog/tag/debt/')} class="toolp-relatedAll" data-attr="related-tag-debt">
        {tool.page.related.footerTag}
        <span aria-hidden="true">&nbsp;&rsaquo;</span>
      </a>
      <a href={localizedPath(locale, '/blog/')} class="toolp-relatedAllSecondary" data-attr="related-all">
        {tool.page.related.footerAll}
      </a>
    </p>
  </ToolPageShell>
</BaseLayout>
