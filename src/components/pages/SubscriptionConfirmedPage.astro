---
/**
 * The page the confirm page redirects to once the subscription is confirmed,
 * in whichever language it was asked for.
 *
 * English is served from `src/pages/subscription-confirmed.astro`, which is
 * also where the Apps Script endpoint redirects; the other languages come
 * through `src/pages/[locale]/subscription-confirmed.astro`, which the confirm
 * page in that language redirects to.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, dict, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale).transactional.confirmed;
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={t.meta.title}
  description={t.meta.description}
  robots="noindex,nofollow"
>
  <section class="transactional">
    <div class="transactional-card">
      <div class="transactional-icon transactional-icon--success" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>

      <h1 class="transactional-title">{t.heading}</h1>
      <p class="transactional-body">
        {t.bodyBefore}<strong>hello@nidhi.today</strong>{t.bodyAfter}
      </p>

      <a class="transactional-cta" href={localizedPath(locale, '/blog/')}>{t.cta}</a>

      <p class="transactional-secondary">
        <a href={localizedPath(locale, '/')}>{t.homeLink}</a>{t.homeAfter}
      </p>
    </div>
  </section>
</BaseLayout>
