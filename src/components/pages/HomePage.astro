---
/**
 * The home page, in whichever language it was asked for.
 *
 * English is served from `src/pages/index.astro`, a two line wrapper around
 * this; the other languages come through `src/pages/[locale]/index.astro`.
 * Both paths render this one component, so the two versions cannot drift apart
 * in markup or in styling.
 *
 * The page tells one story, in order: understand your money, starting wherever
 * you are; learn it, then try it on your own numbers; and keep going as life
 * gets more involved, including across currencies. The planner, which is not
 * open yet, comes after everything that is.
 *
 * Every word is in the `home` catalog namespace. Every lesson and tool link is
 * chosen in src/utils/home/startingPoints.ts, which deals in structure only:
 * ids, levels and slugs. A lesson appears once its post is published (or, for
 * the Monte Carlo simulator, once the tool launches); dev shows scheduled posts
 * too. The two example numbers a reader can read off the charts all come from
 * src/utils/home/heroExamples.ts, so the prose and the drawings agree.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WaitlistSection from '../WaitlistSection.astro';
import HeroChart from '../HeroChart.astro';
import LessonsInEnglish from '../LessonsInEnglish.astro';
import { LOCALES, dict, format, localizedPath, type Locale } from '../../i18n';
import { EXAMPLE_RETURN, STARTER, starterExample, yearlyPath } from '../../utils/home/heroExamples.ts';
import {
  assertHomepageSlugs,
  LADDER_LEVELS,
  lessonToolPairs,
  levelCounts,
  readingOrder,
  resolveStartingPoints,
} from '../../utils/home/startingPoints.ts';
import { assertInclusiveGroups, INCLUSIVE_HUB, liveInclusive } from '../../utils/inclusiveGuides.ts';
import { formatProseAmount } from '../../utils/shared/formatAmount.ts';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../../utils/monte-carlo/release.ts';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, fullStop } = dict(locale);

/** This page's own address for a root-relative path. */
const href = (path: string) => localizedPath(locale, path);
/** Fills `{name}` in a catalog sentence. */
const t = format;

const isDev = import.meta.env.DEV;
const now = isDev ? new Date('2999-01-01') : new Date();
const allPosts = await getCollection('blog');
assertHomepageSlugs(allPosts);

const showMonteCarlo = await isMonteCarloReleased();
const isToolLive = (href: string) => href !== MONTE_CARLO_URL || showMonteCarlo;
const startingPoints = resolveStartingPoints(allPosts, now, isToolLive);
const pairs = lessonToolPairs(allPosts, now, isToolLive);
const counts = levelCounts(allPosts, now);
const order = readingOrder(allPosts, now);
const firstLesson = order[0];

// The names of things the catalog keys by id, read through a lookup rather than
// indexed directly, so a card whose id the catalog does not carry renders an
// empty label instead of failing the build.
const pointCopy = (id: string) =>
  (home.startingPoints as Record<string, { audience: string; situation: string; detail: string }>)[id] ?? { audience: '', situation: '', detail: '' };
const levelLabel = (level: string | null) => (level ? (home.levels as Record<string, string>)[level] ?? null : null);

// Inclusive Finances joins the starting points once a guide in it is live.
assertInclusiveGroups(allPosts);
const inclusive = liveInclusive(allPosts, now);

// The worked example, computed (see src/utils/home/heroExamples.ts): the
// table sits in Step 2 and the ten-year chart in Step 3.
const eur = (v: number) => formatProseAmount(v, 'EUR');
const ex = starterExample();
const pctReturn = `${Math.round(EXAMPLE_RETURN * 100)}%`;
const roundedEnd = Math.round(ex.end / 100) * 100;
// Drawn twice: a narrower drawing for phones keeps its labels readable
// (CSS shows one of the two). The description and the footnote are printed
// once, outside both drawings, so the page text (and anything reading it,
// crawlers included) carries each only once.
const roundedGrowth = Math.round(ex.growth / 100) * 100;
// Step 3: the same start with one decision changed, the monthly amount.
// The gap is split into money put in and growth, so it is not read as
// growth alone.
const HIGHER_MONTHLY = 300;
const alt = yearlyPath(ex.invested, HIGHER_MONTHLY, STARTER.years);
const roundedAlt = Math.round(alt[STARTER.years] / 100) * 100;
const gap = roundedAlt - roundedEnd;
const extraIn = (HIGHER_MONTHLY - STARTER.monthly) * 12 * STARTER.years;
const starterDesc = t(home.example.description, {
  invested: eur(ex.invested),
  pct: pctReturn,
  monthly: eur(STARTER.monthly),
  end: eur(roundedEnd),
  years: STARTER.years,
  higher: eur(HIGHER_MONTHLY),
  alternative: eur(roundedAlt),
  gap: eur(gap),
  extra: eur(extraIn),
  growth: eur(gap - extraIn),
});
const starterChart = {
  title: home.example.chartTitle,
  descId: 'hero-starter-desc',
  pointLabels: ex.values.map((_, i) => (i === 0 ? home.example.today : t(home.example.year, { n: i }))),
  // Solid blue for the changed path, dashed grey for the baseline: they
  // differ in lightness and pattern, not only hue, so they stay apart on a
  // dim dark screen.
  series: [
    { name: t(home.example.perMonth, { amount: eur(HIGHER_MONTHLY) }), values: alt, color: 'var(--chart-eur)', area: true },
    { name: t(home.example.perMonth, { amount: eur(STARTER.monthly) }), values: ex.values, color: 'var(--color-text-muted)', dashFrom: 0 },
  ],
  axisStart: home.example.axisStart,
  axisEnd: t(home.example.axisEnd, { years: STARTER.years }),
};
// Step 2: two illustrative people on the same income, to show that income
// and net worth are different things.
const SAME_INCOME = 3_000;
const people = [
  { ...home.compare.people.alex, owns: 22_000, owes: 31_000 },
  { ...home.compare.people.sam, owns: 16_500, owes: 4_000 },
];
const peopleMax = Math.max(...people.flatMap((p) => [p.owns, p.owes]));
const signedEur = (v: number) => (v < 0 ? `−${eur(-v)}` : eur(v));

// The hero card previews the three steps below with their own numbers; its
// small chart is Step 3's two paths, on one scale.
const spark = (() => {
  const w = 120, h = 36, max = Math.max(...alt);
  const line = (vals: number[]) => vals.map((v, i) => `${((i / (vals.length - 1)) * w).toFixed(1)},${(h - (v / max) * (h - 4) - 2).toFixed(1)}`).join(' ');
  return { low: line(ex.values), high: line(alt) };
})();

const starterFootnote = t(home.example.footnote, {
  invested: eur(ex.invested),
  monthly: eur(STARTER.monthly),
  higher: eur(HIGHER_MONTHLY),
  pct: pctReturn,
});

// Shown on the page and, word for word, in the FAQPage data below.
const faqs = home.faq.items.map((f) => ({ q: f.q, a: t(f.a, { total: counts.total }) }));

const description = home.meta.description;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  slogan: home.schema.slogan,
  description: home.schema.organization,
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  foundingLocation: { '@type': 'Place', name: 'Prague' },
  knowsAbout: home.schema.knowsAbout,
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: home.schema.site,
  // The blog index honours `?q=` as a deep link: it reads the value into its
  // search box and then removes it from the address (see
  // `src/components/LearnHome.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(href('/blog/'), Astro.site) + '?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---


<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={home.meta.title}
  description={description}
  imageAlt={home.meta.imageAlt}
  jsonLd={[organizationSchema, webSiteSchema, faqSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  {/* =============================================================
       1. Hero: the promise and two ways in
       ============================================================= */}
  <section class="lp-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-heading">{home.hero.heading}</h1>
          <p class="lp-subhead hero-trio"><span>{home.hero.subhead[0]}</span> <span>{home.hero.subhead[1]}</span> <span>{home.hero.subhead[2]}</span></p>

          <div class="hero-actions">
            <a href={href('/blog/')} class="lp-btn lp-btn--primary" data-attr="home-hero-start-learning">{home.hero.startLearning}</a>
            <a href={href('/free/')} class="lp-btn lp-btn--secondary" data-attr="home-hero-tools">{home.hero.tryTool}</a>
          </div>

          {firstLesson && (
            <div class="hero-next" data-continue={JSON.stringify(order)} hidden>
              {/* Only for a returning reader: the hero's two buttons are the
                  first-visit choices, and the routes below say where to begin. */}
              <p data-next-continue>
                {home.hero.welcomeBack} <a href="#" data-attr="home-hero-continue" lang="en" hreflang="en"></a>
              </p>
            </div>
          )}
        </div>

        {/* The three steps below, at a glance, with the same illustrative numbers. */}
        <div class="journey">
          <p class="journey-label">{home.journey.label}</p>
          <ol class="journey-list">
            <li>
              <span class="journey-step">{home.journey.learnStep}</span>
              <span class="journey-big">{home.journey.learnBig}</span>
              <span class="journey-small">{home.journey.learnSmall}</span>
            </li>
            <li>
              <span class="journey-step">{home.journey.stockStep}</span>
              <span class="journey-big">{t(home.journey.stockBig, { one: signedEur(people[0].owns - people[0].owes), two: signedEur(people[1].owns - people[1].owes) })}</span>
              <span class="journey-small">{t(home.journey.stockSmall, { amount: eur(SAME_INCOME) })}</span>
            </li>
            <li>
              <span class="journey-step">{home.journey.planStep}</span>
              <span class="journey-big">{t(home.journey.planBig, { gap: eur(gap) })}</span>
              <span class="journey-small">{t(home.journey.planSmall, { low: eur(STARTER.monthly), high: eur(HIGHER_MONTHLY), years: STARTER.years })}</span>
              <svg class="journey-spark" viewBox="0 0 120 36" aria-hidden="true"><polyline class="journey-spark-high" points={spark.high} /><polyline points={spark.low} /></svg>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       2. Step 1, learn: free lessons, one line per route
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="start" aria-labelledby="start-heading">
    <div class="lp-section-inner">
      <div class="section-head">
        <p class="step-mark"><span class="step-num" aria-hidden="true">1</span><span class="chart-srOnly">{t(home.steps.mark, { n: 1 })}</span>{home.steps.learn}</p>
        <h2 id="start-heading">{home.lessons.heading}</h2>
        <p class="cap-body">{home.lessons.body}</p>
      </div>

      <p class="route-help">
        {home.lessons.helperQuestion} <a href={href('/blog/#level-helper')} data-attr="home-level-helper">{home.lessons.helperLink}</a>{fullStop}
      </p>

      {/* Every line below opens an English lesson: the routes are named in
          Hindi, the lessons they open are not. */}
      <LessonsInEnglish locale={locale} />

      {/* One line per route. Each opens the first lesson this browser has not read yet. */}
      <ul class="routes" role="list">
        {startingPoints.map((s) => s.lessons.length === 0 ? (
          <li style={`--start-level: var(--level-${s.level ?? 'mixed'}, var(--color-text-secondary))`}>
            {/* A level whose lessons are still scheduled: shown, not linked, until the first one goes live. */}
            <div class="route route--soon">
              <span class="route-badge" aria-hidden="true">{s.level ? LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 : '+'}</span>
              <span class="route-title">{pointCopy(s.id).situation}</span>
              <span class="route-meta">{s.level ? t(home.lessons.comingSoon, { level: levelLabel(s.level) }) : home.lessons.comingSoonNoLevel}</span>
            </div>
          </li>
        ) : (
          <li style={`--start-level: var(--level-${s.level ?? 'mixed'}, var(--color-text-secondary))`}>
            <a
              class="route"
              href={s.lessons[0].href}
              data-start-route={JSON.stringify(s.lessons)}
              data-route-done={href(s.level ? `/blog/${s.level}/` : '/blog/')}
              data-door-continue={home.lessons.doorContinue}
              data-door-read={home.lessons.doorRead}
              data-door-path={home.lessons.doorPath}
              data-attr={`home-start-${s.id}-door`}
            >
              <span class="route-badge" aria-hidden="true">{s.level ? LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 : '+'}</span>
              <span class="route-title">{pointCopy(s.id).situation}</span>
              <span class="route-meta">{s.level ? t(home.lessons.levelCount, { level: levelLabel(s.level), count: s.levelCount }) : home.lessons.severalLevels}</span>
              <span class="route-go"><span data-door-verb>{home.lessons.start}</span><span data-door-title></span> <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))}
        {inclusive.count > 0 && (
          <li style="--start-level: var(--level-inclusive-finances)">
            <a class="route route--inclusive" href={href(INCLUSIVE_HUB)} data-attr="home-inclusive-finances">
              <span class="route-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></svg>
              </span>
              <span class="route-title">{home.lessons.inclusiveTitle}</span>
              <span class="route-meta">{inclusive.count === 1 ? home.lessons.inclusiveMetaOne : t(home.lessons.inclusiveMeta, { count: inclusive.count })}</span>
              <span class="route-go">{home.lessons.inclusiveGo} <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        )}
      </ul>

      <p class="section-foot">
        <a href={href('/blog/')} data-attr="home-cta-blog">{home.lessons.foot}</a>
      </p>
    </div>
  </section>

  {/* =============================================================
       3. Step 2, take stock: an example net worth and the free tools
       ============================================================= */}
  {pairs.length > 0 && (
    <section class="lp-section" id="apply" aria-labelledby="apply-heading">
      <div class="lp-section-inner">
        <div class="section-head">
          <p class="step-mark"><span class="step-num" aria-hidden="true">2</span><span class="chart-srOnly">{t(home.steps.mark, { n: 2 })}</span>{home.steps.stock}</p>
          <h2 id="apply-heading">{home.tools.heading}</h2>
          <p class="cap-body">{home.tools.body}</p>
        </div>

        <div class="tools-grid">
        <figure class="starter compare">
          <p class="starter-label">{t(home.compare.label, { amount: eur(SAME_INCOME) })}</p>
          <div class="compare-grid">
            {people.map((p) => (
              <div class="compare-person">
                <p class="compare-name">{p.name}</p>
                <p class="compare-note">{p.note}</p>
                <dl class="compare-rows">
                  <div><dt>{home.compare.owns}</dt><dd><span class="compare-track" aria-hidden="true"><span class="compare-bar compare-bar--own" style={`width: ${(p.owns / peopleMax) * 100}%`}></span></span>{eur(p.owns)}</dd></div>
                  <div><dt>{home.compare.owes}</dt><dd><span class="compare-track" aria-hidden="true"><span class="compare-bar compare-bar--owe" style={`width: ${(p.owes / peopleMax) * 100}%`}></span></span>{eur(p.owes)}</dd></div>
                </dl>
                <p class={`compare-net${p.owns < p.owes ? ' is-negative' : ''}`}>{signedEur(p.owns - p.owes)} <span>{home.compare.netWorth}</span></p>
              </div>
            ))}
          </div>
          <figcaption class="compare-caption">{home.compare.caption}</figcaption>
        </figure>

        <ul class="tool-list" role="list">
          {pairs.map((p) => {
            const key = p.tool.href.split('/').filter(Boolean).pop();
            return (
              <li>
                <a href={href(p.tool.href)} class="an-card" data-attr={`home-cta-${key}`}>
                  <span class="an-preview" aria-hidden="true">
                    {p.tool.preview === 'donut' && (
                      <svg viewBox="0 0 80 48"><g transform="translate(24,24)"><path d="M 0 -18 A 18 18 0 1 1 -12.3 13.1 L 0 0 Z" fill="var(--chart-eur)" /><path d="M -12.3 13.1 A 18 18 0 0 1 -10.6 -14.6 L 0 0 Z" fill="var(--chart-usd)" /><path d="M -10.6 -14.6 A 18 18 0 0 1 0 -18 L 0 0 Z" fill="var(--chart-inr)" /><circle r="9" fill="var(--color-bg-white)" /></g><rect x="50" y="14" width="22" height="5" rx="2" fill="var(--chart-eur)" /><rect x="50" y="23" width="16" height="5" rx="2" fill="var(--chart-usd)" /><rect x="50" y="32" width="9" height="5" rx="2" fill="var(--chart-inr)" /></svg>
                    )}
                    {p.tool.preview === 'bars' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 8 C 30 12, 50 26, 74 42" stroke="var(--chart-eur)" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M 6 8 C 26 16, 44 30, 64 42" stroke="var(--chart-usd)" stroke-width="3" fill="none" stroke-dasharray="5 4" stroke-linecap="round" /></svg>
                    )}
                    {p.tool.preview === 'fan' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 40 L 74 6 L 74 36 Z" fill="var(--chart-eur)" opacity="0.22" /><path d="M 6 40 L 74 14 L 74 28 Z" fill="var(--chart-eur)" opacity="0.4" /><path d="M 6 40 L 74 21" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" /></svg>
                    )}
                  </span>
                  <span class="an-title">{home.toolCards[p.tool.key].name}</span>
                  <span class="an-desc">{home.toolCards[p.tool.key].desc}</span>
                </a>
              </li>
            );
          })}
        </ul>
        </div>

      </div>
    </section>
  )}

  {/* =============================================================
       4. Step 3, plan ahead: what the planner is, one decision compared
          over ten years, and the waitlist
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="signup" aria-labelledby="planner-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="planner-grid">
        <div class="planner-copy">
          <p class="step-mark"><span class="step-num" aria-hidden="true">3</span><span class="chart-srOnly">{t(home.steps.mark, { n: 3 })}</span>{home.steps.plan}</p>
          <h2 id="planner-heading">{home.planner.heading}</h2>
          <p class="cap-body">{home.planner.body}</p>
          <div class="starter starter--chart">
            <p class="starter-label">{home.example.label}</p>
            <p class="starter-text">{t(home.example.text, { start: eur(ex.invested), low: eur(STARTER.monthly), high: eur(HIGHER_MONTHLY) })}</p>
            <p class="gap"><strong>{t(home.example.gapLead, { gap: eur(gap) })}</strong> {t(home.example.gapRest, { years: STARTER.years, extra: eur(extraIn), growth: eur(gap - extraIn) })}</p>
            <p class="starter-currency">{home.example.currencyNote}</p>
            <p id="hero-starter-desc" class="chart-srOnly">{starterDesc}</p>
            <HeroChart id="hero-starter" class="starter-chart--wide" {...starterChart} />
            <HeroChart id="hero-starter-sm" class="starter-chart--narrow" width={300} height={160} {...starterChart} />
            <details class="fold" data-phone-fold>
              <summary class="fold-label">{home.example.fold}</summary>
              <p class="hc-foot">{starterFootnote}</p>
            </details>
          </div>
        </div>
        <div class="planner-signup">
          <WaitlistSection locale={locale} />
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       5. FAQ (also in FAQPage data above), and who is behind nidhi in
          one line
       ============================================================= */}
  <section class="lp-section" id="faq" aria-labelledby="faq-heading" tabindex="-1">
    <div class="lp-section-inner lp-section-inner--narrow">
      <h2 id="faq-heading" class="faq-heading">{home.faq.heading}</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" data-attr={`home-faq-${i + 1}`}>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <p class="trust-why">
        {home.faq.why}
      </p>
      <p class="trust-line">
        {home.faq.trustLine}
        <span class="trust-links">
          <a href={href('/beliefs/')} data-attr="home-cta-beliefs">{home.faq.trustBeliefs}</a>
          <a href={href('/editorial-policy/')} data-attr="home-editorial-policy">{home.faq.trustEditorial}</a>
          <a href={href('/privacy/')} data-attr="home-privacy">{home.faq.trustPrivacy}</a>
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Reading progress on the homepage, which reads the same in any language
  // because it works in slugs. Both parts read the existing
  // nidhi-reading-progress key, which never leaves the browser, and only
  // change where links point.
  import { nextLesson, routeNext, type LessonLink } from '../../utils/home/startingPoints.ts';

  // Phone folds: supporting detail is collapsed on phones and always shown
  // on wider screens. CSS already shows the content there (::details-content),
  // so this only keeps the open state, and what assistive tech hears, in step
  // with the layout. Nothing is stored: every visit starts the same way.
  const wide = window.matchMedia('(min-width: 641px)');
  const folds = document.querySelectorAll<HTMLDetailsElement>('details[data-phone-fold]');
  function syncFolds() {
    folds.forEach((fold) => {
      fold.open = wide.matches;
      // Not inert: a summary can hold the card's heading, which must stay
      // readable. It just stops being a tab stop while it cannot fold.
      const summary = fold.querySelector('summary');
      if (wide.matches) summary?.setAttribute('tabindex', '-1');
      else summary?.removeAttribute('tabindex');
    });
  }
  syncFolds();
  // Optional call: older Safari has no MediaQueryList.addEventListener, and
  // throwing here would also stop the reading-progress code below.
  wide.addEventListener?.('change', syncFolds);
  // A screen reader can still activate a summary on wide screens; keep the
  // fold open there so what it hears matches what is shown.
  folds.forEach((fold) => {
    fold.addEventListener('toggle', () => {
      if (wide.matches && !fold.open) fold.open = true;
    });
  });

  function readSlugs(): string[] {
    try {
      const read = JSON.parse(localStorage.getItem('nidhi-reading-progress') || '[]');
      return Array.isArray(read) ? read.map(String) : [];
    } catch {
      return [];
    }
  }

  // "Start wherever you are": each card's button leads to the first lesson
  // on its route this browser has not read yet, from the same local key.
  const read = readSlugs();
  document.querySelectorAll<HTMLAnchorElement>('[data-start-route]').forEach((door) => {
    try {
      const route = JSON.parse(door.dataset.startRoute || '[]') as LessonLink[];
      const { next, started } = routeNext(route, read);
      if (!started) return;
      const verb = door.querySelector<HTMLElement>('[data-door-verb]')!;
      const title = door.querySelector<HTMLElement>('[data-door-title]')!;
      if (next) {
        door.href = next.href;
        verb.textContent = door.dataset.doorContinue || '';
        title.textContent = next.title;
        // A lesson title is English on every edition; the path's name is not.
        title.lang = 'en';
      } else {
        door.href = door.dataset.routeDone || '/blog/';
        verb.textContent = door.dataset.doorRead || '';
        title.textContent = door.dataset.doorPath || '';
        title.removeAttribute('lang');
      }
    } catch {
      /* malformed route: keep the default button */
    }
  });

  // "Continue learning": if this browser has read lessons on the path, point
  // to the next unread one instead of the first lesson.
  const box = document.querySelector<HTMLElement>('[data-continue]');
  if (box) {
    try {
      const order = JSON.parse(box.dataset.continue || '[]') as LessonLink[];
      const next = nextLesson(order, read);
      if (next) {
        const link = box.querySelector<HTMLAnchorElement>('[data-next-continue] a')!;
        link.href = next.href;
        link.textContent = next.title;
        box.hidden = false;
      }
    } catch {
      /* storage unavailable: keep the default line */
    }
  }
</script>

<script is:inline define:vars={{ keysHint: home.example.keysHint }}>
  // Hover, tap or arrow keys on the example chart show its values at that
  // point. The values are pre-formatted at build time (HeroChart.astro), and
  // the hint the chart is labelled with comes from the catalog.
  (function () {
    document.querySelectorAll('[data-hero-chart]').forEach(function (box) {
      var data = JSON.parse(box.getAttribute('data-hero-chart'));
      var svg = box.querySelector('svg');
      var hover = box.querySelector('.hc-hover');
      var cross = hover.querySelector('.hc-crosshair');
      var dots = hover.querySelectorAll('.hc-hoverDot');
      var readout = box.querySelector('.hc-readout');
      var live = box.querySelector('.hc-live');
      var vb = svg.viewBox.baseVal;
      var title = svg.querySelector('title');
      var current = null;
      box.tabIndex = 0;
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', (title ? title.textContent + '. ' : '') + keysHint);
      function show(i) {
        current = i;
        var xv = data.xs[i] * vb.width;
        cross.setAttribute('x1', xv);
        cross.setAttribute('x2', xv);
        data.series.forEach(function (s, k) {
          dots[k].setAttribute('cx', xv);
          dots[k].setAttribute('cy', s.ys[i] * vb.height);
        });
        hover.classList.add('is-on');
        readout.innerHTML = '';
        var heading = document.createElement('strong');
        heading.textContent = data.labels[i];
        readout.appendChild(heading);
        data.series.forEach(function (s) {
          var row = document.createElement('span');
          var sw = document.createElement('i');
          sw.style.background = s.color;
          row.appendChild(sw);
          row.appendChild(document.createTextNode(s.name + ': ' + s.values[i]));
          readout.appendChild(row);
        });
        readout.classList.add('is-on');
        if (live) live.textContent = data.labels[i] + '. ' + data.series.map(function (s) { return s.name + ': ' + s.values[i]; }).join(', ') + '.';
        readout.classList.toggle('is-left', data.xs[i] > 0.5);
        readout.style.left = (data.xs[i] * 100) + '%';
      }
      function hide() {
        current = null;
        hover.classList.remove('is-on');
        readout.classList.remove('is-on');
      }
      function nearest(clientX) {
        var r = svg.getBoundingClientRect();
        var fx = (clientX - r.left) / r.width;
        var best = 0;
        data.xs.forEach(function (x, i) { if (Math.abs(x - fx) < Math.abs(data.xs[best] - fx)) best = i; });
        return best;
      }
      svg.addEventListener('pointermove', function (e) { show(nearest(e.clientX)); });
      svg.addEventListener('pointerdown', function (e) { show(nearest(e.clientX)); });
      box.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hide(); });
      box.addEventListener('blur', hide);
      box.addEventListener('keydown', function (e) {
        var last = data.xs.length - 1;
        if (e.key === 'ArrowRight') show(current === null ? 0 : Math.min(last, current + 1));
        else if (e.key === 'ArrowLeft') show(current === null ? last : Math.max(0, current - 1));
        else if (e.key === 'Escape') hide();
        else return;
        e.preventDefault();
      });
    });
  })();
</script>

<style>
  /* ----------------------------------------------------------------
