---
/**
 * The home page, in whichever language it was asked for.
 *
 * English is served from `src/pages/index.astro`, a two line wrapper around
 * this; the other languages come through `src/pages/[locale]/index.astro`.
 * Both paths render this one component, so the two versions cannot drift apart
 * in markup or in styling.
 *
 * The page shows, for one reader at a time, how the three parts of nidhi work
 * together: read a lesson, try it on your own numbers with a free tool, and
 * (soon) see the whole picture in the planner. The hero does that with two
 * situations; the sections below are the lessons, the tools and the planner,
 * then who is behind it and two common questions. The design and the
 * decisions behind it are in docs/plans/homepage-variant-c.md.
 *
 * Every word is in the `home` catalog namespace, apart from the founder's
 * note (src/i18n/strings/founderNote.ts, a placeholder until approved). Every
 * lesson and tool link is chosen in src/utils/home/startingPoints.ts, which
 * deals in structure only: ids, levels, slugs and addresses.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WaitlistSection from '../WaitlistSection.astro';
import LessonsInEnglish from '../LessonsInEnglish.astro';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, dict, format, localizedPath, type Locale } from '../../i18n';
import {
  assertHomepageSlugs,
  LADDER_LEVELS,
  levelCounts,
  liveTools,
  resolveSituations,
  resolveStartingPoints,
} from '../../utils/home/startingPoints.ts';
import { assertInclusiveGroups, INCLUSIVE_HUB, inclusiveHostLevels, inclusiveLine, liveInclusive } from '../../utils/inclusiveGuides.ts';
import { getPathPosts } from '../../utils/learnPosts';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../../utils/monte-carlo/release.ts';
import { isInvestOrPayOffReleased, INVEST_OR_PAY_OFF_URL } from '../../utils/invest-or-pay-off/release.ts';
import { FOUNDER_NOTE } from '../../i18n/strings/founderNote.ts';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, learn, footer, fullStop } = dict(locale);

/** This page's own address for a root-relative path. */
const href = (path: string) => localizedPath(locale, path);
/** Fills `{name}` in a catalog sentence. */
const t = format;
/** Outside English, marks a link that opens an English lesson. */
const lessonLang = locale === DEFAULT_LOCALE ? {} : { hreflang: 'en' };
/** Outside English, marks text that is still English only. */
const enOnly = locale === DEFAULT_LOCALE ? {} : { lang: 'en' };

// The volunteer card says "five languages" in words, in every catalog.
if (LOCALES.length !== 5) {
  throw new Error(`The site now has ${LOCALES.length} languages, but home.helpCard.body says five. Update it in every catalog, then this check.`);
}

const isDev = import.meta.env.DEV;
const now = isDev ? new Date('2999-01-01') : new Date();
const allPosts = await getCollection('blog');
assertHomepageSlugs(allPosts);

const showMonteCarlo = await isMonteCarloReleased();
const showInvestOrPayOff = await isInvestOrPayOffReleased();
const isToolLive = (href: string) =>
  (href !== MONTE_CARLO_URL || showMonteCarlo) && (href !== INVEST_OR_PAY_OFF_URL || showInvestOrPayOff);
const startingPoints = resolveStartingPoints(allPosts, now, isToolLive);
const situations = resolveSituations(allPosts, now, isToolLive);
const tools = liveTools(isToolLive);
const counts = levelCounts(allPosts, now);

/** A catalog question without its outer quotation marks, in any of the five languages' styles. */
const unquote = (q: string) => q.replace(/^[“„«"]\s*/, '').replace(/\s*[”“»"]$/, '');

// Each situation ends on one of the planner section's questions.
const planQuestion = { currencies: home.planner.questions.currencies, loans: home.planner.questions.loan };

// The names of things the catalog keys by id, read through a lookup rather than
// indexed directly, so a card whose id the catalog does not carry renders an
// empty label instead of failing the build.
const pointCopy = (id: string) =>
  (home.startingPoints as Record<string, { audience: string; situation: string; detail: string }>)[id] ?? { audience: '', situation: '', detail: '' };
const levelLabel = (level: string | null) => (level ? (home.levels as Record<string, string>)[level] ?? null : null);

// Inclusive Finances joins the routes once a guide in it is live.
assertInclusiveGroups(allPosts);
const inclusive = liveInclusive(allPosts, now);
// Its line on the routes, in the same words as on /blog/.
const inclusiveText = inclusiveLine(learn.collections, inclusiveHostLevels(await getPathPosts()).map((id) => learn.levels[id]), LOCALE_META[locale].htmlLang);

// The hero's counts. Lessons only: Inclusive Finances guides are a collection
// beside the ladder (docs/plans/blog-content-plan.md, "Lessons, levels and
// collections"), so they are not counted. A tool counts once it is live, the
// same filter the tools section uses.
const lessonTotal = counts.total;
const toolTotal = tools.length;

// The founder's note is a placeholder until the owner approves its words: the
// dev server shows it for review, a production build leaves it out.
const showNote = isDev || !FOUNDER_NOTE.placeholder;

// Shown on the page and, word for word, in the FAQPage data below.
const faqs = home.faq.items;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  slogan: home.schema.slogan,
  description: home.schema.organization,
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  foundingLocation: { '@type': 'Place', name: 'Prague' },
  knowsAbout: home.schema.knowsAbout,
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  // Each edition describes itself at its own address and in its own language,
  // so the two descriptions never belong to one URL.
  url: new URL(href('/'), Astro.site).href,
  inLanguage: LOCALE_META[locale].htmlLang,
  description: home.schema.site,
  // The blog index honours `?q=` as a deep link: it reads the value into its
  // search box and then removes it from the address (see
  // `src/components/LearnHome.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL(href('/blog/'), Astro.site) + '?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LOCALE_META[locale].htmlLang,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---


<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={home.meta.title}
  description={home.meta.description}
  imageAlt={home.meta.imageAlt}
  jsonLd={[organizationSchema, webSiteSchema, faqSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  {/* The call for volunteer translators, directly under the header. The whole
       bar is one link. Remove it, with its catalog strings, the volunteer card
       below and the privacy changelog's mention, when the call closes. */}
  <a class="vol-bar" href={href('/volunteers/')} data-attr="home-volunteers">
    <span>{home.volunteers.text}</span>
    <span class="vol-bar-pill">{home.volunteers.link}&nbsp;<span aria-hidden="true">&rarr;</span></span>
  </a>

  {/* =============================================================
       1. Hero: the promise, and two readers' situations
       ============================================================= */}
  <section class="lp-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner hero-grid">
      <div class="hero-copy">
        <h1 id="hero-heading">{home.hero.heading}</h1>
        <p class="hero-lead">{home.hero.lead}</p>
        <p class="hero-jump">
          <a class="jump" href="#signup" data-attr="home-hero-planner">{home.hero.plannerLink}&nbsp;<span aria-hidden="true">&darr;</span></a>
        </p>
        {/* Outside English, said here too and not only in the lessons section:
            the situations' first links open English lessons. */}
        {locale !== DEFAULT_LOCALE && <div class="hero-lang"><LessonsInEnglish locale={locale} /></div>}
      </div>

      {/* Each situation is one reader's chain: a lesson, a tool, the planner.
          Nothing here folds: a closed situation would hide the whole chain. */}
      <div class="sits">
        <h2 id="sits-heading" class="sits-heading">{home.situations.heading}</h2>
        <ul class="sits-list" role="list" aria-labelledby="sits-heading">
          {situations.map((s) => (
            <li class="sit">
              <h3 class="sit-who" id={`sit-${s.id}`}>{home.situations.items[s.id].who}</h3>
              <ol class="chain" role="list" aria-labelledby={`sit-${s.id}`}>
                <li>
                  <a class="chain-row chain-go" href={s.lesson.href} data-attr={`home-sit-${s.id}-lesson`} {...lessonLang}>
                    <span class="chain-k">{home.situations.read}</span>
                    <span class="chain-t">{home.situations.items[s.id].lesson}&nbsp;<span aria-hidden="true">&rarr;</span></span>
                  </a>
                </li>
                <li>
                  <a class="chain-row chain-go" href={href(s.tool.href)} data-attr={`home-sit-${s.id}-tool`}>
                    <span class="chain-k">{home.situations.try}</span>
                    <span class="chain-t">{home.toolCards[s.tool.key].name}&nbsp;<span aria-hidden="true">&rarr;</span></span>
                  </a>
                </li>
                <li>
                  <p class="chain-row chain-plan">
                    <span class="chain-k">{home.situations.plan}</span>
                    <span class="chain-q">
                      {planQuestion[s.id]}<span class="sr-only">,</span>{' '}
                      <span class="chain-soon">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.25" /><path d="M8 4.75V8l2.25 1.5" /></svg>
                        {home.situations.soon}
                      </span>
                    </span>
                  </p>
                </li>
              </ol>
            </li>
          ))}
        </ul>
        <p class="sits-more">
          <span>{t(home.situations.more, { lessons: lessonTotal, tools: toolTotal })}</span>
          {' '}<a class="jump" href="#start" data-attr="home-hero-find">{home.situations.moreLink}&nbsp;<span aria-hidden="true">&darr;</span></a>
        </p>
      </div>
    </div>
  </section>

  {/* =============================================================
       2. Lessons: one line per route
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="start" aria-labelledby="start-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="section-head">
        <h2 id="start-heading"><a class="hlink" href={href('/blog/')} data-attr="home-lessons-head">{home.lessons.heading}&nbsp;<span aria-hidden="true">&rarr;</span></a></h2>
        <p class="cap-body">
          {home.lessons.body} <a class="inline-link" href={href('/blog/#level-helper')} data-attr="home-level-helper">{home.lessons.helperLink}</a>
        </p>
      </div>

      {/* Every line below opens an English lesson: the routes are named in
          the page's language, the lessons they open are not. */}
      <LessonsInEnglish locale={locale} />

      {/* One line per route. Each opens the first lesson this browser has not
          read yet. Inclusive Finances, a collection beside the levels, is the
          last line once a guide in it is live. */}
      <ul class="routes" role="list">
        {startingPoints.map((s) => s.lessons.length === 0 ? (
          <li style={`--start-level: var(--level-${s.level ?? 'mixed'}, var(--color-text-secondary))`}>
            {/* A level whose lessons are still scheduled: shown, not linked, until the first one goes live. */}
            <div class="route route--soon">
              <span class="route-badge" aria-hidden="true">{s.level ? LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 : '+'}</span>
              <span class="route-title">{s.level && <span class="sr-only">{t(home.lessons.routeN, { n: LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 })}</span>}{pointCopy(s.id).situation}</span>
              <span class="route-meta">{s.level ? t(home.lessons.comingSoon, { level: levelLabel(s.level) }) : home.lessons.comingSoonNoLevel}</span>
            </div>
          </li>
        ) : (
          <li style={`--start-level: var(--level-${s.level ?? 'mixed'}, var(--color-text-secondary))`}>
            <a
              class="route"
              href={s.lessons[0].href}
              data-start-route={JSON.stringify(s.lessons)}
              data-route-done={href(s.level ? `/blog/${s.level}/` : '/blog/')}
              data-door-continue={home.lessons.doorContinue}
              data-door-read={home.lessons.doorRead}
              data-door-path={home.lessons.doorPath}
              data-attr={`home-start-${s.id}-door`}
            >
              <span class="route-badge" aria-hidden="true">{s.level ? LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 : '+'}</span>
              <span class="route-title">{s.level && <span class="sr-only">{t(home.lessons.routeN, { n: LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 })}</span>}{pointCopy(s.id).situation}</span>
              <span class="route-meta">{s.level ? t(home.lessons.levelCount, { level: levelLabel(s.level), count: s.levelCount }) : home.lessons.severalLevels}</span>
              <span class="route-go"><span data-door-verb>{home.lessons.start}</span><span data-door-title></span> <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))}
        {inclusive.count > 0 && (
          <li style="--start-level: var(--level-inclusive-finances)">
            <a class="route" href={href(INCLUSIVE_HUB)} data-attr="home-inclusive-finances">
              <span class="route-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></svg>
              </span>
              <span class="route-title">{learn.levels['inclusive-finances']}</span>
              <span class="route-meta">{inclusiveText}</span>
              <span class="route-go">{home.lessons.inclusiveGo} <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        )}
      </ul>

      <p class="section-foot">
        <a href={href('/blog/')} data-attr="home-cta-blog">{home.lessons.foot}&nbsp;<span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </section>

  {/* =============================================================
       3. Free tools: one card per tool, led by the question it answers
       ============================================================= */}
  <section class="lp-section" id="apply" aria-labelledby="apply-heading">
    <div class="lp-section-inner">
      <div class="section-head">
        <h2 id="apply-heading"><a class="hlink" href={href('/free/')} data-attr="home-tools-head">{home.tools.heading}&nbsp;<span aria-hidden="true">&rarr;</span></a></h2>
        <p class="cap-body">
          {home.tools.body} <a class="inline-link" href={`${href('/privacy/')}#free-tools`} data-attr="home-tools-privacy">{home.tools.privacyLink}</a>
        </p>
      </div>

      <ul class="tool-list" role="list">
        {tools.map((tool) => (
          <li>
            <a href={href(tool.href)} class="tool-card" data-attr={`home-cta-${tool.href.split('/').filter(Boolean).pop()}`}>
              <span class="tool-q">{home.toolCards[tool.key].question}</span>
              <span class="tool-name">{home.toolCards[tool.key].name}&nbsp;<span aria-hidden="true">&rarr;</span></span>
              <span class="tool-desc">{home.toolCards[tool.key].desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* =============================================================
       4. The planner, with the waitlist beside it
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="signup" aria-labelledby="planner-heading" tabindex="-1">
    <div class="lp-section-inner planner-grid">
      <div class="planner-copy">
        {/* Drawn above the heading, read as part of it: someone jumping by
            heading still hears the date. */}
        <p class="planner-badge" aria-hidden="true">{home.planner.badge}</p>
        <h2 id="planner-heading"><a class="hlink" href={href('/beta/')} data-attr="home-planner-head">{home.planner.heading}<span class="sr-only">{fullStop} {home.planner.badge}</span>&nbsp;<span aria-hidden="true">&rarr;</span></a></h2>
        <p class="cap-body">{home.planner.body}</p>
        {/* The same questions as the hero's Plan rows, without their quotation
            marks: here they are what the planner answers, not a reader speaking. */}
        <h3 id="planner-qs-lead" class="planner-qs-lead">{home.planner.questionsLead}</h3>
        <ul class="planner-qs" role="list" aria-labelledby="planner-qs-lead">
          <li>{unquote(home.planner.questions.loan)}</li>
          <li>{unquote(home.planner.questions.careerBreak)}</li>
          <li>{unquote(home.planner.questions.currencies)}</li>
        </ul>
      </div>
      <div class="planner-signup">
        <WaitlistSection locale={locale} />
      </div>
    </div>
  </section>

  {/* =============================================================
       5. Who is behind nidhi, and the call for translators
       ============================================================= */}
  <section class="lp-section" id="why">
    <div class={`lp-section-inner help-grid${showNote ? '' : ' help-grid--card-only'}`}>
      {showNote && (
        <figure class="note">
          <h2 class="note-label">{home.note.label}</h2>
          <blockquote class="note-say" {...enOnly}><p>{FOUNDER_NOTE.quote}</p></blockquote>
          <figcaption class="note-by" {...enOnly}>{FOUNDER_NOTE.signOff}</figcaption>
          <p class="note-links">
            <span>{home.note.trustLine}</span>{' '}
            <a href={href('/about/')} data-attr="home-cta-about">{footer.links.about}</a>
            <span aria-hidden="true"> · </span>
            <a href={href('/beliefs/')} data-attr="home-cta-beliefs">{footer.links.beliefs}</a>
            <span aria-hidden="true"> · </span>
            <a href={href('/editorial-policy/')} data-attr="home-editorial-policy">{home.note.editorial}</a>
            <span aria-hidden="true"> · </span>
            <a href={href('/privacy/')} data-attr="home-privacy">{footer.links.privacy}</a>
          </p>
        </figure>
      )}
      <div class="help-card">
        <p class="help-eyebrow">{home.helpCard.eyebrow}</p>
        <h2 class="help-heading">{home.helpCard.heading}</h2>
        <p class="help-body">{home.helpCard.body}</p>
        <a class="help-link" href={href('/volunteers/')} data-attr="home-help-volunteer">{home.helpCard.link}&nbsp;<span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  {/* =============================================================
       6. Two common questions (also in FAQPage data above)
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="faq" aria-labelledby="faq-heading" tabindex="-1">
    <div class="lp-section-inner lp-section-inner--narrow">
      <h2 id="faq-heading" class="faq-heading">{home.faq.heading}</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" data-attr={`home-faq-${i + 1}`}>
            <summary class="disclosure"><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Reading progress on the homepage, which reads the same in any language
  // because it works in slugs. It reads the existing nidhi-reading-progress
  // key, which never leaves the browser, and only changes where the route
  // lines point.
  import { routeNext, type LessonLink } from '../../utils/home/startingPoints.ts';

  function readSlugs(): string[] {
    try {
      const read = JSON.parse(localStorage.getItem('nidhi-reading-progress') || '[]');
      return Array.isArray(read) ? read.map(String) : [];
    } catch {
      return [];
    }
  }

  // Each route line leads to the first lesson on its route this browser has
  // not read yet, from the same local key.
  const read = readSlugs();
  document.querySelectorAll<HTMLAnchorElement>('[data-start-route]').forEach((door) => {
    try {
      const route = JSON.parse(door.dataset.startRoute || '[]') as LessonLink[];
      const { next, started } = routeNext(route, read);
      if (!started) return;
      const verb = door.querySelector<HTMLElement>('[data-door-verb]')!;
      const title = door.querySelector<HTMLElement>('[data-door-title]')!;
      if (next) {
        door.href = next.href;
        verb.textContent = door.dataset.doorContinue || '';
        title.textContent = next.title;
        // A lesson title is English on every edition; the path's name is not.
        title.lang = 'en';
      } else {
        door.href = door.dataset.routeDone || '/blog/';
        verb.textContent = door.dataset.doorRead || '';
        title.textContent = door.dataset.doorPath || '';
        title.removeAttribute('lang');
      }
    } catch {
      /* malformed route: keep the default button */
    }
  });
</script>

<style>
  /* ----------------------------------------------------------------
     Volunteer bar, under the header: soft, with the link drawn as an
     outlined pill. One link; at least 44px tall on phones.
     ---------------------------------------------------------------- */
  .vol-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 0.5em;
    row-gap: 4px;
    min-height: 44px;
    padding: 8px 16px;
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
  }

  .vol-bar-pill {
    display: inline-block;
    white-space: nowrap;
    padding: 2px 10px;
    border: 1.5px solid var(--color-deep-blue);
    border-radius: 999px;
    color: var(--color-deep-blue);
    font-weight: 600;
  }

  .vol-bar:hover .vol-bar-pill {
    background: var(--color-deep-blue);
    color: var(--color-bg-white);
  }

  .vol-bar:focus-visible {
    outline: 3px solid var(--color-deep-blue);
    outline-offset: -3px;
  }

  @media (max-width: 759px) {
    .vol-bar { justify-content: flex-start; text-align: left; font-size: 0.8125rem; }
  }

  /* Read by screen readers, not drawn: "Route 1" before each route line,
     the beta date in the planner heading, the pause before "soon". */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ----------------------------------------------------------------
     Section frame
     ---------------------------------------------------------------- */
  .lp-section { padding: 72px 24px; }
  .lp-section:focus { outline: none; }
  .lp-section--alt {
    background: var(--color-bg-white);
    border-block: 1px solid var(--color-border);
  }

  .lp-section-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .lp-section-inner--narrow { max-width: 760px; }

  h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw + 0.6rem, 2.3rem);
    line-height: 1.15;
    color: var(--color-deep-blue);
    margin: 0 0 12px;
    font-weight: 700;
    text-wrap: balance;
  }

  /* A section's heading is a link to the section's own page. */
  .hlink { color: inherit; text-decoration: none; }
  .hlink:hover,
  .hlink:focus-visible { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
