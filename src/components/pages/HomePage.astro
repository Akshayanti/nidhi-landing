  .an-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-deep-blue);
  }

  .an-title::after { content: ' \2192' / ''; }

  .an-desc {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.45;
  }


  /* ----------------------------------------------------------------
     5. Planner
     ---------------------------------------------------------------- */
