---
/**
 * The inflation calculator page, in whichever language it was asked for.
 *
 * English is served from `src/pages/free/inflation-calculator.astro`, the other
 * languages from `src/pages/[locale]/free/inflation-calculator.astro`; both
 * render this one component, so the editions cannot drift apart in markup or
 * styling.
 *
 * The copy is in the catalog, under `tools.inflation.page`, and what the tool
 * says under `tools.inflation.island`, which is handed to the island as a
 * prop: one locale's slice, never `dict(locale)`, which would ship every
 * language and every tool to the browser.
 *
 * The country history is the World Bank's (src/data/inflation/worldbank.json,
 * refreshed monthly by .github/workflows/inflation-data.yml). Only what the
 * select needs is passed to the island: each country's code, its name written
 * here with `Intl.DisplayNames` in the page's language, and its currency when
 * the tools have it. The yearly figures stay out of the page, except the one
 * country it starts with (India on the Hindi page), so a page that shows no
 * history loads none. The rest is fetched from this site's own origin
 * (`/data/inflation-history.json`) when a reader picks a country; the
 * reader's browser never contacts the World Bank.
 *
 * What stays here rather than in the catalog is what no translator would
 * touch: the `data-attr` labels, which the privacy notice's changelog names;
 * the addresses, which `localizedPath` prefixes; the lesson slugs; and the
 * English title of the lesson the notes link to, since lessons are English
 * in every edition.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import InflationCalculator, { type CountryOption } from '../InflationCalculator.tsx';
import ToolStateGuard from '../ToolStateGuard.astro';
import ToolPageShell from '../ToolPageShell.astro';
import ToolWaitlist from '../ToolWaitlist.astro';
import { getCollection } from 'astro:content';
import data from '../../data/inflation/worldbank.json';
import { COUNTRY_CURRENCY } from '../../utils/inflation/countries.ts';
import { HISTORY_URL, INFLATION_URL, toCompactSeries, type WorldBankFile } from '../../utils/inflation/history.ts';
import { MAX_RATE, MIN_RATE } from '../../utils/inflation/math.ts';
import { SHARED_STATE_GLOBAL, STATE_KEY_PATTERN } from '../../utils/inflation/url.ts';
import { TOOL_AMOUNT_LOCALE, TOOL_DEFAULT_CURRENCY } from '../../utils/shared/toolState.ts';
import { CURRENCIES } from '../../utils/loan/math.ts';
import { PROSE_NUMBER_LOCALE } from '../../i18n/config.ts';
import { DATE_LOCALE, LOCALE_META, LOCALES, dict, localizedPath, lessonPath, format, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

/**
 * The country whose history the page starts with: India on the Hindi and
 * Marathi pages, Czechia on the Czech page, none elsewhere. A page's language is the only thing this reads; the tool
 * never detects a reader's location.
 */
const DEFAULT_COUNTRY: Record<Locale, string> = { en: '', hi: 'IND', es: '', cs: 'CZE', mr: 'IND' };

const { locale } = Astro.props;
const { inflation, export: exportStrings } = dict(locale).tools;
const strings = inflation.page;
const island = inflation.island;
const t = format;
const htmlLang = LOCALE_META[locale].htmlLang;
const file = data as WorldBankFile;

// The select's countries, named in the page's language from their ISO codes.
// The euro area has no ISO code, so its name is the catalog's.
const toolCurrencies = new Set(CURRENCIES.map((c) => c.code));
const regionNames = new Intl.DisplayNames([htmlLang], { type: 'region' });
const countries: CountryOption[] = Object.entries(file.countries)
  .map(([code, entry]) => {
    const named = code === 'EMU' ? island.history.euroArea : regionNames.of(entry.iso2);
    const currency = COUNTRY_CURRENCY[code];
    return {
      code,
      name: named && named !== entry.iso2 ? named : code,
      currency: currency && toolCurrencies.has(currency) ? currency : null,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, htmlLang));

const defaultCountry = DEFAULT_COUNTRY[locale];
const defaultSeries = defaultCountry ? toCompactSeries(file.countries[defaultCountry]?.years ?? {}) : null;
const initialHistory = defaultCountry && defaultSeries ? { code: defaultCountry, series: defaultSeries } : null;

const proseNumber = (n: number) => n.toLocaleString(PROSE_NUMBER_LOCALE[locale]);
const updated = new Intl.DateTimeFormat(DATE_LOCALE[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(
  new Date(`${file.lastUpdated}T00:00:00Z`),
);

// Everything the page's copy quotes, in one place.
const figures = {
  countries: proseNumber(Object.keys(file.countries).filter((c) => c !== 'EMU').length),
  minRate: proseNumber(MIN_RATE),
  maxRate: proseNumber(MAX_RATE),
  updated,
  copyLink: island.actions.copy,
};

const siteUrl = 'https://nidhi.today';
const canonicalUrl = new URL(localizedPath(locale, INFLATION_URL), siteUrl).href;
const faqs = strings.faq.items.map((f) => ({ q: t(f.q, figures), a: t(f.a, figures) }));

// The lesson the notes link to. Its title is English in every edition.
const LESSON = { slug: 'purchasing-power', title: "Purchasing Power: Why €1,000 Today Isn't €1,000 Tomorrow" };

// Related reading, in order of relevance; an unpublished lesson is skipped.
const RELATED_CANDIDATES: { slug: keyof typeof strings.related.cards; dataAttr: string }[] = [
  { slug: 'purchasing-power', dataAttr: 'related-purchasing-power' },
  { slug: 'saving-vs-investing', dataAttr: 'related-saving-vs-investing' },
  { slug: 'why-your-euro-buys-more-in-some-countries', dataAttr: 'related-why-your-euro-buys-more' },
];

const isDev = import.meta.env.DEV;
const now = new Date();
const publishedSlugs = new Set(
  (await getCollection('blog')).filter((p) => isDev || p.data.pubDate <= now).map((p) => p.data.slug),
);
const lessonPublished = publishedSlugs.has(LESSON.slug);
const related = RELATED_CANDIDATES.filter((c) => publishedSlugs.has(c.slug)).map((c) => ({
  ...c,
  ...strings.related.cards[c.slug],
  url: lessonPath(c.slug),
}));

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  inLanguage: htmlLang,
  name: inflation.schema.name,
  alternateName: inflation.schema.alternateNames,
  url: canonicalUrl,
  description: inflation.meta.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: inflation.schema.operatingSystem,
  browserRequirements: inflation.schema.browserRequirements,
  isAccessibleForFree: true,
  featureList: inflation.schema.featureList.map((f) => t(f, figures)),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'nidhi', url: 'https://nidhi.today/' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: strings.breadcrumb.home, item: new URL(localizedPath(locale, '/'), siteUrl).href },
    { '@type': 'ListItem', position: 2, name: strings.breadcrumb.freeTools, item: new URL(localizedPath(locale, '/free/'), siteUrl).href },
    { '@type': 'ListItem', position: 3, name: strings.breadcrumb.this, item: canonicalUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: htmlLang,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={inflation.meta.title}
  description={inflation.meta.description}
  jsonLd={[webAppSchema, breadcrumbSchema, faqSchema]}
  toolStateGlobal={SHARED_STATE_GLOBAL}
>
  <ToolStateGuard slot="head" globalName={SHARED_STATE_GLOBAL} keyPattern={STATE_KEY_PATTERN} />
  <ToolPageShell
    locale={locale}
    breadcrumb={strings.breadcrumb}
    eyebrow={strings.eyebrow}
    title={strings.title}
    lead={strings.lead}
    faq={{ heading: strings.faq.heading, items: faqs }}
    related={{ heading: strings.related.heading, cards: related }}
  >

    <InflationCalculator
      client:load
      strings={island}
      exportStrings={exportStrings}
      defaultCurrency={TOOL_DEFAULT_CURRENCY[locale]}
      defaultCountry={defaultCountry}
      countries={countries}
      initialHistory={initialHistory}
      historyUrl={HISTORY_URL}
      numberLocale={PROSE_NUMBER_LOCALE[locale]}
      amountLocale={TOOL_AMOUNT_LOCALE[locale]}
    />

    <aside class="toolp-panel toolp-notes" aria-labelledby="toolp-notes-h">
      <h2 id="toolp-notes-h" class="toolp-sectionTitle">{strings.notes.heading}</h2>
      <ul>
        {Object.values(strings.notes.items).map((item) => (
          <li><strong>{item.lead}</strong>{item.rest}</li>
        ))}
      </ul>
      {lessonPublished && (
        <p class="toolp-lesson">
          {strings.notes.lesson.before}<a href={lessonPath(LESSON.slug)} hreflang="en" lang="en" data-attr="free-inflation-lesson-link">{LESSON.title}</a>{strings.notes.lesson.after}
        </p>
      )}
    </aside>

    <ToolWaitlist locale={locale} line={strings.plannerLine} />

    <section class="toolp-panel" aria-labelledby="toolp-source-h">
      <h2 id="toolp-source-h" class="toolp-sectionTitle">{strings.source.heading}</h2>
      <p class="toolp-source">
        {strings.source.before}<a href="https://data.worldbank.org/indicator/FP.CPI.TOTL.ZG" target="_blank" rel="noopener noreferrer">{strings.source.link}</a>{t(strings.source.after, figures)}
      </p>
    </section>
  </ToolPageShell>
</BaseLayout>

<style>
  /* The page's frame and panels are styled by ToolPageShell.astro. */
</style>
