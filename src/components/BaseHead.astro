---
import { NEUTRAL, SEMANTIC } from '../styles/palette.ts';
import {
  DEFAULT_LOCALE,
  LOCALE_META,
  dict,
  localizedPath,
  stripLocale,
  type Locale,
} from '../i18n';

interface Props {
  /** The language this page is written in. Defaults to English. */
  locale?: Locale;
  /**
   * The locales this page exists in, including `locale`. `hreflang` links and
   * `og:locale:alternate` are built from this list, so a page that has no
   * counterpart in another language points search engines at nothing.
   * Defaults to this page's own language: see `BaseLayout` props.
   */
  alternates?: readonly Locale[];
  title: string;
  description: string;
  image?: string;
  /**
   * Pixel width of the OG image. Defaults to 1200, the dimension of the
   * generic site OG image at `/brand/social/og-image.png`. Pages that
   * pass a custom `image` MUST also pass matching `imageWidth` and
   * `imageHeight`; declaring dims that don't match the asset is a
   * common cause of social-card render failures.
   */
  imageWidth?: number;
  /** Pixel height of the OG image. Defaults to 630. See `imageWidth`. */
  imageHeight?: number;
  /**
   * Twitter card alt text. Defaults to a generic site-level description.
   * Per-page overrides are encouraged for richer accessibility on
   * social previews and so that future per-post OG images (PR16) can
   * carry post-specific alt text without another props change.
   */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
}

const defaultImage = '/brand/social/og-image.png';
const {
  locale = DEFAULT_LOCALE,
  alternates = [locale],
  title,
  description,
  image = defaultImage,
  imageWidth = 1200,
  imageHeight = 630,
  article,
  prevUrl,
  nextUrl,
  jsonLd = [],
  robots,
} = Astro.props;

// The same page in another language is the same path under a different locale
// prefix, so the canonical URL is built from the path with the prefix removed
// rather than from the address this page happens to be served at.
const path = stripLocale(Astro.url.pathname).path;
const urlIn = (target: Locale) => new URL(localizedPath(target, path), Astro.site);
const canonicalURL = urlIn(locale);
const otherLocales = alternates.filter((other) => other !== locale);
// x-default is the address to fall back to, which is the English one whenever
// English is among the languages this page exists in.
const xDefault = alternates.includes(DEFAULT_LOCALE) ? urlIn(DEFAULT_LOCALE) : canonicalURL;
const strings = dict(locale);
// One feed, in English, linked and named the same on every page: there is one
// lesson library and it is not translated, so a Hindi page's feed link offers
// the English feed under the English feed's own name, which is what arrives in
// the reader once they subscribe.
const feedTitle = dict(DEFAULT_LOCALE).rss.linkTitle;
// Every page but the home page takes this default, and it opens with the brand
// tagline, so it is read from the catalog rather than written into this file.
const imageAlt = Astro.props.imageAlt ?? strings.meta.defaultImageAlt;

// A Hindi page's first paint is set in Devanagari: the nav, the headings and the
// body are Devanagari before Inter sees a Latin word, so that face is worth
// preloading beside it. Inter stays preloaded on every page, because the Latin
// words and every amount are set in it. Only a Hindi page gets the second
// preload. It is the same origin, so neither adds a third-party request.
const preloadDevanagari = locale !== DEFAULT_LOCALE;
---

<!-- Flash prevention: apply theme before render -->
<script is:inline>
  (function() {
    var mode = localStorage.getItem('nidhi-theme-mode') || 'system';
    if (mode === 'system') {
      mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', mode);
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/brand/favicons/favicon-16.png" />
<link rel="shortcut icon" href="/brand/favicons/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/brand/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/brand/site.webmanifest" />
<!-- Preload primary Inter latin variant: it's the first font requested by
     global.css for the body face. Latin-ext is excluded on purpose: it's
     rarely needed on first paint and would slow LCP for the common case. -->
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
{preloadDevanagari && <link rel="preload" href="/fonts/noto-devanagari.woff2" as="font" type="font/woff2" crossorigin />}
<meta name="theme-color" content={NEUTRAL.offWhite} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={NEUTRAL.pageBgDark} />
<meta name="msapplication-TileColor" content={SEMANTIC.calloutBg} />
<meta name="msapplication-TileImage" content="/brand/favicons/mstile-150x150.png" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={LOCALE_META[alternate].htmlLang} href={urlIn(alternate)} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={feedTitle} href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="nidhi" />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{otherLocales.map((other) => (
  <meta property="og:locale:alternate" content={LOCALE_META[other].ogLocale} />
))}

<!-- Article-specific OG -->
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Prev/Next -->
{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

<!-- JSON-LD Structured Data -->
{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- PostHog analytics is intentionally NOT here. It loads at the end of
     <body> via Analytics.astro so it never blocks HTML parsing or paint. -->
