---
interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string[];
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
}

const defaultImage = '/brand/social/og-image.png';
const { title, description, image = defaultImage, keywords, article, prevUrl, nextUrl, jsonLd = [], robots } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!-- Flash prevention: apply theme before render -->
<script is:inline>
  (function() {
    var mode = localStorage.getItem('nidhi-theme-mode') || 'system';
    if (mode === 'system') {
      mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', mode);
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/brand/favicons/favicon-16.png" />
<link rel="shortcut icon" href="/brand/favicons/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/brand/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/brand/site.webmanifest" />
<meta name="theme-color" content="#F8F9FA" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />
<meta name="msapplication-TileColor" content="#0D47A1" />
<meta name="msapplication-TileImage" content="/brand/favicons/mstile-150x150.png" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="nidhi | Personal Finance Blog" href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="nidhi" />
<meta property="og:locale" content="en_US" />

<!-- Article-specific OG -->
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content="nidhi: Money, understood. Personal finance tools and financial literacy." />

<!-- Prev/Next -->
{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

<!-- JSON-LD Structured Data -->
{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- PostHog Analytics
     Anonymous pageviews + UTM: always (no PII, legitimate interest)
     Heatmaps + autocapture: only after consent -->
<script is:inline define:vars={{ posthogKey: import.meta.env.PUBLIC_POSTHOG_KEY }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onSessionId setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

  var hasFullConsent = localStorage.getItem('nidhi-cookie-consent') === 'accepted';

  posthog.init(posthogKey, {
    api_host: 'https://eu.i.posthog.com',
    capture_pageview: true,
    capture_pageleave: true,
    autocapture: hasFullConsent,
    enable_heatmaps: hasFullConsent,
    persistence: 'localStorage',
    disable_session_recording: true,
  })

  // Flag AI-sourced traffic for easy dashboard filtering.
  // PostHog auto-captures $referrer and $referring_domain on every
  // pageview; this adds a dedicated is_ai_traffic event so you can
  // create a one-click insight for "AI to site" without manual filters.
  var aiReferrers = ['chatgpt.com', 'chat.openai.com', 'perplexity.ai', 'claude.ai', 'gemini.google.com', 'copilot.microsoft.com', 'you.com', 'bard.google.com', 'deepseek.com', 'grok.com'];
  var ref = document.referrer;
  try { var refHost = new URL(ref).hostname; } catch(_) { var refHost = ''; }
  var isAI = refHost && aiReferrers.some(function(d) { return refHost === d || refHost.endsWith('.' + d); });
  if (isAI) {
    posthog.capture('$ai_referrer', { ai_referrer_domain: refHost, ai_referrer_full: ref });
  }
</script>