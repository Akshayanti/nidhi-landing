---
import { jsonForScript } from '../utils/shared/jsonForScript.ts';
import { NEUTRAL, SEMANTIC } from '../styles/palette.ts';
import {
  DEFAULT_LOCALE,
  LOCALE_META,
  dict,
  localizedPath,
  stripLocale,
  type Locale,
} from '../i18n';

interface Props {
  /** The language this page is written in. Defaults to English. */
  locale?: Locale;
  /**
   * The locales this page exists in, including `locale`. `hreflang` links and
   * `og:locale:alternate` are built from this list, so a page that has no
   * counterpart in another language points search engines at nothing.
   * Defaults to this page's own language: see `BaseLayout` props.
   */
  alternates?: readonly Locale[];
  /**
   * The languages search engines are told this page exists in: the `hreflang`
   * links and `og:locale:alternate`. Defaults to `alternates`. A page whose
   * other editions are kept out of search (the glossary, see
   * `ENGLISH_ONLY_IN_SEARCH`) names only the ones that are in it, while
   * `alternates` goes on deciding what the language picker offers.
   */
  pairedLocales?: readonly Locale[];
  title: string;
  description: string;
  image?: string;
  /**
   * Pixel width of the OG image. Defaults to 1200, the dimension of the
   * generic site OG image at `/brand/social/og-image.png`. Pages that
   * pass a custom `image` MUST also pass matching `imageWidth` and
   * `imageHeight`; declaring dims that don't match the asset is a
   * common cause of social-card render failures.
   */
  imageWidth?: number;
  /** Pixel height of the OG image. Defaults to 630. See `imageWidth`. */
  imageHeight?: number;
  /**
   * Twitter card alt text. Defaults to a generic site-level description.
   * Per-page overrides are encouraged for richer accessibility on
   * social previews and so that future per-post OG images (PR16) can
   * carry post-specific alt text without another props change.
   */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
    /** Address of the page about who wrote it (`article:author`). */
    author?: string;
    /** The part of the site it belongs to, a lesson's level (`article:section`). */
    section?: string;
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
  /**
   * For a page with no address of its own: the 404, which the host serves at
   * every missing address. Its build path (/404/) is not a page anyone can
   * visit, so it states no canonical and no `og:url` rather than that one.
   */
  noCanonical?: boolean;
}

const defaultImage = '/brand/social/og-image.png';
const {
  locale = DEFAULT_LOCALE,
  alternates = [locale],
  title,
  description,
  image = defaultImage,
  imageWidth = 1200,
  imageHeight = 630,
  article,
  prevUrl,
  nextUrl,
  jsonLd = [],
  robots,
  noCanonical = false,
} = Astro.props;

// The same page in another language is the same path under a different locale
// prefix, so the canonical URL is built from the path with the prefix removed
// rather than from the address this page happens to be served at.
const path = stripLocale(Astro.url.pathname).path;
const urlIn = (target: Locale) => new URL(localizedPath(target, path), Astro.site);
const canonicalURL = urlIn(locale);
const paired = Astro.props.pairedLocales ?? alternates;
const otherLocales = paired.filter((other) => other !== locale);
// x-default is the address to fall back to, which is the English one whenever
// English is among the languages this page is paired in.
const xDefault = paired.includes(DEFAULT_LOCALE) ? urlIn(DEFAULT_LOCALE) : canonicalURL;
const strings = dict(locale);
// One feed, in English, linked and named the same on every page: there is one
// lesson library and it is not translated, so a Hindi page's feed link offers
// the English feed under the English feed's own name, which is what arrives in
// the reader once they subscribe.
const feedTitle = dict(DEFAULT_LOCALE).rss.linkTitle;
// Every page but the home page takes this default, and it opens with the brand
// tagline, so it is read from the catalog rather than written into this file.
const imageAlt = Astro.props.imageAlt ?? strings.meta.defaultImageAlt;

// Which font files a page asks for before its stylesheet is read. The
// stylesheet sets headings and the nav in Inter (`--font-heading`) and body
// text in Roboto (`--font-body`), with Noto Sans Devanagari behind both, and
// every face swaps in when it arrives, so a file the browser learns about late
// is a visible reflow of whatever it sets. The list is kept to the files a
// page's first screen is certain to use:
//
// - Inter's Latin file on every page: headings and the nav on a Latin-script
//   page, the Latin words in the header on a Devanagari one.
// - Roboto's Latin file on the Latin-script editions (English, Spanish,
//   Czech): the body face, and the largest block of text on a lesson or a
//   guide (#456). A Hindi or Marathi page's body is Devanagari, so it gets
//   the Devanagari file instead (it carries Marathi's own letters and letter
//   forms too). Such a page still fetches Roboto's Latin file, for the Latin
//   words and digits in its body, and it is left without a preload on
//   purpose. Measured on the first screen of the home, Learn, about and loan
//   comparison pages in Hindi and Marathi, at phone and laptop widths (#708,
//   Nov 2026): Roboto sets 1 to 7% of the body text's characters, and 10 to
//   22% on the Learn page, whose lesson titles are English. A preload would
//   put a 37 KB file in line with the 121 KB Devanagari one that sets the
//   rest, to spare a late swap on a few words.
// - On a Czech page, the extended-Latin files of both faces: its headings and
//   its body carry diacritics (č, ř, ě) from the first word. English and
//   Spanish leave them out, as their accents are in the Latin files.
//
// All are the same origin, so none adds a third-party request.
const preloadDevanagari = locale === 'hi' || locale === 'mr';
const preloadBodyLatin = !preloadDevanagari;
const preloadLatinExt = locale === 'cs';
const noindex = !!robots && /noindex/i.test(robots);
---

<!-- Flash prevention: apply theme before render -->
<script is:inline>
  (function() {
    // Reading storage throws where site data is blocked: the system's
    // scheme then decides, as it does for a reader who never chose.
    var mode = 'system';
    try { mode = localStorage.getItem('nidhi-theme-mode') || 'system'; } catch (e) { /* storage blocked */ }
    if (mode === 'system') {
      mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', mode);
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/brand/favicons/favicon-16.png" />
<link rel="shortcut icon" href="/brand/favicons/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/brand/favicons/apple-touch-icon.png" />
{/* A translated edition has its own manifest, with its tagline and home page
    (src/pages/[locale]/site.webmanifest.ts). The English one is a brand asset. */}
<link rel="manifest" href={locale === DEFAULT_LOCALE ? '/brand/site.webmanifest' : localizedPath(locale, '/site.webmanifest')} />
{/* Font preloads: the heading face, then the body face of this edition's
    script. Which files and why is set out where the flags are defined above. */}
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
{preloadBodyLatin && <link rel="preload" href="/fonts/roboto-latin.woff2" as="font" type="font/woff2" crossorigin />}
{preloadDevanagari && <link rel="preload" href="/fonts/noto-devanagari.woff2" as="font" type="font/woff2" crossorigin />}
{preloadLatinExt && <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />}
{preloadLatinExt && <link rel="preload" href="/fonts/roboto-latin-ext.woff2" as="font" type="font/woff2" crossorigin />}
<meta name="theme-color" content={NEUTRAL.offWhite} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={NEUTRAL.pageBgDark} />
<meta name="msapplication-TileColor" content={SEMANTIC.calloutBg} />
<meta name="msapplication-TileImage" content="/brand/favicons/mstile-150x150.png" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<!-- Canonical -->
{!noCanonical && <link rel="canonical" href={canonicalURL} />}
{/* A noindex page (the 404, the transactional pages) has nothing for search
    engines to pair, and the 404's own path is not a real address. */}
{!noindex && paired.map((alternate) => (
  <link rel="alternate" hreflang={LOCALE_META[alternate].htmlLang} href={urlIn(alternate)} />
))}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={feedTitle} href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{!noCanonical && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="nidhi" />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{otherLocales.map((other) => (
  <meta property="og:locale:alternate" content={LOCALE_META[other].ogLocale} />
))}

<!-- Article-specific OG -->
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.author && <meta property="article:author" content={new URL(article.author, Astro.site)} />}
    {article.section && <meta property="article:section" content={article.section} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Prev/Next -->
{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

<!-- JSON-LD Structured Data -->
{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={jsonForScript(schema)} />
))}

<!-- PostHog analytics is intentionally NOT here. It loads at the end of
     <body> via Analytics.astro so it never blocks HTML parsing or paint. -->
