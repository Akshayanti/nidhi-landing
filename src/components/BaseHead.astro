---
import { NEUTRAL, SEMANTIC } from '../styles/palette.ts';

interface Props {
  title: string;
  description: string;
  image?: string;
  /**
   * Pixel width of the OG image. Defaults to 1200, the dimension of the
   * generic site OG image at `/brand/social/og-image.png`. Pages that
   * pass a custom `image` MUST also pass matching `imageWidth` and
   * `imageHeight`; declaring dims that don't match the asset is a
   * common cause of social-card render failures.
   */
  imageWidth?: number;
  /** Pixel height of the OG image. Defaults to 630. See `imageWidth`. */
  imageHeight?: number;
  /**
   * Twitter card alt text. Defaults to a generic site-level description.
   * Per-page overrides are encouraged for richer accessibility on
   * social previews and so that future per-post OG images (PR16) can
   * carry post-specific alt text without another props change.
   */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
}

const defaultImage = '/brand/social/og-image.png';
const defaultImageAlt = 'nidhi: Money, understood. Personal finance tools and financial literacy.';
const {
  title,
  description,
  image = defaultImage,
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = defaultImageAlt,
  article,
  prevUrl,
  nextUrl,
  jsonLd = [],
  robots,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!-- Flash prevention: apply theme before render -->
<script is:inline>
  (function() {
    var mode = localStorage.getItem('nidhi-theme-mode') || 'system';
    if (mode === 'system') {
      mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', mode);
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/brand/favicons/favicon-16.png" />
<link rel="shortcut icon" href="/brand/favicons/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/brand/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/brand/site.webmanifest" />
<!-- Preload primary Inter latin variant: it's the first font requested by
     global.css for the body face. Latin-ext is excluded on purpose: it's
     rarely needed on first paint and would slow LCP for the common case. -->
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content={NEUTRAL.offWhite} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content={NEUTRAL.pageBgDark} />
<meta name="msapplication-TileColor" content={SEMANTIC.calloutBg} />
<meta name="msapplication-TileImage" content="/brand/favicons/mstile-150x150.png" />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="nidhi | Personal Finance Blog" href="/rss.xml" />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="nidhi" />
<meta property="og:locale" content="en_US" />

<!-- Article-specific OG -->
{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Prev/Next -->
{prevUrl && <link rel="prev" href={prevUrl} />}
{nextUrl && <link rel="next" href={nextUrl} />}

<!-- JSON-LD Structured Data -->
{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- PostHog analytics is intentionally NOT here. It loads at the end of
     <body> via Analytics.astro so it never blocks HTML parsing or paint. -->
