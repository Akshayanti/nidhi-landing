---
interface Props {
  level: 'discovery' | 'building' | 'optimizing' | 'mastery';
}

const { level } = Astro.props;

const levels: Record<string, { label: string; icon: string }> = {
  discovery: { label: 'Discovery', icon: '&#x1F4A1;' },
  building: { label: 'Building', icon: '&#x1F3D7;' },
  optimizing: { label: 'Optimizing', icon: '&#x2699;' },
  mastery: { label: 'Mastery', icon: '&#x1F3C6;' },
};

const { label, icon } = levels[level];
---

<span class:list={['level-badge', `level-badge--${level}`]}>
  <span class="level-icon" set:html={icon} />
  {label}
</span>

<style>
  /* Each level resolves its identity color via a CSS variable that flips
     between light and dark themes (see :root and [data-theme="dark"] in
     global.css). This keeps the badge readable in both modes. */
  .level-badge--discovery { --badge-color: var(--level-discovery); }
  .level-badge--building { --badge-color: var(--level-building); }
  .level-badge--optimizing { --badge-color: var(--level-optimizing); }
  .level-badge--mastery { --badge-color: var(--level-mastery); }

  .level-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--badge-color) 14%, var(--color-bg-white));
    color: var(--badge-color);
  }

  .level-icon {
    font-size: 0.8rem;
  }
</style>