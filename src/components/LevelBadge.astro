---
/**
 * The lesson's level, above its title: the level's number in an outlined,
 * tinted disc and its name, the same mark the home page's routes use (#418).
 * Inclusive finances sits beside the path, not on it, so it has no number and
 * shows its name only. Lessons are English, so the names are too.
 */
import { LADDER_LEVELS } from '../utils/home/startingPoints';

interface Props {
  level: 'discovery' | 'building' | 'psychology' | 'optimizing' | 'mastery' | 'inclusive-finances';
}

const { level } = Astro.props;

const labels: Record<Props['level'], string> = {
  discovery: 'Discovery',
  building: 'Building',
  psychology: 'Psychology',
  optimizing: 'Optimizing',
  mastery: 'Mastery',
  'inclusive-finances': 'Inclusive Finances',
};

const label = labels[level];
const step = (LADDER_LEVELS as readonly string[]).indexOf(level) + 1;
---

<span class:list={['level-badge', `level-badge--${level}`]}>
  {step > 0 && <span class="level-num" aria-hidden="true">{step}</span>}
  {step > 0 && <span class="sr-only">Level {step}: </span>}
  {label}
</span>

<style>
  /* Each level resolves its identity color via a CSS variable that flips
     between light and dark themes (see :root and [data-theme="dark"] in
     global.css). This keeps the badge readable in both modes. */
  .level-badge--discovery { --badge-color: var(--level-discovery); }
  .level-badge--building { --badge-color: var(--level-building); }
  .level-badge--psychology { --badge-color: var(--level-psychology); }
  .level-badge--optimizing { --badge-color: var(--level-optimizing); }
  .level-badge--mastery { --badge-color: var(--level-mastery); }
  .level-badge--inclusive-finances { --badge-color: var(--level-inclusive-finances); }

  .level-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--badge-color);
  }

  .level-num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.75em;
    height: 1.75em;
    border: 1.5px solid var(--badge-color);
    border-radius: 50%;
    background: color-mix(in srgb, var(--badge-color) 12%, var(--color-bg-white));
    letter-spacing: normal;
    line-height: 1;
  }
</style>
