---
// Subscribe form. Posts to a Google Apps Script Web App that stores the email
// in a Google Sheet and sends a double-opt-in confirmation email. Fully free,
// fully self-hosted (Apps Script + Workspace Gmail + GitHub Actions).
//
// Configure PUBLIC_NEWSLETTER_ENDPOINT to the Apps Script Web App exec URL.
// See docs/blog-subscription-setup.md for full setup instructions.

export interface Props {
  /**
   * `full`    — large centered box with heading + copy. Use at the end of a
   *             blog post (high-intent moment after reading).
   * `compact` — single inline row with input + button. Use near the top of
   *             the blog index as a slim visible CTA.
   */
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '';
const isDev = import.meta.env.DEV;

// Stable per-variant IDs so the inline script can wire up the right instance
// even if both variants somehow ended up on the same page.
const formId = `subscribe-form-${variant}`;
const statusId = `subscribe-status-${variant}`;
const inputId = `subscribe-email-${variant}`;
---

<section class={`subscribe subscribe--${variant}`} aria-label="Newsletter subscription" data-variant={variant}>
  {variant === 'full' && (
    <div class="subscribe-box">
      {/* Pre-submit: form. */}
      <div class="subscribe-pre" data-subscribe-state="pre">
        <h3 class="subscribe-title">Receive new posts directly in your inbox</h3>
        <p class="subscribe-text">One email when something new goes up. No spam, unsubscribe anytime.</p>

        <form
          id={formId}
          class="subscribe-form"
          data-endpoint={endpoint}
        >
          <div class="subscribe-input-group">
            <label class="sr-only" for={inputId}>Email address</label>
            <input
              id={inputId}
              type="email"
              name="email"
              placeholder="your@email.com"
              required
              autocomplete="email"
              class="subscribe-input"
            />
            <button type="submit" class="subscribe-button">Subscribe</button>
          </div>
          <p id={statusId} class="subscribe-status" role="status" aria-live="polite"></p>
          <p class="subscribe-privacy">
            Double opt-in. Unsubscribe anytime. <a href="/privacy/">Privacy policy</a>.
            {' · '}<a href="/rss.xml" rel="alternate" type="application/rss+xml">RSS</a>
          </p>
        </form>
        <div class="subscribe-dismiss">
          <button type="button" class="subscribe-dismiss-link" data-action="already-subscribed">I already subscribed</button>
          <span class="subscribe-dismiss-sep" aria-hidden="true">·</span>
          <button type="button" class="subscribe-dismiss-link" data-action="not-now">Not now</button>
        </div>
        {isDev && !endpoint && (
          <p class="subscribe-dev-warning">
            ⚠ <code>PUBLIC_NEWSLETTER_ENDPOINT</code> is not set — the form is visible
            but submissions will no-op. See <code>docs/blog-subscription-setup.md</code>.
          </p>
        )}
      </div>

      {/* Post-submit: success card. Swapped in by JS on successful POST. */}
      <div class="subscribe-post" data-subscribe-state="post" hidden>
        <div class="subscribe-success-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h3 class="subscribe-success-title">Check your inbox</h3>
        <p class="subscribe-success-body">
          We sent a confirmation link to <strong data-subscribe-email>your email</strong>.
          Click the button in that email to finish subscribing. Takes a second.
        </p>
        <p class="subscribe-success-hint">
          No email after a minute? Check spam, or
          <button type="button" class="subscribe-success-retry" data-subscribe-retry>try a different address</button>.
        </p>
      </div>

      {/* Dismissed: shown when user clicks "I already subscribed" or "Not now". */}
      <div class="subscribe-dismissed" data-subscribe-state="dismissed" hidden>
        <p class="subscribe-dismissed-text" data-dismissed-text></p>
        <button type="button" class="subscribe-dismissed-undo" data-dismiss-undo>Undo</button>
      </div>
    </div>
  )}

  {variant === 'compact' && (
    <div class="subscribe-compact">
      <div class="subscribe-pre" data-subscribe-state="pre">
        <div class="subscribe-compact-row">
          <span class="subscribe-compact-label">Receive new posts directly in your inbox</span>
          <form
            id={formId}
            class="subscribe-form subscribe-form--compact"
            data-endpoint={endpoint}
          >
            <label class="sr-only" for={inputId}>Email address</label>
            <input
              id={inputId}
              type="email"
              name="email"
              placeholder="your@email.com"
              required
              autocomplete="email"
              class="subscribe-input"
            />
            <button type="submit" class="subscribe-button">Subscribe</button>
          </form>
          <a class="subscribe-rss" href="/rss.xml" rel="alternate" type="application/rss+xml" aria-label="RSS feed">
            or RSS
          </a>
        </div>
        <p id={statusId} class="subscribe-status" role="status" aria-live="polite"></p>
        {isDev && !endpoint && (
          <p class="subscribe-dev-warning">
            ⚠ <code>PUBLIC_NEWSLETTER_ENDPOINT</code> is not set — the form is visible
            but submissions will no-op.
          </p>
        )}
        <div class="subscribe-dismiss subscribe-dismiss--compact">
          <button type="button" class="subscribe-dismiss-link" data-action="already-subscribed">I already subscribed</button>
          <span class="subscribe-dismiss-sep" aria-hidden="true">·</span>
          <button type="button" class="subscribe-dismiss-link" data-action="not-now">Not now</button>
        </div>
      </div>

      <div class="subscribe-post subscribe-post--compact" data-subscribe-state="post" hidden>
        <div class="subscribe-success-icon subscribe-success-icon--compact" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div>
          <p class="subscribe-success-title subscribe-success-title--compact">Check your inbox</p>
          <p class="subscribe-success-body subscribe-success-body--compact">
            Confirmation link sent to <strong data-subscribe-email>your email</strong>.
            <button type="button" class="subscribe-success-retry" data-subscribe-retry>Use a different email</button>
          </p>
        </div>
      </div>

      {/* Dismissed state for compact variant. */}
      <div class="subscribe-dismissed subscribe-dismissed--compact" data-subscribe-state="dismissed" hidden>
        <p class="subscribe-dismissed-text" data-dismissed-text></p>
        <button type="button" class="subscribe-dismissed-undo" data-dismiss-undo>Undo</button>
      </div>
    </div>
  )}
</section>

<script is:inline define:vars={{ formId, statusId, variant }}>
  (function () {
    // Single localStorage key shared across all SubscribeSection instances
    // and the confirm/unsubscribe pages. See /privacy.
    //   - { status: 'confirmed', at }  → confirm.astro saw success
    //   - (absent)                     → not confirmed on this device
    //
    // Only written when the user clicks the confirmation link in their email.
    // Form submit alone does NOT set this — we don't hide the CTA until the
    // double-opt-in loop is complete.
    var STORAGE_KEY = 'nidhi-newsletter-subscription';

    function readState() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (parsed.status !== 'confirmed') return null;
        return parsed;
      } catch (_) {
        return null;
      }
    }
    function writeState(state) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (_) {}
    }
    function clearState() {
      try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
    }

    // ---- dismiss state (localStorage) ---------------------------------
    // Separate from subscription state. Dismiss is user-initiated ("I already
    // subscribed" or "Not now") and independent of whether they've actually
    // submitted the form on this device.
    var DISMISS_KEY = 'nidhi-newsletter-dismissed';
    var DISMISS_COOLDOWN_DAYS = 30;

    function readDismissState() {
      try {
        var raw = localStorage.getItem(DISMISS_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (parsed.type === 'permanent') return parsed;
        if (parsed.type === 'timed' && typeof parsed.until === 'number') {
          if (Date.now() < parsed.until) return parsed;
          // Cooldown expired — clean up the stale entry so the form
          // reappears on next paint.
          try { localStorage.removeItem(DISMISS_KEY); } catch (_) {}
          return null;
        }
        return null;
      } catch (_) {
        return null;
      }
    }

    function writeDismissState(type) {
      var state = { type: type, at: Date.now() };
      if (type === 'timed') {
        state.until = Date.now() + DISMISS_COOLDOWN_DAYS * 24 * 60 * 60 * 1000;
      }
      try { localStorage.setItem(DISMISS_KEY, JSON.stringify(state)); } catch (_) {}
    }

    function clearDismissState() {
      try { localStorage.removeItem(DISMISS_KEY); } catch (_) {}
    }

    var form = document.getElementById(formId);
    var status = document.getElementById(statusId);
    if (!form || !status) return;

    var section = form.closest('[data-variant]');
    var preEl   = section && section.querySelector('[data-subscribe-state="pre"]');
    var postEl  = section && section.querySelector('[data-subscribe-state="post"]');
    var emailEcho   = postEl && postEl.querySelector('[data-subscribe-email]');
    var retryBtn    = postEl && postEl.querySelector('[data-subscribe-retry]');
    var dismissedEl = section && section.querySelector('[data-subscribe-state="dismissed"]');

    var endpoint = form.getAttribute('data-endpoint') || '';
    var button = form.querySelector('button[type="submit"]');
    var input = form.querySelector('input[type="email"]');

    // Reentrancy guard. `button.disabled` already blocks clicks, but Enter-key
    // submits and programmatic `.submit()` calls can sneak past that, and we
    // never want to POST twice for the same user.
    var submitting = false;

    // SHA-256(lowercase-trimmed email), hex. Must match newsletter.gs's
    // distinctIdForEmail_() exactly — both normalise then hash so the
    // browser's posthog.identify(hash) aliases its anon distinct_id to the
    // same ID the Apps Script uses for server-side subscriber events. That
    // alias is what makes the blog_subscribe_submit → _pending →
    // _confirm_clicked → _confirmed funnel stitch in PostHog across the
    // client + server boundary. Falls back to null on older browsers
    // lacking crypto.subtle; identify is then skipped and the funnel
    // simply degrades to not stitching for that visitor.
    async function subscriberDistinctId(email) {
      try {
        if (!(window.crypto && window.crypto.subtle)) return null;
        var buf = new TextEncoder().encode(String(email).toLowerCase().trim());
        var digest = await window.crypto.subtle.digest('SHA-256', buf);
        var bytes = new Uint8Array(digest);
        var hex = '';
        for (var i = 0; i < bytes.length; i++) {
          var h = bytes[i].toString(16);
          hex += h.length === 1 ? '0' + h : h;
        }
        return hex;
      } catch (_) {
        return null;
      }
    }

    function setStatus(text, kind) {
      status.textContent = text;
      status.className = 'subscribe-status subscribe-status--' + kind;
    }

    // Single source of truth for which panel is visible. Called on first
    // paint and whenever external state could have changed (bfcache restore,
    // another tab updating localStorage). Keeps the UI honest even if the
    // browser restored a stale DOM (e.g. a disabled "Sending…" button from
    // a mid-flight submit before the user hit back).
    function applyState() {
      var state = readState();
      if (state) {
        // Confirmed subscriber — hide the CTA everywhere.
        if (section) section.hidden = true;
        return;
      }

      var dismiss = readDismissState();
      if (dismiss) {
        // User explicitly dismissed the CTA. Show a minimal confirmation
        // instead of the form so they know their choice was registered.
        if (section) section.hidden = false;
        if (preEl)  preEl.hidden = true;
        if (postEl) postEl.hidden = true;
        if (dismissedEl) {
          dismissedEl.hidden = false;
          var textEl = dismissedEl.querySelector('[data-dismissed-text]');
          if (textEl) {
            textEl.textContent = dismiss.type === 'permanent'
              ? 'Thanks for subscribing! We won’t show this banner on this device again.'
              : 'We’ll check back later.';
          }
        }
        return;
      }

      // No subscription and no dismiss — show the form.
      if (section) section.hidden = false;
      if (postEl) postEl.hidden = true;
      if (dismissedEl) dismissedEl.hidden = true;
      if (preEl)  preEl.hidden = false;
      setStatus('', 'idle');
      if (button) { button.disabled = false; button.textContent = 'Subscribe'; }
      submitting = false;
    }

    // In-session success view. We still show the "Check your inbox" panel
    // on the page the user just submitted from, even though applyState()
    // would hide the whole section on any subsequent load — the immediate
    // feedback is important, the persistent "shut up about subscribing"
    // behavior kicks in on next navigation.
    function showSuccessInSession(email) {
      if (emailEcho) emailEcho.textContent = email;
      if (preEl)  preEl.hidden = true;
      if (dismissedEl) dismissedEl.hidden = true;
      if (postEl) postEl.hidden = false;
      // Move focus so screen readers announce the new panel.
      if (postEl) {
        postEl.setAttribute('tabindex', '-1');
        try { postEl.focus({ preventScroll: false }); } catch (_) {}
      }
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        // "Try a different email" means the user didn't actually want the
        // address they just typed. Clear the persisted flag too — otherwise
        // the form stays hidden on every other page and they can't recover.
        clearState();
        applyState();
        if (input) { try { input.focus(); } catch (_) {} }
        if (window.posthog) window.posthog.capture('blog_subscribe_retry_clicked', { variant: variant });
      });
    }

    // ---- dismiss link handlers ------------------------------------------
    var dismissLinks = section ? section.querySelectorAll('[data-action]') : [];
    for (var di = 0; di < dismissLinks.length; di++) {
      dismissLinks[di].addEventListener('click', function () {
        var action = this.getAttribute('data-action');
        if (action === 'already-subscribed') {
          writeDismissState('permanent');
          if (window.posthog) window.posthog.capture('blog_subscribe_dismissed', { action: 'already_subscribed', variant: variant });
        } else if (action === 'not-now') {
          writeDismissState('timed');
          if (window.posthog) window.posthog.capture('blog_subscribe_dismissed', { action: 'not_now', variant: variant });
        }
        applyState();
      });
    }

    // ---- undo dismiss ---------------------------------------------------
    var undoBtn = section && section.querySelector('[data-dismiss-undo]');
    if (undoBtn) {
      undoBtn.addEventListener('click', function () {
        clearDismissState();
        applyState();
        if (input) { try { input.focus(); } catch (_) {} }
        if (window.posthog) window.posthog.capture('blog_subscribe_dismiss_undo', { variant: variant });
      });
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (submitting) return;
      var email = (input && input.value || '').trim();
      if (!email) return;

      // Unconfigured (local preview or misconfigured prod): surface a
      // dev-visible warning but never silently "succeed" so we don't
      // mislead the user into thinking they're subscribed.
      if (!endpoint) {
        console.warn('[SubscribeSection] PUBLIC_NEWSLETTER_ENDPOINT is not set. Submissions are no-ops.');
        setStatus('Subscriptions are not configured yet. Check back soon, or grab the RSS feed.', 'error');
        return;
      }

      submitting = true;
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }
      setStatus('', 'idle');

      // Identify the browser's anon PostHog distinct_id to the server-side
      // subscriber ID *before* the first capture so this event and all
      // subsequent ones on this device get aliased to the same ID the Apps
      // Script uses. Without this the funnel can't link submit → pending
      // → confirmed because each step carries a different distinct_id.
      var hashedId = await subscriberDistinctId(email);
      if (window.posthog) {
        if (hashedId) {
          try { window.posthog.identify(hashedId); } catch (_) {}
        }
        var domain = email.split('@')[1] || '';
        window.posthog.capture('blog_subscribe_submit', {
          email_domain: domain,
          source: window.location.pathname,
          variant: variant,
        });
      }

      var body = new URLSearchParams();
      body.set('action', 'subscribe');
      body.set('email', email);
      body.set('source', window.location.pathname);

      // Apps Script web apps don't set CORS headers, so we POST with
      // mode: 'no-cors'. We can't read the response, but we also don't
      // need to — the Apps Script always replies with a confirmation
      // email on any valid submission, so the UX message is the same
      // either way: "check your inbox to confirm".
      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      }).then(function () {
        // Clear any prior dismiss — an actual subscribe beats "not now."
        // We do NOT write subscription state here. The CTA stays visible
        // until the user clicks the confirmation link in their email
        // (handled by confirm.astro), which is the only place that sets
        // status:'confirmed' and hides the CTA across the site.
        clearDismissState();
        form.reset();
        submitting = false;
        showSuccessInSession(email);
        if (window.posthog) {
          window.posthog.capture('blog_subscribe_sent', { variant: variant });
        }
      }).catch(function () {
        submitting = false;
        setStatus('Something went wrong. Please try again in a moment.', 'error');
        if (button) { button.disabled = false; button.textContent = 'Subscribe'; }
      });
    });

    // bfcache: hitting back after submitting can restore the DOM with the
    // button stuck disabled as "Sending…" or the success panel showing the
    // previous email. Re-derive visibility from localStorage so whatever
    // the browser restored is overridden by actual state.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) applyState();
    });

    // Cross-tab sync: if a user subscribes / confirms / unsubscribes in
    // another tab, this tab's CTA should update without a reload.
    // The `storage` event only fires in *other* tabs for the origin that
    // wrote the change, which is exactly the behavior we want.
    window.addEventListener('storage', function (e) {
      if (e.key === STORAGE_KEY || e.key === DISMISS_KEY || e.key === null /* storage cleared */) {
        applyState();
      }
    });

    // Initial paint. Runs synchronously before first paint in normal
    // parsing order, so users already subscribed don't see a flash of
    // the form before it's hidden.
    applyState();
  })();
</script>

<style>
  /* --- Shared ------------------------------------------------------ */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .subscribe-form { max-width: 420px; margin: 0; }
  .subscribe-form--compact { max-width: none; margin: 0; flex: 1; min-width: 0; }

  .subscribe-input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  @media (min-width: 480px) {
    .subscribe-input-group { flex-direction: row; }
  }

  .subscribe-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
  }
  .subscribe-input::placeholder { color: var(--color-text-muted); }
  .subscribe-input:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 0; }

  .subscribe-button {
    padding: var(--space-3) var(--space-5);
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease, opacity 0.15s ease;
    white-space: nowrap;
  }
  .subscribe-button:hover:not(:disabled) { background: var(--color-cta-bg-hover); }
  .subscribe-button:active:not(:disabled) { transform: translateY(1px); }
  .subscribe-button:disabled { opacity: 0.6; cursor: wait; }
  .subscribe-button:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .subscribe-status {
    font-size: 0.85rem;
    margin: var(--space-2) 0 0;
    min-height: 1.2em;
  }
  .subscribe-status--success { color: var(--color-teal); }
  .subscribe-status--error { color: var(--status-error-light); }
  .subscribe-status--idle { color: var(--color-text-muted); }

  /* --- Full variant (end of blog post) ----------------------------- */
  .subscribe--full { margin-top: var(--space-10); padding: var(--space-8) 0; border-top: 1px solid var(--color-border-light); }
  .subscribe--full .subscribe-box {
    background: var(--color-callout-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5);
    text-align: center;
  }
  @media (min-width: 640px) {
    .subscribe--full .subscribe-box { padding: var(--space-8); }
  }
  .subscribe--full .subscribe-form { margin: 0 auto; }
  .subscribe-title { font-size: 1.25rem; color: white; margin-bottom: var(--space-2); font-weight: 600; }
  .subscribe-text { color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; margin-bottom: var(--space-5); line-height: 1.5; }
  .subscribe--full .subscribe-input { border-color: transparent; }
  .subscribe-privacy {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    margin: var(--space-3) 0 0;
  }
  .subscribe-privacy a { color: white; text-decoration: underline; }
  .subscribe-privacy a:hover { color: rgba(255, 255, 255, 0.9); }
  .subscribe--full .subscribe-status { color: rgba(255, 255, 255, 0.85); }
  .subscribe--full .subscribe-status--success { color: var(--status-success-on-dark); }
  .subscribe--full .subscribe-status--error { color: var(--status-error-on-dark); }

  /* --- Compact variant (top of blog index) ------------------------- */
  .subscribe--compact {
    margin: 0 auto var(--space-8);
    max-width: var(--max-width);
    padding: var(--space-4) var(--space-5);
    background: var(--color-border-light);
    border-radius: var(--radius-md);
  }
  .subscribe-compact-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .subscribe-compact-label {
    font-weight: 600;
    color: var(--color-deep-blue);
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .subscribe-form--compact .subscribe-input-group { margin-bottom: 0; }
  .subscribe-rss {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-text-muted);
    flex-shrink: 0;
  }
  .subscribe-rss:hover { color: var(--color-deep-blue); border-bottom-color: var(--color-deep-blue); }
  @media (max-width: 640px) {
    .subscribe-compact-row { flex-direction: column; align-items: stretch; }
    .subscribe-compact-label { text-align: center; }
    .subscribe-rss { text-align: center; }
  }

  /* --- Post-submit success card ----------------------------------- */
  /* Replaces the form entirely so the user can't miss that the next
     step is in their inbox. Mirrors the visual weight of the form so
     layout doesn't jump. */
  .subscribe-post { text-align: center; }
  .subscribe-post:focus { outline: none; }

  /* `display: flex` on .subscribe-post--compact below (and any future
     non-block display we add) beats the browser's default
     [hidden] { display: none }, which would leave both the form AND the
