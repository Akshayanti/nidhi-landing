---
import { DEFAULT_LOCALE, dict, localizedPath, type Locale } from '../i18n';
import consentRuntimeScript from '../utils/shared/consentRuntime.js?raw';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
---

<div id="cookie-overlay" class="cookie-overlay" role="dialog" aria-label={strings.cookie.dialogLabel} aria-describedby="cookie-text cookie-planner" aria-modal="true">
  <div class="cookie-modal">
    <p id="cookie-text" class="cookie-text">
      {strings.cookie.textBefore}<em>{strings.cookie.textEmphasis}</em>{strings.cookie.textAfter}
    </p>
    <p id="cookie-planner" class="cookie-text">{strings.cookie.planner}</p>
    <p class="cookie-sub">
      <a href={localizedPath(locale, '/privacy/')} data-attr="cookie-privacy-link">{strings.cookie.privacyLink}</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="btn btn--outline" data-attr="cookie-decline">{strings.cookie.decline}</button>
      <button id="cookie-accept" class="btn btn--outline" data-attr="cookie-accept">{strings.cookie.accept}</button>
    </div>
  </div>
</div>

<script is:inline set:html={consentRuntimeScript}></script>
<script is:inline>
  (function() {
    var overlay = document.getElementById('cookie-overlay');
    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');
    var focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    var previousFocus = null;

    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      var focusable = overlay.querySelectorAll(focusableSelector);
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    function openConsent() {
      previousFocus = document.activeElement;
      overlay.style.display = 'flex';
      requestAnimationFrame(function() { overlay.classList.add('cookie-overlay--visible'); });
      document.addEventListener('keydown', trapFocus);
      // Focus the less-destructive button first, without scrolling: at large
      // text sizes the prompt scrolls inside, and it must open at its first line.
      declineBtn.focus({ preventScroll: true });
      var modal = overlay.querySelector('.cookie-modal');
      if (modal) modal.scrollTop = 0;
    }

    function closeConsent(choice) {
      window.nidhiConsent.save(choice);
      // Close first, so the prompt can never get stuck open.
      overlay.style.display = 'none';
      overlay.classList.remove('cookie-overlay--visible');
      // Apply the choice to the running SDK straight away, both ways
      // (Analytics.astro): a "No thanks" after an earlier "Sure" switches click
      // recording off and stops storing the visitor ID for the rest of this
      // visit too.
      window.nidhiConsent.apply();
      document.removeEventListener('keydown', trapFocus);
      // Return focus to the element that was focused before the overlay opened
      if (previousFocus) { try { previousFocus.focus(); } catch (_) {} }
    }

    acceptBtn.addEventListener('click', function() { closeConsent('accepted'); });
    declineBtn.addEventListener('click', function() { closeConsent('declined'); });

    // "Cookie settings" in the footer reopens this prompt, so a choice can be
    // changed as easily as it was made.
    document.addEventListener('click', function(e) {
      var trigger = e.target && e.target.closest && e.target.closest('[data-cookie-settings]');
      if (!trigger) return;
      e.preventDefault();
      openConsent();
    });

    var consent = window.nidhiConsent.read();
    if (consent === 'accepted' || consent === 'declined') {
      overlay.style.display = 'none';
      return;
    }
    openConsent();
  })();
</script>

<style is:global>
  .cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.5);
    align-items: safe center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cookie-overlay--visible {
    opacity: 1;
  }

  .cookie-modal {
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 420px;
    width: 100%;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    margin: auto;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  /* Prose reads from a straight edge; only the link and the buttons stay centred. */
  .cookie-text {
    text-align: start;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cookie-text em {
    font-style: italic;
    color: var(--color-deep-blue);
  }

  .cookie-sub {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .cookie-sub a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-sub a:hover {
    color: var(--color-teal-dark);
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* The shared .btn roles (docs/color-palette.md, "Buttons"). Declining is as
     easy to see as accepting: the two are the same width, height and weight. */
  .cookie-actions .btn {
    flex: 1 1 10rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .cookie-modal {
      padding: 1.5rem 1rem;
    }
  }
</style>
