---
---

<div id="cookie-overlay" class="cookie-overlay" role="dialog" aria-label="Cookie consent" aria-modal="true">
  <div class="cookie-modal">
    <p class="cookie-text">
      We count anonymous pageviews either way, to see what&rsquo;s helping.
      Can we also record <em>clicks</em> so we can spot broken links and
      layouts that confuse people? No ads, no data sold.
    </p>
    <p class="cookie-sub">
      <a href="/privacy" data-attr="cookie-privacy-link">See what we actually collect &rarr;</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="cookie-btn cookie-btn--decline" data-attr="cookie-decline">No thanks</button>
      <button id="cookie-accept" class="cookie-btn cookie-btn--accept" data-attr="cookie-accept">Sure, that&rsquo;s fine</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var consent = localStorage.getItem('nidhi-cookie-consent');
    var overlay = document.getElementById('cookie-overlay');

    if (consent === 'accepted') {
      overlay.style.display = 'none';
      return;
    }
    if (consent === 'declined') {
      overlay.style.display = 'none';
      return;
    }

    overlay.style.display = 'flex';
    requestAnimationFrame(function() { overlay.classList.add('cookie-overlay--visible'); });

    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');
    var focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      var focusable = overlay.querySelectorAll(focusableSelector);
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    function closeConsent(choice) {
      localStorage.setItem('nidhi-cookie-consent', choice);
      if (choice === 'accepted' && window.posthog) {
        posthog.set_config({ autocapture: true, enable_heatmaps: true });
      }
      overlay.style.display = 'none';
      document.removeEventListener('keydown', trapFocus);
      // Return focus to the element that was focused before the overlay opened
      if (previousFocus) { try { previousFocus.focus(); } catch (_) {} }
    }

    var previousFocus = document.activeElement;
    acceptBtn.addEventListener('click', function() { closeConsent('accepted'); });
    declineBtn.addEventListener('click', function() { closeConsent('declined'); });
    document.addEventListener('keydown', trapFocus);
    // Focus the less-destructive button first
    declineBtn.focus();
  })();
</script>

<style is:global>
  .cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cookie-overlay--visible {
    opacity: 1;
  }

  .cookie-modal {
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .cookie-text {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cookie-text em {
    font-style: italic;
    color: var(--color-deep-blue);
  }

  .cookie-sub {
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .cookie-sub a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-sub a:hover {
    color: var(--color-teal-dark);
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }

  .cookie-btn {
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s;
  }

  .cookie-btn:hover {
    opacity: 0.85;
  }

  .cookie-btn:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .cookie-btn--accept {
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
  }
  .cookie-btn--accept:hover { background: var(--color-cta-bg-hover); }

  .cookie-btn--decline {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-light);
  }

  @media (max-width: 640px) {
    .cookie-modal {
      padding: 1.5rem 1rem;
    }
  }
</style>
