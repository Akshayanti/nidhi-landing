---
import { DEFAULT_LOCALE, dict, localizedPath, type Locale } from '../i18n';
import consentPromptScript from '../utils/shared/consentPrompt.js?raw';
import consentRuntimeScript from '../utils/shared/consentRuntime.js?raw';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
---

<div id="cookie-overlay" class="cookie-overlay" role="dialog" aria-label={strings.cookie.dialogLabel} aria-describedby="cookie-text cookie-planner" aria-modal="true">
  <div class="cookie-modal">
    <p id="cookie-text" class="cookie-text">
      {strings.cookie.textBefore}<em>{strings.cookie.textEmphasis}</em>{strings.cookie.textAfter}
    </p>
    <p id="cookie-planner" class="cookie-text">{strings.cookie.planner}</p>
    <p class="cookie-sub">
      <a href={localizedPath(locale, '/privacy/')} data-attr="cookie-privacy-link">{strings.cookie.privacyLink}</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="btn btn--outline" data-attr="cookie-decline">{strings.cookie.decline}</button>
      <button id="cookie-accept" class="btn btn--outline" data-attr="cookie-accept">{strings.cookie.accept}</button>
    </div>
  </div>
</div>

<script is:inline set:html={consentRuntimeScript}></script>
<script is:inline set:html={consentPromptScript}></script>

<style is:global>
  .cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-dialog);
    background: rgba(0, 0, 0, 0.5);
    align-items: safe center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cookie-overlay--visible {
    opacity: 1;
  }

  .cookie-modal {
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 420px;
    width: 100%;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: auto;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  /* Prose reads from a straight edge; only the link and the buttons stay centred. */
  .cookie-text {
    text-align: start;
    margin: 0 0 0.5rem;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cookie-text em {
    font-style: italic;
    color: var(--color-deep-blue);
  }

  .cookie-sub {
    margin: 0 0 1.25rem;
    font-size: var(--text-caption);
    line-height: 1.4;
  }

  .cookie-sub a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-sub a:hover {
    color: var(--color-teal-dark);
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* The shared .btn roles (docs/color-palette.md, "Buttons"). Declining is as
     easy to see as accepting: the two are the same width, height and weight. */
  .cookie-actions .btn {
    flex: 1 1 10rem;
    font-weight: 700;
  }

  @media (width < 640px) {
    .cookie-modal {
      padding: 1.5rem 1rem;
    }
  }
</style>
