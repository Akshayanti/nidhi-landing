---

<div id="cookie-overlay" class="cookie-overlay" role="dialog" aria-label="Cookie consent" aria-modal="true">
  <div class="cookie-modal">
    <p class="cookie-text">Can we spot broken links and confusing navigation so we can fix them for you? No ads, no personal data sold</p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="cookie-btn cookie-btn--decline" data-attr="cookie-decline">No thanks</button>
      <button id="cookie-accept" class="cookie-btn cookie-btn--accept" data-attr="cookie-accept">Sure, that's fine</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var consent = localStorage.getItem('nidhi-cookie-consent');
    var overlay = document.getElementById('cookie-overlay');

    if (consent === 'accepted') {
      overlay.style.display = 'none';
      return;
    }
    if (consent === 'declined') {
      overlay.style.display = 'none';
      return;
    }

    overlay.style.display = 'flex';
    requestAnimationFrame(function() { overlay.classList.add('cookie-overlay--visible'); });

    document.getElementById('cookie-accept').addEventListener('click', function() {
      localStorage.setItem('nidhi-cookie-consent', 'accepted');
      // Enable heatmaps and autocapture for this session
      if (window.posthog) {
        posthog.set_config({ autocapture: true, enable_heatmaps: true });
      }
      overlay.style.display = 'none';
    });

    document.getElementById('cookie-decline').addEventListener('click', function() {
      localStorage.setItem('nidhi-cookie-consent', 'declined');
      overlay.style.display = 'none';
    });
  })();
</script>

<style is:global>
  .cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cookie-overlay--visible {
    opacity: 1;
  }

  .cookie-modal {
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .cookie-text {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }

  .cookie-btn {
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s;
  }

  .cookie-btn:hover {
    opacity: 0.85;
  }

  .cookie-btn--accept {
    background: var(--color-teal);
    color: #fff;
  }

  .cookie-btn--decline {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-light);
  }

  @media (max-width: 640px) {
    .cookie-modal {
      padding: 1.5rem 1rem;
    }
  }
</style>
