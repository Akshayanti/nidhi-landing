---
import { DEFAULT_LOCALE, dict, localizedPath, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
---

<div id="cookie-overlay" class="cookie-overlay" role="dialog" aria-label={strings.cookie.dialogLabel} aria-modal="true">
  <div class="cookie-modal">
    <p class="cookie-text">
      {strings.cookie.textBefore}<em>{strings.cookie.textEmphasis}</em>{strings.cookie.textAfter}
    </p>
    <p class="cookie-sub">
      <a href={localizedPath(locale, '/privacy/')} data-attr="cookie-privacy-link">{strings.cookie.privacyLink}</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="cookie-btn cookie-btn--decline" data-attr="cookie-decline">{strings.cookie.decline}</button>
      <button id="cookie-accept" class="cookie-btn cookie-btn--accept" data-attr="cookie-accept">{strings.cookie.accept}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var overlay = document.getElementById('cookie-overlay');
    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');
    var focusableSelector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    var previousFocus = null;

    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      var focusable = overlay.querySelectorAll(focusableSelector);
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    function openConsent() {
      previousFocus = document.activeElement;
      overlay.style.display = 'flex';
      requestAnimationFrame(function() { overlay.classList.add('cookie-overlay--visible'); });
      document.addEventListener('keydown', trapFocus);
      // Focus the less-destructive button first
      declineBtn.focus();
    }

    function closeConsent(choice) {
      try { localStorage.setItem('nidhi-cookie-consent', choice); } catch (_) {}
      // Close first, so the prompt can never get stuck open.
      overlay.style.display = 'none';
      overlay.classList.remove('cookie-overlay--visible');
      // Apply the choice to the running SDK straight away, both ways: a
      // "No thanks" after an earlier "Sure" switches click recording off for
      // the rest of this visit too. Before the SDK finishes loading (or when a
      // blocker stops it), posthog is a stub without set_config;
      // Analytics.astro reads the stored choice when it starts.
      if (window.posthog && typeof window.posthog.set_config === 'function') {
        var on = choice === 'accepted';
        // Heatmaps stay off while the learning path's level helper is open.
        window.posthog.set_config({ autocapture: on, enable_heatmaps: on && !window.nidhiHeatmapsPaused, capture_dead_clicks: on });
      }
      document.removeEventListener('keydown', trapFocus);
      // Return focus to the element that was focused before the overlay opened
      if (previousFocus) { try { previousFocus.focus(); } catch (_) {} }
    }

    acceptBtn.addEventListener('click', function() { closeConsent('accepted'); });
    declineBtn.addEventListener('click', function() { closeConsent('declined'); });

    // "Cookie settings" in the footer reopens this prompt, so a choice can be
    // changed as easily as it was made.
    document.addEventListener('click', function(e) {
      var trigger = e.target && e.target.closest && e.target.closest('[data-cookie-settings]');
      if (!trigger) return;
      e.preventDefault();
      openConsent();
    });

    var consent = null;
    try { consent = localStorage.getItem('nidhi-cookie-consent'); } catch (_) {}
    if (consent === 'accepted' || consent === 'declined') {
      overlay.style.display = 'none';
      return;
    }
    openConsent();
  })();
</script>

<style is:global>
  .cookie-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cookie-overlay--visible {
    opacity: 1;
  }

  .cookie-modal {
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .cookie-text {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cookie-text em {
    font-style: italic;
    color: var(--color-deep-blue);
  }

  .cookie-sub {
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .cookie-sub a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-sub a:hover {
    color: var(--color-teal-dark);
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }

  .cookie-btn {
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s;
  }

  .cookie-btn:hover {
    opacity: 0.85;
  }

  .cookie-btn:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .cookie-btn--accept {
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
  }
  .cookie-btn--accept:hover { background: var(--color-cta-bg-hover); }

  .cookie-btn--decline {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-light);
  }

  @media (max-width: 640px) {
    .cookie-modal {
      padding: 1.5rem 1rem;
    }
  }
</style>
