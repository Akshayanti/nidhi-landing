---
/**
 * The cookie prompt: a sheet at the bottom of the screen that leaves the page
 * readable and scrollable (#399). Its behaviour is in consentPrompt.js; the
 * "Cookie choices" link that leads to it sits right after "Skip to content"
 * (BaseLayout.astro), and the sheet itself comes after the footer, so the
 * page reads in its usual order. The text and the two answers are the same
 * as when it was a dialog; "No thanks" comes first, and the two buttons look
 * the same.
 */
import { DEFAULT_LOCALE, dict, localizedPath, type Locale } from '../i18n';
import consentPromptScript from '../utils/shared/consentPrompt.js?raw';
import consentRuntimeScript from '../utils/shared/consentRuntime.js?raw';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
---

<section id="cookie-sheet" class="cookie-sheet" role="region" aria-labelledby="cookie-title" hidden>
  <h2 id="cookie-title" class="cookie-title">{strings.cookie.title}</h2>
  <p id="cookie-text" class="cookie-text">
    {strings.cookie.textBefore}<em>{strings.cookie.textEmphasis}</em>{strings.cookie.textAfter}
  </p>
  <p id="cookie-planner" class="cookie-text">{strings.cookie.planner}</p>
  <div class="cookie-actions">
    <button type="button" id="cookie-decline" class="btn btn--outline" data-attr="cookie-decline">{strings.cookie.decline}</button>
    <button type="button" id="cookie-accept" class="btn btn--outline" data-attr="cookie-accept">{strings.cookie.accept}</button>
  </div>
  <p class="cookie-sub">
    <a href={localizedPath(locale, '/privacy/')} data-attr="cookie-privacy-link">{strings.cookie.privacyLink}</a>
  </p>
</section>

<script is:inline set:html={consentRuntimeScript}></script>
<script is:inline set:html={consentPromptScript}></script>

<style is:global>
  /* Phones: the full width of the screen, on its bottom edge. Below the
     header in the stacking order (--z-header), so the header and its menu
     are never covered, and above the lesson index button (--z-header - 10). */
  .cookie-sheet {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: calc(var(--z-header) - 5);
    box-sizing: border-box;
    /* Never more than 45% of the screen, and never higher than the space
       below the header, which consentPrompt.js measures. One scroll area
       holds everything, and it opens at its first line; the two answers
       stay at its bottom edge (.cookie-actions, below). */
    max-height: min(45dvh, var(--cookie-room, 45dvh));
    overflow-y: auto;
    overscroll-behavior: contain;
    /* A control scrolled into view by focus keeps its whole focus ring. */
    scroll-padding-block: 8px;
    padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
  }

  /* On a phone, 39%: the home page's two buttons then stay clear of it on a
     320 by 568 px screen in every language. Only while the screen is tall
     for its text (in rem, like the pinned answers below): with the text made
     much larger the sheet keeps its 45%, where every pixel is needed (#769). */
  @media (height >= 30rem) and (width < 48rem) {
    .cookie-sheet {
      max-height: min(39dvh, var(--cookie-room, 39dvh));
    }
  }

  .cookie-sheet[hidden] {
    display: none;
  }

  /* Wider screens: a card in the bottom corner, so most of the page stays
     clear. In rem, so with the text made larger the sheet keeps the full
     width, where the text has the most room. */
  @media (width >= 48rem) {
    .cookie-sheet {
      inset-inline: auto 1rem;
      bottom: 1rem;
      width: min(32rem, 100% - 2rem);
      max-height: min(45dvh, var(--cookie-room, 45dvh) - 1rem);
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }
  }

  /* While the sheet is open, the page keeps room for it at the bottom, so
     its end can be scrolled above the sheet and a focused element is not
     hidden behind it. On a page with the site footer the room is the
     footer's own bottom padding (Footer.astro), so the page ends in the
     footer's colour; only a page without it pads the body. */
  html.cookie-open body:not(:has(.site-footer)) {
    padding-bottom: var(--cookie-space, 0px);
  }

  html.cookie-open {
    scroll-padding-bottom: var(--cookie-space, 0px);
  }

  .cookie-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-lead);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--color-deep-blue);
  }

  /* The words a reader answers on are body size, not small print. */
  .cookie-text {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
    overflow-wrap: break-word;
  }

  .cookie-text em {
    font-style: italic;
    color: var(--color-deep-blue);
  }

  .cookie-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-3) 0;
  }

  /* The two answers stay in view while the words above them scroll: on a
     phone the sheet is shorter than its text, and an answer should not have
     to be looked for. Only while the screen is tall enough for the text to
     keep most of the sheet (in rem, so with the text made much larger the
     answers scroll with it again and never fill the sheet). */
  @media (height >= 30rem) {
    .cookie-actions {
      position: sticky;
      bottom: calc(-1 * (var(--space-4) + env(safe-area-inset-bottom, 0px)));
      z-index: 1;
      margin-block: 0;
      padding-block: var(--space-3);
      background: var(--color-bg-white);
      /* Words cut off above the answers read as "more above". */
      border-top: 1px solid var(--color-border);
    }
  }

  /* The shared .btn roles (docs/color-palette.md, "Buttons"). Declining is as
     easy to see as accepting: the two are the same width, height and weight,
     and they stack when they do not fit side by side. Side by side down to
     a 320 px phone, where a longer label takes two lines: stacked, they
     left two lines of the question showing above them. */
  .cookie-actions .btn {
    flex: 1 1 8rem;
    min-width: 0;
    /* The top and bottom padding stops at 10px: growing with the text, it
       made "No thanks" taller than the sheet on a small phone at 400%, with
       its focus ring cut off. */
    padding-block: min(0.625rem, 10px);
    font-weight: 700;
    white-space: normal;
  }

  .cookie-sub {
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .cookie-sub a {
    color: var(--color-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-sub a:hover {
    color: var(--color-teal-dark);
  }
</style>
