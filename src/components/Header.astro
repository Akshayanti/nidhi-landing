---
import ThemeToggle from './ThemeToggle.astro';
import LangPicker from './LangPicker.astro';
import LogoMark from './LogoMark.astro';
import { DEFAULT_LOCALE, LOCALES, dict, localePrefix, localizedPath, stripLocale, type Locale } from '../i18n';
import { isMonteCarloReleased } from '../utils/monte-carlo/release.ts';
import { DESKTOP_DROPDOWNS, navGroups, navHref, navLabel, type NavGroup, type NavLink } from './nav.ts';

interface Props {
  locale?: Locale;
  /**
   * The locales this page exists in, including this one. A language picker is
   * offered only when there is another one, so a page with nothing to switch
   * to carries no control. Defaults to this page's own language: see
   * `BaseLayout` props.
   */
  alternates?: readonly Locale[];
}

const { locale = DEFAULT_LOCALE, alternates = [locale] } = Astro.props;

const strings = dict(locale);
const currentPath = Astro.url.pathname;
const showMonteCarlo = await isMonteCarloReleased();
const groups = navGroups({ showMonteCarlo });

// The desktop nav's two dropdowns, in the desktop nav's order.
const dropdowns = DESKTOP_DROPDOWNS.map((key) => groups.find((group) => group.key === key)).filter(
  (group): group is NavGroup => group !== undefined,
);

// Usually one; more if a third language ever lands.
const otherLocales = alternates.filter((other) => other !== locale);

/** Localizes a header link, leaving addresses that leave the site alone. */
const href = (path: string) => navHref(locale, path);

// A nav entry is compared against the path without the locale prefix, so the
// same entry is current on /blog/ and on /hi/blog/. `href` above is the
// localized address, which only the rendered link needs.
const barePath = stripLocale(currentPath).path;

/** Whether a desktop dropdown entry is the page you are on. */
const isMenuActive = (entry: NavLink) =>
  entry.activePrefix ? barePath.startsWith(entry.activePrefix) : barePath === entry.href;

/**
 * Whether a sheet entry is the page you are on. The sheet marks on an exact
 * match only, where the dropdown above also marks a whole section, and so does
 * not use `isMenuActive`.
 */
const isSheetActive = (path: string) => barePath === path;

// What the inline script below needs to rebuild a switcher's href from the
// live address: the locale prefixes, so it can move a path between them.
const prefixes: Record<string, string> = {};
for (const l of LOCALES) prefixes[l] = localePrefix(l);
---

<header class="site-header">
  <nav class="site-nav container container--wide" aria-label={strings.nav.primaryLabel}>
    <a href={href('/')} class="logo" data-attr="nav-logo" aria-label={strings.nav.homeLabel}>
      <LogoMark size={32} />
      <span class="logo-text">nidhi</span>
    </a>
    <div class="nav-right">
      {dropdowns.map((group) => (
        <div class="nav-dropdown">
          <button
            class:list={['nav-link', 'nav-dropdownToggle', { active: barePath.startsWith(group.button.activePath) }]}
            aria-haspopup="true"
            aria-expanded="false"
            data-attr={group.button.attr}
          >
            {strings.nav.buttons[group.button.key]}
            <span class="nav-dropdownCaret" aria-hidden="true">&#9662;</span>
          </button>
          <ul class="nav-dropdownMenu" role="menu">
            {group.entries.map((entry) => (
              'children' in entry ? null : (
                <>
                  {entry.dividerBefore && <li role="none" class="nav-dropdownDivider" aria-hidden="true"></li>}
                  <li role="none">
                    <a
                      href={href(entry.href)}
                      class:list={[{ active: isMenuActive(entry) }]}
                      role="menuitem"
                      data-attr={`nav-${entry.attr}`}
                    >
                      {navLabel(strings, entry.key, 'menu')}
                    </a>
                  </li>
                </>
              )
            ))}
          </ul>
        </div>
      ))}
      {otherLocales.length > 0 && (
        <LangPicker locale={locale} alternates={alternates} variant="header" />
      )}
      <ThemeToggle locale={locale} />
      <button
        type="button"
        class="nav-menuToggle"
        aria-expanded="false"
        aria-controls="nav-sheet"
        aria-label={strings.nav.menuLabel}
        data-attr="nav-menu"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="nav-menuIcon-open" d="M4 7h16M4 12h16M4 17h16" />
          <path class="nav-menuIcon-close" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  {/* Phones only: the site's links in one panel under the header, in place
      of the dropdown, the Learn link and the footer's link columns. */}
  <div class="nav-sheet" id="nav-sheet" hidden>
    <nav class="container container--wide nav-sheetInner" aria-label={strings.nav.menuLabel}>
      {groups.map((group) => (
        <div class="nav-sheetGroup">
          <p class="nav-sheetHeading">{strings.nav.groups[group.key]}</p>
          <ul role="list">
            {group.entries.map((entry) => (
              <li>
                {'children' in entry ? (
                  <details class="nav-sheetSub">
                    <summary data-attr={`nav-menu-${entry.attr}`}>{navLabel(strings, entry.key)}</summary>
                    <ul role="list" class="nav-contactTiles">
                      {entry.children.map((child) => (
                        <li>
                          <a
                            href={href(child.href)}
                            class={`nav-contactTile nav-contactTile--${child.icon}`}
                            target={child.external ? '_blank' : undefined}
                            rel={child.external ? 'noopener noreferrer' : undefined}
                            data-attr={`nav-menu-${child.attr}`}
                          >
                            <span class="nav-contactIcon" aria-hidden="true">
                              {child.icon === 'mail' && (
                                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
                              )}
                              {child.icon === 'instagram' && (
                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
                              )}
                            </span>
                            <span class="nav-contactText">
                              <span class="nav-contactLabel">{navLabel(strings, child.key)}</span>
                              <span class="nav-contactDetail">{child.detail}</span>
                            </span>
                            <span class="nav-contactGo" aria-hidden="true">{child.external ? '↗' : '→'}</span>
                            {child.external && <span class="nav-srOnly">{strings.nav.newTabHint}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={href(entry.href)}
                    class:list={[{ active: isSheetActive(entry.href) }]}
                    aria-current={isSheetActive(entry.href) ? 'page' : undefined}
                    data-attr={`nav-menu-${entry.attr}`}
                  >{navLabel(strings, entry.key)}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
      {/* The header's picker is hidden below 640px, so the sheet carries the
          same choice as a list. Its heading is the nav group heading, which is
          why the picker itself renders only the rows. */}
      {otherLocales.length > 0 && (
        <div class="nav-sheetGroup">
          <p class="nav-sheetHeading">{strings.nav.groups.language}</p>
          <LangPicker locale={locale} alternates={alternates} variant="sheet" />
        </div>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-white);
    border-bottom: 1px solid var(--color-border-light);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-deep-blue);
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdownToggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    /* 24px tall at least: WCAG 2.2 minimum target size. */
    min-height: 24px;
  }

  .nav-dropdownCaret {
    font-size: 0.65rem;
    transition: transform 0.15s ease;
  }

  .nav-dropdown:hover .nav-dropdownCaret,
  .nav-dropdown:focus-within .nav-dropdownCaret {
    transform: rotate(180deg);
  }

  .nav-dropdownMenu {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    list-style: none;
    padding: var(--space-1) 0;
    min-width: 220px;
    z-index: 200;
  }

  .nav-dropdown:hover .nav-dropdownMenu,
  .nav-dropdown:focus-within .nav-dropdownMenu {
    display: block;
  }

  .nav-dropdownMenu a {
    display: block;
    padding: 10px 16px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
    white-space: nowrap;
  }

  /* Hairline divider between specific tools and the "View all" entry. */
  .nav-dropdownDivider {
    height: 1px;
    background: var(--color-border-light);
    margin: var(--space-1) 0;
  }

  .nav-dropdownMenu a:hover,
  .nav-dropdownMenu a:focus-visible,
  .nav-dropdownMenu a.active {
    background: var(--color-bg);
    color: var(--color-deep-blue);
    outline: none;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-deep-blue);
    text-decoration: none;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 480px) {
    .nav-right { gap: var(--space-3); }
    .nav-link { font-size: 0.8rem; }
    .nav-dropdownMenu { right: -40px; min-width: 200px; }
  }

  /* Phone menu: hidden on wider screens, where the two dropdowns
     and the footer columns do the job. */
  .nav-menuToggle,
  .nav-sheet { display: none; }

  @media (max-width: 640px) {
    .nav-dropdown,
    .nav-right > .nav-link { display: none; }

    .nav-menuToggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      background: none;
      border: 0;
      border-radius: var(--radius-md);
      color: var(--color-deep-blue);
      cursor: pointer;
    }

    .nav-menuToggle:focus-visible {
      outline: 2px solid var(--color-teal);
      outline-offset: -2px;
    }

    .nav-menuIcon-close { display: none; }
    .nav-menuToggle[aria-expanded='true'] .nav-menuIcon-open { display: none; }
    .nav-menuToggle[aria-expanded='true'] .nav-menuIcon-close { display: block; }

    .nav-sheet:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      background: var(--color-bg-white);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
    }

    .nav-sheetInner {
      display: grid;
      gap: var(--space-5);
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
    }

    .nav-sheetHeading {
      margin: 0 0 var(--space-1);
      font-family: var(--font-heading);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .nav-sheetGroup ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-sheetGroup a {
      display: block;
      padding: 10px 0;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 1.02rem;
      color: var(--color-text-primary);
      text-decoration: none;
    }

    .nav-sheetGroup a.active { color: var(--color-deep-blue); }

    /* "Contact us": a row like the links around it that opens to show
       its own links, indented beneath it. */
    .nav-sheetSub > summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 1.02rem;
      color: var(--color-text-primary);
      list-style: none;
      cursor: pointer;
    }

    .nav-sheetSub > summary::-webkit-details-marker { display: none; }

    .nav-sheetSub > summary::after {
      content: '+' / '';
      font-size: 1.2rem;
      color: var(--color-teal);
    }

    .nav-sheetSub[open] > summary::after { content: '\2212' / ''; }

    .nav-sheetSub > summary:focus-visible {
      outline: 2px solid var(--color-teal);
      outline-offset: 2px;
      border-radius: 2px;
    }

    /* Contact tiles: an icon badge, the channel and its address, and an
       arrow saying where the tap goes. */
    .nav-contactTiles {
      display: grid;
      gap: 10px;
      padding: 4px 0 8px;
      animation: nav-contactIn 0.22s ease-out;
    }

    @keyframes nav-contactIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: none; }
    }

    .nav-sheetGroup a.nav-contactTile {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      padding: 12px 14px;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-bg);
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .nav-sheetGroup a.nav-contactTile:active { transform: scale(0.98); }

    .nav-contactTile--mail:hover,
    .nav-contactTile--mail:focus-visible { border-color: var(--color-teal); }

    .nav-contactTile--instagram:hover,
    .nav-contactTile--instagram:focus-visible { border-color: #dd2a7b; }

    .nav-contactIcon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }

    .nav-contactIcon svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .nav-contactTile--mail .nav-contactIcon {
      background: color-mix(in srgb, var(--color-teal) 16%, var(--color-bg-white));
      color: var(--color-teal);
    }

    /* Instagram's own gradient, so the tile reads as Instagram at a glance. */
    .nav-contactTile--instagram .nav-contactIcon {
      background: linear-gradient(45deg, #f58529 0%, #dd2a7b 50%, #8134af 80%, #515bd4 100%);
      color: #fff;
    }

    .nav-contactText {
      display: grid;
      min-width: 0;
    }

    .nav-contactLabel {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1rem;
      color: var(--color-text-primary);
    }

    .nav-contactDetail {
      font-family: var(--font-body, inherit);
      font-weight: 400;
      font-size: 0.88rem;
      color: var(--color-text-secondary);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav-contactGo {
      font-size: 1.15rem;
      color: var(--color-text-muted);
    }

    .nav-srOnly {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-contactTiles { animation: none; }
      .nav-sheetGroup a.nav-contactTile { transition: none; }
      .nav-sheetGroup a.nav-contactTile:active { transform: none; }
    }

    .nav-sheetGroup a:focus-visible {
      outline: 2px solid var(--color-teal);
      outline-offset: 2px;
      border-radius: 2px;
    }
  }

  /* JS-managed open state: ensures keyboard toggles also show the menu */
  .nav-dropdown--open .nav-dropdownMenu {
    display: block;
  }
</style>

<script is:inline define:vars={{ menuLabel: strings.nav.menuLabel, menuCloseLabel: strings.nav.menuCloseLabel }}>
  // Each dropdown (Free Tools, Learn) opens and closes on its own.
  document.querySelectorAll('.nav-dropdown').forEach(function(dropdown) {
    var toggle = dropdown.querySelector('.nav-dropdownToggle');
    var menu = dropdown.querySelector('.nav-dropdownMenu');
    if (!toggle || !menu) return;

    function openMenu() {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.parentElement.classList.add('nav-dropdown--open');
      document.addEventListener('click', onClickOutside);
      document.addEventListener('keydown', onMenuKeydown);
    }

    function closeMenu() {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.parentElement.classList.remove('nav-dropdown--open');
      document.removeEventListener('click', onClickOutside);
      document.removeEventListener('keydown', onMenuKeydown);
    }

    function isOpen() {
      return toggle.getAttribute('aria-expanded') === 'true';
    }

    function onClickOutside(e) {
      if (!toggle.parentElement.contains(e.target)) closeMenu();
    }

    function onMenuKeydown(e) {
      if (e.key === 'Escape') { closeMenu(); toggle.focus(); return; }
      if (e.key !== 'Tab' || !isOpen()) return;
      var links = menu.querySelectorAll('a');
      var first = links[0];
      var last = links[links.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); closeMenu();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); closeMenu();
      }
    }

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      isOpen() ? closeMenu() : openMenu();
    });

    toggle.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (!isOpen()) openMenu();
        var firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen()) openMenu();
        var links = menu.querySelectorAll('a');
        if (links.length) links[links.length - 1].focus();
      }
    });

    menu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() { closeMenu(); });
    });
  });

  // Phone menu: the button shows and hides the panel. Escape, a tap outside
  // or following a link closes it. Nothing is stored.
  (function() {
    var button = document.querySelector('.nav-menuToggle');
    var sheet = document.getElementById('nav-sheet');
    if (!button || !sheet) return;
    var header = button.closest('.site-header');

    function setOpen(open) {
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      button.setAttribute('aria-label', open ? menuCloseLabel : menuLabel);
      sheet.hidden = !open;
      if (open) {
        document.addEventListener('click', onOutside);
        document.addEventListener('keydown', onKey);
      } else {
        document.removeEventListener('click', onOutside);
        document.removeEventListener('keydown', onKey);
      }
    }

    function onOutside(e) {
      if (!header.contains(e.target)) setOpen(false);
    }

    function onKey(e) {
      if (e.key === 'Escape') { setOpen(false); button.focus(); }
    }

    button.addEventListener('click', function() { setOpen(sheet.hidden); });
    sheet.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() { setOpen(false); });
    });
    // Rotating a phone to a wider layout hides the button; close the panel too.
    var wide = window.matchMedia('(min-width: 641px)');
    if (wide.addEventListener) wide.addEventListener('change', function(e) { if (e.matches) setOpen(false); });
  })();
</script>

{otherLocales.length > 0 && (
<script is:inline define:vars={{ prefixes }}>
  // The language switchers were rendered with the path this page was built at.
  // A campaign tag is not in that path and has to survive a switch, so the
  // hrefs are rebuilt from the live address before anything else reads it.
  //
  // Nothing is written to the address: this only reads it and rewrites the
  // links. A target locale the map does not know is left as it was rendered,
  // so a stale map can cost the query and the fragment but can never send
  // anyone to the wrong path.
  //
  // A free tool's # state is not preserved here, because ToolStateGuard has
  // already moved it out of the address by the time this runs (it sits in
  // window[<tool>Shared] from then on). Switching language on a shared tool
  // link therefore opens the tool's other-language page with no state. Fixing
  // that means handing this script the tool's window property and putting the
  // state back as the fragment, which belongs with the tool pages.
  (function() {
    var links = document.querySelectorAll('[data-lang-switch]');
    if (!links.length) return;

    // Move the path out of this page's locale prefix, the same way
    // src/i18n/url.ts does at build time. Only prefixes the site serves are
    // stripped: never a bare two letter segment, which a page path could be.
    var path = window.location.pathname;
    if (path.charAt(0) !== '/') path = '/' + path;
    for (var locale in prefixes) {
      var prefix = prefixes[locale];
      if (!prefix) continue;
      if (path === prefix || path === prefix + '/') { path = '/'; break; }
      if (path.indexOf(prefix + '/') === 0) { path = path.slice(prefix.length); break; }
    }

    var keep = new URLSearchParams();
    new URLSearchParams(window.location.search).forEach(function(value, key) {
      if (key.indexOf('utm_') === 0) keep.append(key, value);
    });
    var query = keep.toString();
    var suffix = (query ? '?' + query : '') + window.location.hash;

    for (var i = 0; i < links.length; i++) {
      var target = links[i].getAttribute('data-lang-switch');
      if (!Object.prototype.hasOwnProperty.call(prefixes, target)) continue;
      links[i].setAttribute('href', prefixes[target] + path + suffix);
    }
  })();
</script>
)}
