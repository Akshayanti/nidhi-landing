---
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';
const currentPath = Astro.url.pathname;

// TODO (brand-rollout): remove the `showMark` gate and always render
// <LogoMark /> once the rebrand is live in production.
const showMark = import.meta.env.DEV;
---

<header class="site-header">
  <nav class="site-nav container container--wide">
    <a href="/" class="logo" data-attr="nav-logo" aria-label="nidhi — home">
      {showMark && <LogoMark size={32} />}
      <span class="logo-text">nidhi</span>
    </a>
    <div class="nav-right">
      <a href="/blog" class:list={['nav-link', { active: currentPath.startsWith('/blog') }]} data-attr="nav-blog">Blog</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-white);
    border-bottom: 1px solid var(--color-border-light);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-deep-blue);
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-deep-blue);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .nav-right { gap: var(--space-3); }
    .nav-link { font-size: 0.8rem; }
  }
</style>