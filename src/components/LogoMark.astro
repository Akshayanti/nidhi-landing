---
// Inline logo mark — theme-reactive via CSS custom properties.
// Colors follow --color-deep-blue and --color-teal from global.css,
// which automatically swap for [data-theme="dark"].
//
// The "white" artwork (strokes) stays white in both modes — this matches
// the dark-variant PNGs produced by generate-brand-assets.sh.
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 512 512"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect x="0" y="0" width="512" height="512" rx="96" class="lm-bg" />
  <path d="M120 200 H360" class="lm-stroke" stroke-width="16" stroke-linecap="round" />
  <path
    d="M150 360 V290 Q150 250 195 250 Q240 250 240 290 V360"
    fill="none"
    class="lm-stroke"
    stroke-width="24"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="320" cy="310" r="45" fill="none" class="lm-stroke" stroke-width="24" />
  <path d="M365 310 V205" class="lm-stroke" stroke-width="24" stroke-linecap="round" />
  <path d="M365 200 L425 140" class="lm-stroke" stroke-width="16" stroke-linecap="round" />
  <path
    d="M385 140 H425 V180"
    fill="none"
    class="lm-stroke"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="410" cy="220" r="14" class="lm-accent" />
</svg>

<style>
  .logo-mark {
    display: block;
    flex-shrink: 0;
  }
  .lm-bg {
    fill: var(--color-deep-blue);
  }
  .lm-stroke {
    stroke: #ffffff;
  }
  .lm-accent {
    fill: var(--color-teal);
  }
</style>
