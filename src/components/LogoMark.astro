---
// Inline logo mark — theme-reactive via CSS custom properties.
//
// All three colors come from the brand palette (docs/color-palette.md) and
// flip across [data-theme="dark"] so the mark stays AA-readable in both
// modes:
//
//   Light mode: deep-blue bg #0A3D8F, white strokes (10.1:1), teal-light
//               accent #80CBC4 (5.4:1 on bg, AA non-text).
//   Dark mode:  light-blue bg #90CAF9, deep-blue strokes #0A3D8F (5.8:1),
//               teal accent #005B4F (4.6:1 on bg, AA non-text).
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 512 512"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect x="0" y="0" width="512" height="512" rx="96" class="lm-bg" />
  <path d="M120 200 H360" class="lm-stroke" stroke-width="16" stroke-linecap="round" />
  <path
    d="M150 360 V290 Q150 250 195 250 Q240 250 240 290 V360"
    fill="none"
    class="lm-stroke"
    stroke-width="24"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="320" cy="310" r="45" fill="none" class="lm-stroke" stroke-width="24" />
  <path d="M365 310 V205" class="lm-stroke" stroke-width="24" stroke-linecap="round" />
  <path d="M365 200 L425 140" class="lm-stroke" stroke-width="16" stroke-linecap="round" />
  <path
    d="M385 140 H425 V180"
    fill="none"
    class="lm-stroke"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="410" cy="220" r="14" class="lm-accent" />
</svg>

<style>
  .logo-mark {
    display: block;
    flex-shrink: 0;
  }
  .lm-bg {
    fill: var(--color-deep-blue);
  }
  .lm-stroke {
    stroke: var(--color-logo-stroke);
  }
  .lm-accent {
    fill: var(--color-logo-accent);
  }
</style>
