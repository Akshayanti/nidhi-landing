---
// Early-access waitlist signup. Single opt-in, no confirmation email,
// no double-opt-in loop. Posts to the same Google Apps Script Web App as
// the newsletter, with action=waitlist.
//
// Uses PUBLIC_WAITLIST_ENDPOINT (separate Apps Script deployment from the
// blog newsletter). See scripts/waitlist.gs for setup instructions.
//
// One box, the same everywhere it appears: the home page and every free
// tool (through ToolWaitlist.astro). Once someone signs up, the shared
// localStorage key hides it on every page.

import { dict, format, localizedPath, type Locale } from '../i18n';
import { shownWaitlistCount, waitlistCount } from '../utils/waitlistCount';

interface Props {
  /** The language of the page the box sits on. */
  locale: Locale;
}

const { locale } = Astro.props;
const { waitlist } = dict(locale);
// "20+ people have joined my waitlist.": absent until there are 20 (see waitlistCount).
// The dev server shows the exact count instead, ungated, for the founder only.
const signups = await waitlistCount();
const joined = shownWaitlistCount(signups);
const ctaLabel = waitlist.cta;

const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT || '';
const isDev = import.meta.env.DEV;

const idPrefix = 'waitlist';
const formId = `${idPrefix}-form`;
const statusId = `${idPrefix}-status`;
const inputId = `${idPrefix}-email`;
---

<section class="waitlist" aria-label={waitlist.region}>
  <div class="waitlist-box">
    <!-- Pre-submit: form -->
    <div class="waitlist-pre" data-waitlist-state="pre">
      <h3 class="waitlist-title">{waitlist.heading}</h3>
      {import.meta.env.DEV ? (
        <p class="waitlist-text waitlist-devCount">
          {signups === null
            ? 'Dev only: waitlist count unavailable. Set WAITLIST_COUNT_TOKEN in .env.'
            : `Dev only: ${signups} on the waitlist. The live site shows this from 20, rounded down to a multiple of 20.`}
        </p>
      ) : (
        joined !== null && <p class="waitlist-text">{format(waitlist.joined, { n: joined })}</p>
      )}

      <form
        id={formId}
        class="waitlist-form"
        data-endpoint={endpoint}
      >
        <div class="waitlist-input-group">
          <label class="sr-only" for={inputId}>{waitlist.emailLabel}</label>
          <input
            id={inputId}
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="waitlist-input"
          />
          <button type="submit" class="waitlist-button" data-cta={ctaLabel}>{ctaLabel}</button>
        </div>
        <!-- Shown before anything is sent, so a typo can be caught. -->
        <div class="waitlist-confirm" data-confirm hidden>
          <p class="waitlist-confirm-text">{waitlist.confirmPrompt} <strong data-confirm-email></strong></p>
          <div class="waitlist-confirm-actions">
            <button type="button" class="waitlist-button" data-confirm-yes data-attr={`${idPrefix}-confirm-yes`}>{waitlist.confirmYes}</button>
            <button type="button" class="waitlist-confirm-change" data-confirm-change data-attr={`${idPrefix}-confirm-change`}>{waitlist.confirmChange}</button>
          </div>
        </div>
        <p id={statusId} class="waitlist-status" role="status" aria-live="polite"></p>
        <p class="waitlist-privacy">
          {waitlist.privacyBefore}<a href={localizedPath(locale, '/privacy/')}>{waitlist.privacyLink}</a>{waitlist.privacyAfter}
        </p>
      </form>

      {isDev && !endpoint && (
        <p class="waitlist-dev-warning">
          ⚠ <code>PUBLIC_WAITLIST_ENDPOINT</code> is not set: the form is visible
          but submissions will no-op. See <code>scripts/waitlist.gs</code>.
        </p>
      )}
    </div>

    <!-- Post-submit: success -->
    <div class="waitlist-post" data-waitlist-state="post" hidden>
      <div class="waitlist-success-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <h3 class="waitlist-success-title">{waitlist.successTitle}</h3>
      <p class="waitlist-success-body">
        {waitlist.successBody}
      </p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ formId, statusId, sending: waitlist.sending, notConfigured: waitlist.notConfigured, errorMessage: waitlist.error, confirmYesLabel: waitlist.confirmYes }}>
  (function () {
    var STORAGE_KEY = 'nidhi-waitlist-signedup';

    function readState() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (parsed.status !== 'signedup') return null;
        return parsed;
      } catch (_) {
        return null;
      }
    }
    function writeState() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status: 'signedup', at: Date.now() })); } catch (_) {}
    }

    var form = document.getElementById(formId);
    var statusEl = document.getElementById(statusId);
    if (!form || !statusEl) return;

    var section = form.closest('.waitlist');
    var preEl  = section && section.querySelector('[data-waitlist-state="pre"]');
    var postEl = section && section.querySelector('[data-waitlist-state="post"]');

    var endpoint = form.getAttribute('data-endpoint') || '';
    var button = form.querySelector('button[type="submit"]');
    var input = form.querySelector('input[type="email"]');
    var ctaLabel = (button && button.getAttribute('data-cta')) || '';
    var confirmEl = form.querySelector('[data-confirm]');
    var confirmEmail = confirmEl && confirmEl.querySelector('[data-confirm-email]');
    var yesBtn = confirmEl && confirmEl.querySelector('[data-confirm-yes]');
    var changeBtn = confirmEl && confirmEl.querySelector('[data-confirm-change]');

    var submitting = false;

    function setStatus(text, kind) {
      statusEl.textContent = text;
      statusEl.className = 'waitlist-status waitlist-status--' + kind;
    }

    function applyState() {
      var state = readState();
      if (state) {
        if (section) section.hidden = true;
        return;
      }
      if (section) section.hidden = false;
      if (postEl) postEl.hidden = true;
      if (preEl)  preEl.hidden = false;
      setStatus('', 'idle');
      if (button) { button.disabled = false; button.textContent = ctaLabel; }
      closeConfirm();
      submitting = false;
    }

    // The check before sending: the typed address, a yes and a change.
    // While it shows, the address can't be edited, so what is confirmed is
    // what is sent.
    var pendingEmail = '';
    function openConfirm(email) {
      if (!confirmEl) return false;
      pendingEmail = email;
      if (confirmEmail) confirmEmail.textContent = email;
      if (input) input.readOnly = true;
      if (button) button.hidden = true;
      confirmEl.hidden = false;
      if (yesBtn) { yesBtn.disabled = false; yesBtn.textContent = confirmYesLabel; try { yesBtn.focus(); } catch (_) {} }
      return true;
    }
    function closeConfirm() {
      pendingEmail = '';
      if (yesBtn) { yesBtn.disabled = false; yesBtn.textContent = confirmYesLabel; }
      if (changeBtn) changeBtn.disabled = false;
      if (confirmEl) confirmEl.hidden = true;
      if (input) input.readOnly = false;
      if (button) button.hidden = false;
    }

    function showSuccess() {
      if (preEl)  preEl.hidden = true;
      if (postEl) {
        postEl.hidden = false;
        postEl.setAttribute('tabindex', '-1');
        try { postEl.focus({ preventScroll: false }); } catch (_) {}
      }
      writeState();
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (submitting) return;
      var email = (input && input.value || '').trim();
      if (!email) return;

      if (!endpoint) {
        console.warn('[WaitlistSection] PUBLIC_WAITLIST_ENDPOINT is not set. Submissions are no-ops.');
        setStatus(notConfigured, 'error');
        return;
      }

      setStatus('', 'idle');
      if (!openConfirm(email)) send(email);
    });

    if (changeBtn) {
      changeBtn.addEventListener('click', function () {
        if (submitting) return;
        closeConfirm();
        if (input) { try { input.focus(); input.select(); } catch (_) {} }
      });
    }
    if (yesBtn) {
      yesBtn.addEventListener('click', function () {
        // The address shown, not the input's value now: autofill can still
        // change a read-only field.
        send(pendingEmail);
      });
    }

    function send(email) {
      if (submitting || !email) return;
      submitting = true;
      if (yesBtn) { yesBtn.disabled = true; yesBtn.textContent = sending; }
      if (changeBtn) changeBtn.disabled = true;
      setStatus('', 'idle');

      if (window.posthog) {
        var domain = email.split('@')[1] || '';
        window.posthog.capture('waitlist_submit', {
          email_domain: domain,
          source: window.location.pathname,
        });
      }

      var body = new URLSearchParams();
      body.set('action', 'waitlist');
      body.set('email', email);
      body.set('source', window.location.pathname);

      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      }).then(function () {
        form.reset();
        closeConfirm();
        if (changeBtn) changeBtn.disabled = false;
        submitting = false;
        showSuccess();
        if (window.posthog) {
          window.posthog.capture('waitlist_sent', {});
        }
      }).catch(function () {
        submitting = false;
        setStatus(errorMessage, 'error');
        if (yesBtn) { yesBtn.disabled = false; yesBtn.textContent = confirmYesLabel; }
        if (changeBtn) changeBtn.disabled = false;
      });
    }

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) applyState();
    });

    window.addEventListener('storage', function (e) {
      if (e.key === STORAGE_KEY || e.key === null) {
        applyState();
      }
    });

    applyState();
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waitlist {
    margin-top: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .waitlist-box {
    max-width: 460px;
    margin: 0 auto;
    background: var(--color-callout-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5);
    text-align: center;
  }

  @media (min-width: 640px) {
    .waitlist-box { padding: var(--space-6) var(--space-8); }
  }

  .waitlist-title {
    font-size: 1.4rem;
    color: white;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .waitlist-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  /* A dev-server note, never on the published site: dashed so it reads as one. */
  .waitlist-devCount {
    border: 1px dashed rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  .waitlist-form {
    max-width: 420px;
    margin: 0 auto;
  }

  .waitlist-input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 480px) {
    .waitlist-input-group { flex-direction: row; }
  }

  .waitlist-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
  }

  .waitlist-input::placeholder { color: var(--color-text-muted); }
  .waitlist-input:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 0; }

  .waitlist-button {
    padding: var(--space-3) var(--space-5);
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
    border: 1px solid var(--color-cta-bg);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease, opacity 0.15s ease;
    white-space: nowrap;
  }

  .waitlist-button:hover:not(:disabled) { background: var(--color-cta-bg-hover); border-color: var(--color-teal); }
  .waitlist-button:active:not(:disabled) { transform: translateY(1px); }
  .waitlist-button:disabled { opacity: 0.6; cursor: wait; }
  /* On the blue card a teal button nearly vanishes on a dim screen; white
     with the card's navy as text stands apart in both themes. */
  .waitlist .waitlist-button { background: #fff; color: var(--color-callout-bg); border-color: #fff; }
  .waitlist .waitlist-button:hover:not(:disabled) { background: rgba(255, 255, 255, 0.88); }
  .waitlist .waitlist-button:focus-visible { outline-color: #fff; }

  .waitlist-button:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .waitlist-confirm { margin-top: var(--space-3); }
  .waitlist-confirm[hidden] { display: none; }
  .waitlist-confirm-text {
    margin: 0 0 var(--space-3);
    font-size: 0.95rem;
    color: white;
    overflow-wrap: anywhere;
  }
  .waitlist-confirm-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .waitlist-confirm-change {
    background: none;
    border: none;
    padding: var(--space-2) 0;
    font: inherit;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    cursor: pointer;
  }
  .waitlist-confirm-change:hover:not(:disabled) { color: white; }
  .waitlist-confirm-change:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .waitlist-button[hidden] { display: none; }
  .waitlist .waitlist-confirm-actions { justify-content: center; }

  .waitlist-status {
    font-size: 0.875rem;
    margin: var(--space-2) 0 0;
    min-height: 1.2em;
    color: rgba(255, 255, 255, 0.85);
  }

  .waitlist-status--success { color: var(--status-success-on-dark); }
  .waitlist-status--error { color: var(--status-error-on-dark); }
  .waitlist-status--idle { color: rgba(255, 255, 255, 0.7); }

  .waitlist-privacy {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
    margin: var(--space-3) 0 0;
  }

  .waitlist-privacy a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
  }

  .waitlist-privacy a:hover { color: white; }

  /* Post-submit success */
  .waitlist-post { text-align: center; }
  .waitlist-post:focus { outline: none; }

  .waitlist-pre[hidden],
  .waitlist-post[hidden] {
    display: none !important;
  }

  .waitlist-success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: var(--status-success-on-dark);
  }

  .waitlist-success-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: white;
  }

  .waitlist-success-body {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Dev warning */
  .waitlist-dev-warning {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    background: var(--warning-light-bg);
    border: 1px solid var(--warning-light-border);
    border-radius: var(--radius-sm);
    color: var(--warning-light-text);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: left;
  }

  .waitlist-dev-warning code {
    background: rgba(0, 0, 0, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.85em;
  }

  @media (max-width: 480px) {
    .waitlist-box { padding: var(--space-4); }
    .waitlist-title { font-size: 1.05rem; }
    .waitlist-text { font-size: 0.875rem; }
    .waitlist-success-title { font-size: 1.15rem; }
  }
</style>
