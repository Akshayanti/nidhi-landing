---
// Public beta waitlist signup. Single opt-in, no confirmation email,
// no double-opt-in loop. Posts to the same Google Apps Script Web App as
// the newsletter, with action=waitlist.
//
// Uses PUBLIC_WAITLIST_ENDPOINT (separate Apps Script deployment from the
// blog newsletter). See scripts/waitlist.gs for setup instructions.
//
// Variants:
//   default  Box-chrome card with heading + body, used in section 6 of the
//            home page and other top-level conversion spots.
//   hero     Stripped to just input + button + privacy note. Used in the
//            home page hero where the surrounding copy already does the
//            framing job.
//
// Both variants share the same submission logic, same localStorage key,
// and both hide their containers post-submit. Because the same key is
// shared, submitting one variant on a page that renders both will also
// hide the other, which is the intended outcome.

interface Props {
  variant?: 'default' | 'hero';
  cta?: string;
}

const { variant = 'default', cta = 'Notify me' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT || '';
const isDev = import.meta.env.DEV;

const idPrefix = variant === 'hero' ? 'waitlist-hero' : 'waitlist';
const formId = `${idPrefix}-form`;
const statusId = `${idPrefix}-status`;
const inputId = `${idPrefix}-email`;
---

<section class:list={['waitlist', `waitlist--${variant}`]} aria-label="Public beta waitlist">
  <div class="waitlist-box">
    <!-- Pre-submit: form -->
    <div class="waitlist-pre" data-waitlist-state="pre">
      {variant === 'default' && (
        <>
          <h3 class="waitlist-title">Be the first to know when public beta opens</h3>
          <p class="waitlist-text">Drop your email and we'll let you know when nidhi opens public beta access. No spam, no newsletters, just the beta.</p>
        </>
      )}

      <form
        id={formId}
        class="waitlist-form"
        data-endpoint={endpoint}
      >
        <div class="waitlist-input-group">
          <label class="sr-only" for={inputId}>Email address</label>
          <input
            id={inputId}
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="waitlist-input"
          />
          <button type="submit" class="waitlist-button" data-cta={cta}>{cta}</button>
        </div>
        <p id={statusId} class="waitlist-status" role="status" aria-live="polite"></p>
        <p class="waitlist-privacy">
          One email when public beta opens. <a href="/privacy/">Privacy policy</a>.
        </p>
      </form>

      {isDev && !endpoint && (
        <p class="waitlist-dev-warning">
          ⚠ <code>PUBLIC_WAITLIST_ENDPOINT</code> is not set: the form is visible
          but submissions will no-op. See <code>scripts/waitlist.gs</code>.
        </p>
      )}
    </div>

    <!-- Post-submit: success -->
    <div class="waitlist-post" data-waitlist-state="post" hidden>
      <div class="waitlist-success-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <h3 class="waitlist-success-title">You're on the list</h3>
      <p class="waitlist-success-body">
        We'll send you one email when public beta opens. That's it.
      </p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ formId, statusId }}>
  (function () {
    var STORAGE_KEY = 'nidhi-waitlist-signedup';

    function readState() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (parsed.status !== 'signedup') return null;
        return parsed;
      } catch (_) {
        return null;
      }
    }
    function writeState() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ status: 'signedup', at: Date.now() })); } catch (_) {}
    }

    var form = document.getElementById(formId);
    var statusEl = document.getElementById(statusId);
    if (!form || !statusEl) return;

    var section = form.closest('.waitlist');
    var preEl  = section && section.querySelector('[data-waitlist-state="pre"]');
    var postEl = section && section.querySelector('[data-waitlist-state="post"]');

    var endpoint = form.getAttribute('data-endpoint') || '';
    var button = form.querySelector('button[type="submit"]');
    var input = form.querySelector('input[type="email"]');
    var ctaLabel = (button && button.getAttribute('data-cta')) || 'Notify me';

    var submitting = false;

    function setStatus(text, kind) {
      statusEl.textContent = text;
      statusEl.className = 'waitlist-status waitlist-status--' + kind;
    }

    function applyState() {
      var state = readState();
      if (state) {
        if (section) section.hidden = true;
        return;
      }
      if (section) section.hidden = false;
      if (postEl) postEl.hidden = true;
      if (preEl)  preEl.hidden = false;
      setStatus('', 'idle');
      if (button) { button.disabled = false; button.textContent = ctaLabel; }
      submitting = false;
    }

    function showSuccess() {
      if (preEl)  preEl.hidden = true;
      if (postEl) {
        postEl.hidden = false;
        postEl.setAttribute('tabindex', '-1');
        try { postEl.focus({ preventScroll: false }); } catch (_) {}
      }
      writeState();
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (submitting) return;
      var email = (input && input.value || '').trim();
      if (!email) return;

      if (!endpoint) {
        console.warn('[WaitlistSection] PUBLIC_WAITLIST_ENDPOINT is not set. Submissions are no-ops.');
        setStatus('Signups are not configured yet. Check back soon.', 'error');
        return;
      }

      submitting = true;
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }
      setStatus('', 'idle');

      if (window.posthog) {
        var domain = email.split('@')[1] || '';
        window.posthog.capture('waitlist_submit', {
          email_domain: domain,
          source: window.location.pathname,
        });
      }

      var body = new URLSearchParams();
      body.set('action', 'waitlist');
      body.set('email', email);
      body.set('source', window.location.pathname);

      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      }).then(function () {
        form.reset();
        submitting = false;
        showSuccess();
        if (window.posthog) {
          window.posthog.capture('waitlist_sent', {});
        }
      }).catch(function () {
        submitting = false;
        setStatus('Something went wrong. Please try again in a moment.', 'error');
        if (button) { button.disabled = false; button.textContent = ctaLabel; }
      });
    });

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) applyState();
    });

    window.addEventListener('storage', function (e) {
      if (e.key === STORAGE_KEY || e.key === null) {
        applyState();
      }
    });

    applyState();
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waitlist {
    margin-top: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .waitlist-box {
    max-width: 460px;
    margin: 0 auto;
    background: var(--color-callout-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-5);
    text-align: center;
  }

  @media (min-width: 640px) {
    .waitlist-box { padding: var(--space-6) var(--space-8); }
  }

  .waitlist-title {
    font-size: 1.15rem;
    color: white;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .waitlist-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  .waitlist-form {
    max-width: 420px;
    margin: 0 auto;
  }

  .waitlist-input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 480px) {
    .waitlist-input-group { flex-direction: row; }
  }

  .waitlist-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
  }

  .waitlist-input::placeholder { color: var(--color-text-muted); }
  .waitlist-input:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 0; }

  .waitlist-button {
    padding: var(--space-3) var(--space-5);
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease, opacity 0.15s ease;
    white-space: nowrap;
  }

  .waitlist-button:hover:not(:disabled) { background: var(--color-cta-bg-hover); }
  .waitlist-button:active:not(:disabled) { transform: translateY(1px); }
  .waitlist-button:disabled { opacity: 0.6; cursor: wait; }
  .waitlist-button:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .waitlist-status {
    font-size: 0.85rem;
    margin: var(--space-2) 0 0;
    min-height: 1.2em;
    color: rgba(255, 255, 255, 0.85);
  }

  .waitlist-status--success { color: var(--status-success-on-dark); }
  .waitlist-status--error { color: var(--status-error-on-dark); }
  .waitlist-status--idle { color: rgba(255, 255, 255, 0.7); }

  .waitlist-privacy {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.65);
    margin: var(--space-3) 0 0;
  }

  .waitlist-privacy a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
  }

  .waitlist-privacy a:hover { color: white; }

  /* Post-submit success */
  .waitlist-post { text-align: center; }
  .waitlist-post:focus { outline: none; }

  .waitlist-pre[hidden],
  .waitlist-post[hidden] {
    display: none !important;
  }

  .waitlist-success-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: var(--status-success-on-dark);
  }

  .waitlist-success-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: white;
  }

  .waitlist-success-body {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Dev warning */
  .waitlist-dev-warning {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    background: var(--warning-light-bg);
    border: 1px solid var(--warning-light-border);
    border-radius: var(--radius-sm);
    color: var(--warning-light-text);
    font-size: 0.8rem;
    line-height: 1.4;
    text-align: left;
  }

  .waitlist-dev-warning code {
    background: rgba(0, 0, 0, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.85em;
  }

  @media (max-width: 480px) {
    .waitlist-box { padding: var(--space-4); }
    .waitlist-title { font-size: 1.05rem; }
    .waitlist-text { font-size: 0.85rem; }
    .waitlist-success-title { font-size: 1.15rem; }
  }

  /* ----------------------------------------------------------------
     Hero variant: drops the deep-blue card chrome so the form sits
     directly on the page background. The hero copy already does the
     framing work, so heading + body text are not rendered. Form
     controls switch to light-bg styling so the input matches the rest
     of the surrounding hero (no color contrast clash with white card
     on a light bg, no white-on-white in dark mode).
     ---------------------------------------------------------------- */
  .waitlist--hero {
    margin: 0;
  }

  .waitlist--hero .waitlist-box {
    background: transparent;
    padding: 0;
    text-align: left;
    max-width: 540px;
    margin: 0;
  }

  .waitlist--hero .waitlist-form { max-width: none; margin: 0; }

  .waitlist--hero .waitlist-input {
    border: 1px solid var(--color-border);
    background: var(--color-bg-white);
    color: var(--color-text-primary);
  }

  .waitlist--hero .waitlist-input:focus-visible {
    outline: none;
    border-color: var(--color-deep-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-deep-blue) 22%, transparent);
  }

  .waitlist--hero .waitlist-status {
    color: var(--color-text-secondary);
  }
  .waitlist--hero .waitlist-status--success { color: var(--color-success); }
  .waitlist--hero .waitlist-status--error   { color: var(--status-error-light); }

  [data-theme="dark"] .waitlist--hero .waitlist-status--error {
    color: var(--palette-deep-orange-dark);
  }

  .waitlist--hero .waitlist-privacy {
    color: var(--color-text-muted);
  }
  .waitlist--hero .waitlist-privacy a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Hero variant post-submit success: keep it inline, theme-correct, no
     dark-card foreground colors from the default variant. */
  .waitlist--hero .waitlist-success-icon {
    background: color-mix(in srgb, var(--color-teal) 16%, transparent);
    color: var(--color-teal);
    margin: 0 0 var(--space-3);
  }
  .waitlist--hero .waitlist-success-title {
    color: var(--color-deep-blue);
    text-align: left;
  }
  .waitlist--hero .waitlist-success-body {
    color: var(--color-text-secondary);
    text-align: left;
  }
  .waitlist--hero .waitlist-post { text-align: left; }
</style>
