---
/**
 * The link that switches the page into another language.
 *
 * A plain `<a>`, so it works with no JavaScript and can be opened in a new tab.
 * The one thing it cannot do at build time is read the visitor's live address,
 * and a campaign tag or a free tool's `#` state must survive the switch, so
 * Header.astro rewrites every one of these hrefs on load from
 * `location.pathname + search + hash`.
 *
 * The href rendered here is what a visitor with JavaScript disabled follows:
 * the same page under the other prefix, without the campaign tag and without a
 * free tool's `#` state, neither of which the build can see. Nothing else is
 * lost, and `#` state never reaches a server in the first place.
 */
import { LOCALE_META, dict, swapLocale, type Locale } from '../i18n';

interface Props {
  /** The language of the page this link sits on. */
  locale: Locale;
  /** The language it switches to. */
  to: Locale;
  /**
   * `header` is the small pill beside the theme toggle, shown above 640px;
   * `sheet` is a full-width row in the phone menu, which carries the link on
   * smaller screens where the header has no room for it.
   */
  variant?: 'header' | 'sheet';
}

const { locale, to, variant = 'header' } = Astro.props;
const strings = dict(locale);
const label = to === 'hi' ? strings.langSwitch.toHindi : strings.langSwitch.toEnglish;
const ariaLabel = to === 'hi' ? strings.langSwitch.ariaToHindi : strings.langSwitch.ariaToEnglish;
const targetLang = LOCALE_META[to].htmlLang;
const fallbackHref = swapLocale(Astro.url.pathname, to);
---

<a
  class:list={['lang-switch', `lang-switch--${variant}`]}
  href={fallbackHref}
  hreflang={targetLang}
  aria-label={ariaLabel}
  data-attr={`lang-switch-${to}`}
  data-lang-switch={to}
>
  <span class="lang-switch__label" lang={targetLang}>{label}</span>
</a>

<style>
  .lang-switch {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-switch:hover,
  .lang-switch:focus-visible {
    color: var(--color-deep-blue);
  }

  .lang-switch:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Header: a bordered pill, so it reads as a control and not as a link into
     a section of the site. It sizes to its text, so the Devanagari label
     ("हिन्दी") is a little wider than the Latin one ("English") and the header
     shifts by the difference when a page switches language. */
  .lang-switch--header {
    display: inline-block;
    padding: 5px 10px;
    font-size: 0.8rem;
    line-height: 1.2;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  /* Below 640px the header carries the theme toggle and the menu button
     already; the sheet has the row instead. */
  @media (max-width: 640px) {
    .lang-switch--header {
      display: none;
    }
  }

  /* Sheet: a row like the links around it. Kept here rather than inherited
     from Header's scoped rules, which do not reach into a child component. */
  .lang-switch--sheet {
    display: block;
    padding: 10px 0;
    font-size: 1.02rem;
    color: var(--color-text-primary);
  }
</style>
