---
/**
 * A small line chart for the homepage hero examples, drawn at build time
 * from the worked examples in src/utils/home/heroExamples.ts. Hovering or
 * tapping it shows the values at that point (script in src/pages/index.astro,
 * which reads the data-* attributes written here); the same numbers are in
 * the <desc> for screen readers, or in the element named by descId.
 */
import { formatProseAmount } from '../utils/shared/formatAmount.ts';

interface Series {
  name: string;
  values: number[];
  /** CSS colour, e.g. var(--chart-eur). */
  color: string;
  dashFrom?: number;
  area?: boolean;
}

interface Props {
  id: string;
  title: string;
  /** The numbers in words, for screen readers. Leave it out when passing descId. */
  desc?: string;
  /** id of an element elsewhere on the page that describes the chart. Use it when the page draws the same chart twice (one per screen size), so the description is printed once instead of once per drawing. */
  descId?: string;
  /** One label per point, used by the hover readout. */
  pointLabels: string[];
  series: Series[];
  axisStart: string;
  axisEnd: string;
  axisMid?: { index: number; label: string };
  target?: { value: number; label: string };
  marker?: { index: number; label: string };
  /** Shown under the chart. Leave it out when the page draws the same chart twice (one per screen size) and prints the note once itself. */
  footnote?: string;
  /** Drawing size in SVG units. A narrower one keeps labels readable when the chart is shown small, on phones. */
  width?: number;
  height?: number;
  /** Extra class on the outer box, e.g. to show it only at some widths. */
  class?: string;
}

const { id, title, desc, descId, pointLabels, series, axisStart, axisEnd, axisMid, target, marker, footnote, width = 480, height = 270, class: extraClass } = Astro.props;

const W = width;
const H = height;
const PAD = { top: 20, right: 92, bottom: 48, left: 64 };
const PW = W - PAD.left - PAD.right;
const PH = H - PAD.top - PAD.bottom;
const n = pointLabels.length;

const maxV = Math.max(...series.flatMap((s) => s.values), target?.value ?? 0);
const raw = maxV / 4;
const exp = Math.pow(10, Math.floor(Math.log10(raw)));
const step = [1, 2, 2.5, 5, 10].map((m) => m * exp).find((s) => s >= raw) ?? 10 * exp;
const count = Math.ceil(maxV / step - 1e-9);
const top = step * count;

const r1 = (v: number) => Math.round(v * 10) / 10;
const x = (i: number) => r1(PAD.left + (i / (n - 1)) * PW);
const y = (v: number) => r1(PAD.top + (1 - v / top) * PH);
const pts = (vals: number[], from = 0, to = vals.length - 1) =>
  vals.slice(from, to + 1).map((v, k) => `${x(from + k)},${y(v)}`).join(' ');

const ticks = Array.from({ length: count + 1 }, (_, t) => t * step);
const gradId = `${id}-grad`;

// Spread end labels so they never overlap.
const ends = series.map((s) => ({ s, y: y(s.values[n - 1]) })).sort((a, b) => a.y - b.y);
// Each label is two lines (name, value), about 34 units tall.
for (let i = 1; i < ends.length; i++) if (ends[i].y - ends[i - 1].y < 36) ends[i].y = ends[i - 1].y + 36;

// For the hover script: x positions as fractions of the width, and the
// pre-formatted values, so the browser does no formatting of its own.
const hoverData = JSON.stringify({
  xs: pointLabels.map((_, i) => x(i) / W),
  labels: pointLabels,
  series: series.map((s) => ({
    name: s.name,
    color: s.color,
    ys: s.values.map((v) => y(v) / H),
    values: s.values.map((v) => formatProseAmount(v, 'EUR')),
  })),
});
---

<div class:list={["hero-chart", extraClass]} data-hero-chart={hoverData}>
  <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby={descId ? `${id}-title` : `${id}-title ${id}-desc`} aria-describedby={descId}>
    <title id={`${id}-title`}>{title}</title>
    {!descId && <desc id={`${id}-desc`}>{desc}</desc>}
    <defs>
      <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--chart-eur)" stop-opacity="0.22" />
        <stop offset="100%" stop-color="var(--chart-eur)" stop-opacity="0.02" />
      </linearGradient>
    </defs>
    <rect class="hc-plot" x={PAD.left} y={PAD.top} width={PW} height={PH} rx="5" />
    {ticks.map((t) => (
      <g>
        <line class={t === 0 ? 'hc-axis' : 'hc-grid'} x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
        <text class="hc-tick" x={PAD.left - 8} y={y(t) + 4} text-anchor="end">{formatProseAmount(t, 'EUR', true)}</text>
      </g>
    ))}
    {target && (
      <g>
        <line class="hc-target" x1={PAD.left} x2={W - PAD.right} y1={y(target.value)} y2={y(target.value)} />
        <text class="hc-targetLabel" x={PAD.left + 6} y={y(target.value) - 6}>{target.label}</text>
      </g>
    )}
    {series.map((s) => (
      <g>
        {s.area && <polygon points={`${pts(s.values)} ${x(n - 1)},${y(0)} ${x(0)},${y(0)}`} fill={`url(#${gradId})`} />}
        {s.dashFrom !== undefined ? (
          <>
            <polyline class="hc-line" points={pts(s.values, 0, s.dashFrom)} stroke={s.color} />
            <polyline class="hc-line hc-line--dashed" points={pts(s.values, s.dashFrom)} stroke={s.color} />
          </>
        ) : (
          <polyline class="hc-line" points={pts(s.values)} stroke={s.color} />
        )}
      </g>
    ))}
    {marker && (
      <g>
        <line class="hc-marker" x1={x(marker.index)} x2={x(marker.index)} y1={PAD.top} y2={y(0)} />
        <circle class="hc-markerDot" cx={x(marker.index)} cy={y(series[0].values[marker.index])} r="5" />
        <text class="hc-markerLabel" x={x(marker.index)} y={H - PAD.bottom + 34} text-anchor="middle">{marker.label}</text>
      </g>
    )}
    {ends.map(({ s, y: ly }) => (
      <g>
        <circle cx={x(n - 1)} cy={y(s.values[n - 1])} r="4" fill={s.color} class="hc-endDot" />
        <text class="hc-endName" x={W - PAD.right + 10} y={ly - 3} fill={s.color}>{s.name}</text>
        <text class="hc-endValue" x={W - PAD.right + 10} y={ly + 12}>{formatProseAmount(s.values[n - 1], 'EUR', true)}</text>
      </g>
    ))}
    <text class="hc-tick" x={PAD.left} y={H - PAD.bottom + 16}>{axisStart}</text>
    {axisMid && <text class="hc-tick hc-tickStrong" x={x(axisMid.index)} y={H - PAD.bottom + 16} text-anchor="middle">{axisMid.label}</text>}
    <text class="hc-tick" x={W - PAD.right} y={H - PAD.bottom + 16} text-anchor="end">{axisEnd}</text>
    <g class="hc-hover" aria-hidden="true">
      <line class="hc-crosshair" x1="0" x2="0" y1={PAD.top} y2={y(0)} />
      {series.map((s) => <circle class="hc-hoverDot" r="5" fill={s.color} />)}
    </g>
  </svg>
  <div class="hc-readout" aria-hidden="true"></div>
  <span class="hc-live chart-srOnly" aria-live="polite"></span>
  {footnote && <p class="hc-foot">{footnote}</p>}
</div>
