---
/**
 * The frame every free tool page shares: breadcrumbs, the eyebrow, title and
 * lead, the line for a browser without scripts, then the tool and its own
 * panels (the default slot), then the questions and the related lessons.
 *
 * It exists so the tools cannot drift apart again. Each tool page used to
 * carry its own copy of these elements under its own prefix (`ifcp-`, `iopp-`,
 * `mcsp-`) with about 220 lines of scoped CSS, and the copies had started to
 * differ. The classes here are `toolp-*`, and the styles are global on
 * purpose: a tool page writes its own panels into the slot with the same
 * classes (`toolp-panel`, `toolp-sectionTitle`, `toolp-notes`, ...), and a
 * scoped rule would not reach them. What only one page has keeps that page's
 * own prefix (`mcsp-steps`, `iopp-intro`) and a scoped rule in its file.
 *
 * `data-attr` labels are passed in by the page, written out in its source,
 * so the label registry can still read them.
 */
import LangRuns from './LangRuns.astro';
import LessonsInEnglish from './LessonsInEnglish.astro';
import { dict, localizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  breadcrumb: { home: string; freeTools: string; this: string };
  eyebrow: string;
  title: string;
  /** Three parts: phones show the first and the last. */
  lead: { before: string; wide: string; after: string };
  faq: { heading: string; items: { q: string; a: string }[] };
  related: { heading: string; cards: { url: string; dataAttr: string; kicker: string; title: string; desc: string }[] };
}

const { locale, breadcrumb, eyebrow, title, lead, faq, related } = Astro.props;
---

<section class="toolp-page">
  <nav class="toolp-breadcrumbs" aria-label={dict(locale).a11y.breadcrumb}>
    <ol>
      <li><a href={localizedPath(locale, '/')}>{breadcrumb.home}</a></li>
      <li><a href={localizedPath(locale, '/free/')}>{breadcrumb.freeTools}</a></li>
      <li aria-current="page">{breadcrumb.this}</li>
    </ol>
  </nav>

  <header class="toolp-header">
    <p class="toolp-eyebrow">{eyebrow}</p>
    <h1 class="toolp-title"><LangRuns text={title} locale={locale} /></h1>
    <p class="toolp-lead">
      {lead.before}<span class="toolp-wideOnly">{lead.wide}</span>{lead.after}
    </p>
  </header>

  <noscript><p class="tool-noscript">{dict(locale).tools.export.noScript}</p></noscript>

  <slot />

  <details class="toolp-panel toolp-faq">
    <summary class="toolp-sectionTitle disclosure">{faq.heading}</summary>
    {faq.items.map((f) => (
      <details class="toolp-faqItem">
        <summary class="toolp-faqQ disclosure">{f.q}</summary>
        <p class="toolp-faqA">{f.a}</p>
      </details>
    ))}
  </details>

  {related.cards.length > 0 && (
    <aside class="toolp-panel" aria-labelledby="toolp-related-h">
      <h2 id="toolp-related-h" class="toolp-sectionTitle">{related.heading}</h2>
      <LessonsInEnglish locale={locale} />
      <div class="toolp-relatedGrid">
        {related.cards.map((post) => (
          <a href={post.url} hreflang="en" class="toolp-relatedCard link-card" data-attr={post.dataAttr}>
            <span class="toolp-relatedKicker">{post.kicker}</span>
            <span class="toolp-relatedTitle">{post.title}</span>
            <span class="toolp-relatedDesc">{post.desc}</span>
          </a>
        ))}
      </div>
    </aside>
  )}
</section>

<style is:global>
.toolp-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: var(--space-6) var(--space-4) var(--space-12);
}
.toolp-breadcrumbs {
  margin-bottom: var(--space-3);
  font-size: 0.8125rem;
  color: var(--color-text-muted);
}
.toolp-breadcrumbs ol {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.toolp-breadcrumbs li + li::before {
  content: '/';
  margin-right: 4px;
}
.toolp-breadcrumbs a {
  color: var(--color-text-secondary);
  text-decoration: none;
}
.toolp-breadcrumbs a:hover,
.toolp-breadcrumbs a:focus-visible {
  color: var(--color-deep-blue);
  text-decoration: underline;
}
.toolp-breadcrumbs [aria-current="page"] {
  color: var(--color-text-primary);
}
.toolp-header {
  text-align: center;
  margin-bottom: var(--space-8);
}
.toolp-eyebrow {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-teal);
  margin: 0 0 var(--space-2);
}
.toolp-title {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: clamp(1.6rem, 2.4vw + 1rem, 2.4rem);
  color: var(--color-deep-blue);
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 var(--space-3);
  text-wrap: balance;
}
.toolp-lead {
  color: var(--color-text-secondary);
  font-size: 1rem;
  line-height: 1.55;
  max-width: 62ch;
  margin: 0 auto;
  text-wrap: balance;
}
.toolp-panel {
  margin-top: var(--space-8);
  background: var(--color-bg-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  box-shadow: var(--shadow-sm);
}
.toolp-sectionTitle {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--color-deep-blue);
  margin: 0 0 var(--space-3);
}
.toolp-panel ul {
  margin: 0;
  padding-left: var(--space-5);
  color: var(--color-text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
}
.toolp-panel li {
  margin-bottom: var(--space-2);
}
.toolp-panel li strong {
  color: var(--color-text-primary);
}
.toolp-notes {
  border-left: 4px solid var(--color-teal);
}
.toolp-lesson {
  margin: var(--space-4) 0 0;
  color: var(--color-text-primary);
  font-size: 0.95rem;
  line-height: 1.6;
}
.toolp-lesson a {
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--color-deep-blue);
}
.toolp-source {
  margin: 0;
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.toolp-source a {
  color: var(--color-deep-blue);
  /* A link inside a sentence is underlined, so it is not told apart by colour alone. */
  text-decoration: underline;
}
/* The chevrons come from .disclosure. */
.toolp-faq > summary {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin: 0;
}
/* A box that opens, so its edge is a control's edge. */
.toolp-faqItem {
  border: 1px solid var(--color-control-edge);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  background: var(--color-bg);
  margin-top: var(--space-2);
}
/* The question fills the box's padding, so the whole closed box is the
   target, and the box keeps the size it had. */
.toolp-faqItem > .toolp-faqQ {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin: calc(-1 * var(--space-3));
  padding: var(--space-3) 40px var(--space-3) var(--space-3);
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--color-text-primary);
  font-size: 0.95rem;
}
.toolp-faqA {
  margin: var(--space-2) 0 0;
  color: var(--color-text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
}
.toolp-relatedGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
}
.toolp-relatedCard {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: var(--space-4) 40px var(--space-4) var(--space-4);
  background: var(--color-bg);
  border: 1px solid var(--color-link-edge);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: inherit;
}
.toolp-relatedCard:hover,
.toolp-relatedCard:focus-visible {
  border-color: var(--color-deep-blue);
}
.toolp-relatedKicker {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-teal);
}
.toolp-relatedTitle {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--color-deep-blue);
}
.toolp-relatedDesc {
  font-size: 0.88rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
@media (max-width: 800px) {
  .toolp-relatedGrid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 640px) {
  .toolp-wideOnly {
    display: none;
  }
  .toolp-header {
    text-align: left;
    margin-bottom: var(--space-5);
  }
  .toolp-page {
    padding: var(--space-4) var(--space-3) var(--space-8);
  }
  .toolp-panel {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-3);
  }
  .toolp-sectionTitle {
    font-size: 1.15rem;
  }
  .toolp-relatedDesc {
    display: none;
  }
  .toolp-relatedCard {
    padding: var(--space-3) 40px var(--space-3) var(--space-3);
  }
}
</style>
