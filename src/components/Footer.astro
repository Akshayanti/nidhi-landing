---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo">nidhi</span>
        <p class="footer-tagline">Money, understood</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Learn</h4>
          <a href="/blog">Blog</a>
        </div>
        <div class="footer-col">
          <h4>Product</h4>
          <a href="/">Home</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="disclaimer">
        nidhi helps you understand your finances -- it's not a substitute for professional advice.
        Everything here is educational, not a recommendation to buy, sell, or do anything specific with your money.
      </p>
      <p class="footer-copy">&copy; {year} nidhi. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border-light);
    margin-top: var(--space-16);
    padding: var(--space-10) 0 var(--space-6);
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: var(--space-10);
    margin-bottom: var(--space-8);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-deep-blue);
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--color-teal-dark);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  .footer-links {
    display: flex;
    gap: var(--space-10);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-col h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .footer-col a:hover {
    color: var(--color-teal);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-5);
  }

  .footer-bottom .disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .footer-grid {
      flex-direction: column;
      gap: var(--space-6);
    }
  }
</style>