---
import LogoMark from './LogoMark.astro';
const year = new Date().getFullYear();

---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand-row">
          <LogoMark size={28} />
          <span class="footer-logo">nidhi</span>
        </div>
        <p class="footer-tagline">Money, understood</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <strong class="footer-col-heading">Learn</strong>
          <a href="/blog" data-attr="footer-blog">Blog</a>
        </div>
        <div class="footer-col">
          <strong class="footer-col-heading">Free Tools</strong>
          <a href="/free/multi-currency-net-worth" data-attr="footer-multi-currency-net-worth">Multi-currency net worth</a>
          <a href="/free/loan-comparison" data-attr="footer-loan-comparison">Loan comparison</a>
        </div>
        <div class="footer-col">
          <strong class="footer-col-heading">Product</strong>
          <a href="/" data-attr="footer-home">Home</a>
        </div>
        <div class="footer-col">
          <strong class="footer-col-heading">About</strong>
          <a href="/beliefs" data-attr="footer-beliefs">Our Beliefs</a>
          <a href="/privacy" data-attr="footer-privacy">Privacy</a>
        </div>
        <div class="footer-col">
          <strong class="footer-col-heading">Connect</strong>
          <a href="mailto:hello@nidhi.today" class="footer-social" data-attr="footer-email">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            hello@nidhi.today
          </a>
          <a href="https://www.instagram.com/nidhi.today" target="_blank" rel="noopener noreferrer" class="footer-social" data-attr="footer-instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            @nidhi.today
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="disclaimer">
        nidhi offers guidance to help you understand your money, but it's not a licensed financial adviser.
        Our suggestions are educational in nature and shouldn't be treated as professional financial, investment, or tax advice. Past performance of any investment is not indicative of future results. For decisions that matter, consult a qualified professional.
      </p>
      <p class="footer-copy">&copy; {year} nidhi. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border-light);
    margin-top: var(--space-16);
    padding: var(--space-10) 0 var(--space-6);
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: var(--space-10);
    margin-bottom: var(--space-8);
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-deep-blue);
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--color-teal-dark);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-col-heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .footer-col a:hover {
    color: var(--color-teal);
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-social svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-5);
  }

  .footer-bottom .disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .footer-grid {
      flex-direction: column;
      gap: var(--space-6);
    }
  }
</style>