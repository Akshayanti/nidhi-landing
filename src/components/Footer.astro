---
import { DEFAULT_LOCALE, dict, format, type Locale } from '../i18n';
import { isMonteCarloReleased } from '../utils/monte-carlo/release.ts';
import { isInvestOrPayOffReleased } from '../utils/invest-or-pay-off/release.ts';
import { navHref } from './nav.ts';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
const year = new Date().getFullYear();
const showMonteCarlo = await isMonteCarloReleased();
const showInvestOrPayOff = await isInvestOrPayOffReleased();
const href = (path: string) => navHref(locale, path);

---

<footer class="site-footer">
  <div class="container container--wide">
    {/* Four equal columns and no logo block: the header carries the logo on
        every page. Privacy and Cookie settings sit on the copyright line, so
        they stay at the bottom of every page at every width (the privacy
        notice promises Cookie settings there). */}
    <div class="footer-cols">
      <div class="footer-col">
        <strong class="footer-col-heading">{strings.footer.columns.learn}</strong>
        <a href={href('/blog/')} data-attr="footer-blog">{strings.footer.links.blog}</a>
        <a href={href('/blog/tag/')} data-attr="footer-blog-topics">{strings.footer.links.blogTopics}</a>
        <a href={href('/blog/glossary/')} data-attr="footer-blog-glossary">{strings.footer.links.glossary}</a>
        <a href={href('/editorial-policy/')} data-attr="footer-editorial-policy">{strings.footer.links.editorialPolicy}</a>
      </div>
      <div class="footer-col">
        <strong class="footer-col-heading">{strings.footer.columns.tools}</strong>
        <a href={href('/free/multi-currency-net-worth/')} data-attr="footer-multi-currency-net-worth">{strings.footer.links.multiCurrencyNetWorth}</a>
        <a href={href('/free/loan-comparison/')} data-attr="footer-loan-comparison">{strings.footer.links.loanComparison}</a>
        {showMonteCarlo && <a href={href('/free/monte-carlo-simulator/')} data-attr="footer-monte-carlo-simulator">{strings.footer.links.monteCarloSimulator}</a>}
        <a href={href('/free/inflation-calculator/')} data-attr="footer-inflation-calculator">{strings.footer.links.inflationCalculator}</a>
        {showInvestOrPayOff && <a href={href('/free/invest-or-pay-off/')} data-attr="footer-invest-or-pay-off">{strings.footer.links.investOrPayOff}</a>}
        <a href={href('/free/')} data-attr="footer-all-tools">{strings.footer.links.allTools}</a>
      </div>
      <div class="footer-col">
        <strong class="footer-col-heading">{strings.footer.columns.about}</strong>
        <a href={href('/about/')} data-attr="footer-about">{strings.footer.links.about}</a>
        <a href={href('/beliefs/')} data-attr="footer-beliefs">{strings.footer.links.beliefs}</a>
        <a href={href('/beta/')} data-attr="footer-beta">{strings.footer.links.beta}</a>
        <a href={href('/changes/')} data-attr="footer-changes">{strings.footer.links.changes}</a>
      </div>
      <div class="footer-col">
        <strong class="footer-col-heading">{strings.footer.columns.connect}</strong>
        <a href="mailto:hello@nidhi.today" class="footer-social" data-attr="footer-email">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          hello@nidhi.today
        </a>
        <a href="https://www.instagram.com/nidhi.today" target="_blank" rel="noopener noreferrer" class="footer-social" data-attr="footer-instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          @nidhi.today
        </a>
        <a href={href('/volunteers/')} data-attr="footer-volunteers">{strings.footer.links.volunteers}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="disclaimer">
        {strings.footer.disclaimerShort}{' '}<span class="footer-wideOnly">{strings.footer.disclaimerLong}</span>
      </p>
      <p class="footer-copy">
        <span class="footer-copyText">{format(strings.footer.copyright, { year })}</span>
        <a href={href('/privacy/')} data-attr="footer-privacy">{strings.footer.links.privacy}</a>
        <button type="button" class="footer-cookieSettings" data-cookie-settings data-attr="footer-cookie-settings">{strings.footer.links.cookieSettings}</button>
        <a href="/third-party-notices.txt">{strings.footer.links.thirdParty}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border-light);
    margin-top: var(--space-16);
    padding: var(--space-10) 0 var(--space-6);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 32px;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 900px) {
    .footer-cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .footer-col-heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-1);
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  .footer-col a:hover,
  .footer-copy a:hover,
  .footer-cookieSettings:hover,
  .footer-cookieSettings:focus-visible {
    color: var(--color-teal);
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-social svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-5);
  }

  .footer-bottom .disclaimer {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0 0 var(--space-3);
    padding: 16px 20px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-text-muted) 10%, transparent);
  }

  /* The copyright line carries the legal links: Privacy, Cookie settings
     (an action, so a button styled like the links beside it) and the
     third-party licences. */
  .footer-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer-copy a,
  .footer-cookieSettings {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font: inherit;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  /* Phones: the header menu carries the site's links, so the footer keeps
     only what must sit at the bottom of every page: a one-sentence
     disclaimer and the copyright line with Privacy and Cookie settings. */
  @media (max-width: 640px) {
    .site-footer {
      margin-top: var(--space-10);
      padding: var(--space-5) 0;
    }

    .footer-cols,
    .footer-wideOnly { display: none; }

    .footer-bottom {
      border-top: 0;
      padding-top: 0;
    }

    .footer-bottom .disclaimer { font-size: 0.9375rem; }

    .footer-copy { font-size: 0.875rem; }
    .footer-copyText { flex-basis: 100%; }

    .footer-copy a,
    .footer-cookieSettings { min-height: 44px; font-size: 0.9375rem; }
  }
</style>
