---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistSection from '../components/WaitlistSection.astro';

// New landing page redesign. Lives at /index2/ during the parallel
// review period with robots="noindex,nofollow" and is excluded from the
// sitemap (see astro.config.mjs). Once approved, this file's contents
// replace src/pages/index.astro and the noindex + sitemap exclusion are
// dropped. See docs/plans/landing-page-redesign.md for the full plan
// and docs/plans/landing-wireframe.html for the wireframe.

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Personal finance planning across currencies. Track net worth, project financial independence, and compare decisions before you make them.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Personal finance planning across currencies, retirement projections, and decision comparison.',
  // SearchAction wired up in PR4. The blog index honours `?q=` as a
  // deep link and writes the value back into the URL via
  // `replaceState` as the search field changes (see
  // `src/components/LearningPath.tsx`). Carrying the schema on the
  // parked redesign so the behaviour and the declaration stay in sync
  // when /index2/ graduates to / in PR18.
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://nidhi.today/',
    },
  ],
};

// Pre-launch CTA. Swaps to "Get beta access" at beta and
// "Sign up free" at public release. Single-line edit per phase.
const heroCta = 'Notify me at launch';
---

<BaseLayout
  title="nidhi | Personal Finance Planning Across Currencies"
  description="Track net worth across currencies, project when you can stop working, and compare decisions before you make them. Free during beta, free tier always after."
  jsonLd={[organizationSchema, webSiteSchema, breadcrumbSchema]}
  robots="noindex,nofollow"
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  <slot name="head" slot="head">
    {/* Frankfurter is used by the hero's live FX caption. Preconnecting
        here lands the rates request faster on first paint. */}
    <link rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
  </slot>

  {/* =============================================================
       Section 1: Hero
       ============================================================= */}
  <section class="lp-section snap-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lp-eyebrow">Money, understood</p>
          <h1 id="hero-heading">See your full financial picture, in any currency.</h1>
          <p class="lp-subhead">
            Track net worth across currencies, project when you can stop working, and compare decisions before you make them.
          </p>

          <WaitlistSection variant="hero" cta={heroCta} />

          <p class="hero-trust-line">
            Built because no planner handled my actual life: assets in three currencies, debts in two, retirement that crossed borders. Free during beta, free tier always after. <a href="/beliefs/">More on our beliefs.</a>
          </p>
        </div>

        <div class="hero-visual-wrap" aria-hidden="false">
          <div class="lp-visual-card">
            {/*
              Hero visual: a summary card. Two stacked panels.

              Top panel (y 0..148): big total + horizontal stacked bar
                showing the EUR/USD/INR mix. The stacked bar is a
                deliberately different idiom from section 2's labelled
                donut: same data, different shape, so the hero does not
                read as a small copy of the multi-currency snap.

              Bottom panel (y 148..340): a short-horizon sparkline with
                a "today" marker. Solid line for the last 12 months,
                dashed continuation for the next 12. No FI target, no
                crossing year, no assumptions: that's section 3's job,
                and putting any of it here would make the hero compete
                with the projection deep-dive.

              No forecast cone, no probability band: those visuals read
              as Monte Carlo, which is roadmap, not launch.
            */}
            <svg
              viewBox="0 0 360 340"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-labelledby="hero-svg-title hero-svg-desc"
            >
              <title id="hero-svg-title">Example output</title>
              <desc id="hero-svg-desc">A summary card showing a net worth of EUR 124,300 split across three currencies (EUR 62%, USD 28%, INR 10%), above a sparkline that traces the last twelve months of growth and continues with a dashed twelve-month projection.</desc>

              {/* Top panel: total + currency stacked bar */}
              <text x="180" y="32" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" font-weight="700" letter-spacing="0.12em" fill="var(--color-text-muted)">NET WORTH</text>
              <text x="180" y="72" text-anchor="middle" font-family="Inter,sans-serif" font-size="28" font-weight="700" fill="var(--color-deep-blue)">EUR 124,300</text>

              {/* Stacked bar: EUR (62% = 173.6) + USD (28% = 78.4) + INR (10% = 28).
                  Outer corners rounded only on the leftmost and rightmost
                  segments so the whole bar reads as a single capsule. */}
              <g transform="translate(40,92)">
                <rect x="0" y="0" width="173.6" height="10" fill="var(--chart-eur)" rx="2" ry="2" />
                <rect x="173.6" y="0" width="78.4" height="10" fill="var(--chart-usd)" />
                <rect x="252" y="0" width="28" height="10" fill="var(--chart-inr)" rx="2" ry="2" />
              </g>

              <text x="180" y="125" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="var(--color-text-secondary)">EUR 62%  &#183;  USD 28%  &#183;  INR 10%</text>

              {/* Divider between panels */}
              <line x1="40" y1="148" x2="320" y2="148" stroke="var(--color-border-light)" stroke-width="1" />

              {/* Bottom panel: short-horizon track */}
              <text x="180" y="168" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="700" letter-spacing="0.12em" fill="var(--color-text-muted)">12-MONTH TRACK</text>

              {/* Subtle gridlines: top, mid, axis */}
              <line x1="40" y1="190" x2="320" y2="190" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="245" x2="320" y2="245" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="300" x2="320" y2="300" stroke="var(--color-border-light)" />

              {/* Solid historical sparkline: 12 months ago to today.
                  Faintly filled below to give the hero some weight. */}
              <polygon points="40,288 70,282 100,275 130,265 160,250 180,235 180,300 40,300" fill="var(--chart-eur)" opacity="0.08" />
              <polyline points="40,288 70,282 100,275 130,265 160,250 180,235" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />

              {/* "Today" marker on the historical-to-forecast handoff */}
              <circle cx="180" cy="235" r="4" fill="var(--chart-eur)" stroke="var(--color-bg-white)" stroke-width="2" />

              {/* Dashed forecast continuation. Slightly less steep than
                  the historical to suggest the projection is conservative;
                  the visual difference between solid and dashed alone is
                  enough to read as "this part is projected." */}
              <polyline points="180,235 215,222 250,210 285,198 320,190" stroke="var(--chart-eur)" stroke-width="2" stroke-dasharray="4,3" fill="none" stroke-linecap="round" stroke-linejoin="round" />

              {/* Axis labels */}
              <text x="40" y="320" text-anchor="start" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">12 mo ago</text>
              <text x="180" y="320" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="var(--color-text-secondary)">today</text>
              <text x="320" y="320" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+ 12 mo</text>
            </svg>
            <p class="lp-visual-caption">
              Example output<span class="lp-example-badge">illustrative</span>
              <br />
              <span id="hero-fx-caption" aria-live="polite">Live ECB rate: loading&hellip;</span>
            </p>
          </div>
        </div>
      </div>

      <a class="lp-scroll-affordance" href="#multi-currency" aria-label="Scroll to next section">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* =============================================================
       Section 2: Multi-currency net worth
       ============================================================= */}
  <section class="lp-section lp-section--alt snap-section" id="multi-currency" aria-labelledby="cap-mc-heading">
    <div class="lp-section-inner">
      <div class="cap-grid">
        <div class="cap-copy">
          <h2 id="cap-mc-heading">See your wealth in any currency, all at once.</h2>
          <p class="cap-body">
            Track every asset and liability in any currency. See your net worth in your spending currency, with live ECB rates. See where the concentration sits, and where it should not.
          </p>
        </div>
        <div class="cap-visual">
          <div class="lp-visual-card">
            <svg
              viewBox="0 0 480 320"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-labelledby="cap-mc-svg-title cap-mc-svg-desc"
            >
              <title id="cap-mc-svg-title">Multi-currency net worth example</title>
              <desc id="cap-mc-svg-desc">A list of multi-currency assets with their values, a donut showing the currency split (62% EUR, 28% USD, 10% INR), and a total of EUR 451,200.</desc>

              <text x="20" y="28" font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-muted)">TOTAL NET WORTH</text>
              <text x="20" y="58" font-family="Inter,sans-serif" font-size="24" font-weight="700" fill="var(--color-deep-blue)">EUR 451,200</text>
              <line x1="20" y1="80" x2="460" y2="80" stroke="var(--color-border-light)" />

              <g font-family="Inter,sans-serif" font-size="13" fill="var(--color-text-primary)">
                <text x="20" y="105">Apartment, Prague</text>
                <text x="460" y="105" text-anchor="end" fill="var(--color-text-secondary)">EUR 280,000</text>

                <text x="20" y="135">Brokerage, US</text>
                <text x="460" y="135" text-anchor="end" fill="var(--color-text-secondary)">USD  47,300</text>

                <text x="20" y="165">Savings, India</text>
                <text x="460" y="165" text-anchor="end" fill="var(--color-text-secondary)">INR 8,40,000</text>

                <text x="20" y="195" fill="var(--color-text-muted)">Mortgage, EUR</text>
                <text x="460" y="195" text-anchor="end" fill="var(--color-text-muted)">EUR -110,000</text>
              </g>

              <line x1="20" y1="215" x2="460" y2="215" stroke="var(--color-border-light)" />

              {/* Same 62/28/10 split as the hero donut, scaled to r=28. */}
              <g transform="translate(70,275)">
                <path d="M 0 -28 A 28 28 0 1 1 -19.17 20.41 L 0 0 Z" fill="var(--chart-eur)" />
                <path d="M -19.17 20.41 A 28 28 0 0 1 -16.46 -22.65 L 0 0 Z" fill="var(--chart-usd)" />
                <path d="M -16.46 -22.65 A 28 28 0 0 1 0 -28 L 0 0 Z" fill="var(--chart-inr)" />
                <circle cx="0" cy="0" r="16" fill="var(--color-bg-white)" />
              </g>
              <g font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-secondary)">
                <rect x="120" y="262" width="9" height="9" fill="var(--chart-eur)" rx="2" />
                <text x="135" y="270">EUR 62%</text>
                <rect x="210" y="262" width="9" height="9" fill="var(--chart-usd)" rx="2" />
                <text x="225" y="270">USD 28%</text>
                <rect x="300" y="262" width="9" height="9" fill="var(--chart-inr)" rx="2" />
                <text x="315" y="270">INR 10%</text>
                <text x="120" y="293" fill="var(--color-text-muted)">Currency split, all converted to EUR</text>
              </g>
            </svg>
            <p class="lp-visual-caption">
              Example output<span class="lp-example-badge">illustrative</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       Section 3: Projections
       ============================================================= */}
  <section class="lp-section snap-section" id="projections" aria-labelledby="cap-proj-heading">
    <div class="lp-section-inner">
      <div class="cap-grid cap-grid--reverse">
        <div class="cap-copy">
          <h2 id="cap-proj-heading">Know when you can stop working.</h2>
          <p class="cap-body">
            Inflation-adjusted projections for net worth, retirement, and financial independence. The assumptions are visible alongside the answer. Change them, and watch the year move.
          </p>
        </div>
        <div class="cap-visual">
          <div class="lp-visual-card">
            <svg
              viewBox="0 0 480 280"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-labelledby="cap-proj-svg-title cap-proj-svg-desc"
            >
              <title id="cap-proj-svg-title">Projections example</title>
              <desc id="cap-proj-svg-desc">A net-worth projection from today rising to cross a horizontal financial-independence target line at year 16, with the underlying assumptions (real return, inflation, savings rate) listed below.</desc>

              {/* Gridlines */}
              <line x1="40" y1="40" x2="460" y2="40" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="100" x2="460" y2="100" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="160" x2="460" y2="160" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="220" x2="460" y2="220" stroke="var(--color-border-light)" />

              {/*
                Single deterministic projection. No fanned cone, no
                probability band, no dashed median: a probabilistic visual
                would read as Monte Carlo, which is roadmap, not launch.
                The trajectory is concave-up to suggest compound growth
                without overclaiming a specific simulation method.
              */}

              {/* FI target line, with its label anchored at the left end
                  so the rising forecast (which passes through the upper
                  right of the chart) does not collide with the label. */}
              <line x1="40" y1="80" x2="460" y2="80" stroke="var(--color-teal)" stroke-width="1.5" />
              <text x="46" y="72" text-anchor="start" font-family="Inter,sans-serif" font-size="10" fill="var(--color-teal)" font-weight="600">Financial independence</text>

              {/* Historical sparkline (last 12 months before today) */}
              <polyline points="40,210 60,205 80,195 100,180" stroke="var(--color-text-secondary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />

              {/* Forecast line: solid, single trajectory, concave-up. */}
              <polyline points="100,180 160,170 220,150 280,118 340,72 400,45 460,30" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />

              {/* Crossing point at the FI target. Drop-line down to the
                  time axis carries the eye to the year label. */}
              <circle cx="330" cy="80" r="5" fill="var(--chart-eur)" stroke="var(--color-bg-white)" stroke-width="2" />
              <line x1="330" y1="80" x2="330" y2="220" stroke="var(--color-text-muted)" stroke-dasharray="2,2" />
              <text x="330" y="255" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-primary)" font-weight="600">Reaches FI at year 16</text>

              <text x="40" y="240" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">today</text>
              <text x="460" y="240" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+25 years</text>

              {/* Axis assumptions. y=268 leaves room for descenders inside
                  the 280-tall viewBox; middle-dot separators keep the
                  rhythm even where SVG collapses whitespace. */}
              <text x="40" y="268" font-family="Inter,sans-serif" font-size="10" fill="var(--color-text-muted)">Real returns 5%  &#183;  Inflation 2.5% (EUR)  &#183;  Savings rate 38%</text>
            </svg>
            <p class="lp-visual-caption">
              Example output<span class="lp-example-badge">illustrative</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       Section 4: What-if scenarios
       ============================================================= */}
  <section class="lp-section lp-section--alt snap-section" id="what-if" aria-labelledby="cap-wi-heading">
    <div class="lp-section-inner">
      <div class="cap-grid">
        <div class="cap-copy">
          <h2 id="cap-wi-heading">Compare decisions before you make them.</h2>
          <p class="cap-body">
            Run two paths side by side. Higher savings rate, different asset mix, foreign-currency mortgage, retirement in a different country. Each gives a yes-or-no, not a guess.
          </p>
        </div>
          <div class="cap-visual">
            <div class="lp-visual-card">
            {/* Two-line comparison. viewBox kept at 480x280 to match
                section 3's aspect ratio. Chart data area: x=40..400.
                Right gutter (400..470) holds the line labels and the
                gap annotation. Outcome line sits at y=255, centered.
                Earlier draft had a dual footer ("Retire 3 years sooner"
                + "Net worth at 60: +EUR 220k") that mixed timeframes
                (20-year horizon vs age 60) and implied an FI threshold
                the chart never drew; both replaced by a single delta
                that the chart itself visualises. */}
            <svg
              viewBox="0 0 480 280"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-labelledby="cap-wi-svg-title cap-wi-svg-desc"
            >
              <title id="cap-wi-svg-title">What-if comparison example</title>
              <desc id="cap-wi-svg-desc">Two net-worth paths over twenty years. The path where the saver puts away five percentage points more ends about EUR 220,000 higher.</desc>

              <line x1="40" y1="40" x2="400" y2="40" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="120" x2="400" y2="120" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
              <line x1="40" y1="200" x2="400" y2="200" stroke="var(--color-border-light)" />

              <polyline points="40,200 100,180 160,155 220,125 280,95 340,68 400,50" stroke="var(--chart-usd)" stroke-width="2.5" fill="none" stroke-linecap="round" />
              <text x="406" y="54" font-family="Inter,sans-serif" font-size="10" fill="var(--chart-usd)" font-weight="600">Save +5pp</text>

              <polyline points="40,200 100,190 160,178 220,160 280,140 340,118 400,95" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" />
              <text x="406" y="99" font-family="Inter,sans-serif" font-size="10" fill="var(--chart-eur)" font-weight="600">Current</text>

              <text x="40" y="220" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">today</text>
              <text x="400" y="220" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+20 years</text>

              <text x="240" y="255" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" font-weight="600" fill="var(--color-text-primary)">After 20 years: about EUR 220k more by saving 5pp extra.</text>
            </svg>
            <p class="lp-visual-caption">
              Example output<span class="lp-example-badge">illustrative</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       No standalone "free tools" section on the landing page.

       The header dropdown ("Free Tools") and the footer column already
       link the two shipped tools and the /free/ index page on every
       route. Repeating that on the home page interrupted the conversion
       narrative (hero -> capabilities -> self-check -> trust ->
       waitlist) and created a small messaging conflict: the hero
       promises an upcoming product, but a "the multi-currency one
       already works today" section sat directly under it. Free tools
       still ship, still rank on their own pages, and are still
       discoverable from every page's chrome; they just don't compete
       with the waitlist CTA on this one.
       ============================================================= */}

  {/* =============================================================
       Conversion tail. Deliberately NOT a snap section: it scrolls
       naturally as the page's conclusion. Order is intentional:
         self-check (priming) -> trust strip (friction removal) ->
         waitlist form (conversion).
       Footer.astro renders below <main> in the default Astro flow.
       ============================================================= */}
  <section class="lp-section lp-section--alt lp-section--tail" id="signup" aria-labelledby="self-check-heading">
    <div class="lp-section-inner">

      <div class="self-check">
        <h3 id="self-check-heading">nidhi is for you if:</h3>
        <ul>
          <li>You hold money or debts in more than one currency.</li>
          <li>You have moved countries, or plan to, and your savings have not caught up.</li>
          <li>You want to know, with some confidence, when you can stop working.</li>
          <li>You want to see what changes if you save five percent more, or take a lower-paying job you actually want.</li>
          <li>Your retirement depends on where you eventually live.</li>
          <li>Your spreadsheet has stopped keeping up, or you would rather not maintain one at all.</li>
        </ul>
        <p class="self-check-cta">If any of these sound like you, drop your email below.</p>
      </div>

      <div class="trust-strip" aria-label="Privacy and data handling">
        <p class="trust-strip-title">What this means for your data</p>
        <ul>
          <li>Free-tool calculations run entirely in your browser. Your numbers never leave the page.</li>
          <li>No ads. No data selling. Analytics on EU servers only (PostHog Cloud EU).</li>
          <li>We never share or sell your email. One click to unsubscribe from anything.</li>
          <li>GDPR-aware. <a href="/privacy/">Read the full privacy policy.</a></li>
        </ul>
      </div>

      <WaitlistSection />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Live ECB rate caption in the hero. One fetch on page load, no polling.
  // Same Frankfurter API the multi-currency tool uses (already disclosed
  // in the privacy policy as a third-party call). Fails silently if the
  // request errors or the network is offline.
  (function () {
    var el = document.getElementById('hero-fx-caption');
    if (!el) return;
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=USD')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (data) {
        var rate = data && data.rates && data.rates.USD;
        if (rate) {
          el.textContent = 'Live ECB rate: 1 EUR = ' + rate.toFixed(4) + ' USD';
        } else {
          el.style.display = 'none';
        }
      })
      .catch(function () {
        el.style.display = 'none';
      });
  })();
</script>

<style>
  /* ----------------------------------------------------------------
     Section frame.
     Each .lp-section is at least 100dvh tall on the landing page
     (rule lives in global.css under body[data-page="landing"]). The
     padding-top accounts for the fixed/sticky header (60px) plus
     breathing room.
     ---------------------------------------------------------------- */
  .lp-section {
    padding: 96px 24px 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lp-section--alt { background: var(--color-bg-white); }

  /* The tail section (section 6) does not snap and does not need to
     fill a viewport. It carries self-check + trust strip + waitlist,
     and its natural height is what we want to render. */
  .lp-section--tail {
    min-height: 0 !important;
