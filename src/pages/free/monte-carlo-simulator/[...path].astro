---
/**
 * The English Monte Carlo simulator page.
 *
 * A rest route so the page can be left out of the production build until the
 * tool launches with post 43 (see src/utils/monte-carlo/release.ts), and a thin
 * wrapper so that both languages render one component: the page itself is
 * `src/components/pages/MonteCarloPage.astro`, and the Hindi edition comes
 * through `src/pages/[locale]/free/monte-carlo-simulator/[...path].astro`.
 *
 * When released it builds exactly one page, at /free/monte-carlo-simulator/.
 */
import MonteCarloPage from '../../../components/pages/MonteCarloPage.astro';
import { isMonteCarloReleased } from '../../../utils/monte-carlo/release.ts';

export async function getStaticPaths() {
  return (await isMonteCarloReleased()) ? [{ params: { path: undefined } }] : [];
}
---

<MonteCarloPage locale="en" />
