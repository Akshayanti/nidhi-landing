---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MultiCurrencyNetWorth from '../../components/MultiCurrencyNetWorth.tsx';
import { getCollection } from 'astro:content';

const RELATED_CANDIDATES = [
  {
    slug: 'managing-money-across-currencies',
    kicker: 'Currency management',
    title: 'Managing money across currencies',
    desc: 'Practical strategies for earning, saving, and spending in multiple currencies without losing money to FX fees.',
    dataAttr: 'related-multi-currency',
  },
  {
    slug: 'setting-financial-goals',
    kicker: 'Planning',
    title: 'Setting financial goals',
    desc: 'Why your goals should drive your asset allocation, including which currencies you hold.',
    dataAttr: 'related-goals',
  },
  {
    slug: 'net-worth',
    kicker: 'Fundamentals',
    title: 'What is net worth and why it matters',
    desc: 'Assets minus liabilities: the simplest measure of financial health, explained currency by currency.',
    dataAttr: 'related-net-worth',
  },
  {
    slug: 'introduction-to-financial-independence',
    kicker: 'FIRE',
    title: 'Introduction to financial independence',
    desc: 'The basics of FIRE and why currency diversification matters when your retirement spans countries.',
    dataAttr: 'related-fire-intro',
  },
  {
    slug: 'assets-vs-liabilities',
    kicker: 'Fundamentals',
    title: 'Assets vs liabilities',
    desc: 'Knowing the difference is the first step to understanding your true net worth in any currency.',
    dataAttr: 'related-assets-liabilities',
  },
];

const isDev = import.meta.env.DEV;
const now = new Date();
const publishedSlugs = new Set(
  (await getCollection('blog'))
    .filter((post) => isDev || post.data.pubDate <= now)
    .map((post) => post.data.slug),
);
const RELATED = RELATED_CANDIDATES.filter((c) => publishedSlugs.has(c.slug)).slice(0, 3);

const title =
  'Multi-Currency Net Worth Calculator & Currency Risk Analyzer | nidhi';
// Trimmed to ~155 chars so Google does not chop the privacy hook
// ("everything runs in your browser") off the end of the SERP snippet.
// 60 < title <= 70, 150 < description <= 160 are the practical sweet spots.
const description =
  'Free multi-currency net worth calculator. See your net worth in any of 29 currencies with live ECB rates. Runs in your browser; nothing is sent.';
const keywords = [
  'multi-currency net worth calculator',
  'net worth in any currency',
  'expat net worth calculator',
  'multi-currency net worth',
  'net worth across countries',
  'net worth by currency',
  'net worth currency breakdown',
  'currency risk calculator',
  'currency exposure calculator',
  'currency concentration',
  'foreign exchange risk',
  'multi-currency portfolio analyzer',
  'expat financial planning',
  'currency diversification',
  'cross currency exposure',
  'FX risk analyzer',
  'functional currency',
  'EUR USD INR GBP currency calculator',
];

const faqs = [
  {
    q: 'How does the multi-currency net worth calculator work?',
    a: 'You add your assets and liabilities with their currency and current value. The tool fetches live ECB reference exchange rates (via the free Frankfurter API), converts everything to your chosen functional currency, and shows your total net worth as a single number. Below that, it shows your currency concentration as a donut chart and flags any non-functional currency where you have elevated exposure.',
  },
  {
    q: 'What is currency concentration risk?',
    a: 'If a large portion of your net worth is in a currency you don\'t spend in, a swing in the exchange rate changes your real purchasing power. For example, if you plan to retire in Europe but hold 70% of your wealth in USD, a 10% move in USD/EUR (a magnitude EUR/USD has seen in many calendar years) would shift your retirement fund by roughly 7% measured in euros.',
  },
  {
    q: 'Does this send my financial data anywhere?',
    a: 'No. Everything runs in your browser. Your asset names, values, and currencies are never sent to any server. The only external request is to the Frankfurter API to fetch exchange rates, and that request only includes your functional currency code, not your asset data. Shareable links encode your data into the URL, and you control whether to share.',
  },
  {
    q: 'Which currencies are supported?',
    a: 'Twenty-nine currencies are supported, including the Euro (EUR), US Dollar (USD), British Pound (GBP), Swiss Franc (CHF), Japanese Yen (JPY), Indian Rupee (INR), Chinese Yuan (CNY), Canadian Dollar (CAD), Australian Dollar (AUD), Singapore Dollar (SGD), and the Nordic, Central European, Latin American, and South-East Asian majors. Exchange rates are fetched from the ECB via Frankfurter, which are reference rates and may differ from the rates available to retail customers at their bank.',
  },
  {
    q: 'What\'s the difference between the "Full" and "Redacted" share modes?',
    a: 'Full mode includes all your asset names, values, currencies, and types in the URL: anyone with the link can see your full breakdown and verify the math. Redacted mode includes only the per-currency concentration percentages and the band labels: no amounts, no asset names. Both are copied to your clipboard as a single link, and you choose which to send.',
  },
  {
    q: 'How are exchange rates sourced?',
    a: 'Rates come from the European Central Bank via the free Frankfurter API (frankfurter.app). They are reference rates updated daily on ECB business days, intended as benchmarks rather than transactable quotes. The rates you actually receive at your bank or broker include a spread and may be materially different, especially for smaller currencies. No API key is required, and the request is made directly from your browser.',
  },
  {
    q: 'What does "functional currency" mean?',
    a: 'Your functional currency is the currency you primarily spend and live in. It\'s the one your bills, rent, and groceries are priced in. We exclude it from risk flagging because having most of your wealth in your spending currency is normal and desirable.',
  },
  {
    q: 'What do "low", "moderate", and "elevated" mean?',
    a: 'They are descriptive bands for non-functional currencies: under 20% of net worth is "low", 20-40% is "moderate", and over 40% is "elevated". They describe concentration size, not what you should do about it. Whether a given level fits your situation depends on your future spending plans, where you intend to retire, and how you choose to balance currency risk with other goals.',
  },
  {
    q: 'Can I include debts and liabilities?',
    a: 'Yes. Each row has an Asset/Liability toggle. Liability amounts are subtracted from that currency\'s net position. If you have a USD mortgage alongside USD savings, the tool shows your net USD exposure. A currency where you owe more than you hold gets flagged as "Net debt."',
  },
  {
    q: 'How does the CSV upload work?',
    a: 'Create a CSV file with columns: name (optional), value (required), currency (required, 3-letter code), type (optional, "asset" or "liability", defaults to asset). Click "Upload CSV", pick the file, and the rows populate automatically. Any invalid rows are listed with line numbers so you can fix them. Uploading replaces existing data after a confirmation prompt.',
  },
];

const canonicalUrl = 'https://nidhi.today/free/multi-currency-net-worth/';

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'nidhi Multi-Currency Net Worth & Currency Risk Analyzer',
  alternateName: [
    'nidhi Multi-Currency Net Worth Calculator',
    'nidhi Net Worth Calculator for Expats',
    'nidhi Currency Risk Analyzer',
    'nidhi Currency Exposure Calculator',
    'nidhi FX Risk Tool',
    'nidhi Currency Concentration Checker',
  ],
  url: canonicalUrl,
  description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (web browser)',
  browserRequirements: 'Requires JavaScript. Modern browser.',
  isAccessibleForFree: true,
  featureList: [
    'Calculate total net worth across 29 currencies in your chosen functional currency',
    'Add unlimited assets and liabilities in any supported currency',
    'Live ECB reference exchange rates via Frankfurter API',
    'Currency concentration donut chart',
    'Per-currency risk assessment (low, moderate, elevated)',
    'Asset/liability toggle for net position calculation',
    'CSV bulk upload',
    'Dual sharing modes: full data and anonymous',
    'Everything runs in your browser; no data sent to any server',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'nidhi',
    url: 'https://nidhi.today/',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nidhi.today/' },
    { '@type': 'ListItem', position: 2, name: 'Multi-currency net worth & currency risk analyzer', item: canonicalUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  jsonLd={[webAppSchema, breadcrumbSchema, faqSchema]}
>
  {/*
    Preconnect to the Frankfurter FX API so the first rates request on
    page load isn't gated on a fresh DNS lookup + TLS handshake. The
    rates fetch fires in MultiCurrencyNetWorth.tsx as soon as the React
    island hydrates; the preconnect typically saves 50-150 ms on the
    first paint with conversion data.
  */}
  <link slot="head" rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
  <section class="mcnw-page">
    <nav class="mcnw-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Multi-currency net worth &amp; currency risk</li>
      </ol>
    </nav>

    <header class="mcnw-pageHeader">
      <p class="mcnw-eyebrow">Free tools</p>
      <h1 class="mcnw-pageTitle">
        Multi-currency net worth calculator and currency risk analyzer
      </h1>
      <p class="mcnw-pageLead">
        Add your assets and liabilities in any currency. See your real net
        worth in your chosen currency with live ECB rates, then check how
        much of it sits in currencies you don&rsquo;t actually spend in.
        Everything runs in your browser. Nothing is sent to a server.
        Supports USD, EUR, GBP, INR, JPY, and 24 more.
      </p>
    </header>

    <MultiCurrencyNetWorth client:load />

    <section class="mcnw-explainer" aria-labelledby="mcnw-explainer-h">
      <h2 id="mcnw-explainer-h" class="mcnw-sectionTitle">How the calculation works</h2>
      <p>
        For each currency, we net your assets and liabilities, then convert
        the result to your functional currency using live exchange rates.
        Sum those converted positions and you have your total net worth in
        one currency. Each currency&rsquo;s share of that total is your
        concentration:
      </p>
      <p class="mcnw-formula">
        <code>
          Concentration % = (Net in currency X &times; Rate to functional) / Total net worth &times; 100
        </code>
      </p>
      <ul class="mcnw-explainerList">
        <li>
          <strong>Net position</strong> per currency = sum of assets minus sum
          of liabilities in that currency. A negative net means you owe more
          than you hold in that currency.
        </li>
        <li>
          <strong>Rate to functional</strong> is the multiplier that converts
          one unit of currency X into your functional currency, sourced live
          from the European Central Bank via the Frankfurter API and fetched
          directly by your browser. Rates update daily on business days. ECB
          reference rates are benchmarks and may differ from the rates your
          bank or broker actually offers.
        </li>
        <li>
          <strong>Concentration bands</strong> apply only to non-functional
          currencies (currencies you don't spend in). Under 20% is low, 20-40%
          is moderate, and over 40% is elevated. They describe how big a
          share of net worth sits in that currency, not what to do
          about it. Your functional currency is never flagged.
        </li>
        <li>
          <strong>Net vs. gross exposure.</strong> Concentration is computed
          on net positions. If you have a large foreign-currency debt that
          offsets a foreign-currency asset (for example a USD mortgage and
          a USD savings account), the net position is small but your gross
          FX exposure on each side is much larger. This tool measures the
          net; consider the gross figures separately when sizing real-world
          exchange-rate risk.
        </li>
        <li>
          <strong>All computation is client-side.</strong> Your asset names,
          values, and totals never leave your browser. The only network
          request is a one-time exchange rate fetch from Frankfurter, which
          carries your functional currency code (e.g. <code>?from=EUR</code>)
          and nothing about your assets.
        </li>
      </ul>
    </section>

    <details class="mcnw-faq" aria-labelledby="mcnw-faq-h">
      <summary id="mcnw-faq-h" class="mcnw-faqHeading">
        <span class="mcnw-sectionTitle">Frequently asked questions</span>
        <span class="mcnw-faqHeadingCount" aria-hidden="true">{faqs.length}</span>
      </summary>
      <div class="mcnw-faqList">
        {faqs.map((f) => (
          <details class="mcnw-faqItem">
            <summary class="mcnw-faqQ">{f.q}</summary>
            <p class="mcnw-faqA">{f.a}</p>
          </details>
        ))}
      </div>
    </details>

    <aside class="mcnw-related" aria-labelledby="mcnw-related-h">
      <header class="mcnw-relatedHeader">
        <h2 id="mcnw-related-h" class="mcnw-sectionTitle">Understand your money across borders</h2>
        <p class="mcnw-relatedLead">
          Reads for the multi-currency household.
        </p>
      </header>

      <div class="mcnw-relatedGrid">
        {RELATED.map((post) => (
          <a href={`/blog/${post.slug}`} class="mcnw-relatedCard" data-attr={post.dataAttr}>
            <span class="mcnw-relatedKicker">{post.kicker}</span>
            <span class="mcnw-relatedTitle">{post.title}</span>
            <span class="mcnw-relatedDesc">{post.desc}</span>
          </a>
        ))}
      </div>

      <p class="mcnw-relatedFooter">
        <a href="/blog/tag/currency/" class="mcnw-relatedAll" data-attr="related-tag-currency">
          Read more on currency management
          <span aria-hidden="true">&nbsp;&rsaquo;</span>
        </a>
        <a href="/blog/" class="mcnw-relatedAllSecondary" data-attr="related-all">
          Or browse every article
        </a>
      </p>
    </aside>
  </section>
</BaseLayout>

<style>
  .mcnw-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-12);
  }

  .mcnw-breadcrumbs {
    margin-bottom: var(--space-3);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .mcnw-breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .mcnw-breadcrumbs li + li::before {
    content: '/';
    margin-right: 4px;
    color: var(--color-text-muted);
  }
  .mcnw-breadcrumbs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .mcnw-breadcrumbs a:hover,
  .mcnw-breadcrumbs a:focus-visible {
    color: var(--color-deep-blue);
    text-decoration: underline;
  }
  .mcnw-breadcrumbs [aria-current="page"] {
    color: var(--color-text-primary);
  }

  .mcnw-pageHeader {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .mcnw-eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal);
    margin: 0 0 var(--space-2);
  }

  .mcnw-pageTitle {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.6rem, 2.4vw + 1rem, 2.4rem);
    color: var(--color-deep-blue);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }

  .mcnw-pageLead {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 56ch;
    margin: 0 auto;
    text-wrap: balance;
  }

  .mcnw-sectionTitle {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin: 0;
  }

  /* Explainer & FAQ */
  .mcnw-explainer,
  .mcnw-faq,
  .mcnw-related {
    margin-top: var(--space-8);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .mcnw-explainer p,
  .mcnw-explainerList li,
  .mcnw-faqA {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .mcnw-formula {
    font-family: var(--font-body);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-align: center;
    overflow-x: auto;
  }

  .mcnw-formula code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .mcnw-explainerList {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
  }

  .mcnw-explainerList li {
    margin-bottom: var(--space-2);
  }

  .mcnw-explainerList li strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* FAQ: entire section is collapsible. The summary doubles as the
     section heading; we keep the visual weight of an h2 and add a tiny
     count badge so the user knows how many questions are hidden. */
  .mcnw-faqHeading {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    user-select: none;
  }

  .mcnw-faqHeading::-webkit-details-marker { display: none; }

  .mcnw-faqHeading::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-deep-blue);
    font-weight: 700;
    font-size: 0.9rem;
    flex: 0 0 auto;
    transition: transform 0.15s ease;
  }

  .mcnw-faq[open] > .mcnw-faqHeading::before {
    content: '−';
  }

  .mcnw-faqHeading:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .mcnw-faqHeadingCount {
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .mcnw-faqList {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mcnw-faqItem {
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    background: var(--color-bg);
  }

  .mcnw-faqItem[open] {
    background: var(--color-bg-white);
    border-color: var(--color-border);
  }

  .mcnw-faqQ {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
  }

  .mcnw-faqQ::-webkit-details-marker { display: none; }

  .mcnw-faqQ::before {
    content: '+';
    font-weight: 700;
    color: var(--color-deep-blue);
    width: 1em;
    text-align: center;
    flex-shrink: 0;
  }

  .mcnw-faqItem[open] .mcnw-faqQ::before {
    content: '\2212';
  }

  .mcnw-faqQ:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .mcnw-faqA {
    margin: var(--space-2) 0 0;
  }

  /* Related reading */
  .mcnw-relatedHeader {
    margin-bottom: var(--space-4);
  }

  .mcnw-relatedLead {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: var(--space-2) 0 0;
    max-width: 60ch;
    text-wrap: balance;
  }

  .mcnw-relatedGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 800px) {
    .mcnw-relatedGrid {
      grid-template-columns: 1fr;
    }
  }

  .mcnw-relatedCard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    min-height: 100%;
  }

  .mcnw-relatedCard:hover,
  .mcnw-relatedCard:focus-visible {
    border-color: var(--color-deep-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    outline: none;
  }

  .mcnw-relatedCard:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .mcnw-relatedKicker {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal);
  }

  .mcnw-relatedTitle {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-deep-blue);
    line-height: 1.3;
  }

  .mcnw-relatedDesc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .mcnw-relatedFooter {
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    justify-content: flex-end;
    align-items: center;
  }

  /* text-decoration (not border-bottom) so the underline follows
     line wraps correctly on narrow viewports: border-bottom only
     renders under the last visual line of a wrapped link. */
  .mcnw-relatedAll {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-deep-blue);
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-style 0.15s ease;
  }

  .mcnw-relatedAll:hover,
  .mcnw-relatedAll:focus-visible {
    text-decoration-style: solid;
  }

  .mcnw-relatedAllSecondary {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: underline dotted;
    text-decoration-color: var(--color-text-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease, text-decoration-style 0.15s ease;
  }

  .mcnw-relatedAllSecondary:hover,
  .mcnw-relatedAllSecondary:focus-visible {
    color: var(--color-deep-blue);
    text-decoration-color: var(--color-deep-blue);
    text-decoration-style: solid;
  }

  /* Switch to stacked layout earlier (640px): at widths between
     480 and 640px the right-aligned wrap makes the two links sit on
     ragged staggered lines. Stacking them reads cleaner. */
  @media (max-width: 640px) {
    .mcnw-relatedFooter {
      justify-content: flex-start;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }

