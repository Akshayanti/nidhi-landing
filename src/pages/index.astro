---
import BaseLayout from '../layouts/BaseLayout.astro';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Personal finance tools and financial literacy education. A smarter way to understand and plan your financial future.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Personal finance literacy, net worth tracking, and money management education.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout title="nidhi | Personal Finance Tools and Financial Literacy" description="nidhi helps you understand and plan your financial future. Free personal finance education, net worth tracking, and money management tools. Built in Prague." keywords={['personal finance', 'financial literacy', 'personal finance literacy', 'money management', 'net worth tracker', 'financial planning', 'budgeting', 'multi-currency']} jsonLd={[organizationSchema, webSiteSchema]}>
  <section class="landing">
    <div class="landing-container">
      <div class="baba">
        <img src="/baba_money.webp" alt="Meditating finosopher contemplating your finances" />
      </div>
      <h1 class="brand">nidhi</h1>
      <p class="tagline">Money, understood</p>

      <p class="cheeky">
        Our <abbr class="finosopher" data-tooltip="Finance + philosopher, smushed together" aria-label="finosopher: finance and philosopher, smushed together">finosopher</abbr> has been meditating on<br />
        where everyone's money keeps going.<br />
        He's building something to make your money easier to understand. Soon.
      </p>

      <div class="roadmap">
        <div class="roadmap-title">The sacred roadmap</div>

        <div class="item done">
          <span class="icon">&#x2705;</span>
          <span class="text">
            Have an existential crisis about finances
          </span>
        </div>

        <div class="item done">
          <span class="icon">&#x2705;</span>
          <span class="text">
            Decide to build an app instead of using Excel
            <span class="aside">...because that's the rational thing to do, right?</span>
          </span>
        </div>

        <div class="item done">
          <span class="icon">&#x2705;</span>
          <span class="text">
            Pick a name that means "treasure" in Sanskrit
          </span>
        </div>

        <div class="item current">
          <span class="icon">&#x1F6A7;</span>
          <span class="text">
            Actually build the thing
            <span class="aside">current status: caffeinated and optimistic</span>
          </span>
        </div>

        <div class="item">
          <span class="icon">&#x1F570;&#xFE0F;</span>
          <span class="text">
            Let real humans try it
          </span>
        </div>

        <div class="item">
          <span class="icon">&#x1F30D;</span>
          <span class="text">
            World domination (financial literacy edition)
          </span>
        </div>
      </div>

      <div class="learn-more">
        <p class="learn-more-text">While you wait, the finosopher has left a few tools behind:</p>

        <div class="tools-grid">
          <a href="/free/multi-currency-net-worth/" class="tool-card" data-attr="home-cta-multi-currency-net-worth">
            <span class="tool-card__kicker">Free tool</span>
            <span class="tool-card__title">Multi-Currency Net Worth</span>
            <span class="tool-card__desc">See your real net worth across every currency you hold &mdash; and where the concentration sits.</span>
            <span class="tool-card__arrow" aria-hidden="true">&rarr;</span>
          </a>

          <a href="/free/loan-comparison/" class="tool-card" data-attr="home-cta-loan-comparison">
            <span class="tool-card__kicker">Free tool</span>
            <span class="tool-card__title">Loan Comparison</span>
            <span class="tool-card__desc">Compare loan offers and find the one that's actually cheaper.</span>
            <span class="tool-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <p class="aux-links">
          Or read the <a href="/blog/" data-attr="home-cta-blog">blog</a>
          <span class="aux-sep" aria-hidden="true">&middot;</span>
          explore <a href="/beliefs/" data-attr="home-cta-beliefs">our beliefs</a>
        </p>
      </div>

      <p class="footer">
        Built with unreasonable ambition in Prague
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .landing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--space-4);
    text-align: center;
  }

  .landing-container {
    max-width: 560px;
  }

  .baba {
    margin-bottom: var(--space-1);
    animation: float 3s ease-in-out infinite;
  }

  .baba img {
    width: 100px;
    height: auto;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-icon img { animation: none; }
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2.2rem;
    color: var(--color-deep-blue);
    letter-spacing: -0.02em;
    margin-bottom: 2px;
  }

  .tagline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-teal);
    margin-bottom: var(--space-3);
  }

  .cheeky {
    font-weight: 300;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-5);
  }

  .cheeky strong {
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .finosopher {
    position: relative;
    display: inline-block;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    color: inherit;
    font-weight: inherit;
    cursor: help;
    transition: border-color 0.2s ease;
    outline: none;
  }

  .finosopher:hover,
  .finosopher:focus-visible {
    border-bottom-color: var(--color-teal);
  }

  .finosopher::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--color-deep-blue);
    color: white;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.72rem;
    white-space: nowrap;
    box-shadow: var(--shadow-md);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .finosopher::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px 6px 0 6px;
    border-style: solid;
    border-color: var(--color-deep-blue) transparent transparent transparent;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .finosopher:hover::after,
  .finosopher:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .finosopher:hover::before,
  .finosopher:focus-visible::before {
    opacity: 1;
  }

  .roadmap {
    text-align: left;
    margin: 0 auto;
    max-width: 400px;
    background: var(--color-bg-white);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--shadow-md);
  }

  .roadmap-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-2);
    text-align: center;
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: var(--space-1);
  }

  .item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 3px 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .item .icon {
    font-size: 0.85rem;
    flex-shrink: 0;
    width: 22px;
    text-align: center;
  }

  .item .text {
    padding-top: 0;
  }

  .item.done .text {
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  .item.current .text {
    color: var(--color-deep-blue);
    font-weight: 500;
  }

  .item .aside {
    display: block;
    font-size: 0.65rem;
    font-weight: 300;
    color: var(--color-text-muted);
    margin-top: 0;
    font-style: italic;
  }

  .learn-more {
    margin-top: var(--space-5);
  }

  .learn-more-text {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    max-width: 480px;
    margin: 0 auto;
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .tool-card:hover,
  .tool-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-deep-blue);
    outline: none;
  }

  .tool-card:hover .tool-card__arrow,
  .tool-card:focus-visible .tool-card__arrow {
    transform: translateX(2px);
    color: var(--color-deep-blue);
  }

  .tool-card__kicker {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal);
  }

  .tool-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-deep-blue);
    line-height: 1.2;
  }

  .tool-card__desc {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .tool-card__arrow {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .aux-links {
    margin-top: var(--space-4);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .aux-links a {
    color: var(--color-deep-blue);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .aux-links a:hover,
  .aux-links a:focus-visible {
    border-bottom-color: var(--color-deep-blue);
  }

  .aux-sep {
    margin: 0 6px;
    color: var(--color-border);
  }

  .footer {
    margin-top: var(--space-4);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  @media (max-width: 480px) {
    .baba img { width: 80px; }
    .brand { font-size: 1.8rem; }
    .tagline { font-size: 0.85rem; margin-bottom: var(--space-2); }
    .cheeky { font-size: 0.8rem; margin-bottom: var(--space-4); }
    .cheeky br { display: none; }
    .roadmap { max-width: 100%; }
    .item { font-size: 0.75rem; }
    .item .aside { font-size: 0.6rem; }
    .tools-grid { grid-template-columns: 1fr; gap: var(--space-2); }
    .tool-card { padding: var(--space-3); }
    .aux-links { font-size: 0.75rem; }
  }
</style>