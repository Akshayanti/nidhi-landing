---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import HeroChart from '../components/HeroChart.astro';
import { EXAMPLE_RETURN, STARTER, starterExample } from '../utils/home/heroExamples.ts';
import {
  assertHomepageSlugs,
  lessonToolPairs,
  levelCounts,
  readingOrder,
  resolveGrowthTopics,
  resolveStartingPoints,
} from '../utils/home/startingPoints.ts';
import { assertInclusiveGroups, INCLUSIVE_HUB, liveInclusive } from '../utils/inclusiveGuides.ts';
import { formatAmount } from '../utils/shared/formatAmount.ts';
import { getReadingTime } from '../utils/readingTime.ts';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../utils/monte-carlo/release.ts';
import { getCollection } from 'astro:content';

// The live home page. It tells one story, in order: understand your money,
// starting wherever you are; learn it, then try it on your own numbers; and
// keep going as life gets more involved, including across currencies. The
// planner, which is not open yet, comes after everything that is.
//
// Every lesson and tool link is chosen in src/utils/home/startingPoints.ts
// and only appears once its post is published (or, for the Monte Carlo
// simulator, once the tool launches). Dev shows scheduled posts too.

const isDev = import.meta.env.DEV;
const now = isDev ? new Date('2999-01-01') : new Date();
const allPosts = await getCollection('blog');
assertHomepageSlugs(allPosts);

const showMonteCarlo = await isMonteCarloReleased();
const isToolLive = (href: string) => href !== MONTE_CARLO_URL || showMonteCarlo;
const startingPoints = resolveStartingPoints(allPosts, now, isToolLive);
const growthTopics = resolveGrowthTopics(allPosts, now);
const pairs = lessonToolPairs(allPosts, now, isToolLive);
const counts = levelCounts(allPosts, now);
const order = readingOrder(allPosts, now);
const firstLesson = order[0];
const firstPost = allPosts.find((p) => p.data.slug === firstLesson?.slug);
const firstMinutes = firstPost ? getReadingTime(firstPost.body || '') : null;

// Inclusive Finances joins the starting points once a guide in it is live.
assertInclusiveGroups(allPosts);
const inclusive = liveInclusive(allPosts, now);

// Hero example, computed (see src/utils/home/heroExamples.ts).
const eur = (v: number) => formatAmount(v, 'EUR');
const ex = starterExample();
const pctReturn = `${Math.round(EXAMPLE_RETURN * 100)}%`;
const roundedEnd = Math.round(ex.end / 100) * 100;
// Drawn twice: a narrower drawing for phones keeps its labels readable
// (CSS shows one of the two).
const starterChart = {
  title: 'Example: net worth over ten years',
  desc: `An example net worth of ${eur(ex.netWorth)} today, with ${eur(STARTER.monthly)} added each month at ${pctReturn} a year after inflation, reaches about ${eur(roundedEnd)} after ${STARTER.years} years: ${eur(ex.added)} added and about ${eur(Math.round(ex.growth / 100) * 100)} of growth.`,
  pointLabels: ex.values.map((_, i) => (i === 0 ? 'Today' : `Year ${i}`)),
  series: [{ name: 'Net worth', values: ex.values, color: 'var(--chart-eur)', area: true }],
  axisStart: 'today',
  axisEnd: `+${STARTER.years} years`,
  footnote: `Example: ${eur(STARTER.monthly)} added at the start of each month, ${pctReturn} a year after inflation. Of the ${eur(roundedEnd)}, ${eur(ex.added)} is money added.`,
};

// The multi-currency example. Nothing is fetched until the visitor asks.
const mcItems = [
  { name: 'Apartment, Prague', amount: 280_000, currency: 'EUR' },
  { name: 'Brokerage account, US', amount: 47_300, currency: 'USD' },
  { name: 'Savings, India', amount: 840_000, currency: 'INR' },
  { name: 'Mortgage', amount: -110_000, currency: 'EUR' },
];


// Shown on the page and, word for word, in the FAQPage data below.
const faqs = [
  {
    q: 'Is nidhi for beginners?',
    a: `Yes. The learning path starts with what net worth is and assumes no prior knowledge. Each lesson explains its terms as it goes, and the ${counts.total} lessons so far are in reading order, so you can start at the top and keep going.`,
  },
  {
    q: 'Do I need money in more than one currency to use nidhi?',
    a: 'No. Everything works with a single currency. Multi-currency support is there for when your life needs it: savings in one country, a pension or property in another, or plans to move.',
  },
  {
    q: 'What does nidhi cost?',
    a: 'The lessons and the free tools cost nothing and need no account. The lessons will stay free, with no paywall.',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. nidhi is educational: it explains how money works and lets you model your own situation. It is not a licensed financial adviser. For decisions that matter, talk to a qualified professional.',
  },
  {
    q: 'What happens to the numbers I type into the tools?',
    a: 'They stay on your device. The free tools calculate in your browser, and the numbers you enter are not sent to nidhi or anyone else.',
  },
  {
    q: 'What is the planner, and when can I use it?',
    a: 'The planner brings everything together: what you own, owe, earn and expect to spend, projected forward with the assumptions shown, so you can compare decisions before you make them. It is opening in stages. Join the list and you will get one email when it opens.',
  },
];

const description = 'Free personal finance lessons and private tools to understand your money and plan your future. Start with the basics; nidhi keeps up as life gets more complex, across currencies too.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  slogan: 'Money, understood',
  description: 'nidhi helps ordinary people understand their money: free, structured personal finance lessons, private in-browser tools, and a planner for their financial future. It starts with the basics and keeps working as finances get more complex, including when money spans currencies and countries.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  foundingLocation: { '@type': 'Place', name: 'Prague' },
  knowsAbout: ['Personal finance', 'Financial literacy', 'Net worth', 'Emergency funds', 'Investing', 'Financial independence', 'Retirement planning', 'Behavioural finance', 'Multi-currency finance'],
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Learn personal finance, understand your own money, and plan your future, from the basics to finances that span currencies and countries.',
  // The blog index honours `?q=` as a deep link and writes the value back
  // into the URL via `replaceState` as the search field changes (see
  // `src/components/LearningPath.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="nidhi | Understand your money and plan what comes next"
  description={description}
  imageAlt="nidhi: money, understood. Free personal finance lessons and private tools to understand your money and plan your future."
  jsonLd={[organizationSchema, webSiteSchema, faqSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  {/* =============================================================
       1. Hero: the promise, two ways in, and one idea walked through
       ============================================================= */}
  <section class="lp-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lp-eyebrow">Money, understood</p>
          <h1 id="hero-heading">Understand your money. Plan what comes next.</h1>
          <p class="lp-subhead">
            Learn how personal finance works, see what it means for your own money, and plan your future with it. Free lessons and private tools, whether you are learning the basics or your finances have got complicated.
          </p>

          <div class="hero-actions">
            <a href="/blog/" class="lp-btn lp-btn--primary" data-attr="home-hero-start-learning">Start learning</a>
            <a href="/free/" class="lp-btn lp-btn--secondary" data-attr="home-hero-tools">Try a free tool</a>
          </div>

          {firstLesson && (
            <div class="hero-next" data-continue={JSON.stringify(order)}>
              <p data-next-default>
                Not sure where to begin? Start with <a href={firstLesson.href} data-attr="home-hero-first-lesson">{firstLesson.title}</a>{firstMinutes && <>, a {firstMinutes}-minute read</>}.
              </p>
              <p data-next-continue hidden>
                Welcome back. Pick up where you left off: <a href="#" data-attr="home-hero-continue"></a>
              </p>
            </div>
          )}
        </div>

        <figure class="starter" aria-labelledby="starter-title">
          <p class="starter-kicker" id="starter-title">One idea, from learning to planning</p>
          <ol class="starter-steps">
            <li>
              <span class="starter-step">Learn</span>
              <p class="starter-text">Net worth is what you own minus what you owe. It shows whether you are moving forward, whatever you earn.</p>
            </li>
            <li>
              <span class="starter-step">See yours</span>
              <table class="starter-table" aria-label="An example net worth">
                <tbody>
                  {STARTER.owns.map((i) => (
                    <tr><th scope="row">{i.name}</th><td>{eur(i.amount)}</td></tr>
                  ))}
                  {STARTER.owes.map((i) => (
                    <tr class="is-owed"><th scope="row">{i.name}</th><td>&minus;{eur(i.amount)}</td></tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr><th scope="row">Net worth</th><td>{eur(ex.netWorth)}</td></tr>
                </tfoot>
              </table>
            </li>
            <li>
              <span class="starter-step">Look ahead</span>
              <p class="starter-text">Add {eur(STARTER.monthly)} a month and it could grow to about {eur(roundedEnd)} in {STARTER.years} years.</p>
              <HeroChart id="hero-starter" class="starter-chart--wide" {...starterChart} />
              <HeroChart id="hero-starter-sm" class="starter-chart--narrow" width={300} height={220} {...starterChart} />
            </li>
          </ol>
        </figure>
      </div>
    </div>
  </section>

  {/* =============================================================
       2. Start wherever you are: situations, each tied to the path
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="start" aria-labelledby="start-heading">
    <div class="lp-section-inner">
      <div class="section-head">
        <h2 id="start-heading">Start wherever you are.</h2>
        <p class="cap-body">
          You don&rsquo;t need the jargon, or much money, to begin. Pick the line that sounds most like you. {counts.total > 0 && <>There are {counts.total} free lessons so far, in reading order, each citing its sources.</>}
        </p>
      </div>

      <ul class="start-grid" role="list">
        {startingPoints.map((s) => (
          <li class="start-card">
            <h3>{s.situation}</h3>
            <p class="start-detail">{s.detail}</p>
            <p class="start-meta">
              {s.levelLabel ? <>{s.levelLabel} level &middot; {s.levelCount} lessons</> : <>Lessons from several levels, plus free tools</>}
            </p>
            <p class="start-route-label" id={`start-route-${s.id}`}>Your route</p>
            <ol class="start-lessons" aria-labelledby={`start-route-${s.id}`}>
              {s.lessons.map((l, i) => (
                <li>
                  <a href={l.href} data-attr={`home-start-${s.id}-${i + 1}`}>{l.title}</a>
                </li>
              ))}
            </ol>
            {s.tools.length > 0 && (
              <p class="start-tools">
                Then try it on your numbers:{' '}
                {s.tools.map((t, i) => (
                  <>{i > 0 && ', '}<a href={t.href} data-attr={`home-start-${s.id}-tool-${i + 1}`}>{t.name}</a></>
                ))}
              </p>
            )}
            {s.id === 'complex' && (
              <a class="start-more" href="#grows" data-attr="home-start-complex-more">How nidhi keeps up with a complicated life</a>
            )}
            <div class="start-door">
              <a
                class="lp-btn lp-btn--primary"
                href={s.lessons[0].href}
                data-start-route={JSON.stringify(s.lessons)}
                data-route-done={s.level ? `/blog/#level-${s.level}` : '/blog/'}
                data-attr={`home-start-${s.id}-door`}
              >
                <span><span data-door-verb>Start with</span>{' '}<span data-door-title>{s.lessons[0].title}</span></span>
              </a>
            </div>
          </li>
        ))}
        {inclusive.count > 0 && (
          <li class="start-card start-card--inclusive">
            <p class="start-route">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></svg>
              Inclusive Finances &middot; relevant at any stage
            </p>
            <h3>The standard plan doesn&rsquo;t fit my life.</h3>
            <p class="start-detail">
              Most financial advice assumes marriage, steady employment, family the law recognises, and one country. These guides start from the life you actually have.
            </p>
            {inclusive.groups.length > 0 && (
              <ul class="start-situations" role="list" aria-label="Situations the guides cover">
                {inclusive.groups.map((g) => <li>{g.label}</li>)}
              </ul>
            )}
            <a class="start-more" href={INCLUSIVE_HUB} data-attr="home-inclusive-finances">
              Explore {inclusive.count === 1 ? 'the guide' : `all ${inclusive.count} guides`}
            </a>
          </li>
        )}
      </ul>

      <p class="section-foot">
        <a href="/blog/" data-attr="home-cta-blog">See the whole learning path</a>
      </p>
    </div>
  </section>

  {/* =============================================================
       3. Learn it, then try it on your own numbers
       ============================================================= */}
  {pairs.length > 0 && (
    <section class="lp-section" id="apply" aria-labelledby="apply-heading">
      <div class="lp-section-inner">
        <div class="section-head">
          <h2 id="apply-heading">Learn it, then try it on your own numbers.</h2>
          <p class="cap-body">
            Each free tool sits next to a lesson that explains the idea behind it. The tools run in your browser, so what you type stays on your device, and there is nothing to sign up for.
          </p>
        </div>

        <ul class="pair-list" role="list">
          {pairs.map((p) => {
            const key = p.tool.href.split('/').filter(Boolean).pop();
            return (
              <li class="pair">
                <div class="pair-lesson">
                  <span class="pair-kicker">Read</span>
                  <a href={p.lesson.href} data-attr={`home-pair-lesson-${key}`}>{p.lesson.title}</a>
                </div>
                <span class="pair-arrow" aria-hidden="true">&rarr;</span>
                <a href={p.tool.href} class="an-card" data-attr={`home-cta-${key}`}>
                  <span class="an-preview" aria-hidden="true">
                    {p.tool.preview === 'donut' && (
                      <svg viewBox="0 0 80 48"><g transform="translate(24,24)"><path d="M 0 -18 A 18 18 0 1 1 -12.3 13.1 L 0 0 Z" fill="var(--chart-eur)" /><path d="M -12.3 13.1 A 18 18 0 0 1 -10.6 -14.6 L 0 0 Z" fill="var(--chart-usd)" /><path d="M -10.6 -14.6 A 18 18 0 0 1 0 -18 L 0 0 Z" fill="var(--chart-inr)" /><circle r="9" fill="var(--color-bg-white)" /></g><rect x="50" y="14" width="22" height="5" rx="2" fill="var(--chart-eur)" /><rect x="50" y="23" width="16" height="5" rx="2" fill="var(--chart-usd)" /><rect x="50" y="32" width="9" height="5" rx="2" fill="var(--chart-inr)" /></svg>
                    )}
                    {p.tool.preview === 'bars' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 8 C 30 12, 50 26, 74 42" stroke="var(--chart-eur)" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M 6 8 C 26 16, 44 30, 64 42" stroke="var(--chart-usd)" stroke-width="3" fill="none" stroke-dasharray="5 4" stroke-linecap="round" /></svg>
                    )}
                    {p.tool.preview === 'fan' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 40 L 74 6 L 74 36 Z" fill="var(--chart-eur)" opacity="0.22" /><path d="M 6 40 L 74 14 L 74 28 Z" fill="var(--chart-eur)" opacity="0.4" /><path d="M 6 40 L 74 21" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" /></svg>
                    )}
                  </span>
                  <span class="an-kicker">Then try it</span>
                  <span class="an-title">{p.tool.name}</span>
                  <span class="an-desc">{p.tool.desc}</span>
                  <span class="an-cta" aria-hidden="true">Open the tool &rarr;</span>
                </a>
              </li>
            );
          })}
        </ul>

        <p class="section-foot"><a href="/free/" data-attr="home-tools-all">All free tools</a></p>
      </div>
    </section>
  )}

  {/* =============================================================
       4. Grows with you, with multi-currency as one concrete case
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="grows" aria-labelledby="grows-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="section-head">
        <h2 id="grows-heading">nidhi grows with your financial life.</h2>
        <p class="cap-body">
          The ideas you start with keep mattering as life gets more involved. They just gain more moving parts. nidhi is built to keep up, so you never have to outgrow it.
        </p>
      </div>

      <div class="grows-grid">
        <ol class="grows-list">
          {growthTopics.map((t) => (
            <li>
              <h3>{t.label}</h3>
              <p>{t.detail}</p>
              <ul class="grows-links" role="list">
                {t.lessons.map((l, i) => (
                  <li><a href={l.href} data-attr={`home-grows-${t.id}-${i + 1}`}>{l.title}</a></li>
                ))}
              </ul>
            </li>
          ))}
        </ol>

        <div class="mc-panel" data-mc={JSON.stringify(mcItems)}>
          <h3>When your money lives in more than one country</h3>
          <p>
            Most money tools assume one country and one currency. nidhi doesn&rsquo;t, so a home in one place, savings in another and a pension in a third still add up to one picture, in the currency you actually live in.
          </p>
          <ul class="mc-list">
            {mcItems.map((it) => (
              <li>
                <span>{it.name}</span>
                <span class="mc-amount">{formatAmount(it.amount, it.currency)}</span>
              </li>
            ))}
          </ul>
          <div class="mc-result">
            <button type="button" class="lp-btn lp-btn--secondary mc-button" data-mc-convert data-attr="home-mc-convert">Add it up in euros at today&rsquo;s rates</button>
            <div data-mc-out aria-live="polite">
              <p class="mc-total" data-mc-total hidden></p>
              <div class="mc-bar" data-mc-bar hidden aria-hidden="true">
                <span data-mc-share="EUR" style="background:var(--chart-eur)"></span>
                <span data-mc-share="USD" style="background:var(--chart-usd)"></span>
                <span data-mc-share="INR" style="background:var(--chart-inr)"></span>
              </div>
              <p class="mc-split" data-mc-split hidden></p>
            </div>
          </div>
          <p class="mc-note">
            The button fetches the European Central Bank&rsquo;s rates through Frankfurter, the same open service the net worth calculator uses. None of these amounts, or anything else you type, is sent; like any web request, it shows Frankfurter your IP address. <a href="/free/multi-currency-net-worth/" data-attr="home-mc-tool">Try it with your own numbers</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       5. The planner, honestly labelled, with the waitlist
       ============================================================= */}
  <section class="lp-section" id="signup" aria-labelledby="planner-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="planner-grid">
        <div class="planner-copy">
          <p class="lp-eyebrow">Opening in stages</p>
          <h2 id="planner-heading">The planner: your whole picture, looking forward.</h2>
          <p class="cap-body">
            Lessons explain the ideas. Tools answer one question at a time. The planner brings it together, so you can see where your money is heading and compare decisions before you make them. It is not open yet.
          </p>
          <ul class="planner-list">
            <li>What you own, owe, earn and expect to spend, in one place, in one currency or several.</li>
            <li>Where that could lead, including retirement timing, with every assumption in plain view.</li>
            <li>Goals and future costs in the same long-range plan.</li>
            <li>What-if comparisons: saving more, buying a home, changing jobs, retiring earlier.</li>
          </ul>
        </div>
        <div class="planner-signup">
          <WaitlistSection />
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       6. The belief, and what you can count on
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="trust" aria-labelledby="trust-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="section-head section-head--center">
        <h2 id="trust-heading">Understanding money shouldn&rsquo;t be a privilege.</h2>
        <p class="cap-body">
          It shouldn&rsquo;t depend on already knowing finance, paying for advice, or having the time to become an expert. That is what we mean by <em>money, understood</em>.
        </p>
      </div>

      <ul class="trust-grid" role="list">
        <li><strong>Free to learn, for good.</strong> No paywall, and no &ldquo;subscribe for the good stuff&rdquo;.</li>
        <li><strong>No ads, no data selling.</strong> Analytics run on EU servers, and we never share or sell your email.</li>
        <li><strong>Your numbers stay with you.</strong> The free tools calculate in your browser.</li>
        <li><strong>Sources you can check.</strong> Lessons cite what they rely on. <a href="/editorial-policy/" data-attr="home-editorial-policy">How we write</a>.</li>
        <li><strong>Built for real financial lives.</strong> Different households, countries, abilities and ways of working, and a site that works with screen readers, for colour blindness, and for people wired differently.</li>
        <li><strong>Clear about what this is.</strong> Education, not financial advice. <a href="/privacy/" data-attr="home-privacy">Read the privacy policy</a>.</li>
      </ul>

      <p class="trust-founder">
        nidhi is made in Prague by one person who couldn&rsquo;t find a tool that fit a real financial life, and decided to build one. <a href="/beliefs/" data-attr="home-cta-beliefs">What we believe</a>.
      </p>
    </div>
  </section>

  {/* =============================================================
       7. FAQ (also in FAQPage data above)
       ============================================================= */}
  <section class="lp-section" id="faq" aria-labelledby="faq-heading" tabindex="-1">
    <div class="lp-section-inner lp-section-inner--narrow">
      <h2 id="faq-heading" class="faq-heading">Questions people ask first</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" data-attr={`home-faq-${i + 1}`}>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Reading progress on the homepage. Both parts read the existing
  // nidhi-reading-progress key, which never leaves the browser, and only
  // change where links point.
  import { nextLesson, routeNext, type LessonLink } from '../utils/home/startingPoints.ts';

  function readSlugs(): string[] {
    try {
      const read = JSON.parse(localStorage.getItem('nidhi-reading-progress') || '[]');
      return Array.isArray(read) ? read.map(String) : [];
    } catch {
      return [];
    }
  }

  // "Start wherever you are": each card's button leads to the first lesson
  // on its route this browser has not read yet, from the same local key.
  const read = readSlugs();
  document.querySelectorAll<HTMLAnchorElement>('[data-start-route]').forEach((door) => {
    try {
      const route = JSON.parse(door.dataset.startRoute || '[]') as LessonLink[];
      const { next, started } = routeNext(route, read);
      if (!started) return;
      const verb = door.querySelector<HTMLElement>('[data-door-verb]')!;
      const title = door.querySelector<HTMLElement>('[data-door-title]')!;
      if (next) {
        door.href = next.href;
        verb.textContent = 'Continue with';
        title.textContent = next.title;
      } else {
        door.href = door.dataset.routeDone || '/blog/';
        verb.textContent = 'Route read.';
        title.textContent = 'Keep going on the learning path';
      }
    } catch {
      /* malformed route: keep the default button */
    }
  });

  // "Continue learning": if this browser has read lessons on the path, point
  // to the next unread one instead of the first lesson.
  const box = document.querySelector<HTMLElement>('[data-continue]');
  if (box) {
    try {
      const order = JSON.parse(box.dataset.continue || '[]') as LessonLink[];
      const next = nextLesson(order, read);
      if (next) {
        const line = box.querySelector<HTMLElement>('[data-next-continue]')!;
        const link = line.querySelector('a')!;
        link.href = next.href;
        link.textContent = next.title;
        line.hidden = false;
        box.querySelector<HTMLElement>('[data-next-default]')!.hidden = true;
      }
    } catch {
      /* storage unavailable: keep the default line */
    }
  }
</script>

<script is:inline>
  // The multi-currency example converts only when the visitor presses the
  // button: one request to Frankfurter (ECB rates), carrying no personal data.
  (function () {
    var panel = document.querySelector('[data-mc]');
    if (!panel) return;
    var button = panel.querySelector('[data-mc-convert]');
    var totalEl = panel.querySelector('[data-mc-total]');
    var bar = panel.querySelector('[data-mc-bar]');
    var splitEl = panel.querySelector('[data-mc-split]');
    button.addEventListener('click', function () {
      button.disabled = true;
      totalEl.hidden = false;
      totalEl.textContent = 'Fetching today’s rates…';
      // Give up after ten seconds rather than leave the panel waiting.
      var ctrl = window.AbortController ? new AbortController() : null;
      if (ctrl) window.setTimeout(function () { ctrl.abort(); }, 10000);
      var signal = ctrl ? ctrl.signal : undefined;
      fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=USD,INR', { signal: signal })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (data) {
          var rates = data && data.rates;
          if (!rates || !rates.USD || !rates.INR) throw new Error('rates');
          var items = JSON.parse(panel.getAttribute('data-mc'));
          var byCurrency = {};
          var total = 0;
          items.forEach(function (it) {
            var eur = it.currency === 'EUR' ? it.amount : it.amount / rates[it.currency];
            byCurrency[it.currency] = (byCurrency[it.currency] || 0) + eur;
            total += eur;
          });
          var money = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
          var pct = new Intl.NumberFormat('de-DE', { style: 'percent', maximumFractionDigits: 0 });
          totalEl.textContent = 'Net worth: ' + money.format(Math.round(total));
          var gross = Object.keys(byCurrency).reduce(function (s, k) { return s + Math.abs(byCurrency[k]); }, 0);
          var parts = [];
          Object.keys(byCurrency).forEach(function (code) {
            var share = Math.abs(byCurrency[code]) / gross;
            var seg = bar.querySelector('[data-mc-share="' + code + '"]');
            if (seg) seg.style.width = (share * 100).toFixed(1) + '%';
            parts.push(code + ' ' + pct.format(share));
          });
          bar.hidden = false;
          splitEl.hidden = false;
          splitEl.textContent = 'By currency: ' + parts.join(', ') + '. ECB rates of ' + data.date + '.';
          // Keep keyboard focus on the answer, not on a button that disappears.
          totalEl.tabIndex = -1;
          totalEl.focus({ preventScroll: true });
          button.hidden = true;
        })
        .catch(function () {
          totalEl.textContent = 'Rates are unavailable right now. Try again later.';
          button.disabled = false;
        });
    });
  })();

  // Hover, tap or arrow keys on the example chart show its values at that
  // point. The values are pre-formatted at build time (HeroChart.astro).
  (function () {
    document.querySelectorAll('[data-hero-chart]').forEach(function (box) {
      var data = JSON.parse(box.getAttribute('data-hero-chart'));
      var svg = box.querySelector('svg');
      var hover = box.querySelector('.hc-hover');
      var cross = hover.querySelector('.hc-crosshair');
      var dots = hover.querySelectorAll('.hc-hoverDot');
      var readout = box.querySelector('.hc-readout');
      var live = box.querySelector('.hc-live');
      var vb = svg.viewBox.baseVal;
      var title = svg.querySelector('title');
      var current = null;
      box.tabIndex = 0;
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', (title ? title.textContent + '. ' : '') + 'Use the left and right arrow keys to read its values.');
      function show(i) {
        current = i;
        var xv = data.xs[i] * vb.width;
        cross.setAttribute('x1', xv);
        cross.setAttribute('x2', xv);
        data.series.forEach(function (s, k) {
          dots[k].setAttribute('cx', xv);
          dots[k].setAttribute('cy', s.ys[i] * vb.height);
        });
        hover.classList.add('is-on');
        readout.innerHTML = '';
        var heading = document.createElement('strong');
        heading.textContent = data.labels[i];
        readout.appendChild(heading);
        data.series.forEach(function (s) {
          var row = document.createElement('span');
          var sw = document.createElement('i');
          sw.style.background = s.color;
          row.appendChild(sw);
          row.appendChild(document.createTextNode(s.name + ': ' + s.values[i]));
          readout.appendChild(row);
        });
        readout.classList.add('is-on');
        if (live) live.textContent = data.labels[i] + '. ' + data.series.map(function (s) { return s.name + ': ' + s.values[i]; }).join(', ') + '.';
        readout.classList.toggle('is-left', data.xs[i] > 0.5);
        readout.style.left = (data.xs[i] * 100) + '%';
      }
      function hide() {
        current = null;
        hover.classList.remove('is-on');
        readout.classList.remove('is-on');
      }
      function nearest(clientX) {
        var r = svg.getBoundingClientRect();
        var fx = (clientX - r.left) / r.width;
        var best = 0;
        data.xs.forEach(function (x, i) { if (Math.abs(x - fx) < Math.abs(data.xs[best] - fx)) best = i; });
        return best;
      }
      svg.addEventListener('pointermove', function (e) { show(nearest(e.clientX)); });
      svg.addEventListener('pointerdown', function (e) { show(nearest(e.clientX)); });
      box.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hide(); });
      box.addEventListener('blur', hide);
      box.addEventListener('keydown', function (e) {
        var last = data.xs.length - 1;
        if (e.key === 'ArrowRight') show(current === null ? 0 : Math.min(last, current + 1));
        else if (e.key === 'ArrowLeft') show(current === null ? last : Math.max(0, current - 1));
        else if (e.key === 'Escape') hide();
        else return;
        e.preventDefault();
      });
    });
  })();
</script>

<style>
