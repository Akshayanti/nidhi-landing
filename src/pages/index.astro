---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import HeroChart from '../components/HeroChart.astro';
import { EXAMPLE_RETURN, HOUSEHOLD, NET_WORTH_PATH, fiProjection, netWorthPath, whatIf } from '../utils/home/heroExamples.ts';
import { formatAmount } from '../utils/shared/formatAmount.ts';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../utils/monte-carlo/release.ts';
import { getCollection } from 'astro:content';

// The live home page. Originally a scroll-snap redesign (see
// docs/plans/landing-page-redesign.md for the full plan and
// docs/plans/landing-wireframe.html for the wireframe); since Oct 2026 the
// sections flow with even spacing instead of filling the screen.

// "Available now" cards. The Monte Carlo card appears once that tool launches.
const showMonteCarlo = await isMonteCarloReleased();

// Hero examples, computed (see src/utils/home/heroExamples.ts).
const eur = (v: number) => formatAmount(v, 'EUR');
const eurShort = (v: number) => formatAmount(v, 'EUR', true);
const pctReturn = `${Math.round(EXAMPLE_RETURN * 100)}%`;
const nw = netWorthPath();
const nwLabels = nw.values.map((_, i) => {
  const m = i - nw.todayIndex;
  return m === 0 ? 'Today' : m < 0 ? `${-m} month${m === -1 ? '' : 's'} ago` : `In ${m} month${m === 1 ? '' : 's'}`;
});
const fi = fiProjection();
const wi = whatIf();
const yearLabels = (n: number) => Array.from({ length: n }, (_, i) => (i === 0 ? 'Today' : `Year ${i}`));
// The multi-currency example converts at today's ECB rates in the browser.
const mcItems = [
  { name: 'Apartment, Prague', amount: 280_000, currency: 'EUR' },
  { name: 'Brokerage, US', amount: 47_300, currency: 'USD' },
  { name: 'Savings, India', amount: 840_000, currency: 'INR' },
  { name: 'Mortgage', amount: -110_000, currency: 'EUR' },
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Personal finance planning across currencies. See your real net worth, model retirement timing, and stress-test major decisions before they cost you money.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Multi-currency planning for real net worth, retirement timing, and major financial decisions.',
  // SearchAction wired up in PR4. The blog index honours `?q=` as a
  // deep link and writes the value back into the URL via
  // `replaceState` as the search field changes (see
  // `src/components/LearningPath.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const liveBlogSlugs = new Set(
  (await getCollection('blog'))
    .filter((post) => post.data.pubDate <= new Date())
    .map((post) => post.data.slug),
);

// The Inclusive Finances entry point is its own card, not nested under the
// blog CTA, so the level is not framed as later-stage content. Hidden until
// a post in the level is live (always shown in dev for previewing).
const showInclusiveHub = (await getCollection('blog')).some(
  (post) => post.data.level === 'inclusive-finances' && (import.meta.env.DEV || post.data.pubDate <= new Date()),
);

function liveBlogHref(slug: string) {
  return liveBlogSlugs.has(slug) ? `/blog/${slug}/` : null;
}

const blogLinks = {
  netWorth: liveBlogHref('what-is-net-worth'),
  calculateNetWorth: liveBlogHref('how-to-calculate-net-worth'),
  crossCurrencies: liveBlogHref('managing-money-across-currencies'),
  purchasingPower: liveBlogHref('why-your-euro-buys-more-in-some-countries'),
  financialIndependence: liveBlogHref('introduction-to-financial-independence'),
  goals: liveBlogHref('setting-financial-goals'),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://nidhi.today/',
    },
  ],
};

// Pre-launch CTA. Swaps to "Get beta access" at beta and
// "Sign up free" at public release. Single-line edit per phase.
const heroCta = 'Notify me about access';
---

<BaseLayout
  title="nidhi | Multi-Currency Financial Planning"
  description="Plan major life decisions across currencies. See your real net worth, model retirement timing, and stress-test choices before they cost you money."
  imageAlt="nidhi: multi-currency financial planning for net worth, retirement timing, and major financial decisions."
  jsonLd={[organizationSchema, webSiteSchema, breadcrumbSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  <slot name="head" slot="head">
    {/* Frankfurter is used by the hero's live FX caption. Preconnecting
        here lands the rates request faster on first paint. */}
    <link rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
  </slot>

  {/* =============================================================
       Section 1: Hero
       ============================================================= */}
  <section class="lp-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lp-eyebrow">Money, understood</p>
          <h1 id="hero-heading">Plan major life decisions across currencies.</h1>
          <p class="lp-subhead">
            Avoid costly currency surprises. See your real net worth, model retirement timing, and stress-test every decision before it costs you money.
          </p>

          <WaitlistSection variant="hero" cta={heroCta} />

          <p class="hero-trust-line">
            Built because no planner handled my actual life: assets in three currencies, debts in two, retirement that crossed borders. Join the early-access list and we will email you when the planner opens. <a href="/beliefs/">More on our beliefs</a>{blogLinks.crossCurrencies && <> and <a href={blogLinks.crossCurrencies}>planning across currencies</a></>}.
          </p>
        </div>

        <div class="hero-visual-wrap" aria-hidden="false">
          <div class="lp-visual-card hero-carousel" data-hero-carousel aria-label="nidhi planning examples">
            <div class="hero-carousel-slides">
              <div class="hero-carousel-slide is-active" data-slide>
                <div class="hero-summary">
                  <p class="hero-summaryLabel">Net worth today</p>
                  <p class="hero-summaryValue">{eur(nw.today)}</p>
                </div>
                <HeroChart
                  id="hero-nw"
                  title="Net worth path example"
                  desc={`An example net worth: ${eur(NET_WORTH_PATH.startAYearAgo)} a year ago, ${eur(nw.today)} today and ${eur(nw.values[24])} in twelve months, saving ${eur(NET_WORTH_PATH.monthly)} a month at ${pctReturn} a year after inflation.`}
                  pointLabels={nwLabels}
                  series={[{ name: 'Net worth', values: nw.values, color: 'var(--chart-eur)', dashFrom: nw.todayIndex, area: true }]}
                  axisStart="12 mo ago"
                  axisMid={{ index: nw.todayIndex, label: 'today' }}
                  axisEnd="in 12 mo"
                  footnote={`Example: ${eur(NET_WORTH_PATH.startAYearAgo)} a year ago, ${eur(NET_WORTH_PATH.monthly)} added at the start of each month, ${pctReturn} a year after inflation. Dashed: projected.`}
                />
                <p class="lp-visual-caption">Net worth path<br /><span id="hero-fx-caption" aria-live="polite">Live ECB rate: loading&hellip;</span></p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <div class="hero-mc" data-hero-mc={JSON.stringify(mcItems)}>
                  <p class="hero-summaryLabel">Total net worth, in EUR</p>
                  <p class="hero-summaryValue" data-mc-total>Converting&hellip;</p>
                  <ul class="hero-mcList">
                    {mcItems.map((it) => (
                      <li>
                        <span>{it.name}</span>
                        <span class="hero-mcAmount">{formatAmount(it.amount, it.currency)}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="hero-splitBar" aria-hidden="true" data-mc-bar>
                    <span data-mc-share="EUR" style="width:0;background:var(--chart-eur)"></span>
                    <span data-mc-share="USD" style="width:0;background:var(--chart-usd)"></span>
                    <span data-mc-share="INR" style="width:0;background:var(--chart-inr)"></span>
                  </div>
                  <p class="hero-splitText" data-mc-split>Each item stays in its own currency; the total uses today&rsquo;s ECB rates.</p>
                </div>
                <p class="lp-visual-caption">Multi-currency picture</p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <HeroChart
                  id="hero-fi"
                  title="Early-retirement projection example"
                  desc={`An example household with ${eur(HOUSEHOLD.start)} invested, saving ${Math.round(HOUSEHOLD.savingsRate * 100)}% of a ${eur(HOUSEHOLD.income)} monthly income at ${pctReturn} a year after inflation. Financial independence, ${HOUSEHOLD.fiMultiple} times yearly spending or ${eur(fi.target)}, is reached in year ${fi.fiYear}.`}
                  pointLabels={yearLabels(fi.values.length)}
                  series={[{ name: 'Net worth', values: fi.values, color: 'var(--chart-eur)', area: true }]}
                  target={{ value: fi.target, label: `Financial independence, ${eurShort(fi.target)}` }}
                  marker={{ index: fi.fiYear ?? 0, label: `Reaches it in year ${fi.fiYear}` }}
                  axisStart="today"
                  axisEnd={`+${fi.values.length - 1} years`}
                  footnote={`Example: ${eur(HOUSEHOLD.start)} invested, ${Math.round(HOUSEHOLD.savingsRate * 100)}% of ${eur(HOUSEHOLD.income)} added at the start of each month, ${pctReturn} a year after inflation, target ${HOUSEHOLD.fiMultiple} times yearly spending.`}
                />
                <p class="lp-visual-caption">Early-retirement projection</p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <HeroChart
                  id="hero-wi"
                  title="What-if comparison example"
                  desc={`The same household over twenty years: saving ${Math.round(HOUSEHOLD.savingsRate * 100)}% of income reaches ${eur(wi.base[20])}; saving five percentage points more (${eur(wi.extraPerMonth)} a month) reaches ${eur(wi.higher[20])}, about ${eurShort(wi.difference)} more.`}
                  pointLabels={yearLabels(wi.base.length)}
                  series={[
                    { name: 'Save +5 pts', values: wi.higher, color: 'var(--chart-usd)' },
                    { name: 'Current', values: wi.base, color: 'var(--chart-eur)' },
                  ]}
                  axisStart="today"
                  axisEnd="+20 years"
                  footnote={`Same household: after 20 years, about ${eurShort(wi.difference)} more by adding ${eur(wi.extraPerMonth)} more at the start of each month.`}
                />
                <p class="lp-visual-caption">What-if comparison</p>
              </div>
            </div>

            <div class="hero-carousel-controls" aria-label="Example controls">
              <div class="hero-carousel-dots" role="tablist" aria-label="Planning examples">
                <button type="button" role="tab" class="hero-carousel-dot is-active" data-slide-dot aria-label="Show net worth path example" aria-selected="true"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show multi-currency example" aria-selected="false"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show early-retirement projection example" aria-selected="false"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show what-if comparison example" aria-selected="false"></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       Section 2: Who it's for
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="who" aria-labelledby="who-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="audience-grid">
        <div class="audience-copy">
          <p class="lp-eyebrow">Who it's for</p>
          <h2 id="who-heading">For people whose money crosses borders.</h2>
          <p class="cap-body">
            Multi-currency planning is the core of nidhi. The beta is for people who need their full plan to work across borders, not as an afterthought{blogLinks.purchasingPower && <>: the same money can behave differently depending on where you live, work, and spend it. <a href={blogLinks.purchasingPower}>Read the primer on purchasing power across countries</a>.</>}
          </p>
        </div>

        <ul class="audience-list">
          <li>You cannot answer "Can I afford this?" without rebuilding your spreadsheet.</li>
          <li>Your retirement plan changes depending on where you eventually live.</li>
          <li>You are comparing a property purchase, career change, or other major financial decision.</li>
          <li>Your financial picture is spread across accounts, assets, debts, and future expenses.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* =============================================================
       Section 3: How it works
       ============================================================= */}
  <section class="lp-section" id="how-it-works" aria-labelledby="how-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="how-grid">
        <div class="how-copy">
          <p class="lp-eyebrow">The model</p>
          <h2 id="how-heading">Start with your real financial life.</h2>
          <p class="cap-body">
            nidhi is built around {blogLinks.netWorth ? <a href={blogLinks.netWorth}>what you own and what you owe</a> : 'what you own, what you owe'}, what you earn, and what you expect to spend. From there, it projects your path and lets you compare choices before you make a financial decision.
          </p>
        </div>

        <ol class="how-steps" aria-label="How nidhi works">
          <li>
            <span class="how-step-number">1</span>
            <div>
              <h3>Add the pieces</h3>
              <p>Assets, debts, income, recurring expenses, future costs, and the currencies they live in.</p>
            </div>
          </li>
          <li>
            <span class="how-step-number">2</span>
            <div>
              <h3>See the path</h3>
              <p>{blogLinks.calculateNetWorth ? <a href={blogLinks.calculateNetWorth}>Net worth</a> : 'Net worth'}, cash flow, {blogLinks.financialIndependence ? <a href={blogLinks.financialIndependence}>retirement timing</a> : 'retirement timing'}, and the assumptions behind the projection.</p>
            </div>
          </li>
          <li>
            <span class="how-step-number">3</span>
            <div>
              <h3>Compare the decision</h3>
              <p>Buying property, saving more, changing jobs, adding future expenses, or retiring earlier.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  {/* =============================================================
       Section 4: Early-access scope
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="beta-scope" aria-labelledby="beta-scope-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="beta-scope">
        <div class="beta-scope-copy">
          <p class="lp-eyebrow">Early access</p>
          <h2 id="beta-scope-heading">What early access will include.</h2>
          <p class="cap-body">
            Early access is focused on the planning questions that get messy when your money crosses borders. These are the core areas we want users to pressure-test first.
          </p>
        </div>

        <ul class="beta-scope-list">
          <li>
            <h3>Multi-currency net worth</h3>
            <p>Track assets and debts in different currencies, then view the whole picture in the currency you actually spend{blogLinks.crossCurrencies ? <>. <a href={blogLinks.crossCurrencies}>Read how cross-currency planning changes the picture</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>Retirement and early-retirement projections</h3>
            <p>See possible timing, key assumptions, and how the path changes when your savings or costs change{blogLinks.financialIndependence ? <>. <a href={blogLinks.financialIndependence}>Start with financial independence basics</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>Goal and expense planning</h3>
            <p>Map expected income, recurring costs, and future expenses into the same long-range plan{blogLinks.goals ? <>. <a href={blogLinks.goals}>Read about setting concrete financial goals</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>What-if comparisons</h3>
            <p>Model major decisions like buying property, saving more, taking a lower-paying job, or changing key assumptions.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* =============================================================
       Conversion tail, the page's conclusion: trust strip, then
       waitlist.
       Footer.astro renders below <main> in the default Astro flow.
       ============================================================= */}
  <section class="lp-section lp-section--tail" id="signup" aria-labelledby="signup-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="available-now" aria-labelledby="available-now-heading">
        <div class="available-now-copy">
          <p class="lp-eyebrow">Available now</p>
          <h2 id="available-now-heading">Use the free tools while the full planner opens up.</h2>
          <p>
            The full planner is opening in stages. In the meantime, the free tools and blog are live.
          </p>
        </div>
        <ul class="available-now-links" role="list" aria-label="Available now">
          {[
            { href: '/free/multi-currency-net-worth/', attr: 'home-cta-multi-currency-net-worth', kicker: 'Free tool', title: 'Multi-currency net worth', desc: 'See assets and debts across currencies, converted at live ECB rates.', preview: 'donut' },
            { href: '/free/loan-comparison/', attr: 'home-cta-loan-comparison', kicker: 'Free tool', title: 'Loan comparison', desc: 'Compare borrowing offers side by side: APR, total cost and payoff.', preview: 'bars' },
            ...(showMonteCarlo ? [{ href: MONTE_CARLO_URL, attr: 'home-cta-monte-carlo-simulator', kicker: 'Free tool', title: 'Monte Carlo simulator', desc: 'See the spread of outcomes for your savings and retirement.', preview: 'fan' }] : []),
            showInclusiveHub
              ? { href: '/blog/', attr: 'home-cta-blog', kicker: 'Learn', title: 'Start the learning path', desc: 'Step-by-step guides, from net worth basics to long-term planning.', preview: 'path' }
              : { href: '/blog/', attr: 'home-cta-blog', kicker: 'Learn', title: 'Read the blog', desc: 'Learn the concepts behind the planner.', preview: 'path' },
            ...(showInclusiveHub ? [{ href: '/blog/inclusive-finances/', attr: 'home-inclusive-finances', kicker: 'Learn', title: 'Money for every kind of household', desc: 'Unmarried couples, blended and chosen families, solo agers, gig work, disability, lives across borders.', preview: 'compass' }] : []),
          ].map((c) => (
            <li>
              <a href={c.href} data-attr={c.attr} class="an-card">
                <span class="an-preview" aria-hidden="true">
                  {c.preview === 'donut' && (
                    <svg viewBox="0 0 80 48"><g transform="translate(24,24)"><path d="M 0 -18 A 18 18 0 1 1 -12.3 13.1 L 0 0 Z" fill="var(--chart-eur)" /><path d="M -12.3 13.1 A 18 18 0 0 1 -10.6 -14.6 L 0 0 Z" fill="var(--chart-usd)" /><path d="M -10.6 -14.6 A 18 18 0 0 1 0 -18 L 0 0 Z" fill="var(--chart-inr)" /><circle r="9" fill="var(--color-bg-white)" /></g><rect x="50" y="14" width="22" height="5" rx="2" fill="var(--chart-eur)" /><rect x="50" y="23" width="16" height="5" rx="2" fill="var(--chart-usd)" /><rect x="50" y="32" width="9" height="5" rx="2" fill="var(--chart-inr)" /></svg>
                  )}
                  {c.preview === 'bars' && (
                    <svg viewBox="0 0 80 48"><path d="M 6 8 C 30 12, 50 26, 74 42" stroke="var(--chart-eur)" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M 6 8 C 26 16, 44 30, 64 42" stroke="var(--chart-usd)" stroke-width="3" fill="none" stroke-dasharray="5 4" stroke-linecap="round" /></svg>
                  )}
                  {c.preview === 'fan' && (
                    <svg viewBox="0 0 80 48"><path d="M 6 40 L 74 6 L 74 36 Z" fill="var(--chart-eur)" opacity="0.22" /><path d="M 6 40 L 74 14 L 74 28 Z" fill="var(--chart-eur)" opacity="0.4" /><path d="M 6 40 L 74 21" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" /></svg>
                  )}
                  {c.preview === 'path' && (
                    <svg viewBox="0 0 80 48"><line x1="10" y1="8" x2="10" y2="42" stroke="var(--color-border)" stroke-width="2" /><circle cx="10" cy="10" r="5" fill="var(--chart-usd)" /><circle cx="10" cy="24" r="5" fill="var(--chart-eur)" /><circle cx="10" cy="38" r="5" fill="var(--color-bg-white)" stroke="var(--chart-eur)" stroke-width="2" /><rect x="22" y="7" width="44" height="6" rx="3" fill="var(--color-border)" /><rect x="22" y="21" width="36" height="6" rx="3" fill="var(--color-border)" /><rect x="22" y="35" width="48" height="6" rx="3" fill="var(--color-border)" /></svg>
                  )}
                  {c.preview === 'compass' && (
                    <svg viewBox="0 0 80 48"><circle cx="24" cy="24" r="17" fill="none" stroke="var(--color-teal)" stroke-width="2.5" /><path d="M 30 18 L 26 26 L 18 30 L 22 22 Z" fill="var(--color-teal)" /><rect x="48" y="14" width="24" height="5" rx="2" fill="var(--color-border)" /><rect x="48" y="23" width="18" height="5" rx="2" fill="var(--color-border)" /><rect x="48" y="32" width="22" height="5" rx="2" fill="var(--color-border)" /></svg>
                  )}
                </span>
                <span class="an-kicker">{c.kicker}</span>
                <span class="an-title">{c.title}</span>
                <span class="an-desc">{c.desc}</span>
                <span class="an-cta" aria-hidden="true">Open &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="trust-strip" aria-label="Privacy and data handling">
        <p class="trust-strip-title">What this means for your data</p>
        <ul>
          <li>Free-tool calculations run entirely in your browser. Your numbers never leave the page.</li>
          <li>No ads. No data selling. Analytics on EU servers only (PostHog Cloud EU).</li>
          <li>We never share or sell your email. One click to unsubscribe from anything.</li>
          <li>GDPR-aware. <a href="/privacy/">Read the full privacy policy.</a></li>
        </ul>
      </div>

      <div class="signup-block">
        <p class="lp-eyebrow">Early access</p>
        <h2 id="signup-heading" class="signup-heading">Join the early-access list</h2>
        <WaitlistSection />
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Live ECB rate caption in the hero. One fetch on page load, no polling.
  // Same Frankfurter API the multi-currency tool uses (already disclosed
  // in the privacy policy as a third-party call). Fails silently if the
  // request errors or the network is offline.
  // Live ECB rates (via Frankfurter, already disclosed in the privacy policy):
  // the caption under the first example, and the conversion in the
  // multi-currency example, whose total and split are never hard-coded.
  (function () {
    var caption = document.getElementById('hero-fx-caption');
    var mc = document.querySelector('[data-hero-mc]');
    var totalEl = mc && mc.querySelector('[data-mc-total]');
    var splitEl = mc && mc.querySelector('[data-mc-split]');
    function unavailable() {
      if (caption) caption.style.display = 'none';
      if (totalEl) totalEl.textContent = 'Rates unavailable right now';
    }
    fetch('https://api.frankfurter.dev/v1/latest?base=EUR&symbols=USD,INR')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (data) {
        var rates = data && data.rates;
        if (!rates || !rates.USD || !rates.INR) return unavailable();
        if (caption) caption.textContent = 'Live ECB rate: 1 EUR = ' + rates.USD.toFixed(4) + ' USD';
        if (!mc) return;
        var items = JSON.parse(mc.getAttribute('data-hero-mc'));
        var byCurrency = {};
        var total = 0;
        items.forEach(function (it) {
          var eur = it.currency === 'EUR' ? it.amount : it.amount / rates[it.currency];
          byCurrency[it.currency] = (byCurrency[it.currency] || 0) + eur;
          total += eur;
        });
        var money = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
        var pct = new Intl.NumberFormat('de-DE', { style: 'percent', maximumFractionDigits: 0 });
        totalEl.textContent = money.format(Math.round(total));
        var gross = Object.keys(byCurrency).reduce(function (s, k) { return s + Math.abs(byCurrency[k]); }, 0);
        var parts = [];
        Object.keys(byCurrency).forEach(function (code) {
          var share = Math.abs(byCurrency[code]) / gross;
          var bar = mc.querySelector('[data-mc-share="' + code + '"]');
          if (bar) bar.style.width = (share * 100).toFixed(1) + '%';
          parts.push(code + ' ' + pct.format(share));
        });
        splitEl.textContent = parts.join(' \u00b7 ') + ', converted at ECB rates of ' + data.date + '.';
      })
      .catch(unavailable);
  })();

  // Hover, tap or arrow keys on a hero example chart show its values at
  // that point. The values are pre-formatted at build time (HeroChart.astro).
  (function () {
    document.querySelectorAll('[data-hero-chart]').forEach(function (box) {
      var data = JSON.parse(box.getAttribute('data-hero-chart'));
      var svg = box.querySelector('svg');
      var hover = box.querySelector('.hc-hover');
      var cross = hover.querySelector('.hc-crosshair');
      var dots = hover.querySelectorAll('.hc-hoverDot');
      var readout = box.querySelector('.hc-readout');
      var live = box.querySelector('.hc-live');
      var vb = svg.viewBox.baseVal;
      var current = null;
      box.tabIndex = 0;
      box.setAttribute('aria-label', 'Example chart. Use the left and right arrow keys to read its values.');
      function show(i) {
        current = i;
        var xv = data.xs[i] * vb.width;
        cross.setAttribute('x1', xv);
        cross.setAttribute('x2', xv);
        data.series.forEach(function (s, k) {
          dots[k].setAttribute('cx', xv);
          dots[k].setAttribute('cy', s.ys[i] * vb.height);
        });
        hover.classList.add('is-on');
        readout.innerHTML = '';
        var title = document.createElement('strong');
        title.textContent = data.labels[i];
        readout.appendChild(title);
        data.series.forEach(function (s) {
          var row = document.createElement('span');
          var sw = document.createElement('i');
          sw.style.background = s.color;
          row.appendChild(sw);
          row.appendChild(document.createTextNode(s.name + ': ' + s.values[i]));
          readout.appendChild(row);
        });
        readout.classList.add('is-on');
        if (live) live.textContent = data.labels[i] + '. ' + data.series.map(function (s) { return s.name + ': ' + s.values[i]; }).join(', ') + '.';
        readout.classList.toggle('is-left', data.xs[i] > 0.5);
        readout.style.left = (data.xs[i] * 100) + '%';
      }
      function hide() {
        current = null;
        hover.classList.remove('is-on');
        readout.classList.remove('is-on');
      }
      function nearest(clientX) {
        var r = svg.getBoundingClientRect();
        var fx = (clientX - r.left) / r.width;
        var best = 0;
        data.xs.forEach(function (x, i) { if (Math.abs(x - fx) < Math.abs(data.xs[best] - fx)) best = i; });
        return best;
      }
      svg.addEventListener('pointermove', function (e) { show(nearest(e.clientX)); });
      svg.addEventListener('pointerdown', function (e) {
        // Focusing the chart pauses the carousel (its focusin handler), so a
        // tap is not lost to the next slide.
        try { box.focus({ preventScroll: true }); } catch (_) { box.focus(); }
        show(nearest(e.clientX));
      });
      box.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hide(); });
      box.addEventListener('blur', hide);
      box.addEventListener('keydown', function (e) {
        var last = data.xs.length - 1;
        if (e.key === 'ArrowRight') show(current === null ? 0 : Math.min(last, current + 1));
        else if (e.key === 'ArrowLeft') show(current === null ? last : Math.max(0, current - 1));
        else if (e.key === 'Escape') hide();
        else return;
        e.preventDefault();
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('.hc-hover.is-on, .hc-readout.is-on').forEach(function (el) { el.classList.remove('is-on'); });
    });
  })();

  (function () {
    var carousel = document.querySelector('[data-hero-carousel]');
    if (!carousel) return;
    var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-slide]'));
    var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-slide-dot]'));
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var index = 0;
    var timer = null;
    var resumeTimer = null;
    var paused = reduceMotion;

    function show(nextIndex) {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === index);
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    function clearResumeTimer() {
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = null;
    }

    function start() {
      stop();
      if (paused || reduceMotion || slides.length < 2) return;
      timer = window.setInterval(function () {
        show(index + 1);
      }, 3000);
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        show(i);
        stop();
        clearResumeTimer();
        if (reduceMotion) return;
        paused = true;
        resumeTimer = window.setTimeout(function () {
          paused = false;
          start();
        }, 5000);
      });
    });

    carousel.addEventListener('mouseenter', function () {
      clearResumeTimer();
      stop();
    });
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', function () {
      clearResumeTimer();
      stop();
    });
    carousel.addEventListener('focusout', start);

    show(0);
    start();
  })();

</script>

