  }

  .lp-btn--secondary:hover { border-color: var(--color-teal); }

  .lp-btn:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .lp-btn:disabled { opacity: 0.6; cursor: wait; }

  /* ----------------------------------------------------------------
     Phone folds (details[data-phone-fold]): closed on phones, a plain
     always-open block on wider screens. A fold-head summary holds the
     block's heading and stays visible; a fold-label summary is only the
     phone toggle and is hidden on wider screens.
     ---------------------------------------------------------------- */
  .fold > summary {
    list-style: none;
    cursor: pointer;
  }

  .fold > summary::-webkit-details-marker { display: none; }

  .fold > summary:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (min-width: 641px) {
    .fold > summary { pointer-events: none; cursor: auto; }
    .fold > summary.fold-label { display: none; }
  }

  /* Shows the content before the script has opened the fold, so wide
     screens never see it collapse and reopen. A separate rule, so a browser
     without ::details-content skips only this. */
  @media (min-width: 641px) {
    .fold::details-content { content-visibility: visible; }
  }

  @media (max-width: 640px) {
    .fold > summary { position: relative; padding-right: 32px; }

    .fold > summary::after {
      content: '+' / '';
      position: absolute;
      right: 4px;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-heading);
      font-size: 1.3rem;
      line-height: 1;
      color: var(--color-teal);
    }

    .fold[open] > summary::after { content: '\2212' / ''; }

    .fold-label {
      display: block;
      padding: 10px 32px 10px 0;
      font-family: var(--font-heading);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-deep-blue);
