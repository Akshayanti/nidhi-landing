  /* The worked example, one step at a time: step buttons above a strip of
     three slides that snap into place. Swipe or scroll on phones, the
     buttons everywhere; nothing moves on its own. */
  .starter {
    max-width: 760px;
    margin: 0 auto;
    /* Contains absolutely positioned screen-reader text in the off-screen slides, which would otherwise widen the page. */
    position: relative;
    background: var(--color-bg-white);
