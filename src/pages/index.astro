  .starter :global(.starter-chart--narrow text) { font-size: 14px; }
  .starter :global(.starter-chart--narrow .hc-endValue) { font-size: 15px; transform: translateY(5px); }

  @media (max-width: 640px) {
    .starter :global(.starter-chart--wide) { display: none; }
    .starter :global(.starter-chart--narrow) { display: block; }
  }

  /* ----------------------------------------------------------------
     2. Start wherever you are
     ---------------------------------------------------------------- */
  .start-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 760px) {
    .start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .start-card {
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
