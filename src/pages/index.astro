    font-size: 0.85rem;
    color: var(--color-deep-blue);
  }

  /* ----------------------------------------------------------------
     4. Grows with you
     ---------------------------------------------------------------- */
  .grows-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .grows-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 56px; }
  }

  .grows-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: grows;
  }

  .grows-list > li {
    position: relative;
    padding: 0 0 24px 34px;
    counter-increment: grows;
  }

  /* A line joining the stages, drawn from dot to dot. */
  .grows-list > li::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 5px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-teal);
    background: var(--color-bg-white);
    box-sizing: border-box;
  }

  .grows-list > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 12px;
    top: 20px;
    bottom: -4px;
    width: 2px;
    background: var(--color-border);
  }

  .grows-list > li:last-child { padding-bottom: 0; }

  .grows-list > li:last-child::before { background: var(--color-teal); }

  .grows-list h3 {
    font-family: var(--font-heading);
