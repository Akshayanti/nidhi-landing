    color: var(--color-text-secondary);
    padding: 2px 0;
  }

  .starter-table td {
    text-align: right;
    color: var(--color-text-primary);
    padding: 2px 0;
  }

  .starter-table tfoot th,
  .starter-table tfoot td {
    font-weight: 700;
    color: var(--color-text-primary);
    border-top: 1px solid var(--color-border);
    padding-top: 6px;
  }

  .starter :global(svg) { width: 100%; height: auto; display: block; }

  /* Phones get the narrower drawing, with labels sized to stay readable
     once it is scaled down to the card. */
  .starter :global(.starter-chart--narrow) { display: none; }
  .starter :global(.starter-chart--narrow text) { font-size: 14px; }
  .starter :global(.starter-chart--narrow .hc-endValue) { font-size: 15px; transform: translateY(5px); }
  /* One series here, so its name needs no series colour; link blue would read as a link. */
  .starter :global(.hc-endName) { fill: var(--color-text-primary); }

  @media (max-width: 640px) {
    .starter :global(.starter-chart--wide) { display: none; }
    .starter :global(.starter-chart--narrow) { display: block; }
  }

  /* ----------------------------------------------------------------
     2. Start wherever you are
     ---------------------------------------------------------------- */
  .start-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 760px) {
    .start-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .start-card {
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg);
  }

  /* Text colour, not link blue: at this size a blue title reads as a link. */
  .start-card h3 {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0 0 8px;
  }

  .start-detail {
    margin: 0 0 12px;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* The fold fills the card, so the door still sits at the bottom. */
  .start-fold,
  .start-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .start-fold::details-content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .start-fold > summary { display: block; }

  /* Block-level, as when it was a paragraph, so no extra line box. */
  .start-fold > summary .start-route { display: flex; }

  .start-meta {
    display: block;
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .start-lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  /* Number and title stay on one row; a long title wraps beside its
     number instead of dropping below it. */
  .start-lessons li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .start-lessons li span {
    flex: 1 1 auto;
    min-width: 0;
    padding: 6px 0;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .start-more,
  .grows-links a,
  .pair-lesson a {
    display: inline-block;
    padding: 6px 0;
    color: var(--color-deep-blue);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-deep-blue) 35%, transparent);
    text-underline-offset: 3px;
  }

  .start-more:hover,
  .grows-links a:hover,
  .pair-lesson a:hover { text-decoration-color: currentColor; }

  .start-route-label {
    margin: 0 0 2px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /* The route reads as numbered steps, so a card is a path, not a list. */
  .start-lessons { counter-reset: route; }

  .start-lessons li { counter-increment: route; }

  .start-lessons li::before {
    content: counter(route);
    flex-shrink: 0;
    /* Centres the number on the first line of the link (6px link padding). */
    margin-top: 8px;
    width: 1.5em;
    height: 1.5em;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .start-tools {
    margin: 10px 0 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .start-tools a {
    color: var(--color-deep-blue);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-deep-blue) 35%, transparent);
    text-underline-offset: 3px;
  }

  .start-tools a:hover { text-decoration-color: currentColor; }

  .start-more {
    padding-top: 12px;
    font-size: 0.9rem;
  }

  /* How lessons teach, for readers who already know the rules. */
  .depth {
    margin-top: 28px;
    padding: 22px 24px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--color-teal) 22%, transparent);
    background: color-mix(in srgb, var(--color-teal) 6%, var(--color-bg-white));
  }

  .depth h3 {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    color: var(--color-text-primary);
    margin: 0 0 8px;
  }

  .depth-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 6px;
    counter-reset: depth;
  }

  .depth-steps li {
    counter-increment: depth;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .depth-steps li::before {
    content: counter(depth);
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    border: 1.5px solid var(--color-text-secondary);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* An arrow between steps on one row; hidden when the row wraps on phones. */
  .depth-steps li:not(:last-child)::after {
    content: '→' / '';
    margin: 0 4px 0 6px;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  @media (max-width: 559px) {
    .depth-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .depth-steps li:not(:last-child)::after { content: none; }
  }

  /* The door: one way into each route, as a text link so the hero's
     "Start learning" stays the page's only primary button. Pinned to the
     bottom so the links line up across a row of cards. */
  .start-door {
    margin-top: auto;
    padding-top: 14px;
  }

  .start-door-link {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 6px;
    min-height: 44px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-deep-blue) 35%, transparent);
    text-underline-offset: 4px;
  }

  .start-door-link:hover { text-decoration-color: currentColor; }

  .start-door-link:focus-visible {
    outline: 2px solid var(--color-deep-blue);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* Inclusive Finances: a route of its own, across the full width. */
  .start-card--inclusive {
    grid-column: 1 / -1;
    border-color: color-mix(in srgb, var(--level-inclusive-finances) 40%, var(--color-border));
    border-left: 5px solid var(--level-inclusive-finances);
  }

  .start-route {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .start-route svg { color: var(--level-inclusive-finances); flex-shrink: 0; }

  .start-situations {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .start-situations li {
    /* Plain labels, not links: tinted text with no border so they do not
       read as buttons. */
    padding: 3px 10px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--level-inclusive-finances) 10%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-primary);
  }

  /* ----------------------------------------------------------------
     3. Lesson and tool pairs
     ---------------------------------------------------------------- */
  .pair-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    align-items: center;
  }

  @media (min-width: 760px) {
    .pair { grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1.3fr); gap: 16px; }
  }

  .pair-lesson {
    display: flex;
    flex-direction: column;
  }

  .pair-kicker {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .pair-lesson a { font-size: 1.05rem; }

  .pair-arrow {
    display: none;
    color: var(--color-text-muted);
    font-size: 1.4rem;
    text-align: center;
  }

  @media (min-width: 760px) { .pair-arrow { display: block; } }

  .an-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 2px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .an-card > :not(.an-preview) { grid-column: 2; }

  .an-card:hover {
    border-color: var(--color-teal);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-deep-blue) 10%, transparent);
  }

  .an-card:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .an-preview {
    grid-row: 1 / span 4;
    width: 80px;
    height: 48px;
    align-self: center;
  }

  .an-preview svg { width: 100%; height: 100%; display: block; }

  .an-kicker {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .an-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-deep-blue);
  }

  .an-desc {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .an-cta {
    margin-top: 4px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-deep-blue);
  }

  /* ----------------------------------------------------------------
     4. Grows with you
     ---------------------------------------------------------------- */
  .grows-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .grows-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 56px; }
  }

  .grows-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: grows;
  }

  .grows-list > li {
    position: relative;
    padding: 0 0 24px 34px;
    counter-increment: grows;
  }

  /* A line joining the stages, drawn from dot to dot. */
  .grows-list > li::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 5px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-teal);
    background: var(--color-bg-white);
    box-sizing: border-box;
  }

  .grows-list > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 12px;
    top: 20px;
    bottom: -4px;
    width: 2px;
    background: var(--color-border);
  }

  .grows-list > li:last-child { padding-bottom: 0; }

  .grows-list > li:last-child::before { background: var(--color-teal); }

  .grows-list h3 {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    color: var(--color-text-primary);
    margin: 0 0 5px;
    line-height: 1.3;
  }

  .grows-list p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .grows-links {
    list-style: none;
    margin: 7px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 18px;
    row-gap: 2px;
  }

  /* Dense list: medium weight, so the list reads before the links shout. */
  .grows-links a { font-size: 0.9rem; padding: 4px 0; font-weight: 500; }

  /* Phones: links stack for comfortable tap targets. */
  @media (max-width: 759px) {
    #grows .section-head { margin-bottom: 32px; }
    .grows-grid { gap: 28px; }
    .grows-list > li { padding-left: 30px; padding-bottom: 22px; }
    .grows-list > li:last-child { padding-bottom: 0; }
    .grows-list > li::before { left: 4px; }
    .grows-list > li:not(:last-child)::after { left: 10px; }
    .grows-links { display: grid; gap: 0; }
  }

  .mc-panel {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-bg);
  }

  .mc-panel h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin: 0 0 8px;
  }

  .mc-panel > p {
    margin: 0 0 16px;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .mc-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  .mc-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .mc-amount { color: var(--color-text-primary); font-weight: 600; white-space: nowrap; }

  .mc-result { min-height: 44px; }

  .mc-total {
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-deep-blue);
  }

  .mc-bar {
    display: flex;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    background: var(--color-border-light);
    margin-bottom: 8px;
  }

  .mc-bar[hidden] { display: none; }

  .mc-split {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .mc-note {
    margin: 16px 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ----------------------------------------------------------------
     5. Planner
     ---------------------------------------------------------------- */
  .planner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .planner-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; }
  }

  .planner-list {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .planner-list li {
    position: relative;
    padding-left: 22px;
    color: var(--color-text-primary);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  .planner-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  /* ----------------------------------------------------------------
     6. Trust
     ---------------------------------------------------------------- */
  .trust-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  @media (min-width: 760px) {
    .trust-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .trust-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .trust-grid li {
    padding: 18px 20px;
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    background: var(--color-bg);
    font-size: 0.93rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Phone-only marks; shown by the small-screen rules below. */
  .trust-icon,
  .start-badge { display: none; }

  .trust-grid strong {
    display: block;
    font-family: var(--font-heading);
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  .trust-founder {
    margin: 28px auto 0;
    max-width: 62ch;
    text-align: center;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* ----------------------------------------------------------------
     7. FAQ
     ---------------------------------------------------------------- */
  .faq-heading { text-align: center; margin-bottom: 24px; }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 4px;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-teal);
    flex-shrink: 0;
  }

  .faq-item[open] summary::after { content: '\2212'; }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .faq-item h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .faq-item p {
    margin: 0 4px 18px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 0.97rem;
    max-width: 64ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-btn, .an-card { transition: none; }
  }

  /* ----------------------------------------------------------------
     Small screens
     ---------------------------------------------------------------- */
  @media (max-width: 640px) {
    .lp-section { padding: 44px 16px; }
    #hero { padding-top: 28px; }
    .section-head { margin-bottom: 24px; }
    .starter { box-shadow: none; }
    .ex-steps { padding: 12px; gap: 6px; }
    /* Numbers drop on phones so the three steps fit on one line. */
    .ex-step { padding: 0 12px; font-size: 0.85rem; }
    .ex-step-num { display: none; }
    .ex-slide { padding: 18px 16px 20px; }
    .starter-table { font-size: 0.85rem; }
    .starter-table th,
    .starter-table td { padding: 1px 0; }
    .starter-table tfoot th,
    .starter-table tfoot td { padding-top: 4px; }
    .starter :global(.starter-chart--narrow) { margin-top: 6px; }
    .hero-actions .lp-btn { flex: 1 1 auto; }
    .mc-panel { padding: 18px; }
    .start-situations { gap: 6px; }
    .start-situations li { font-size: 0.8rem; padding: 2px 8px; }

    /* Starting points: rows marked by their level's number and colour, each
       opening its route. Inclusive Finances keeps a box: it sits beside the
       ladder, not on it. */
    .start-grid { gap: 0; }
    .start-card {
      padding: 16px 2px;
      border: 0;
      border-bottom: 1px solid var(--color-border);
      border-radius: 0;
      background: transparent;
    }
    .start-card:first-child { padding-top: 4px; }
    .start-card .fold-head { padding-left: 38px; }
    /* The badge carries the level colour; the label stays neutral, since Building's level blue is the link blue. */
    .start-badge {
      position: absolute;
      left: 0;
      top: 0;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border: 1.5px solid var(--start-level);
      border-radius: 50%;
      background: color-mix(in srgb, var(--start-level) 12%, var(--color-bg-white));
      color: var(--start-level);
      font-family: var(--font-heading);
      font-size: 0.78rem;
      font-weight: 700;
    }
    /* A notch smaller than desktop: the rows read as a list to scan. */
    .start-card h3 { margin-bottom: 4px; font-size: 1rem; }
    .start-meta { font-size: 0.75rem; }
    .start-detail,
    .start-lessons a,
    .start-tools,
    .start-door .lp-btn { font-size: 0.88rem; }
    .depth h3 { font-size: 1rem; }
    .start-fold > summary .start-meta { margin: 0; }
    .start-fold[open] > summary { margin-bottom: 12px; }
    .start-card--inclusive {
      margin-top: 16px;
      padding: 16px;
      border: 1px solid color-mix(in srgb, var(--level-inclusive-finances) 40%, var(--color-border));
      border-left: 4px solid var(--level-inclusive-finances);
      border-radius: 14px;
      background: color-mix(in srgb, var(--level-inclusive-finances) 7%, var(--color-bg-white));
    }
    .start-card--inclusive .fold-head { padding-left: 0; }
