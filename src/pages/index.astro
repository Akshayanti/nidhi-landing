---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import { getCollection } from 'astro:content';

// The live home page (scroll-snap landing redesign). See
// docs/plans/landing-page-redesign.md for the full plan and
// docs/plans/landing-wireframe.html for the wireframe.

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Pre-beta personal finance planning across currencies. Plan net worth, early retirement, and big money decisions before you make them.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Pre-beta planning for net worth, early retirement, and big money decisions across currencies.',
  // SearchAction wired up in PR4. The blog index honours `?q=` as a
  // deep link and writes the value back into the URL via
  // `replaceState` as the search field changes (see
  // `src/components/LearningPath.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const liveBlogSlugs = new Set(
  (await getCollection('blog'))
    .filter((post) => post.data.pubDate <= new Date())
    .map((post) => post.data.slug),
);

function liveBlogHref(slug: string) {
  return liveBlogSlugs.has(slug) ? `/blog/${slug}/` : null;
}

const blogLinks = {
  netWorth: liveBlogHref('what-is-net-worth'),
  calculateNetWorth: liveBlogHref('how-to-calculate-net-worth'),
  crossCurrencies: liveBlogHref('managing-money-across-currencies'),
  purchasingPower: liveBlogHref('why-your-euro-buys-more-in-some-countries'),
  financialIndependence: liveBlogHref('introduction-to-financial-independence'),
  goals: liveBlogHref('setting-financial-goals'),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://nidhi.today/',
    },
  ],
};

// Pre-launch CTA. Swaps to "Get beta access" at beta and
// "Sign up free" at public release. Single-line edit per phase.
const heroCta = 'Notify me about beta';
---

<BaseLayout
  title="nidhi | Multi-Currency Financial Planning"
  description="Plan big money decisions across currencies. Track net worth, model early retirement, and test what changes before you make a financial decision. Public beta coming soon."
  imageAlt="nidhi: multi-currency financial planning for net worth, early retirement, and big money decisions."
  jsonLd={[organizationSchema, webSiteSchema, breadcrumbSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  <slot name="head" slot="head">
    {/* Frankfurter is used by the hero's live FX caption. Preconnecting
        here lands the rates request faster on first paint. */}
    <link rel="preconnect" href="https://api.frankfurter.dev" crossorigin />
  </slot>

  {/* =============================================================
       Section 1: Hero
       ============================================================= */}
  <section class="lp-section snap-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="lp-eyebrow">Money, understood</p>
          <h1 id="hero-heading">Plan big money decisions across currencies.</h1>
          <p class="lp-subhead">
            Track net worth, model early retirement, and test what changes before you make a financial decision. Public beta is coming soon.
          </p>

          <WaitlistSection variant="hero" cta={heroCta} />

          <p class="hero-trust-line">
            Built because no planner handled my actual life: assets in three currencies, debts in two, retirement that crossed borders. Join the beta list and we will email you when access opens. <a href="/beliefs/">More on our beliefs</a>{blogLinks.crossCurrencies && <> and <a href={blogLinks.crossCurrencies}>planning across currencies</a></>}.
          </p>
        </div>

        <div class="hero-visual-wrap" aria-hidden="false">
          <div class="lp-visual-card hero-carousel" data-hero-carousel aria-label="Illustrative nidhi planning examples">
            <div class="hero-carousel-slides">
              <div class="hero-carousel-slide is-active" data-slide>
                <svg viewBox="0 0 360 340" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-summary-title hero-summary-desc">
                  <title id="hero-summary-title">Net worth summary example</title>
                  <desc id="hero-summary-desc">A summary card showing a net worth of EUR 124,300 split across three currencies, above a twelve-month historical line and twelve-month projected line.</desc>
                  <text x="180" y="32" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" font-weight="700" letter-spacing="0.12em" fill="var(--color-text-muted)">NET WORTH</text>
                  <text x="180" y="72" text-anchor="middle" font-family="Inter,sans-serif" font-size="28" font-weight="700" fill="var(--color-deep-blue)">EUR 124,300</text>
                  <g transform="translate(40,92)">
                    <rect x="0" y="0" width="173.6" height="10" fill="var(--chart-eur)" rx="2" ry="2" />
                    <rect x="173.6" y="0" width="78.4" height="10" fill="var(--chart-usd)" />
                    <rect x="252" y="0" width="28" height="10" fill="var(--chart-inr)" rx="2" ry="2" />
                  </g>
                  <text x="180" y="125" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="var(--color-text-secondary)">EUR 62%  &#183;  USD 28%  &#183;  INR 10%</text>
                  <line x1="40" y1="148" x2="320" y2="148" stroke="var(--color-border-light)" stroke-width="1" />
                  <text x="180" y="168" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="700" letter-spacing="0.12em" fill="var(--color-text-muted)">12-MONTH TRACK</text>
                  <line x1="40" y1="190" x2="320" y2="190" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="245" x2="320" y2="245" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="300" x2="320" y2="300" stroke="var(--color-border-light)" />
                  <polygon points="40,288 70,282 100,275 130,265 160,250 180,235 180,300 40,300" fill="var(--chart-eur)" opacity="0.08" />
                  <polyline points="40,288 70,282 100,275 130,265 160,250 180,235" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="180" cy="235" r="4" fill="var(--chart-eur)" stroke="var(--color-bg-white)" stroke-width="2" />
                  <polyline points="180,235 215,222 250,210 285,198 320,190" stroke="var(--chart-eur)" stroke-width="2" stroke-dasharray="4,3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <text x="40" y="320" text-anchor="start" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">12 mo ago</text>
                  <text x="180" y="320" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" font-weight="600" fill="var(--color-text-secondary)">today</text>
                  <text x="320" y="320" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+ 12 mo</text>
                </svg>
                <p class="lp-visual-caption">Net worth path<span class="lp-example-badge">illustrative</span><br /><span id="hero-fx-caption" aria-live="polite">Live ECB rate: loading&hellip;</span></p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <svg viewBox="0 0 480 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-mc-title hero-mc-desc">
                  <title id="hero-mc-title">Multi-currency net worth example</title>
                  <desc id="hero-mc-desc">A list of multi-currency assets and liabilities with a currency split and total converted to EUR.</desc>
                  <text x="20" y="28" font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-muted)">TOTAL NET WORTH</text>
                  <text x="20" y="58" font-family="Inter,sans-serif" font-size="24" font-weight="700" fill="var(--color-deep-blue)">EUR 451,200</text>
                  <line x1="20" y1="80" x2="460" y2="80" stroke="var(--color-border-light)" />
                  <g font-family="Inter,sans-serif" font-size="13" fill="var(--color-text-primary)">
                    <text x="20" y="105">Apartment, Prague</text>
                    <text x="460" y="105" text-anchor="end" fill="var(--color-text-secondary)">EUR 280,000</text>
                    <text x="20" y="135">Brokerage, US</text>
                    <text x="460" y="135" text-anchor="end" fill="var(--color-text-secondary)">USD  47,300</text>
                    <text x="20" y="165">Savings, India</text>
                    <text x="460" y="165" text-anchor="end" fill="var(--color-text-secondary)">INR 8,40,000</text>
                    <text x="20" y="195" fill="var(--color-text-muted)">Mortgage, EUR</text>
                    <text x="460" y="195" text-anchor="end" fill="var(--color-text-muted)">EUR -110,000</text>
                  </g>
                  <line x1="20" y1="215" x2="460" y2="215" stroke="var(--color-border-light)" />
                  <g transform="translate(70,275)">
                    <path d="M 0 -28 A 28 28 0 1 1 -19.17 20.41 L 0 0 Z" fill="var(--chart-eur)" />
                    <path d="M -19.17 20.41 A 28 28 0 0 1 -16.46 -22.65 L 0 0 Z" fill="var(--chart-usd)" />
                    <path d="M -16.46 -22.65 A 28 28 0 0 1 0 -28 L 0 0 Z" fill="var(--chart-inr)" />
                    <circle cx="0" cy="0" r="16" fill="var(--color-bg-white)" />
                  </g>
                  <g font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-secondary)">
                    <rect x="120" y="262" width="9" height="9" fill="var(--chart-eur)" rx="2" />
                    <text x="135" y="270">EUR 62%</text>
                    <rect x="210" y="262" width="9" height="9" fill="var(--chart-usd)" rx="2" />
                    <text x="225" y="270">USD 28%</text>
                    <rect x="300" y="262" width="9" height="9" fill="var(--chart-inr)" rx="2" />
                    <text x="315" y="270">INR 10%</text>
                    <text x="120" y="293" fill="var(--color-text-muted)">Currency split, all converted to EUR</text>
                  </g>
                </svg>
                <p class="lp-visual-caption">Multi-currency picture<span class="lp-example-badge">illustrative</span></p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <svg viewBox="0 0 480 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-proj-title hero-proj-desc">
                  <title id="hero-proj-title">Projection example</title>
                  <desc id="hero-proj-desc">A net-worth projection crossing a financial-independence target line at year 16.</desc>
                  <line x1="40" y1="40" x2="460" y2="40" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="100" x2="460" y2="100" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="160" x2="460" y2="160" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="220" x2="460" y2="220" stroke="var(--color-border-light)" />
                  <line x1="40" y1="80" x2="460" y2="80" stroke="var(--color-teal)" stroke-width="1.5" />
                  <text x="46" y="72" text-anchor="start" font-family="Inter,sans-serif" font-size="10" fill="var(--color-teal)" font-weight="600">Financial independence</text>
                  <polyline points="40,210 60,205 80,195 100,180" stroke="var(--color-text-secondary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <polyline points="100,180 160,170 220,150 280,118 340,72 400,45 460,30" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="330" cy="80" r="5" fill="var(--chart-eur)" stroke="var(--color-bg-white)" stroke-width="2" />
                  <line x1="330" y1="80" x2="330" y2="220" stroke="var(--color-text-muted)" stroke-dasharray="2,2" />
                  <text x="330" y="255" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="var(--color-text-primary)" font-weight="600">Reaches FI at year 16</text>
                  <text x="40" y="240" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">today</text>
                  <text x="460" y="240" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+25 years</text>
                  <text x="40" y="268" font-family="Inter,sans-serif" font-size="10" fill="var(--color-text-muted)">Real returns 5%  &#183;  Inflation 2.5% (EUR)  &#183;  Savings rate 38%</text>
                </svg>
                <p class="lp-visual-caption">Early-retirement projection<span class="lp-example-badge">illustrative</span></p>
              </div>

              <div class="hero-carousel-slide" data-slide>
                <svg viewBox="0 0 480 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="hero-wi-title hero-wi-desc">
                  <title id="hero-wi-title">What-if comparison example</title>
                  <desc id="hero-wi-desc">Two net-worth paths over twenty years comparing current savings with saving five percentage points more.</desc>
                  <line x1="40" y1="40" x2="400" y2="40" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="120" x2="400" y2="120" stroke="var(--color-border-light)" stroke-dasharray="2,4" />
                  <line x1="40" y1="200" x2="400" y2="200" stroke="var(--color-border-light)" />
                  <polyline points="40,200 100,180 160,155 220,125 280,95 340,68 400,50" stroke="var(--chart-usd)" stroke-width="2.5" fill="none" stroke-linecap="round" />
                  <text x="406" y="54" font-family="Inter,sans-serif" font-size="10" fill="var(--chart-usd)" font-weight="600">Save +5pp</text>
                  <polyline points="40,200 100,190 160,178 220,160 280,140 340,118 400,95" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" stroke-linecap="round" />
                  <text x="406" y="99" font-family="Inter,sans-serif" font-size="10" fill="var(--chart-eur)" font-weight="600">Current</text>
                  <text x="40" y="220" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">today</text>
                  <text x="400" y="220" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="var(--color-text-muted)">+20 years</text>
                  <text x="240" y="255" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" font-weight="600" fill="var(--color-text-primary)">After 20 years: about EUR 220k more by saving 5pp extra.</text>
                </svg>
                <p class="lp-visual-caption">What-if comparison<span class="lp-example-badge">illustrative</span></p>
              </div>
            </div>

            <div class="hero-carousel-controls" aria-label="Example controls">
              <div class="hero-carousel-dots" role="tablist" aria-label="Illustrative examples">
                <button type="button" role="tab" class="hero-carousel-dot is-active" data-slide-dot aria-label="Show net worth path example" aria-selected="true"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show multi-currency example" aria-selected="false"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show early-retirement projection example" aria-selected="false"></button>
                <button type="button" role="tab" class="hero-carousel-dot" data-slide-dot aria-label="Show what-if comparison example" aria-selected="false"></button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a class="lp-scroll-affordance" href="#who" aria-label="Scroll to who nidhi is for">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* =============================================================
       Section 2: Who it's for
       ============================================================= */}
  <section class="lp-section lp-section--alt snap-section" id="who" aria-labelledby="who-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="audience-grid">
        <div class="audience-copy">
          <p class="lp-eyebrow">Who it's for</p>
          <h2 id="who-heading">For people whose money crosses borders.</h2>
          <p class="cap-body">
            Multi-currency planning is the core of nidhi. The beta is for people who need their full plan to work across borders, not as an afterthought{blogLinks.purchasingPower && <>: the same money can behave differently depending on where you live, work, and spend it. <a href={blogLinks.purchasingPower}>Read the primer on purchasing power across countries</a>.</>}
          </p>
        </div>

        <ul class="audience-list">
          <li>You cannot answer "Can I afford this?" without rebuilding your spreadsheet.</li>
          <li>Your retirement plan changes depending on where you eventually live.</li>
          <li>You are comparing a property purchase, career change, or other major financial decision.</li>
          <li>Your financial picture is spread across accounts, assets, debts, and future expenses.</li>
        </ul>
      </div>

      <a class="lp-scroll-affordance" href="#how-it-works" aria-label="Scroll to how nidhi works">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* =============================================================
       Section 3: How it works
       ============================================================= */}
  <section class="lp-section snap-section" id="how-it-works" aria-labelledby="how-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="how-grid">
        <div class="how-copy">
          <p class="lp-eyebrow">The model</p>
          <h2 id="how-heading">Start with your real financial life.</h2>
          <p class="cap-body">
            nidhi is built around {blogLinks.netWorth ? <a href={blogLinks.netWorth}>what you own and what you owe</a> : 'what you own, what you owe'}, what you earn, and what you expect to spend. From there, it projects your path and lets you compare choices before you make a financial decision.
          </p>
        </div>

        <ol class="how-steps" aria-label="How nidhi works">
          <li>
            <span class="how-step-number">1</span>
            <div>
              <h3>Add the pieces</h3>
              <p>Assets, debts, income, recurring expenses, future costs, and the currencies they live in.</p>
            </div>
          </li>
          <li>
            <span class="how-step-number">2</span>
            <div>
              <h3>See the path</h3>
              <p>{blogLinks.calculateNetWorth ? <a href={blogLinks.calculateNetWorth}>Net worth</a> : 'Net worth'}, cash flow, {blogLinks.financialIndependence ? <a href={blogLinks.financialIndependence}>retirement timing</a> : 'retirement timing'}, and the assumptions behind the projection.</p>
            </div>
          </li>
          <li>
            <span class="how-step-number">3</span>
            <div>
              <h3>Compare the decision</h3>
              <p>Buying property, saving more, changing jobs, adding future expenses, or retiring earlier.</p>
            </div>
          </li>
        </ol>
      </div>

      <a class="lp-scroll-affordance" href="#beta-scope" aria-label="Scroll to public beta scope">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* =============================================================
       Section 4: Public beta scope
       ============================================================= */}
  <section class="lp-section lp-section--alt snap-section" id="beta-scope" aria-labelledby="beta-scope-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="beta-scope">
        <div class="beta-scope-copy">
          <p class="lp-eyebrow">Public beta</p>
          <h2 id="beta-scope-heading">What we're building for public beta.</h2>
          <p class="cap-body">
            The first beta is focused on the planning questions that get messy when your money crosses borders. These are the core areas we want early users to pressure-test.
          </p>
        </div>

        <ul class="beta-scope-list">
          <li>
            <h3>Multi-currency net worth</h3>
            <p>Track assets and debts in different currencies, then view the whole picture in the currency you actually spend{blogLinks.crossCurrencies ? <>. <a href={blogLinks.crossCurrencies}>Read how cross-currency planning changes the picture</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>Retirement and early-retirement projections</h3>
            <p>See possible timing, key assumptions, and how the path changes when your savings or costs change{blogLinks.financialIndependence ? <>. <a href={blogLinks.financialIndependence}>Start with financial independence basics</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>Goal and expense planning</h3>
            <p>Map expected income, recurring costs, and future expenses into the same long-range plan{blogLinks.goals ? <>. <a href={blogLinks.goals}>Read about setting concrete financial goals</a>.</> : '.'}</p>
          </li>
          <li>
            <h3>What-if comparisons</h3>
            <p>Model major decisions like buying property, saving more, taking a lower-paying job, or changing key assumptions.</p>
          </li>
        </ul>
      </div>

      <a class="lp-scroll-affordance" href="#signup" aria-label="Scroll to beta signup">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {/* =============================================================
       Conversion tail. Deliberately NOT a snap section: it scrolls
       naturally as the page's conclusion: trust strip -> waitlist.
       Footer.astro renders below <main> in the default Astro flow.
       ============================================================= */}
  <section class="lp-section lp-section--tail" id="signup" aria-labelledby="signup-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="available-now" aria-labelledby="available-now-heading">
        <div class="available-now-copy">
          <p class="lp-eyebrow">Available now</p>
          <h2 id="available-now-heading">Use the free tools while public beta is being built.</h2>
          <p>
            The full planner is still pre-beta. In the meantime, the free tools and blog are live.
          </p>
        </div>
        <div class="available-now-links" aria-label="Available now links">
          <a href="/free/multi-currency-net-worth/">
            <span>Multi-currency net worth</span>
            <small>See assets and debts across currencies.</small>
          </a>
          <a href="/free/loan-comparison/">
            <span>Loan comparison</span>
            <small>Compare borrowing offers side by side.</small>
          </a>
          <a href="/blog/">
            <span>Read the blog</span>
            <small>Learn the concepts behind the planner.</small>
          </a>
        </div>
      </div>

      <div class="trust-strip" aria-label="Privacy and data handling">
        <p class="trust-strip-title">What this means for your data</p>
        <ul>
          <li>Free-tool calculations run entirely in your browser. Your numbers never leave the page.</li>
          <li>No ads. No data selling. Analytics on EU servers only (PostHog Cloud EU).</li>
          <li>We never share or sell your email. One click to unsubscribe from anything.</li>
          <li>GDPR-aware. <a href="/privacy/">Read the full privacy policy.</a></li>
        </ul>
      </div>

