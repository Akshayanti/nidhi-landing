     1. Hero
     ---------------------------------------------------------------- */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 60px; }
  }

  .hero-copy h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.4vw + 0.6rem, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-deep-blue);
    margin: 0 0 18px;
    font-weight: 700;
    text-wrap: balance;
  }

  .lp-subhead {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
