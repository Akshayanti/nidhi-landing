---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import HeroChart from '../components/HeroChart.astro';
import { EXAMPLE_RETURN, STARTER, starterExample, yearlyPath } from '../utils/home/heroExamples.ts';
import {
  assertHomepageSlugs,
  LADDER_LEVELS,
  lessonToolPairs,
  levelCounts,
  readingOrder,
  resolveStartingPoints,
} from '../utils/home/startingPoints.ts';
import { assertInclusiveGroups, INCLUSIVE_HUB, liveInclusive } from '../utils/inclusiveGuides.ts';
import { formatAmount } from '../utils/shared/formatAmount.ts';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../utils/monte-carlo/release.ts';
import { getCollection } from 'astro:content';

// The live home page. It tells one story, in order: understand your money,
// starting wherever you are; learn it, then try it on your own numbers; and
// keep going as life gets more involved, including across currencies. The
// planner, which is not open yet, comes after everything that is.
//
// Every lesson and tool link is chosen in src/utils/home/startingPoints.ts
// and only appears once its post is published (or, for the Monte Carlo
// simulator, once the tool launches). Dev shows scheduled posts too.

const isDev = import.meta.env.DEV;
const now = isDev ? new Date('2999-01-01') : new Date();
const allPosts = await getCollection('blog');
assertHomepageSlugs(allPosts);

const showMonteCarlo = await isMonteCarloReleased();
const isToolLive = (href: string) => href !== MONTE_CARLO_URL || showMonteCarlo;
const startingPoints = resolveStartingPoints(allPosts, now, isToolLive);
const pairs = lessonToolPairs(allPosts, now, isToolLive);
const counts = levelCounts(allPosts, now);
const order = readingOrder(allPosts, now);
const firstLesson = order[0];

// Inclusive Finances joins the starting points once a guide in it is live.
assertInclusiveGroups(allPosts);
const inclusive = liveInclusive(allPosts, now);

// The worked example, computed (see src/utils/home/heroExamples.ts): the
// table sits in Step 2 and the ten-year chart in Step 3.
const eur = (v: number) => formatAmount(v, 'EUR');
const ex = starterExample();
const pctReturn = `${Math.round(EXAMPLE_RETURN * 100)}%`;
const roundedEnd = Math.round(ex.end / 100) * 100;
// Drawn twice: a narrower drawing for phones keeps its labels readable
// (CSS shows one of the two). The description and the footnote are printed
// once, outside both drawings, so the page text (and anything reading it,
// crawlers included) carries each only once.
const roundedGrowth = Math.round(ex.growth / 100) * 100;
// Step 3: the same start with one decision changed, the monthly amount.
// The gap is split into money put in and growth, so it is not read as
// growth alone.
const HIGHER_MONTHLY = 300;
const alt = yearlyPath(ex.invested, HIGHER_MONTHLY, STARTER.years);
const roundedAlt = Math.round(alt[STARTER.years] / 100) * 100;
const gap = roundedAlt - roundedEnd;
const extraIn = (HIGHER_MONTHLY - STARTER.monthly) * 12 * STARTER.years;
const starterDesc = `Two example paths from the same ${eur(ex.invested)} invested today, at an illustrative ${pctReturn} a year after inflation. Adding ${eur(STARTER.monthly)} a month reaches about ${eur(roundedEnd)} after ${STARTER.years} years; adding ${eur(HIGHER_MONTHLY)} a month reaches about ${eur(roundedAlt)}. The gap of about ${eur(gap)} is ${eur(extraIn)} more put in and about ${eur(gap - extraIn)} more growth.`;
const starterChart = {
  title: 'Example: one decision compared over ten years',
  descId: 'hero-starter-desc',
  pointLabels: ex.values.map((_, i) => (i === 0 ? 'Today' : `Year ${i}`)),
  series: [
    { name: `${HIGHER_MONTHLY} €/mo`, values: alt, color: 'var(--chart-usd)' },
    { name: `${STARTER.monthly} €/mo`, values: ex.values, color: 'var(--chart-eur)', area: true },
  ],
  axisStart: 'today',
  axisEnd: `+${STARTER.years} years`,
};
// Step 2: two illustrative people on the same income, to show that income
// and net worth are different things.
const SAME_INCOME = 3_000;
const people = [
  { name: 'Alex', owns: 22_000, owes: 31_000, note: 'A car and a card, both on credit' },
  { name: 'Sam', owns: 16_500, owes: 4_000, note: 'Savings, a pension, a small loan' },
];
const peopleMax = Math.max(...people.flatMap((p) => [p.owns, p.owes]));
const signedEur = (v: number) => (v < 0 ? `\u2212${eur(-v)}` : eur(v));

// The hero card previews the three steps below with their own numbers; its
// small chart is Step 3's two paths, on one scale.
const spark = (() => {
  const w = 120, h = 36, max = Math.max(...alt);
  const line = (vals: number[]) => vals.map((v, i) => `${((i / (vals.length - 1)) * w).toFixed(1)},${(h - (v / max) * (h - 4) - 2).toFixed(1)}`).join(' ');
  return { low: line(ex.values), high: line(alt) };
})();

const starterFootnote = `Example: ${eur(ex.invested)} invested today, with ${eur(STARTER.monthly)} or ${eur(HIGHER_MONTHLY)} added at the start of each month, at an illustrative ${pctReturn} a year after inflation. Real returns vary from year to year and can be negative. A whole net worth does not grow at one rate: a car loses value and a loan is paid down.`;


// Shown on the page and, word for word, in the FAQPage data below.
const faqs = [
  {
    q: 'Is nidhi for beginners?',
    a: `Yes. The learning path starts with what net worth is and assumes no prior knowledge. Each lesson explains its terms as it goes, and the ${counts.total} lessons so far are in reading order, so you can start at the top and keep going.`,
  },
  {
    q: 'Do I need money in more than one currency to use nidhi?',
    a: 'No. Everything works with a single currency. Multi-currency support is there for when your life needs it: savings in one country, a pension or property in another, or plans to move.',
  },
  {
    q: 'What does nidhi cost?',
    a: 'The lessons and the free tools cost nothing and need no account. The lessons will stay free, with no paywall.',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. nidhi is educational: it explains how money works and lets you model your own situation. It is not a licensed financial adviser. For decisions that matter, talk to a qualified professional.',
  },
  {
    q: 'What happens to the numbers I type into the tools?',
    a: 'They stay on your device and are not sent to nidhi. The free tools calculate in your browser and never put what you type into the page address. When a tool needs outside data, such as the day\'s exchange rates, your browser asks that service for the rates only, never your amounts; like any request, it shows that service your IP address. The privacy page has the details.',
  },
  {
    q: 'What is the planner, and when can I use it?',
    a: 'The planner brings everything together: what you own, owe, earn and expect to spend, projected forward with the assumptions shown, so you can compare decisions before you make them. It is opening in stages. Join the list and you will get one email when it opens.',
  },
];

const description = 'Free personal finance lessons and private tools to understand your money and plan your future, from the basics to finances that span currencies.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  slogan: 'Money, understood',
  description: 'nidhi helps ordinary people understand their money: free, structured personal finance lessons, private in-browser tools, and a planner for their financial future. It starts with the basics and keeps working as finances get more complex, including when money spans currencies and countries.',
  logo: 'https://nidhi.today/brand/favicons/android-chrome-512x512.png',
  foundingLocation: { '@type': 'Place', name: 'Prague' },
  knowsAbout: ['Personal finance', 'Financial literacy', 'Net worth', 'Emergency funds', 'Investing', 'Financial independence', 'Retirement planning', 'Behavioural finance', 'Multi-currency finance'],
  sameAs: [
    'https://www.instagram.com/nidhi.today',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'nidhi',
  url: 'https://nidhi.today/',
  description: 'Money, understood. Learn personal finance, understand your own money, and plan your future, from the basics to finances that span currencies and countries.',
  // The blog index honours `?q=` as a deep link and writes the value back
  // into the URL via `replaceState` as the search field changes (see
  // `src/components/LearningPath.tsx`).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://nidhi.today/blog/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="nidhi | Understand your money and plan what comes next"
  description={description}
  imageAlt="nidhi: money, understood. Free personal finance lessons and private tools to understand your money and plan your future."
  jsonLd={[organizationSchema, webSiteSchema, faqSchema]}
  mainClass="landing-shell"
  bodyData={{ 'data-page': 'landing' }}
>
  {/* =============================================================
       1. Hero: the promise and two ways in
       ============================================================= */}
  <section class="lp-section" id="hero" aria-labelledby="hero-heading">
    <div class="lp-section-inner">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-heading">Understand your money.</h1>
          <p class="lp-subhead hero-trio"><span>Free lessons.</span> <span>Private tools.</span> <span>A planner on the way.</span></p>

          <div class="hero-actions">
            <a href="/blog/" class="lp-btn lp-btn--primary" data-attr="home-hero-start-learning">Start learning</a>
            <a href="/free/" class="lp-btn lp-btn--secondary" data-attr="home-hero-tools">Try a free tool</a>
          </div>

          {firstLesson && (
            <div class="hero-next" data-continue={JSON.stringify(order)} hidden>
              {/* Only for a returning reader: the hero's two buttons are the
                  first-visit choices, and the routes below say where to begin. */}
              <p data-next-continue>
                Welcome back. Pick up where you left off: <a href="#" data-attr="home-hero-continue"></a>
              </p>
            </div>
          )}
        </div>

        {/* The three steps below, at a glance, with the same illustrative numbers. */}
        <div class="journey">
          <p class="journey-label">Learn, review, look ahead &middot; illustrative amounts</p>
          <ol class="journey-list">
            <li>
              <span class="journey-step">1 &middot; Learn</span>
              <span class="journey-big">What is net worth?</span>
              <span class="journey-small">What you own, minus what you owe.</span>
            </li>
            <li>
              <span class="journey-step">2 &middot; Review</span>
              <span class="journey-big">{signedEur(people[0].owns - people[0].owes)} or {signedEur(people[1].owns - people[1].owes)}</span>
              <span class="journey-small">Two people, both earning {eur(SAME_INCOME)} a month.</span>
            </li>
            <li>
              <span class="journey-step">3 &middot; Look ahead</span>
              <span class="journey-big">{eur(gap)} apart</span>
              <span class="journey-small">{eur(STARTER.monthly)} or {eur(HIGHER_MONTHLY)} a month, over {STARTER.years} years.</span>
              <svg class="journey-spark" viewBox="0 0 120 36" aria-hidden="true"><polyline class="journey-spark-high" points={spark.high} /><polyline points={spark.low} /></svg>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       2. Step 1, learn: free lessons, one line per route
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="start" aria-labelledby="start-heading">
    <div class="lp-section-inner">
      <div class="section-head">
        <p class="step-mark"><span class="step-num" aria-hidden="true">1</span><span class="chart-srOnly">Step 1: </span>Learn</p>
        <h2 id="start-heading">Free lessons, for good.</h2>
        <p class="cap-body">No paywall, no account. Pick the line that sounds like you.</p>
      </div>

      {/* One line per route. Each opens the first lesson this browser has not read yet. */}
      <ul class="routes" role="list">
        {startingPoints.map((s) => (
          <li style={`--start-level: var(--level-${s.level ?? 'mixed'}, var(--color-text-secondary))`}>
            <a
              class="route"
              href={s.lessons[0].href}
              data-start-route={JSON.stringify(s.lessons)}
              data-route-done={s.level ? `/blog/${s.level}/` : '/blog/'}
              data-attr={`home-start-${s.id}-door`}
            >
              <span class="route-badge" aria-hidden="true">{s.level ? LADDER_LEVELS.indexOf(s.level as typeof LADDER_LEVELS[number]) + 1 : '+'}</span>
              <span class="route-title">{s.situation}</span>
              <span class="route-meta">{s.levelLabel ? <>{s.levelLabel} &middot; {s.levelCount} lessons</> : <>Lessons from several levels</>}</span>
              <span class="route-go"><span data-door-verb>Start</span><span data-door-title></span> <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        ))}
        {inclusive.count > 0 && (
          <li style="--start-level: var(--level-inclusive-finances)">
            <a class="route route--inclusive" href={INCLUSIVE_HUB} data-attr="home-inclusive-finances">
              <span class="route-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></svg>
              </span>
              <span class="route-title">The standard plan doesn&rsquo;t fit my life.</span>
              <span class="route-meta">Inclusive Finances &middot; {inclusive.count === 1 ? '1 guide' : `${inclusive.count} guides`}, any stage</span>
              <span class="route-go">Explore <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        )}
      </ul>

      <p class="section-foot">
        <a href="/blog/" data-attr="home-cta-blog">See the whole learning path</a>
      </p>
    </div>
  </section>

  {/* =============================================================
       3. Step 2, see yours: an example net worth and the free tools
       ============================================================= */}
  {pairs.length > 0 && (
    <section class="lp-section" id="apply" aria-labelledby="apply-heading">
      <div class="lp-section-inner">
        <div class="section-head">
          <p class="step-mark"><span class="step-num" aria-hidden="true">2</span><span class="chart-srOnly">Step 2: </span>Review</p>
          <h2 id="apply-heading">See where you stand.</h2>
          <p class="cap-body">Free tools that run in your browser, so what you type stays on your device.</p>
        </div>

        <div class="tools-grid">
        <figure class="starter compare">
          <p class="starter-label">Same income, {eur(SAME_INCOME)} a month each</p>
          <div class="compare-grid">
            {people.map((p) => (
              <div class="compare-person">
                <p class="compare-name">{p.name}</p>
                <p class="compare-note">{p.note}</p>
                <dl class="compare-rows">
                  <div><dt>Owns</dt><dd><span class="compare-track" aria-hidden="true"><span class="compare-bar compare-bar--own" style={`width: ${(p.owns / peopleMax) * 100}%`}></span></span>{eur(p.owns)}</dd></div>
                  <div><dt>Owes</dt><dd><span class="compare-track" aria-hidden="true"><span class="compare-bar compare-bar--owe" style={`width: ${(p.owes / peopleMax) * 100}%`}></span></span>{eur(p.owes)}</dd></div>
                </dl>
                <p class={`compare-net${p.owns < p.owes ? ' is-negative' : ''}`}>{signedEur(p.owns - p.owes)} <span>net worth</span></p>
              </div>
            ))}
          </div>
          <figcaption class="compare-caption">Income is what comes in. Net worth is what you own minus what you owe. Illustrative amounts.</figcaption>
        </figure>

        <ul class="tool-list" role="list">
          {pairs.map((p) => {
            const key = p.tool.href.split('/').filter(Boolean).pop();
            return (
              <li>
                <a href={p.tool.href} class="an-card" data-attr={`home-cta-${key}`}>
                  <span class="an-preview" aria-hidden="true">
                    {p.tool.preview === 'donut' && (
                      <svg viewBox="0 0 80 48"><g transform="translate(24,24)"><path d="M 0 -18 A 18 18 0 1 1 -12.3 13.1 L 0 0 Z" fill="var(--chart-eur)" /><path d="M -12.3 13.1 A 18 18 0 0 1 -10.6 -14.6 L 0 0 Z" fill="var(--chart-usd)" /><path d="M -10.6 -14.6 A 18 18 0 0 1 0 -18 L 0 0 Z" fill="var(--chart-inr)" /><circle r="9" fill="var(--color-bg-white)" /></g><rect x="50" y="14" width="22" height="5" rx="2" fill="var(--chart-eur)" /><rect x="50" y="23" width="16" height="5" rx="2" fill="var(--chart-usd)" /><rect x="50" y="32" width="9" height="5" rx="2" fill="var(--chart-inr)" /></svg>
                    )}
                    {p.tool.preview === 'bars' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 8 C 30 12, 50 26, 74 42" stroke="var(--chart-eur)" stroke-width="3" fill="none" stroke-linecap="round" /><path d="M 6 8 C 26 16, 44 30, 64 42" stroke="var(--chart-usd)" stroke-width="3" fill="none" stroke-dasharray="5 4" stroke-linecap="round" /></svg>
                    )}
                    {p.tool.preview === 'fan' && (
                      <svg viewBox="0 0 80 48"><path d="M 6 40 L 74 6 L 74 36 Z" fill="var(--chart-eur)" opacity="0.22" /><path d="M 6 40 L 74 14 L 74 28 Z" fill="var(--chart-eur)" opacity="0.4" /><path d="M 6 40 L 74 21" stroke="var(--chart-eur)" stroke-width="2.5" fill="none" /></svg>
                    )}
                  </span>
                  <span class="an-title">{p.tool.name}</span>
                  <span class="an-desc">{p.tool.desc}</span>
                </a>
              </li>
            );
          })}
        </ul>
        </div>

      </div>
    </section>
  )}

  {/* =============================================================
       4. Step 3, look ahead: what the planner is, one decision compared
          over ten years, and the waitlist
       ============================================================= */}
  <section class="lp-section lp-section--alt" id="signup" aria-labelledby="planner-heading" tabindex="-1">
    <div class="lp-section-inner">
      <div class="planner-grid">
        <div class="planner-copy">
          <p class="step-mark"><span class="step-num" aria-hidden="true">3</span><span class="chart-srOnly">Step 3: </span>Look ahead</p>
          <h2 id="planner-heading">See where it could go.</h2>
          <p class="cap-body">
            We are building a planner: what you own, owe, earn and spend in one place, in one currency or several, so you can compare decisions like this one before you make them.
          </p>
          <div class="starter starter--chart">
            <p class="starter-label">One decision, compared</p>
            <p class="starter-text">The same {eur(ex.invested)} start, with {eur(STARTER.monthly)} or {eur(HIGHER_MONTHLY)} added each month.</p>
            <p class="gap"><strong>About {eur(gap)} apart</strong> after {STARTER.years} years: {eur(extraIn)} more put in, and about {eur(gap - extraIn)} more growth.</p>
            <p id="hero-starter-desc" class="chart-srOnly">{starterDesc}</p>
            <HeroChart id="hero-starter" class="starter-chart--wide" {...starterChart} />
            <HeroChart id="hero-starter-sm" class="starter-chart--narrow" width={300} height={160} {...starterChart} />
            <details class="fold" data-phone-fold>
              <summary class="fold-label">How this example works</summary>
              <p class="hc-foot">{starterFootnote}</p>
            </details>
          </div>
        </div>
        <div class="planner-signup">
          <WaitlistSection />
        </div>
      </div>
    </div>
  </section>

  {/* =============================================================
       5. FAQ (also in FAQPage data above), and who is behind nidhi in
          one line
       ============================================================= */}
  <section class="lp-section" id="faq" aria-labelledby="faq-heading" tabindex="-1">
    <div class="lp-section-inner lp-section-inner--narrow">
      <h2 id="faq-heading" class="faq-heading">FAQ</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" data-attr={`home-faq-${i + 1}`}>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <p class="trust-why">
        nidhi started because one person couldn&rsquo;t find a tool that fit an ordinary financial life: money in more than one country, debts in another, a future that crosses borders. So we are building it, and explaining what we learn along the way.
      </p>
      <p class="trust-line">
        Made in Prague. No ads, no data selling. Lessons cite their sources.
        <span class="trust-links">
          <a href="/beliefs/" data-attr="home-cta-beliefs">What we believe</a>
          <a href="/editorial-policy/" data-attr="home-editorial-policy">How we write</a>
          <a href="/privacy/" data-attr="home-privacy">Privacy policy</a>
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Reading progress on the homepage. Both parts read the existing
  // nidhi-reading-progress key, which never leaves the browser, and only
  // change where links point.
  import { nextLesson, routeNext, type LessonLink } from '../utils/home/startingPoints.ts';

  // Phone folds: supporting detail is collapsed on phones and always shown
  // on wider screens. CSS already shows the content there (::details-content),
  // so this only keeps the open state, and what assistive tech hears, in step
  // with the layout. Nothing is stored: every visit starts the same way.
  const wide = window.matchMedia('(min-width: 641px)');
  const folds = document.querySelectorAll<HTMLDetailsElement>('details[data-phone-fold]');
  function syncFolds() {
    folds.forEach((fold) => {
      fold.open = wide.matches;
      // Not inert: a summary can hold the card's heading, which must stay
      // readable. It just stops being a tab stop while it cannot fold.
      const summary = fold.querySelector('summary');
      if (wide.matches) summary?.setAttribute('tabindex', '-1');
      else summary?.removeAttribute('tabindex');
    });
  }
  syncFolds();
  // Optional call: older Safari has no MediaQueryList.addEventListener, and
  // throwing here would also stop the reading-progress code below.
  wide.addEventListener?.('change', syncFolds);
  // A screen reader can still activate a summary on wide screens; keep the
  // fold open there so what it hears matches what is shown.
  folds.forEach((fold) => {
    fold.addEventListener('toggle', () => {
      if (wide.matches && !fold.open) fold.open = true;
    });
  });

  function readSlugs(): string[] {
    try {
      const read = JSON.parse(localStorage.getItem('nidhi-reading-progress') || '[]');
      return Array.isArray(read) ? read.map(String) : [];
    } catch {
      return [];
    }
  }

  // "Start wherever you are": each card's button leads to the first lesson
  // on its route this browser has not read yet, from the same local key.
  const read = readSlugs();
  document.querySelectorAll<HTMLAnchorElement>('[data-start-route]').forEach((door) => {
    try {
      const route = JSON.parse(door.dataset.startRoute || '[]') as LessonLink[];
      const { next, started } = routeNext(route, read);
      if (!started) return;
      const verb = door.querySelector<HTMLElement>('[data-door-verb]')!;
      const title = door.querySelector<HTMLElement>('[data-door-title]')!;
      if (next) {
        door.href = next.href;
        verb.textContent = 'Continue with ';
        title.textContent = next.title;
      } else {
        door.href = door.dataset.routeDone || '/blog/';
        verb.textContent = 'Route read. ';
        title.textContent = 'Keep going on the learning path';
      }
    } catch {
      /* malformed route: keep the default button */
    }
  });

  // "Continue learning": if this browser has read lessons on the path, point
  // to the next unread one instead of the first lesson.
  const box = document.querySelector<HTMLElement>('[data-continue]');
  if (box) {
    try {
      const order = JSON.parse(box.dataset.continue || '[]') as LessonLink[];
      const next = nextLesson(order, read);
      if (next) {
        const link = box.querySelector<HTMLAnchorElement>('[data-next-continue] a')!;
        link.href = next.href;
        link.textContent = next.title;
        box.hidden = false;
      }
    } catch {
      /* storage unavailable: keep the default line */
    }
  }
</script>

<script is:inline>
  // Hover, tap or arrow keys on the example chart show its values at that
  // point. The values are pre-formatted at build time (HeroChart.astro).
  (function () {
    document.querySelectorAll('[data-hero-chart]').forEach(function (box) {
      var data = JSON.parse(box.getAttribute('data-hero-chart'));
      var svg = box.querySelector('svg');
      var hover = box.querySelector('.hc-hover');
      var cross = hover.querySelector('.hc-crosshair');
      var dots = hover.querySelectorAll('.hc-hoverDot');
      var readout = box.querySelector('.hc-readout');
      var live = box.querySelector('.hc-live');
      var vb = svg.viewBox.baseVal;
      var title = svg.querySelector('title');
      var current = null;
      box.tabIndex = 0;
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', (title ? title.textContent + '. ' : '') + 'Use the left and right arrow keys to read its values.');
      function show(i) {
        current = i;
        var xv = data.xs[i] * vb.width;
        cross.setAttribute('x1', xv);
        cross.setAttribute('x2', xv);
        data.series.forEach(function (s, k) {
          dots[k].setAttribute('cx', xv);
          dots[k].setAttribute('cy', s.ys[i] * vb.height);
        });
        hover.classList.add('is-on');
        readout.innerHTML = '';
        var heading = document.createElement('strong');
        heading.textContent = data.labels[i];
        readout.appendChild(heading);
        data.series.forEach(function (s) {
          var row = document.createElement('span');
          var sw = document.createElement('i');
          sw.style.background = s.color;
          row.appendChild(sw);
          row.appendChild(document.createTextNode(s.name + ': ' + s.values[i]));
          readout.appendChild(row);
        });
        readout.classList.add('is-on');
        if (live) live.textContent = data.labels[i] + '. ' + data.series.map(function (s) { return s.name + ': ' + s.values[i]; }).join(', ') + '.';
        readout.classList.toggle('is-left', data.xs[i] > 0.5);
        readout.style.left = (data.xs[i] * 100) + '%';
      }
      function hide() {
        current = null;
        hover.classList.remove('is-on');
        readout.classList.remove('is-on');
      }
      function nearest(clientX) {
        var r = svg.getBoundingClientRect();
        var fx = (clientX - r.left) / r.width;
        var best = 0;
        data.xs.forEach(function (x, i) { if (Math.abs(x - fx) < Math.abs(data.xs[best] - fx)) best = i; });
        return best;
      }
      svg.addEventListener('pointermove', function (e) { show(nearest(e.clientX)); });
      svg.addEventListener('pointerdown', function (e) { show(nearest(e.clientX)); });
      box.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hide(); });
      box.addEventListener('blur', hide);
      box.addEventListener('keydown', function (e) {
        var last = data.xs.length - 1;
        if (e.key === 'ArrowRight') show(current === null ? 0 : Math.min(last, current + 1));
        else if (e.key === 'ArrowLeft') show(current === null ? last : Math.max(0, current - 1));
        else if (e.key === 'Escape') hide();
        else return;
        e.preventDefault();
      });
    });
  })();
</script>

<style>
  /* ----------------------------------------------------------------
     Section frame: content-height sections with even spacing.
     ---------------------------------------------------------------- */
  .lp-section {
    padding: 80px 24px;
  }

  .lp-section:focus { outline: none; }

  .lp-section--alt { background: var(--color-bg-white); }

  #hero { padding-top: 56px; }

  /* Step 1, 2 and 3: a numbered marker above each step's heading, so the
     three steps read as a sequence. */
  .step-mark {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-teal);
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-bg-white);
    font-size: 0.9rem;
  }

  .lp-section-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .lp-section-inner--narrow { max-width: 760px; }

  .lp-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-teal);
    font-weight: 600;
    margin: 0 0 12px;
  }

  h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw + 0.6rem, 2.3rem);
    line-height: 1.15;
    color: var(--color-deep-blue);
    margin: 0 0 14px;
    font-weight: 700;
    text-wrap: balance;
  }

  .section-head {
    max-width: 680px;
    margin-bottom: 36px;
  }

  .section-head--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-head--center .cap-body { margin: 0 auto; }

  .cap-body {
    font-size: 1.02rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 60ch;
    text-wrap: pretty;
    margin: 0;
  }

  .section-foot {
    margin: 28px 0 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .section-foot a,
  .hero-next a,
  .trust-line a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Buttons */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .lp-btn--primary {
    background: var(--color-cta-bg);
    color: var(--color-cta-fg);
    border: 1px solid var(--color-cta-bg);
  }

  .lp-btn--primary:hover { background: var(--color-cta-bg-hover); }

  .lp-btn--secondary {
    background: var(--color-bg-white);
    color: var(--color-deep-blue);
    border: 1px solid var(--color-border);
  }

  .lp-btn--secondary:hover { border-color: var(--color-teal); }

  .lp-btn:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .lp-btn:disabled { opacity: 0.6; cursor: wait; }

  /* ----------------------------------------------------------------
     Phone folds (details[data-phone-fold]): closed on phones, a plain
     always-open block on wider screens. A fold-head summary holds the
     block's heading and stays visible; a fold-label summary is only the
     phone toggle and is hidden on wider screens.
     ---------------------------------------------------------------- */
  .fold > summary {
    list-style: none;
    cursor: pointer;
  }

  .fold > summary::-webkit-details-marker { display: none; }

  .fold > summary:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (min-width: 641px) {
    .fold > summary { pointer-events: none; cursor: auto; }
    .fold > summary.fold-label { display: none; }
  }

  /* Shows the content before the script has opened the fold, so wide
     screens never see it collapse and reopen. A separate rule, so a browser
     without ::details-content skips only this. */
  @media (min-width: 641px) {
    .fold::details-content { content-visibility: visible; }
  }

  @media (max-width: 640px) {
    .fold > summary { position: relative; padding-right: 32px; }

    .fold > summary::after {
      content: '+' / '';
      position: absolute;
      right: 4px;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-heading);
      font-size: 1.3rem;
      line-height: 1;
      color: var(--color-teal);
    }

    .fold[open] > summary::after { content: '\2212' / ''; }

    .fold-label {
      display: block;
      padding: 10px 32px 10px 0;
      font-family: var(--font-heading);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-deep-blue);
    }
  }

  /* ----------------------------------------------------------------
     1. Hero
     ---------------------------------------------------------------- */
  /* The promise and two ways in; the worked example has its own panel
     below, so the first screen asks for one thing. Centred from 1024px. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 56px;
      align-items: center;
    }
  }

  .hero-copy h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4.6vw + 0.6rem, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-deep-blue);
    margin: 0 0 18px;
    font-weight: 700;
    text-wrap: balance;
  }

  .lp-subhead {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    max-width: 54ch;
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  /* Three short claims, one per step below. */
  .hero-trio { font-size: clamp(1.1rem, 0.8vw + 0.9rem, 1.35rem); color: var(--color-text-primary); }
  .hero-trio span { white-space: nowrap; }

  .journey {
    margin-top: 40px;
    padding: 22px 24px 18px;
    border: 1px solid var(--color-border-light);
    border-radius: 18px;
    background: var(--color-bg-white);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-deep-blue) 10%, transparent);
  }

  @media (min-width: 960px) { .journey { margin-top: 0; } }

  .journey-label {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .journey-list { list-style: none; margin: 0; padding: 0; }

  .journey-list li {
    position: relative;
    display: grid;
    padding: 14px 0 14px 22px;
    border-left: 2px solid var(--color-border);
    margin-left: 5px;
  }

  .journey-list li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg-white);
    border: 2px solid var(--chart-eur);
  }

  .journey-list li:last-child::before { background: var(--chart-eur); }
  .journey-spark .journey-spark-high { stroke: var(--chart-usd); }

  .journey-step {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .journey-big {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .journey-small { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.4; }

  .journey-spark {
    position: absolute;
    right: 0;
    top: 38px;
    width: 96px;
    height: 30px;
    fill: none;
    stroke: var(--chart-eur);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-next {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
    max-width: 54ch;
  }

  .hero-next p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }


  /* Example cards: the comparison in Step 2, the ten-year chart in Step 3. */
  .starter {
    /* Contains the absolutely positioned screen-reader text, which would otherwise widen the page. */
    position: relative;
    padding: 20px 22px;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-light);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-deep-blue) 8%, transparent);
  }

  .starter-label {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .starter--chart { margin-top: 24px; }
  .starter--chart .starter-text { margin-bottom: 4px; }

  .gap { margin: 0 0 12px; font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.5; }
  .gap strong { display: block; font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-text-primary); }

  .starter-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .starter :global(svg) { width: 100%; height: auto; display: block; }

  /* Phones get the narrower drawing, with labels sized to stay readable
     once it is scaled down to the card. */
  .starter :global(.starter-chart--narrow) { display: none; }
  .starter :global(.starter-chart--narrow text) { font-size: 14px; }
  .starter :global(.starter-chart--narrow .hc-endValue) { font-size: 15px; transform: translateY(5px); }
  /* One series here, so its name needs no series colour; link blue would read as a link. */
  .starter :global(.hc-endName) { fill: var(--color-text-primary); }

  @media (max-width: 640px) {
    .starter :global(.starter-chart--wide) { display: none; }
    .starter :global(.starter-chart--narrow) { display: block; }
  }

  /* ----------------------------------------------------------------
     2. Step 1: one line per route
     ---------------------------------------------------------------- */
  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
    border-top: 1px solid var(--color-border);
  }

  .route {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    column-gap: 16px;
    row-gap: 2px;
    align-items: center;
    padding: 18px 4px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .route-badge {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--start-level);
    border-radius: 50%;
    background: color-mix(in srgb, var(--start-level) 12%, var(--color-bg-white));
    color: var(--start-level);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .route-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .route-meta {
    grid-column: 2;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .route-go {
    grid-column: 3;
    grid-row: 1 / span 2;
    max-width: 22ch;
    text-align: right;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-deep-blue);
  }

  .route:hover .route-go,
  .route:focus-visible .route-go { text-decoration: underline; text-underline-offset: 3px; }
  .route:hover { background: color-mix(in srgb, var(--start-level) 5%, transparent); }

  .route:focus-visible {
    outline: 2px solid var(--color-deep-blue);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route { transition: background 0.15s ease; }
  }

  /* ----------------------------------------------------------------
     3. Free tools, beside an example net worth
     ---------------------------------------------------------------- */
  .tools-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .tools-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 24px; }
  }

  /* Step 2's example: the same income, two different net worths. */
  .compare { margin: 0; }

  .compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .compare-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }


  .compare-note { margin: 4px 0 12px; font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.4; }

  .compare-rows { margin: 0; display: grid; gap: 6px; }
  .compare-rows div { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 8px; }
  .compare-rows dt { font-size: 0.8rem; color: var(--color-text-secondary); }
  .compare-rows dd {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
  }

  .compare-track { height: 10px; border-radius: 5px; background: var(--color-bg); overflow: hidden; }
  .compare-bar { display: block; height: 100%; border-radius: 5px; }
  .compare-bar--own { background: var(--chart-eur); }
  .compare-bar--owe { background: var(--chart-inr); }

  .compare-net {
    margin: 14px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.5vw + 1rem, 2.1rem);
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
  }

  .compare-net.is-negative { color: var(--color-danger); }
  .compare-net span { display: block; font-size: 0.8rem; font-weight: 600; color: var(--color-text-secondary); }

  .compare-caption {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-light);
    font-size: 0.9rem;
    color: var(--color-text-primary);
    line-height: 1.5;
  }

  .tool-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .an-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 2px;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .an-card > :not(.an-preview) { grid-column: 2; }

  .an-card:hover {
    border-color: var(--color-teal);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-deep-blue) 10%, transparent);
  }

  .an-card:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .an-preview {
    grid-row: 1 / span 2;
    width: 80px;
    height: 48px;
    align-self: center;
  }

  .an-preview svg { width: 100%; height: 100%; display: block; }

  .an-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-deep-blue);
  }

  .an-title::after { content: ' \2192' / ''; }

  .an-desc {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.45;
  }


  /* ----------------------------------------------------------------
     5. Planner
     ---------------------------------------------------------------- */
  .planner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .planner-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 56px; }
  }

  /* ----------------------------------------------------------------
     5. FAQ, and the line about who is behind nidhi
     ---------------------------------------------------------------- */
  .faq-heading { margin: 0 0 20px; }

  .trust-why {
    margin: 36px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--color-teal);
    font-size: 1.02rem;
    color: var(--color-text-primary);
    line-height: 1.6;
  }

  .trust-line {
    margin: 14px 0 0;
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .trust-links { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 6px; }
  .trust-links a { display: inline-block; padding: 4px 0; }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 4px;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-teal);
    flex-shrink: 0;
  }

  .faq-item[open] summary::after { content: '\2212'; }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .faq-item h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .faq-item p {
    margin: 0 4px 18px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 0.97rem;
    max-width: 64ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-btn, .an-card { transition: none; }
  }

  /* ----------------------------------------------------------------
     Small screens
     ---------------------------------------------------------------- */
  @media (max-width: 640px) {
    .lp-section { padding: 44px 16px; }
    #hero { padding-top: 28px; }
    .section-head { margin-bottom: 24px; }
    .starter { box-shadow: none; padding: 16px; }
    .starter :global(.starter-chart--narrow) { margin-top: 6px; }
    .hero-actions .lp-btn { flex: 1 1 auto; }
