  }

  .start-card h3 {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--color-deep-blue);
    margin: 0 0 8px;
  }

  .start-detail {
    margin: 0 0 12px;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .start-meta {
    margin: 0 0 10px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .start-lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  /* Number and title stay on one row; a long title wraps beside its
     number instead of dropping below it. */
  .start-lessons li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .start-lessons li a { flex: 1 1 auto; min-width: 0; }

  .start-lessons a,
  .start-more,
  .grows-links a,
  .pair-lesson a {
