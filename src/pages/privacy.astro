---
import BaseLayout from '../layouts/BaseLayout.astro';
import { execSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { relative } from 'node:path';

/**
 * Privacy-notice changelog. Newest first. Every edit to this page gets an
 * entry, no matter how small, so the history is auditable.
 *
 * Mark `material: true` when the change affects how we handle personal data
 * (new processor, new data category, retention change, legal-basis change).
 * Typos and phrasing tweaks are not material.
 *
 * The top-of-page "Last updated" date is derived at build time from git's
 * last-commit timestamp of this file (see `lastUpdated` / `lastUpdatedIso`
 * below). That means: editing this file updates the date automatically on
 * the next build, so you can't forget to bump it and the two can't drift.
 * Local dev and shallow CI checkouts gracefully fall back to the top
 * changelog entry's date.
 */
interface ChangelogEntry {
  date: string;          // "Month D, YYYY" for display
  iso: string;           // YYYY-MM-DD for machines + <time datetime>
  material: boolean;
  summary: string;
  details?: string[];
}

type ChangelogGroup =
  | { kind: 'single'; entry: ChangelogEntry; open: boolean }
  | { kind: 'month' | 'year'; label: string; entries: ChangelogEntry[] };

function groupChangelog(entries: ChangelogEntry[]): { first: ChangelogEntry | null; groups: ChangelogGroup[] } {
  if (entries.length === 0) return { first: null, groups: [] };

  const now = new Date();
  const sevenDaysAgo  = new Date(now.getTime() -  7 * 24 * 60 * 60 * 1000);
  const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
  const thisYear  = now.getFullYear();
  const thisMonth = now.getMonth(); // 0-indexed

  const [first, ...rest] = entries;
  const groups: ChangelogGroup[] = [];

  const expanded: ChangelogEntry[]   = [];  // ≤7 days, open
  const collapsed: ChangelogEntry[] = [];  // 8–30 days, closed
  const older: ChangelogEntry[]     = [];  // >30 days, grouped

  for (const e of rest) {
    const d = new Date(e.iso);
    if (d >= sevenDaysAgo) {
      expanded.push(e);
    } else if (d >= thirtyDaysAgo) {
      collapsed.push(e);
    } else {
      older.push(e);
    }
  }

  // Tier 1: ≤7 days — each gets its own open details.
  for (const e of expanded) {
    groups.push({ kind: 'single', entry: e, open: true });
  }

  // Tier 2: 8–30 days — each gets its own collapsed details.
  for (const e of collapsed) {
    groups.push({ kind: 'single', entry: e, open: false });
  }

  // Tier 3: >30 days — grouped by completed month or year.
  if (older.length > 0) {
    const monthGroups = new Map<string, ChangelogEntry[]>();
    const yearGroups  = new Map<string, ChangelogEntry[]>();

    for (const e of older) {
      const d = new Date(e.iso);
      const entryYear  = d.getFullYear();
      const entryMonth = d.getMonth();

      // Only group by month when the month is truly finished (we're past it).
      // A July entry on July 31 is still in the current month — it goes into
      // a year bucket instead so we don't show a premature "July 2026" group.
      const monthComplete = entryYear < thisYear ||
        (entryYear === thisYear && entryMonth < thisMonth);

      if (monthComplete) {
        const key = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
        const bucket = monthGroups.get(key) ?? [];
        bucket.push(e);
        monthGroups.set(key, bucket);
      } else {
        // Current-month entries >30d old (edge case, e.g. day-1 entry in a
        // 31-day month) or prior-year entries: group by year.
        const key = String(entryYear);
        const bucket = yearGroups.get(key) ?? [];
        bucket.push(e);
        yearGroups.set(key, bucket);
      }
    }

    // Year groups first (oldest), then month groups.
    for (const [label, items] of yearGroups) {
      groups.push({ kind: 'year', label, entries: items });
    }
    for (const [label, items] of monthGroups) {
      groups.push({ kind: 'month', label, entries: items });
    }
  }

  return { first, groups };
}

const changelog: ChangelogEntry[] = [
  {
    date: 'May 24, 2026',
    iso: '2026-05-24',
    material: true,
    summary: 'Dismissible subscribe prompt; subscription key now set only on confirmation.',
    details: [
      'New localStorage key nidhi-newsletter-dismissed. Stored only in your browser, never sent to us or any third party. Records your choice when you click "I already subscribed" (permanent) or "Not now" (30-day cooldown) below the subscribe form, so we honor that choice across pages.',
      'Changed nidhi-newsletter-subscription to be set only when you click the confirmation link in your email (double-opt-in complete). Previously it was also set on form submit, which hid the prompt before you\'d actually confirmed. Does not store your email address.',
      'Both keys cleared on Undo (for dismiss) or unsubscribe (for subscription), or when you clear your browser site data. No category of personal data on our servers changed.',
    ],
  },
  {
    date: 'May 17, 2026',
    iso: '2026-05-17',
    material: true,
    summary: 'Renamed the currency tool, refreshed its event list, and added a few error-and-engagement signals on both free tools.',
    details: [
      'The free tool at /free/currency-risk is now /free/multi-currency-net-worth (the old URL redirects). The tool itself is unchanged in what it computes; the new name better reflects that the headline output is your net worth converted into one currency, with the concentration / risk view as a secondary panel.',
      'New anonymous events on /free/multi-currency-net-worth: free_multi_currency_net_worth_rates_error (fired when the exchange-rate fetch from Frankfurter fails outright; carries the functional currency you had selected and a short, generic reason string from the failed fetch, never your asset data), and free_multi_currency_net_worth_csv_parse_errors (fired when a CSV upload contains invalid rows; carries the count of valid and invalid rows and a coarse reason bucket like "invalid_value" or "unsupported_currency"). Neither event ships any of the values you typed.',
      'The free_multi_currency_net_worth_shared_view_opened event now also includes the utm_source URL parameter. This lets us tell apart someone arriving via a copied share link (utm_source=share) from any other inbound campaign. The utm_source value is the campaign source you yourself sent in the URL; we never invent it.',
      'New anonymous events on /free/loan-comparison: free_loan_comparison_validation_error (debounced, fires 600ms after a burst of input edits if any vendor card has a validation error; carries the count of errored cards, a coarse error reason like "missing_principal", and the slot label of the first errored vendor, never the actual values), free_loan_comparison_horizon_changed (debounced; carries the chosen horizon in months), and free_loan_comparison_refi_changed (debounced; carries which refinance field was last edited: vendor index, refinance month, new rate, new term, new fees, or "roll fee" toggle). None of these events carry the underlying loan numbers.',
      'Most React-rendered buttons in both tools now have a stable data-attr label (for example data-attr="lc-share-copy", data-attr="mcnw-asset-add"). For users who consent to interaction analytics, this gives the autocaptured click events a stable selector instead of a fragile auto-generated one. For users who do not consent, this changes nothing: autocapture is gated on consent.',
    ],
  },
  {
    date: 'May 16, 2026',
    iso: '2026-05-16',
    material: true,
    summary: 'Added the Currency Risk Analyzer tool and disclosed a new third-party API call from your browser.',
    details: [
      'New free tool at /free/multi-currency-net-worth (formerly /free/currency-risk): add assets and liabilities across currencies, see your net worth in your chosen currency, and check your currency concentration. No data is sent to us, everything runs in your browser.',
      'New anonymous interaction events on /free/multi-currency-net-worth: which functional currency you select, when you add or remove an asset, when you upload a CSV file, when you copy a shareable link (and which sharing mode: "full" or "redacted"), and when you reset the form. The financial values you type (asset names, amounts, currencies) are never sent; only interaction metadata is captured.',
      'The tool makes one network request from your browser to api.frankfurter.dev (a free, open ECB exchange-rate API). The request includes only the functional currency code you selected (e.g. ?from=EUR). No personal data is sent. This is a direct browser-to-API call; we never see the request or the response.',
      'The header navigation now includes a dropdown listing all free tools.',
    ],
  },
  {
    date: 'May 10, 2026',
    iso: '2026-05-10',
    material: true,
    summary: 'Disclosed a small set of anonymous interaction events on the Free Tools pages.',
    details: [
      'New anonymous events on /free/loan-comparison: which currency you select, whether you toggle solve-for-term vs solve-for-payment, whether you switch a vendor between fixed and hybrid (ARM) rate kinds, whether you change the analysis tab (side-by-side, horizon, refinance, etc.), whether you change the vendor selected for the per-vendor split chart, whether you open the per-vendor "Show details" expander, whether you copy the shareable link, and whether you click Reset to defaults.',
      'These events do not include any of the financial values you type (loan amount, interest rate, fees, monthly payment, vendor name). The point of the calculator is that the math runs in your browser; we are not exfiltrating the inputs.',
      'These events fire whether or not you accept the cookie banner; they are categorised the same way as pageview and page-leave: anonymous, no name, no email, no user ID.',
    ],
  },
  {
    date: 'May 6, 2026',
    iso: '2026-05-06',
    material: true,
    summary: 'Added a local-only key that remembers whether you’ve subscribed.',
    details: [
      'New localStorage key nidhi-newsletter-subscription. Stored only in your browser, never sent to us or any third party.',
      'Purpose: once you’ve submitted the newsletter form (or confirmed via email), we hide the subscribe prompt on the rest of the site so you don’t get pitched on every blog post.',
      'Cleared automatically when you unsubscribe via the one-click link, when you use the “try a different email” link on the success card, or when you clear your browser site data. No category of personal data on our servers changed.',
    ],
  },
  {
    date: 'May 5, 2026',
    iso: '2026-05-05',
    material: true,
    summary: 'Initial publication.',
    details: [
      'First version of this notice.',
      'Describes PostHog Cloud EU (analytics), Google Workspace EU (newsletter storage + sending), GitHub Pages (static hosting), and browser localStorage (local preferences) as the only processors.',
      'Newsletter uses double opt-in with a one-click unsubscribe in every email.',
    ],
  },
];

const groupedLog = groupChangelog(changelog);
const { first, groups } = groupedLog;

/**
 * Ask git when this file was last committed. Runs only at build time.
 *
 * We use **author date** (`%aI`) rather than committer date (`%cI`) so the
 * timestamp reflects when the change was actually made, not when it was
 * rebased/cherry-picked onto main. Both are "commit-based" in the sense
 * that both come from `git log`, but author date is the one that stays
 * stable across history rewrites.
 *
 * We fall back to the newest changelog entry if:
 *  - we're outside a git checkout (e.g. a deployed preview from a tarball)
 *  - the CI checkout is too shallow to see the relevant commit (workflow
 *    uses fetch-depth: 0 in prod precisely to avoid this)
 *  - git isn't on the PATH (weird local setups)
 */
function gitLastCommitDate(filePath: string): { date: string; iso: string } | null {
  try {
    const iso = execSync(
      `git log -1 --format=%aI -- "${filePath}"`,
      { stdio: ['ignore', 'pipe', 'ignore'] },
    ).toString().trim();
    if (!iso) return null;
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return null;
    const display = d.toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    });
    return { date: display, iso: iso.slice(0, 10) };
  } catch {
    return null;
  }
}

const thisFileAbs = fileURLToPath(import.meta.url);
const thisFileRel = relative(process.cwd(), thisFileAbs);
const gitMeta = gitLastCommitDate(thisFileRel);

const lastUpdated = gitMeta?.date ?? first?.date ?? '';
const lastUpdatedIso = gitMeta?.iso ?? first?.iso ?? '';
---

<BaseLayout
  title="Privacy Notice: How nidhi Handles Your Data | nidhi"
  description="Plain-language privacy notice for nidhi.today: what we collect, why, where it lives, and how to get rid of it."
  keywords={['privacy', 'nidhi privacy policy', 'personal finance blog privacy']}
  robots="index,follow"
>
  <section class="privacy">
    <div class="privacy-container">

      <header class="privacy-hero">
        <h1 class="privacy-title">Privacy, honestly</h1>
        <p class="privacy-intro">
          The short version: we collect as little as we can, we don&rsquo;t sell anything, and you can
          get rid of what we have whenever you want.
        </p>
        <p class="privacy-updated">
          Last updated: <time datetime={lastUpdatedIso}>{lastUpdated}</time> &middot;
          <a href="#changelog">see what changed</a>
        </p>
      </header>

      <h2>What we collect, and when</h2>

      <p>
        <strong>Always, to keep the site working and improving:</strong>
      </p>
      <ul>
        <li>
          Anonymous pageview and page-leave events, via <a href="https://posthog.com/eu" target="_blank" rel="noopener noreferrer">PostHog Cloud EU</a>.
          That includes the URL you visited, the URL you came from, your approximate country
          (derived from your IP address, which PostHog then discards), and your browser, OS,
          and viewport size. No name, no email, no user ID.
        </li>
        <li>
          Anonymous interaction events on the Free Tools pages: which currency you pick on
          the loan-comparison calculator, whether you toggle between solving for term vs
          monthly payment, whether you open the &ldquo;More options&rdquo; panel, whether you
          copy the shareable link, and whether you reset the form. <strong>The financial
          values you type are never sent</strong>: not the loan amount, not the
          interest rate, not the fees, not the vendor name. The whole point of the calculator
          is that the math runs in your browser.
        </li>
        <li>
          Campaign parameters (<code>utm_source</code>, <code>utm_medium</code>, etc.) if you
          arrived from a link we or someone else tagged.
        </li>
      </ul>

      <p>
        <strong>Only if you click &ldquo;Sure, that&rsquo;s fine&rdquo; on the cookie banner:</strong>
      </p>
      <ul>
        <li>
          Click heatmaps and autocaptured events: basically, which elements on a page
          get clicked. We use this to spot broken links and layouts that confuse people.
        </li>
      </ul>

      <p>
        <strong>If you subscribe to the blog newsletter:</strong>
      </p>
      <ul>
        <li>Your email address.</li>
        <li>The page you subscribed from (so we know whether the blog index or a specific post got you there).</li>
        <li>Timestamps for when you subscribed, confirmed, and (if you do) unsubscribed.</li>
        <li>Your subscription status: pending, confirmed, or unsubscribed.</li>
      </ul>

      <p>
        <strong>Stored only in your browser, never sent to us:</strong>
      </p>
      <ul>
        <li>Your cookie-consent choice (<code>nidhi-cookie-consent</code>).</li>
        <li>Your light/dark/system theme preference (<code>nidhi-theme-mode</code>).</li>
        <li>Which blog posts you&rsquo;ve read (<code>nidhi-reading-progress</code>), so we can show a subtle &ldquo;read&rdquo; indicator next time.</li>
        <li>Whether you&rsquo;ve confirmed your newsletter subscription (<code>nidhi-newsletter-subscription</code>), so we stop showing you the subscribe form on every page once you&rsquo;ve completed the double-opt-in loop. Set only when you click the confirmation link in your email; never contains your email address.</li>
        <li>Whether you&rsquo;ve dismissed the newsletter subscribe prompt (<code>nidhi-newsletter-dismissed</code>), so we honor your choice to not see it again for a while. Contains only a dismissal type and timestamp, no email address or personal data.</li>
      </ul>

      <p>
        Clearing your browser&rsquo;s site data wipes all of the above instantly.
      </p>

      <h2>Why we collect it</h2>
      <ul>
        <li>
          <strong>Analytics:</strong> to figure out which posts actually help people and which ones
          lose them halfway through. We can&rsquo;t fix what we can&rsquo;t see.
        </li>
        <li>
          <strong>Newsletter:</strong> to email you when a new blog post is published. Nothing else.
          No promos, no &ldquo;we miss you&rdquo; sequences, no cross-promoting other products.
        </li>
        <li>
          <strong>Local preferences:</strong> to make the site feel consistent for you without a
          server round-trip. All of that stays on your device.
        </li>
      </ul>

      <h2>Where it lives</h2>
      <ul>
        <li>
          <strong>PostHog Cloud EU</strong> (Frankfurt, Germany): our analytics processor.
          Session recording is disabled. We use their standard product, with no custom person
          properties that would identify you, unless you subscribe, in which case your
          subscription status becomes a property on the anonymous person record for funnel
          analysis.
        </li>
        <li>
          <strong>Google Workspace</strong> (Google Cloud EU regions): our email address
          (<code>hello@nidhi.today</code>) and the Google Sheet that stores newsletter
          subscribers. Only we can read it.
        </li>
        <li>
          <strong>GitHub Pages</strong> (a GitHub / Microsoft service): hosts the static
          files of this website. GitHub keeps short-lived server access logs for abuse
          prevention. We don&rsquo;t read them and don&rsquo;t get copies.
        </li>
        <li>
          <strong>Your browser</strong>: for the local preferences listed above.
        </li>
      </ul>

      <p>
        That&rsquo;s the whole list. There&rsquo;s no fourth processor in a footnote somewhere.
      </p>

      <h2>What we don&rsquo;t do</h2>
      <ul>
        <li>We don&rsquo;t run ads. No ad tech on this site at all.</li>
        <li>We don&rsquo;t sell, rent, license, or syndicate your data to anyone.</li>
        <li>
          We don&rsquo;t cross-site track you. No Facebook pixel, no Google Ads tag, no LinkedIn
          Insight, no TikTok pixel, no retargeting of any kind.
        </li>
        <li>We don&rsquo;t record your screen, scrolls, or keystrokes.</li>
        <li>
          We don&rsquo;t read replies to newsletter emails and feed them back into any analytics
          or ads system.
        </li>
        <li>We don&rsquo;t import the newsletter list into any other tool or mailing system.</li>
      </ul>

      <h2>How long we keep it</h2>
      <ul>
        <li>
          <strong>Analytics events:</strong> 12 months (PostHog&rsquo;s default retention;
          we haven&rsquo;t extended it), then auto-deleted.
        </li>
        <li>
          <strong>Newsletter subscribers:</strong> while you&rsquo;re subscribed, plus up to 30 days
          after you unsubscribe so we can make sure you don&rsquo;t get one more email by
          accident. After that, the row is deleted.
        </li>
        <li>
          <strong>Bounced or invalid emails:</strong> removed as soon as we notice them, usually
          within a week.
        </li>
        <li>
          <strong>Your localStorage:</strong> until you clear your browser data. Again, we never
          see it.
        </li>
      </ul>

      <h2>Your rights</h2>
      <p>
        Under the GDPR (and similar regulations), you have the right to ask us what we hold
        about you, correct it, export it, restrict how we use it, object to it, or delete it.
      </p>
      <ul>
        <li>
          For the newsletter, unsubscribing is a one-click link in every email we send, and
          that also schedules the deletion described above. You can also email us and
          we&rsquo;ll do it manually.
        </li>
        <li>
          For analytics, the events are anonymous; we don&rsquo;t have a way to look up
          &ldquo;your&rdquo; events because we don&rsquo;t know who you are. If this bothers
          you, just decline the cookie banner, or use a content blocker. Nothing on the site
          breaks.
        </li>
        <li>
          For anything else, email <a href="mailto:hello@nidhi.today?subject=privacy">hello@nidhi.today</a>
          with the word <strong>privacy</strong> in the subject. We reply within a few days.
        </li>
      </ul>

      <h2>Children</h2>
      <p>
        This site is written for adults trying to figure out their own money. We don&rsquo;t
        knowingly collect anything from children under 16. If you think we have, email us and
        we&rsquo;ll delete it.
      </p>

      <section class="changelog-section" aria-labelledby="changelog">
        <p class="changelog-eyebrow">Changelog</p>
        <h2 id="changelog">Changes to this notice</h2>
        <p class="changelog-intro">
          We update this page in place. Every change gets an entry in the log
          below, newest first, no matter how small. Changes that affect
          how we handle personal data (a new processor, a new category of data,
          a retention change) are flagged <strong>material</strong>.
        </p>
        <p class="changelog-intro">
          We don&rsquo;t push &ldquo;we updated our privacy policy&rdquo; emails.
          If you want to keep an eye on it, bookmark this page or read the log
          below when you&rsquo;re curious. If a change ever makes you
          uncomfortable, unsubscribing from the newsletter is a one-click link
          in every email, and clearing your browser&rsquo;s site data wipes
          everything stored locally.
        </p>

        <ol class="changelog">
          {/* First (latest) entry: always fully visible, no collapse */}
          {first && (
            <li class="changelog-entry">
              <div class="changelog-marker" aria-hidden="true"></div>
              <div class="changelog-body">
                <div class="changelog-head">
                  <time datetime={first.iso} class="changelog-date">{first.iso}</time>
                  {first.material && (
                    <span class="changelog-tag changelog-tag--material" aria-label="Material change">material</span>
                  )}
                </div>
                <p class="changelog-summary">{first.summary}</p>
                {first.details && first.details.length > 0 && (
                  <ul class="changelog-details">
                    {first.details.map((d) => <li>{d}</li>)}
                  </ul>
                )}
              </div>
            </li>
          )}

          {/* Tiered entries: expanded (≤7d), collapsed (8–30d), grouped (>30d) */}
          {groups.map((group) => (
            group.kind === 'single' ? (
              <li class="changelog-entry">
                <details open={group.open} class="changelog-collapse">
                  <summary class="changelog-collapseSummary">
                    <div class="changelog-marker" aria-hidden="true"></div>
                    <div class="changelog-head">
                      <time datetime={group.entry.iso} class="changelog-date">{group.entry.iso}</time>
                      {group.entry.material && (
                        <span class="changelog-tag changelog-tag--material" aria-label="Material change">material</span>
                      )}
                    </div>
                  </summary>
                  <div class="changelog-body">
                    <p class="changelog-summary">{group.entry.summary}</p>
                    {group.entry.details && group.entry.details.length > 0 && (
                      <ul class="changelog-details">
                        {group.entry.details.map((d) => <li>{d}</li>)}
                      </ul>
                    )}
                  </div>
                </details>
              </li>
            ) : (
              <li class="changelog-entry changelog-entry--group">
                <details class="changelog-collapse">
                  <summary class="changelog-collapseSummary">
                    <div class="changelog-marker" aria-hidden="true"></div>
                    <span class="changelog-groupLabel">{group.label}</span>
                    <span class="changelog-groupCount">{group.entries.length} change{group.entries.length !== 1 ? 's' : ''}</span>
                  </summary>
                  <ol class="changelog-groupEntries">
                    {group.entries.map((entry) => (
                      <li class="changelog-groupEntry">
                        <div class="changelog-head">
                          <time datetime={entry.iso} class="changelog-date">{entry.iso}</time>
                          {entry.material && (
                            <span class="changelog-tag changelog-tag--material" aria-label="Material change">material</span>
                          )}
                        </div>
                        <p class="changelog-summary">{entry.summary}</p>
                        {entry.details && entry.details.length > 0 && (
                          <ul class="changelog-details">
                            {entry.details.map((d) => <li>{d}</li>)}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ol>
                </details>
              </li>
            )
          ))}
        </ol>
      </section>

      <h2>Who we are</h2>
      <p>
        nidhi is a small independent project. No investors, no growth team, no ad budget.
        Currently built and run by one person in Prague.
      </p>
      <ul class="contact-list">
        <li><a href="mailto:hello@nidhi.today">hello@nidhi.today</a>: for anything, privacy or otherwise</li>
        <li><a href="https://www.instagram.com/nidhi.today" target="_blank" rel="noopener noreferrer">@nidhi.today</a>: if you prefer DMs</li>
        <li><a href="/beliefs/">Our beliefs</a>: if you want the why</li>
      </ul>

    </div>
  </section>
</BaseLayout>

<style>
  .privacy {
    display: flex;
    justify-content: center;
    padding: var(--space-10) var(--space-4);
  }

  .privacy-container {
    max-width: 640px;
    width: 100%;
  }

  .privacy-hero {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .privacy-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2rem;
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .privacy-intro {
    font-size: 1.05rem;
    color: var(--color-text-primary);
    line-height: 1.65;
    margin: 0 0 var(--space-3);
  }

