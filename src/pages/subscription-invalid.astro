---
import BaseLayout from '../layouts/BaseLayout.astro';
// Reached from an English email, so there is no Hindi counterpart to point
// search engines or a language switcher at.
import { DEFAULT_LOCALE } from '../i18n';
---

<BaseLayout
  title="Link not valid | nidhi"
  description="This subscription link is no longer valid. It may have expired, or stopped working after an unsubscribe. You can subscribe again from the learning path."
  robots="noindex,nofollow"
  alternates={[DEFAULT_LOCALE]}
>
  <section class="transactional">
    <div class="transactional-card">
      <div class="transactional-icon transactional-icon--warning" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="13"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>

      <h1 class="transactional-title">This link isn&rsquo;t valid.</h1>
      <p class="transactional-body" id="invalid-copy">
        It may have expired, stopped working after an unsubscribe, or been
        cut short when it was copied. Opening it changed nothing.
      </p>

      <div class="transactional-actions">
        <a class="btn btn--primary" href="/blog/">Go to the learning path</a>
        <a class="btn btn--outline" href="mailto:hello@nidhi.today?subject=subscription link issue">
          Email me
        </a>
      </div>

      <p class="transactional-secondary">
        If you meant to <strong>unsubscribe</strong> and nothing happened,
        reply to any email from nidhi and I&rsquo;ll remove you by hand.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var copy = document.getElementById('invalid-copy');
    if (!copy) return;
    var reason = new URLSearchParams(window.location.search).get('reason') || '';
    if (reason === 'confirm') {
      copy.textContent = 'This confirmation link has expired or is no longer valid. If you meant to subscribe, enter your email in the form on the learning path again, and a new confirmation link will be sent.';
    } else if (reason === 'unsubscribe') {
      copy.textContent = 'This unsubscribe link isn\u2019t valid anymore. If you want to stop getting emails from nidhi, reply to any of them and I\u2019ll remove you by hand.';
    }
  })();
</script>
