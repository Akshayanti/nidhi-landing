---
/**
 * `/hi/subscription-invalid/`, the invalid-link page in every language but the default one. English
 * is served from `src/pages/subscription-invalid.astro`, so it never comes through here and
 * its address cannot be shadowed by this route.
 */
import SubscriptionInvalidPage from '../../components/pages/SubscriptionInvalidPage.astro';
import { localizedStaticPaths, routeLocale } from '../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<SubscriptionInvalidPage locale={locale} />
