---
/**
 * `/hi/confirm/`, the confirm page in every language but the default one. English
 * is served from `src/pages/confirm.astro`, so it never comes through here and
 * its address cannot be shadowed by this route.
 */
import ConfirmPage from '../../components/pages/ConfirmPage.astro';
import { localizedStaticPaths, routeLocale } from '../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<ConfirmPage locale={locale} />
