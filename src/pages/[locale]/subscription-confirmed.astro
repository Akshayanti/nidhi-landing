---
/**
 * `/hi/subscription-confirmed/`, the subscription-confirmed page in every language but the default one. English
 * is served from `src/pages/subscription-confirmed.astro`, so it never comes through here and
 * its address cannot be shadowed by this route.
 */
import SubscriptionConfirmedPage from '../../components/pages/SubscriptionConfirmedPage.astro';
import { localizedStaticPaths, routeLocale } from '../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<SubscriptionConfirmedPage locale={locale} />
