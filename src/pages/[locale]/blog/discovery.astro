---
/**
 * `/<locale>/blog/discovery/`, in every language but the default one. English is
 * served from `src/pages/blog/discovery.astro`.
 *
 * The page stays out of search until the language has a live lesson in this
 * level (see the layout), which is what a language whose lessons are still
 * being written needs.
 */
import LevelPage from '../../../layouts/LevelPage.astro';
import { localizedStaticPaths, routeLocale } from '../../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<LevelPage level="discovery" locale={locale} />
