---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TAG_META, formatTag } from '../../../../utils/tags';
import { DEFAULT_LOCALE, LOCALES, blogPath, blogTagPath, type Locale } from '../../../../i18n/config';
import { visibleBlogPosts } from '../../../../i18n/content';

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== DEFAULT_LOCALE)
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

const isDev = import.meta.env.DEV;
const now = new Date();
const allPosts = visibleBlogPosts(await getCollection('blog'), locale, isDev, now);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

interface TagRow {
  slug: string;
  formatted: string;
  count: number;
  description: string;
}

const tags: TagRow[] = [...tagCounts.entries()]
  .map(([slug, count]) => {
    const meta = TAG_META[slug];
    const formatted = formatTag(slug);
    const description = meta?.description
      ? meta.description.split('.').slice(0, 2).join('.').trim() + '.'
      : `Articles tagged "${formatted.toLowerCase()}".`;
    return { slug, formatted, count, description };
  })
  .sort((a, b) => {
    if (b.count !== a.count) return b.count - a.count;
    return a.slug.localeCompare(b.slug);
  });

const title = 'Browse by topic | nidhi';
const description =
  'Every topic on the nidhi blog: net worth, budgeting, debt, investing, risk, and more. Pick a topic to read every post in that area.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL(blogPath(locale), 'https://nidhi.today').toString() },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: new URL(`${blogPath(locale).replace(/\/$/, '')}/tag/`, 'https://nidhi.today').toString() },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbSchema]}
  locale={locale}
>
  <section class="tagHub">
    <div class="container">
      <header class="tagHub-header">
        <nav class="tagHub-breadcrumb" aria-label="Breadcrumb">
          <a href={blogPath(locale)}>Blog</a> <span class="sep">/</span> <span>Topics</span>
        </nav>
        <h1>Browse by topic</h1>
        <p class="tagHub-subtitle">
          Every topic on the blog, with a post count for each. Pick one to read every post in that area.
        </p>
      </header>

      {tags.length === 0 ? (
        <p class="tagHub-empty">No topics yet.</p>
      ) : (
        <ul class="tagHub-list">
          {tags.map((t) => (
            <li class="tagHub-item">
              <a class="tagHub-card" href={blogTagPath(locale, t.slug)} data-attr={`tag-hub-${t.slug}`}>
                <div class="tagHub-cardTop">
                  <span class="tagHub-cardName">{t.formatted}</span>
                  <span class="tagHub-cardCount">
                    {t.count} {t.count === 1 ? 'post' : 'posts'}
                  </span>
                </div>
                <p class="tagHub-cardDesc">{t.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .tagHub {
    padding: var(--space-10) 0 var(--space-16);
  }

  .tagHub-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .tagHub-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .tagHub-breadcrumb a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tagHub-breadcrumb .sep {
    margin: 0 var(--space-1);
  }

  .tagHub-header h1 {
    font-size: 2.5rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .tagHub-subtitle {
    color: var(--color-text-secondary);
    max-width: 580px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .tagHub-empty {
    text-align: center;
    color: var(--color-text-muted);
  }

  .tagHub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
  }

  .tagHub-item {
    margin: 0;
  }

  .tagHub-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
  }

  .tagHub-card:hover,
  .tagHub-card:focus-visible {
    border-color: var(--color-deep-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    outline: none;
  }
</style>
