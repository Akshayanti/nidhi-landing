---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { LearningPath } from '../../../../components/LearningPath';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../../utils/readingTime';
import { TAG_META, formatTag } from '../../../../utils/tags';
import { DEFAULT_LOCALE, LOCALES, blogPath, blogPostPath, blogTagPath, type Locale } from '../../../../i18n/config';
import { visibleBlogPosts } from '../../../../i18n/content';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const now = new Date();
  const allContent = await getCollection('blog');
  const paths = [];

  for (const locale of LOCALES.filter((l) => l !== DEFAULT_LOCALE)) {
    const allPosts = visibleBlogPosts(allContent, locale, isDev, now);
    const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];

    for (const tag of allTags) {
      paths.push({
        params: { locale, tag },
        props: {
          locale,
          tag,
          posts: allPosts
            .filter(p => p.data.tags.includes(tag))
            .map(p => ({
              id: p.data.slug,
              title: p.data.title,
              description: p.data.description,
              pubDate: p.data.pubDate.toISOString(),
              level: p.data.level,
              readingTime: getReadingTime(p.body || ''),
              tags: p.data.tags,
            })),
        },
      });
    }
  }

  return paths;
}

const { locale, tag, posts } = Astro.props as { locale: Locale; tag: string; posts: any[] };
const formatted = formatTag(tag);
const meta = TAG_META[tag];
const title = meta?.title ?? `${formatted}: Personal Finance Literacy | nidhi`;
const description = meta?.description ?? `Articles about ${formatted.toLowerCase()}: practical personal finance literacy and financial education from nidhi.`;

const tagBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL(blogPath(locale), 'https://nidhi.today').toString() },
    { '@type': 'ListItem', position: 2, name: formatted, item: new URL(blogTagPath(locale, tag), 'https://nidhi.today').toString() },
  ],
};

const tagItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${formatted} Articles`,
  description,
  numberOfItems: posts.length,
  itemListElement: posts.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(blogPostPath(locale, p.id), 'https://nidhi.today').toString(),
    name: p.title,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex,follow"
  jsonLd={[tagBreadcrumbSchema, tagItemListSchema]}
  locale={locale}
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-header">
        <nav class="tag-breadcrumb" aria-label="Breadcrumb">
          <a href={blogPath(locale)}>Blog</a> <span class="sep">/</span> <span>{formatted}</span>
        </nav>
        <h1>{formatted}</h1>
        <p class="blog-index-subtitle">{description}</p>
      </header>
      <LearningPath client:load posts={posts} blogBasePath={blogPath(locale).replace(/\/$/, '')} interceptTagClick={false} />
      <nav class="tag-allTopics" aria-label="More tag pages">
        <a href={`${blogPath(locale).replace(/\/$/, '')}/tag/`} class="tag-allTopicsLink" data-attr="tag-browse-all">
          Browse all topics
          <span aria-hidden="true">&nbsp;&rsaquo;</span>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .tag-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .tag-breadcrumb a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tag-breadcrumb .sep {
    margin: 0 var(--space-1);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .tag-allTopics {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }

  .tag-allTopicsLink {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-deep-blue);
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
