---
/**
 * `/<locale>/blog/tag/<tag>/`, in every language but the default one. English
 * is served from `src/pages/blog/tag/[tag].astro`.
 *
 * Each language gets a page per tag its own lessons use, so the paths are built
 * per locale here rather than from one shared list. A language with no lessons
 * yet (Hindi today) generates none, and the topic hub says so instead.
 */
import TagPage from '../../../../components/pages/TagPage.astro';
import { getTopicIndex, type TopicSection } from '../../../../utils/learnPosts';
import { MIRRORED_LOCALES, routeLocale } from '../../../../i18n/routes.ts';

export async function getStaticPaths() {
  const paths: Array<{ params: { locale: string; tag: string }; props: { tag: string; groups: TopicSection[] } }> = [];
  for (const locale of MIRRORED_LOCALES) {
    for (const { tag, groups } of await getTopicIndex()) {
      paths.push({ params: { locale, tag }, props: { tag, groups } });
    }
  }
  return paths;
}

const locale = routeLocale(Astro.params);
const { tag, groups } = Astro.props;
---

<TagPage locale={locale} tag={tag} groups={groups} />
