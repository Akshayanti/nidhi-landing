---
/**
 * The learning path in every language but the default one. English is served
 * from `src/pages/blog/index.astro`, so it never comes through here and its
 * address cannot be shadowed by this route.
 */
import BlogIndex from '../../../layouts/BlogIndex.astro';
import { localizedStaticPaths, routeLocale } from '../../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<BlogIndex locale={locale} />
