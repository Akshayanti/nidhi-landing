---
/**
 * `/hi/free/inflation-calculator/` and `/es/free/inflation-calculator/`: the
 * inflation calculator in every language but the default one. English is
 * served from `src/pages/free/inflation-calculator.astro`, so it never comes
 * through here and its address cannot be shadowed by this route.
 */
import InflationCalculatorPage from '../../../components/pages/InflationCalculatorPage.astro';
import { localizedStaticPaths, routeLocale } from '../../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<InflationCalculatorPage locale={locale} />
