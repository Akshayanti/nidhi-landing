---
/**
 * The Monte Carlo simulator in every language but the default one. English is
 * served from `src/pages/free/monte-carlo-simulator.astro`, so it never comes
 * through here and its address cannot be shadowed by this route.
 */
import MonteCarloPage from '../../../components/pages/MonteCarloPage.astro';
import { localizedStaticPaths, routeLocale } from '../../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<MonteCarloPage locale={locale} />
