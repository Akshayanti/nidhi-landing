---
/**
 * `/hi/unsubscribe/`, the unsubscribe page in every language but the default one. English
 * is served from `src/pages/unsubscribe.astro`, so it never comes through here and
 * its address cannot be shadowed by this route.
 */
import UnsubscribePage from '../../components/pages/UnsubscribePage.astro';
import { localizedStaticPaths, routeLocale } from '../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<UnsubscribePage locale={locale} />
