---
/**
 * `/hi/about/`, the about page in every language but the default one. English
 * is served from `src/pages/about.astro`, so it never comes through here and
 * its address cannot be shadowed by this route.
 *
 * The same shape repeats for every page that has a counterpart in another
 * language: the body in `src/components/pages/`, an English wrapper at the
 * root path, and one of these for everything else.
 */
import AboutPage from '../../components/pages/AboutPage.astro';
import { localizedStaticPaths, routeLocale } from '../../i18n/routes.ts';

export function getStaticPaths() {
  return localizedStaticPaths();
}

const locale = routeLocale(Astro.params);
---

<AboutPage locale={locale} />
