---
/**
 * Inclusive Finances hub. On the learning path these posts sit inside the
 * ladder, each after the post it follows up on. This page is the one place
 * that lists them together, for a reader arriving from the homepage or from
 * search with no prior context. It uses the learning path's cards, so read
 * status is shared between the two.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CollectionList } from '../../components/LearningPath';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';
import { TAG_META } from '../../utils/tags';
import { placeOnPath } from '../../utils/companions';

const isDev = import.meta.env.DEV;
const now = new Date();
const visiblePosts = (await getCollection('blog'))
  .filter(post => isDev || post.data.pubDate <= now)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const placements = placeOnPath(visiblePosts);
const posts = visiblePosts
  .filter(post => post.data.level === 'inclusive-finances')
  .map(post => ({
    id: post.data.slug,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate.toISOString(),
    level: post.data.level,
    tags: post.data.tags,
    readingTime: getReadingTime(post.body || ''),
    companionTitle: placements.get(post.data.slug)?.companionTitle,
  }));

const SITUATIONS = [
  { tag: 'relationships', label: 'Couples, families, and shared households' },
  { tag: 'immigration', label: 'Crossing borders' },
  { tag: 'disability', label: 'Disability and means-tested benefits' },
];

// A situation chip only renders when its tag page exists, which is when at
// least one visible post carries the tag.
const livePostTags = new Set(
  (await getCollection('blog'))
    .filter(post => isDev || post.data.pubDate <= now)
    .flatMap(post => post.data.tags),
);
const situations = SITUATIONS.filter(s => livePostTags.has(s.tag));

const title = TAG_META['inclusive-finances'].title;
const description = TAG_META['inclusive-finances'].description;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://nidhi.today/blog/' },
    { '@type': 'ListItem', position: 2, name: 'Inclusive Finances', item: 'https://nidhi.today/blog/inclusive-finances/' },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  robots={posts.length === 0 ? 'noindex,follow' : undefined}
  jsonLd={[breadcrumbSchema]}
>
  <section class="if-hub">
    <div class="container">
      <header class="if-header">
        <nav class="if-breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a> <span class="sep">/</span> <span>Inclusive Finances</span>
        </nav>
        <p class="if-eyebrow">No prerequisite, relevant at any stage</p>
        <h1>When the default plan does not fit you</h1>
        <p class="if-lede">
          Most financial advice quietly assumes one kind of household: a legally married couple or a single adult, a steady employer, a family the law recognises, a life lived in one country. Survivor benefits, joint tax filing, inheritance rules, and workplace pensions are all built around that shape.
        </p>
        <p class="if-lede">
          These guides are for everyone else. Each one takes a single default, shows what breaks when it does not hold for you, and walks through the deliberate choices that replace it. You do not need to have read anything else on this site first.
        </p>
        <p class="if-scope">
          These guides teach what to check and what to ask. The legal details differ by country, so they never tell you what the law where you live says. For that, speak to a local professional.
        </p>
      </header>

      {situations.length > 0 && (
        <nav class="if-situations" aria-label="Explore by situation">
          <h2>Explore by situation</h2>
          <p>Each link shows matching guides from across the whole site, not only this collection.</p>
          <ul>
            {situations.map(s => (
              <li><a href={`/blog/tag/${s.tag}/`}>{s.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      {posts.length > 0 ? (
        <CollectionList client:load posts={posts} />
      ) : (
        <p class="if-empty">The first guides in this collection are on their way. <a href="/blog/">Browse the learning path</a> in the meantime.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .if-hub {
    padding: var(--space-10) 0 var(--space-16);
  }

  .if-header {
    max-width: 640px;
    margin: 0 auto var(--space-10);
  }

  .if-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .if-breadcrumb a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .if-breadcrumb .sep {
    margin: 0 var(--space-1);
  }

  .if-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--level-inclusive-finances);
    margin: 0 0 var(--space-2);
  }

  .if-header h1 {
    font-size: 2.25rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  .if-lede {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 var(--space-3);
  }

  .if-scope {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--level-inclusive-finances);
    background: color-mix(in srgb, var(--level-inclusive-finances) 6%, var(--color-bg-white));
    border-radius: var(--radius-sm);
    margin: var(--space-4) 0 0;
  }

  .if-situations {
    max-width: 640px;
    margin: 0 auto var(--space-8);
  }

  .if-situations h2 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-1);
  }

  .if-situations p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }

  .if-situations ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .if-situations a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--level-inclusive-finances) 45%, var(--color-border));
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--level-inclusive-finances);
    text-decoration: none;
    background: var(--color-bg-white);
  }

  .if-situations a:hover,
  .if-situations a:focus-visible {
    box-shadow: var(--shadow-md);
  }

  .if-empty {
    text-align: center;
    color: var(--color-text-secondary);
  }

  @media (max-width: 600px) {
    .if-header h1 { font-size: 1.75rem; }
  }
</style>
