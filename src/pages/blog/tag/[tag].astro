---
/**
 * The English topic pages, at their original addresses. The page body lives in
 * `src/components/pages/TagPage.astro` so the other languages can render the
 * same markup; this file builds the paths and their groups.
 *
 * The topics come from the lessons themselves, so a language gets a topic page
 * per tag its own lessons use. Hindi has none until its lessons land.
 */
import TagPage from '../../../components/pages/TagPage.astro';
import { getTopicIndex } from '../../../utils/learnPosts';

export async function getStaticPaths() {
  const topics = await getTopicIndex();
  return topics.map(({ tag, groups }) => ({ params: { tag }, props: { tag, groups } }));
}

const { tag, groups } = Astro.props;
---

<TagPage locale="en" tag={tag} groups={groups} />
