---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LearningPath } from '../../../components/LearningPath';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../utils/readingTime';

const TAG_META: Record<string, { title: string; description: string }> = {
  'net-worth': {
    title: 'Net Worth: Personal Finance Literacy',
    description: 'Everything about net worth: what it is, how to calculate it, and why it matters more than your salary. Free personal finance education from nidhi.',
  },
  'fundamentals': {
    title: 'Financial Fundamentals: Personal Finance Literacy',
    description: 'Core personal finance concepts every adult should know: assets, liabilities, cash flow, compound interest, and more. Free financial literacy from nidhi.',
  },
  'getting-started': {
    title: 'Getting Started with Personal Finance',
    description: 'New to personal finance? Start here. Beginner-friendly guides to net worth, budgeting, saving, and building financial literacy from the ground up.',
  },
  'debt': {
    title: 'Understanding and Managing Debt: Finance Literacy',
    description: 'How debt works, why interest rates matter, and proven strategies to get out of debt. Practical personal finance literacy from nidhi.',
  },
  'saving': {
    title: 'Saving Money: Personal Finance Basics',
    description: 'How to save effectively: emergency funds, savings rates, and when saving beats investing. Personal finance literacy guides from nidhi.',
  },
  'investing': {
    title: 'Investing Basics: Financial Literacy',
    description: 'Learn to invest: asset classes, risk, compound interest, and when to start. Beginner-friendly investing guides for personal finance literacy.',
  },
  'budgeting': {
    title: 'Budgeting: Personal Finance Planning',
    description: 'Practical budgeting methods: 50/30/20, zero-based, and pay-yourself-first. Take control of your cash flow with nidhi\'s financial literacy guides.',
  },
  'cash-flow': {
    title: 'Cash Flow: Understanding Your Money Movement',
    description: 'Track where your money goes each month. Cash flow is the engine behind wealth building. Free personal finance education from nidhi.',
  },
  'liquidity': {
    title: 'Liquidity: Why Access to Your Money Matters',
    description: 'What liquidity means for your finances and why being asset-rich but cash-poor is dangerous. Personal finance literacy from nidhi.',
  },
  'risk': {
    title: 'Understanding Financial Risk: Investing Literacy',
    description: 'Risk isn\'t danger, it\'s uncertainty. Learn the difference between volatility and permanent loss, and how time transforms risk. Financial literacy from nidhi.',
  },
  'insurance': {
    title: 'Insurance Basics: Protecting Your Finances',
    description: 'How insurance protects your net worth from catastrophic loss. Health, life, property, disability, and liability explained. Personal finance literacy from nidhi.',
  },
  'credit': {
    title: 'Credit and Credit Scores: Finance Literacy',
    description: 'How credit scores work, why they affect your borrowing costs, and how to build good credit. Personal finance education from nidhi.',
  },
};

function formatTag(tag: string): string {
  return tag.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const now = new Date();
  const allPosts = (await getCollection('blog'))
    .filter(post => isDev || post.data.pubDate <= now)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];

  return allTags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter(p => p.data.tags.includes(tag))
        .map(p => ({
          id: p.data.slug,
          title: p.data.title,
          description: p.data.description,
          pubDate: p.data.pubDate.toISOString(),
          level: p.data.level,
          readingTime: getReadingTime(p.body || ''),
          tags: p.data.tags,
        })),
    },
  }));
}

const { tag, posts } = Astro.props;
const formatted = formatTag(tag);
const meta = TAG_META[tag];
// TAG_META titles already end with "| nidhi"; the fallback path doesn't, so
// we append the suffix exactly once at the end. Keeps the brand suffix
// consistent across both branches without duplicating it.
const baseTitle = meta?.title ?? `${formatted}: Personal Finance Literacy`;
const title = baseTitle.endsWith('| nidhi') ? baseTitle : `${baseTitle} | nidhi`;
const description = meta?.description ?? `Articles about ${formatted.toLowerCase()}: practical personal finance literacy and financial education from nidhi.`;

const tagBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://nidhi.today/blog/' },
    // encodeURIComponent guards against tags that contain spaces, slashes, or
    // unicode. Today every tag in TAG_META is plain ascii lowercase-with-hyphens,
    // but a future tag like "buy now, pay later" would emit an invalid URL.
    { '@type': 'ListItem', position: 2, name: formatted, item: `https://nidhi.today/blog/tag/${encodeURIComponent(tag)}/` },
  ],
};

const tagItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${formatted} Articles`,
  description,
  numberOfItems: posts.length,
  itemListElement: posts.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://nidhi.today/blog/${p.id}/`,
    name: p.title,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[tagBreadcrumbSchema, tagItemListSchema]}
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-header">
        <nav class="tag-breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a> <span class="sep">/</span> <span>{formatted}</span>
        </nav>
        <h1>{formatted}</h1>
        <p class="blog-index-subtitle">{description}</p>
      </header>
      <LearningPath client:load posts={posts} />
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .tag-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .tag-breadcrumb a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tag-breadcrumb a:hover {
    text-decoration-thickness: 2px;
  }

  .tag-breadcrumb .sep {
    margin: 0 var(--space-1);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
