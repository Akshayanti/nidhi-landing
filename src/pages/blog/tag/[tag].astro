---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LearningPath } from '../../../components/LearningPath';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../utils/readingTime';
import { TAG_META, formatTag } from '../../../utils/tags';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const now = new Date();
  const allPosts = (await getCollection('blog'))
    .filter(post => isDev || post.data.pubDate <= now)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))];

  return allTags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter(p => p.data.tags.includes(tag))
        .map(p => ({
          id: p.data.slug,
          title: p.data.title,
          description: p.data.description,
          pubDate: p.data.pubDate.toISOString(),
          level: p.data.level,
          readingTime: getReadingTime(p.body || ''),
          tags: p.data.tags,
        })),
    },
  }));
}

const { tag, posts } = Astro.props;
const formatted = formatTag(tag);
const meta = TAG_META[tag];
// TAG_META titles already end with "| nidhi"; the fallback path appends it
// once. Either branch ends in the brand suffix, no double-append risk.
const title = meta?.title ?? `${formatted}: Personal Finance Literacy | nidhi`;
const description = meta?.description ?? `Articles about ${formatted.toLowerCase()}: practical personal finance literacy and financial education from nidhi.`;

const tagBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://nidhi.today/blog/' },
    // encodeURIComponent guards against tags that contain spaces, slashes, or
    // unicode. Today every tag in TAG_META is plain ascii lowercase-with-hyphens,
    // but a future tag like "buy now, pay later" would emit an invalid URL.
    { '@type': 'ListItem', position: 2, name: formatted, item: `https://nidhi.today/blog/tag/${encodeURIComponent(tag)}/` },
  ],
};

const tagItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${formatted} Articles`,
  description,
  numberOfItems: posts.length,
  itemListElement: posts.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://nidhi.today/blog/${p.id}/`,
    name: p.title,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex,follow"
  jsonLd={[tagBreadcrumbSchema, tagItemListSchema]}
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-header">
        <nav class="tag-breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a> <span class="sep">/</span> <span>{formatted}</span>
        </nav>
        <h1>{formatted}</h1>
        <p class="blog-index-subtitle">{description}</p>
      </header>
      <LearningPath client:load posts={posts} interceptTagClick={false} />
      <nav class="tag-allTopics" aria-label="More tag pages">
        <a href="/blog/tag/" class="tag-allTopicsLink" data-attr="tag-browse-all">
          Browse all topics
          <span aria-hidden="true">&nbsp;&rsaquo;</span>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .tag-breadcrumb {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .tag-breadcrumb a {
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tag-breadcrumb a:hover {
    text-decoration-thickness: 2px;
  }

  .tag-breadcrumb .sep {
    margin: 0 var(--space-1);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Sits below the post list. Gives readers (and crawlers) an obvious path
     back up to the tag hub from any individual tag page. Uses the same
     dotted-underline treatment as the related-tools footer link on the
     multi-currency tool so the affordance reads consistently across the
     site. */
  .tag-allTopics {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }

  .tag-allTopicsLink {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-deep-blue);
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .tag-allTopicsLink:hover,
  .tag-allTopicsLink:focus-visible {
    text-decoration-style: solid;
    color: var(--color-teal);
    outline: none;
  }
</style>
