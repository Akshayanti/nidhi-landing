---
/**
 * One topic (/blog/tag/<tag>/): its lessons grouped by level in reading
 * order, on the same cards as the level pages, each group linking to its
 * full level. Inclusive Finances guides with the topic come last. Search
 * across every lesson lives on /blog/; this page has none, so nothing here
 * writes to the address.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TopicLessons, type TopicGroup } from '../../../components/LearningPath';
import { TAG_META, formatTag } from '../../../utils/tags';
import { getPathPosts } from '../../../utils/learnPosts';
import { LADDER_LEVELS, LEVEL_LABELS } from '../../../utils/home/startingPoints';

export async function getStaticPaths() {
  const posts = await getPathPosts();
  const allTags = [...new Set(posts.flatMap((p) => p.tags))];

  return allTags.map((tag) => {
    const groups: TopicGroup[] = [];
    for (const level of LADDER_LEVELS) {
      const inLevel = posts.filter((p) => p.level === level && p.pathLevel);
      const tagged = inLevel
        .map((p, i) => ({ ...p, step: i + 1, stepCount: inLevel.length }))
        .filter((p) => p.tags.includes(tag));
      if (tagged.length > 0) groups.push({ level, posts: tagged, levelTotal: inLevel.length });
    }
    const guides = posts.filter((p) => p.level === 'inclusive-finances');
    const taggedGuides = guides.filter((p) => p.tags.includes(tag));
    if (taggedGuides.length > 0) groups.push({ level: 'inclusive-finances', posts: taggedGuides, levelTotal: guides.length });
    return { params: { tag }, props: { tag, groups } };
  });
}

const { tag, groups } = Astro.props;
const lessons = groups.flatMap((g) => g.posts);
const formatted = formatTag(tag);
const meta = TAG_META[tag];
// TAG_META titles already end with "| nidhi"; the fallback path appends it
// once. Either branch ends in the brand suffix, no double-append risk.
const title = meta?.title ?? `${formatted}: Personal Finance Literacy | nidhi`;
const description = meta?.description ?? `Articles about ${formatted.toLowerCase()}: practical personal finance literacy and financial education from nidhi.`;
const levelLabel = (level: string) => LEVEL_LABELS[level] ?? 'Inclusive Finances';
const ladderGroups = groups.filter((g) => g.level !== 'inclusive-finances');
const guideGroup = groups.find((g) => g.level === 'inclusive-finances');
const ladderCount = ladderGroups.reduce((n, g) => n + g.posts.length, 0);
const levelNames = ladderGroups.map((g) => levelLabel(g.level));
const levelList = levelNames.length <= 1 ? levelNames.join('') : `${levelNames.slice(0, -1).join(', ')} and ${levelNames[levelNames.length - 1]}`;
const summaryParts = [
  ladderCount > 0 ? `${ladderCount} ${ladderCount === 1 ? 'lesson' : 'lessons'} in ${levelList}` : '',
  guideGroup ? `${guideGroup.posts.length} Inclusive Finances ${guideGroup.posts.length === 1 ? 'guide' : 'guides'}` : '',
].filter(Boolean);
const summary = summaryParts.join(', plus ');

const tagBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Learn', item: 'https://nidhi.today/blog/' },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: 'https://nidhi.today/blog/tag/' },
    // encodeURIComponent guards against tags that contain spaces, slashes, or
    // unicode. Today every tag in TAG_META is plain ascii lowercase-with-hyphens,
    // but a future tag like "buy now, pay later" would emit an invalid URL.
    { '@type': 'ListItem', position: 3, name: formatted, item: `https://nidhi.today/blog/tag/${encodeURIComponent(tag)}/` },
  ],
};

const tagItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${formatted} lessons`,
  description,
  numberOfItems: lessons.length,
  itemListElement: lessons.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://nidhi.today/blog/${p.id}/`,
    name: p.title,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex,follow"
  jsonLd={[tagBreadcrumbSchema, tagItemListSchema]}
>
  <section class="topic-page">
    <div class="container topic-page-container">
      <nav class="topic-page-crumb" aria-label="Breadcrumb">
        <a href="/blog/">Learn</a>
        <span aria-hidden="true"> / </span>
        <a href="/blog/tag/">Topics</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{formatted}</span>
      </nav>
      <header class="topic-page-header">
        <p class="topic-page-eyebrow">Topic</p>
        <h1>{formatted}</h1>
        <p class="topic-page-desc">{description}</p>
        {summary && <p class="topic-page-count">{summary}.</p>}
      </header>

      <TopicLessons client:load groups={groups} />

      <nav class="topic-page-nav" aria-label="More ways to find lessons">
        <a href="/blog/tag/" data-attr="tag-browse-all">All topics</a>
        <a href="/blog/#learn-find-h" data-attr="tag-search-all">Search every lesson <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  .topic-page-container {
    max-width: 1040px;
  }

  .topic-page-crumb {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .topic-page-crumb a {
    color: var(--color-deep-blue);
  }

  .topic-page-header {
    max-width: 680px;
    margin-bottom: var(--space-8);
  }

  .topic-page-eyebrow {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .topic-page-header h1 {
    margin: var(--space-1) 0 var(--space-2);
    font-size: 2.4rem;
    line-height: 1.15;
    color: var(--color-deep-blue);
  }

  .topic-page-desc {
    margin: 0 0 var(--space-2);
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .topic-page-count {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .topic-page-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .topic-page-nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-deep-blue);
  }

  @media (max-width: 640px) {
    .topic-page { padding: var(--space-5) 0 var(--space-8); }

    .topic-page-header { margin-bottom: var(--space-6); }

    .topic-page-header h1 { font-size: 2rem; }

    .topic-page-desc { font-size: 1rem; }
  }
</style>
