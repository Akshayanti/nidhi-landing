---
import BlogPost from '../../layouts/BlogPost.astro';
import { getCollection, render } from 'astro:content';
import { getLayeredReadingTime } from '../../utils/readingTime';
import { GLOSSARY_CARD_ID, termId } from '../../utils/glossary.mjs';
import { LAYERED_LEVELS, layeredLessonProblems } from '../../utils/layeredLessons';
import { searchTitleProblem } from '../../utils/searchTitle';
import { LADDER_LEVELS } from '../../utils/home/startingPoints';
import { isMonteCarloReleased, MONTE_CARLO_URL } from '../../utils/monte-carlo/release';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const now = new Date();
  const allPosts = await getCollection('blog');
  const posts = allPosts
    .filter(post => isDev || post.data.pubDate <= now)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  // Build a fast lookup so we can resolve relatedSlugs entries without a
  // linear scan per post.
  const bySlug = new Map(posts.map((p) => [p.data.slug, p]));

  /**
   * Pick up to 3 "Keep reading" suggestions for a post. Honours the
   * documented contract on the `relatedSlugs` content schema:
   *
   *  - relatedSlugs entries are tried first, in author order.
   *  - Unpublished or unknown slugs are silently skipped (so a post
   *    can ship before its referent and auto-promote on the next
   *    build).
   *  - Backward-only link discipline: a related entry must have
   *    pubDate on or before the current post's pubDate. This prevents
   *    a Discovery post from forward-referencing Building content the
   *    reader has not been given the prerequisites for.
   *  - If fewer than 3 candidates remain, fill from tag-overlap
   *    against the rest of the published corpus. Score = number of
   *    shared tags, tie-break by closest pubDate (most recent first
   *    among same-score matches that are still backward-only).
   *  - Result is always ≤ 3, deduped by slug.
   */
  type Pub = (typeof posts)[number];
  function pickRelated(current: Pub): Pub[] {
    const picked: Pub[] = [];
    const seen = new Set<string>([current.data.slug]);
    const cap = 3;

    const declared = current.data.relatedSlugs ?? [];
    for (const slug of declared) {
      if (picked.length >= cap) break;
      const candidate = bySlug.get(slug);
      if (!candidate) continue;
      if (seen.has(candidate.data.slug)) continue;
      if (candidate.data.pubDate > current.data.pubDate) continue;
      picked.push(candidate);
      seen.add(candidate.data.slug);
    }

    if (picked.length < cap) {
      const currentTags = new Set(current.data.tags);
      const scored = posts
        .filter((p) =>
          !seen.has(p.data.slug) &&
          p.data.slug !== current.data.slug &&
          p.data.pubDate <= current.data.pubDate
        )
        .map((p) => {
          const overlap = p.data.tags.reduce((n, t) => n + (currentTags.has(t) ? 1 : 0), 0);
          return { post: p, overlap };
        })
        .filter((x) => x.overlap > 0)
        .sort((a, b) => {
          if (b.overlap !== a.overlap) return b.overlap - a.overlap;
          // Closer to the current post's pubDate ranks higher.
          const da = Math.abs(a.post.data.pubDate.getTime() - current.data.pubDate.getTime());
          const db = Math.abs(b.post.data.pubDate.getTime() - current.data.pubDate.getTime());
          return da - db;
        });

      for (const { post: p } of scored) {
        if (picked.length >= cap) break;
        picked.push(p);
        seen.add(p.data.slug);
      }
    }

    return picked;
  }

  // Where each lesson sits within its level ("Discovery, lesson 8 of 16").
  // Only the core ladder levels count: Inclusive Finances is a set of
  // guides to read in any order, not a sequence.
  const byLevel = new Map<string, Pub[]>();
  for (const p of posts) {
    if (!(LADDER_LEVELS as readonly string[]).includes(p.data.level)) continue;
    const list = byLevel.get(p.data.level) ?? [];
    list.push(p);
    byLevel.set(p.data.level, list);
  }

  return posts.map((post, index) => {
    const levelPosts = byLevel.get(post.data.level);
    const seriesPosition = levelPosts
      ? { index: levelPosts.indexOf(post) + 1, total: levelPosts.length }
      : null;
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;
    const relatedPosts = pickRelated(post).map((p) => ({
      slug: p.data.slug,
      title: p.data.title,
      description: p.data.description,
    }));
    return {
      params: { slug: post.data.slug },
      props: {
        post,
        prevSlug: prevPost?.data.slug ?? null,
        prevTitle: prevPost?.data.title ?? null,
        nextSlug: nextPost?.data.slug ?? null,
        nextTitle: nextPost?.data.title ?? null,
        relatedPosts,
        seriesPosition,
      },
    };
  });
}

const { post, prevSlug, prevTitle, nextSlug, nextTitle, relatedPosts, seriesPosition } = Astro.props;
const { Content, headings } = await render(post);

// Each glossary term is a link target (#term-...), so its anchor must exist
// and be unique on the page.
const termIds = (post.data.glossary ?? []).map((g) => termId(g.term));
for (const [i, id] of termIds.entries()) {
  if (id === 'term-') throw new Error(`${post.id}: glossary term "${post.data.glossary![i].term}" has no usable anchor`);
  if (termIds.indexOf(id) !== i) throw new Error(`${post.id}: two glossary terms share the anchor #${id}`);
}

// "In this lesson" links must land on something: a heading, the glossary card
// or one of its terms. A renamed heading fails the build instead of leaving a
// dead link.
const targets = new Set([
  ...headings.map((h) => h.slug),
  ...(termIds.length ? [GLOSSARY_CARD_ID, ...termIds] : []),
]);
// The search title only shortens the page title (src/utils/searchTitle.ts).
const titleProblem = searchTitleProblem(post.data.title, post.data.seoTitle);
if (titleProblem) throw new Error(`${post.id}: ${titleProblem} (blog-content-plan.md Rule 11)`);
// Optimizing and Inclusive Finances lessons follow the layered-lesson rule
// (src/utils/layeredLessons.ts), past and future.
if ((LAYERED_LEVELS as readonly string[]).includes(post.data.level)) {
  const problems = layeredLessonProblems(post.data, headings.filter((h) => h.depth === 2).map((h) => h.text));
  if (problems.length) {
    throw new Error(`${post.id}: layered-lesson rule (PLAYBOOK "Blog lessons"): ${problems.join('; ')}`);
  }
}

for (const t of post.data.takeaways ?? []) {
  if (typeof t !== 'string' && !targets.has(t.href.slice(1))) {
    throw new Error(`${post.id}: takeaway "${t.text}" links to ${t.href}, which is not on the page`);
  }
}

// A lesson can name the Monte Carlo simulator before it launches; the
// callout appears once the tool does.
const toolUrl = post.data.relatedTool?.url.replace(/\/?$/, '/');
const relatedTool = toolUrl === MONTE_CARLO_URL && !(await isMonteCarloReleased())
  ? undefined
  : post.data.relatedTool;

const readingTime = getLayeredReadingTime(post.body || '');
---

<BlogPost
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  description={post.data.description}
  tldr={post.data.tldr}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  level={post.data.level}
  tags={post.data.tags}
  readingTime={readingTime}
  takeaways={post.data.takeaways}
  glossary={post.data.glossary}
  localRules={post.data.localRules}
  regulatoryNote={post.data.regulatoryNote}
  referentialReading={post.data.referentialReading}
  prevSlug={prevSlug}
  prevTitle={prevTitle}
  nextSlug={nextSlug}
  nextTitle={nextTitle}
  faq={post.data.faq}
  howTo={post.data.howTo}
  relatedPosts={relatedPosts}
  seriesPosition={seriesPosition}
  relatedTool={relatedTool}
>
  <Content />
</BlogPost>