---
/**
 * Every term the published lessons define, in one place (/blog/glossary/).
 * Built from each lesson's `glossary` frontmatter, the same list that renders
 * the lesson's own glossary card, so a definition is written once. Each entry
 * links back to the term in its lesson. A term defined by more than one
 * lesson lists each definition with its lesson.
 *
 * English only, like the lessons whose words it collects (CLAUDE.md:
 * lessons are content, not copy); the chrome is plain English like the
 * lesson page's.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { termId } from '../../utils/glossary.mjs';

const isDev = import.meta.env.DEV;
const now = new Date();
const posts = (await getCollection('blog'))
  .filter((p) => (isDev || p.data.pubDate <= now) && p.data.glossary?.length)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

type Source = { definition: string; title: string; href: string };
const byTerm = new Map<string, { term: string; id: string; sources: Source[] }>();
for (const post of posts) {
  for (const { term, definition } of post.data.glossary ?? []) {
    const id = termId(term);
    const entry = byTerm.get(id) ?? { term, id, sources: [] };
    // One anchor, one spelling: lessons that define the same term must name
    // it the same way, or the page would merge two different words.
    if (entry.term !== term) {
      throw new Error(`Glossary: "${term}" (${post.data.slug}) and "${entry.term}" share the anchor #${id}; use one spelling`);
    }
    entry.sources.push({ definition, title: post.data.title, href: `/blog/${post.data.slug}/#${id}` });
    byTerm.set(id, entry);
  }
}
const terms = [...byTerm.values()].sort((a, b) => a.term.localeCompare(b.term, 'en'));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];

const title = 'Glossary: the terms the lessons use';
const description = 'Plain definitions of the terms used across the nidhi lessons, each linked to the lesson that explains it.';
const pageUrl = 'https://nidhi.today/blog/glossary/';
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: title,
  url: pageUrl,
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.sources[0].definition,
    url: `${pageUrl}#${t.id}`,
  })),
}];
---

<BaseLayout title={`${title} | nidhi`} description={description} jsonLd={jsonLd}>
  <div class="container glossary-page">
    <nav class="glossary-crumb" aria-label="Breadcrumb"><a href="/blog/">Lessons</a></nav>
    <h1>Glossary</h1>
    <p class="glossary-intro">The terms the lessons use, in plain words. Each one links to the lesson that explains it in context.</p>

    {letters.length > 1 && (
      <nav class="glossary-letters" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l.toLowerCase()}`}>{l}</a>)}
      </nav>
    )}

    {terms.length === 0 && <p>No terms yet.</p>}

    {letters.map((l) => (
      <section class="glossary-group" aria-labelledby={`letter-${l.toLowerCase()}`}>
        <h2 id={`letter-${l.toLowerCase()}`}>{l}</h2>
        <dl>
          {terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => (
            <div class="glossary-entry" id={t.id}>
              <dt>{t.term}</dt>
              {t.sources.map((s) => (
                <dd>
                  {s.definition}
                  <a class="glossary-source" href={s.href}>In context: {s.title}</a>
                </dd>
              ))}
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .glossary-page {
    max-width: 46rem;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  .glossary-crumb { margin-bottom: var(--space-3); font-size: 0.9375rem; }

  .glossary-intro {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .glossary-letters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .glossary-letters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--color-link-edge);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-deep-blue);
    text-decoration: none;
  }

  .glossary-group h2 {
    font-size: 1.25rem;
    color: var(--color-deep-blue);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
    margin: var(--space-6) 0 var(--space-4);
    scroll-margin-top: 80px;
  }

  .glossary-group dl { margin: 0; display: grid; gap: var(--space-5); }

  .glossary-entry { scroll-margin-top: 80px; }

  .glossary-entry:target {
    outline: 2px solid var(--color-teal);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .glossary-entry dt {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-deep-blue);
  }

  .glossary-entry dd {
    margin: var(--space-1) 0 0;
    line-height: 1.6;
  }

  .glossary-source {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.9375rem;
  }
</style>
