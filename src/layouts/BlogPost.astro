---
import BaseLayout from './BaseLayout.astro';
import LevelBadge from '../components/LevelBadge.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
import { LADDER_LEVELS } from '../utils/home/startingPoints';
import LocalRules from '../components/LocalRules.astro';
import type { LocalRuleArea } from '../utils/localRules';
import type { LayeredReadingTime } from '../utils/readingTime';
import { DEFAULT_LOCALE, dict } from '../i18n';
import { GLOSSARY_CARD_ID, termId } from '../utils/glossary.mjs';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  tldr: string;
  pubDate: Date;
  updatedDate?: Date;
  /** Substantive corrections, oldest first, as the frontmatter lists them. */
  corrections?: Array<{ date: Date; note: string }>;
  level: string;
  tags: string[];
  /** Main path, optional detail and their sum, from getLayeredReadingTime. */
  readingTime?: LayeredReadingTime;
  regulatoryNote?: string;
  referentialReading?: Array<{
    title: string;
    author?: string;
    url: string;
    type: string;
  }>;
  prevSlug?: string | null;
  prevTitle?: string | null;
  nextSlug?: string | null;
  nextTitle?: string | null;
  faq?: Array<{ question: string; answer: string }>;
  howTo?: {
    name: string;
    totalTime?: string;
    steps: Array<{ name: string; text: string }>;
  };
  /**
   * Up to 3 "Keep reading" cards. Resolved upstream in
   * `src/pages/blog/[slug].astro` from the post's `relatedSlugs` plus
   * tag-overlap fallback. Empty array (no block rendered) until either
   * `relatedSlugs` lists a published target or another published post
   * shares at least one tag.
   */
  relatedPosts?: Array<{ slug: string; title: string; description: string }>;
  /** Paired free tool from the post's `relatedTool` frontmatter. */
  relatedTool?: { url: string; label: string; cta: string; idea?: string };
  /** Topic phrases from the post's `takeaways`, listed under the TL;DR;
   *  one with `href` links to the part of the lesson that delivers it. */
  takeaways?: (string | { text: string; href: string })[];
  /** Terms from the post's `glossary`, shown collapsed under "In this lesson". */
  glossary?: { term: string; definition: string }[];
  /** Rule areas the lesson depends on; shows "Where to check locally". */
  localRules?: LocalRuleArea[];
  /** Place within the level among published lessons; null outside the ladder. */
  seriesPosition?: { index: number; total: number } | null;
}

const { title, seoTitle, description, tldr, pubDate, updatedDate, corrections = [], level, tags, readingTime, regulatoryNote, referentialReading, prevSlug, prevTitle, nextSlug, nextTitle, faq, howTo, relatedPosts = [], relatedTool, seriesPosition, takeaways = [], glossary = [], localRules = [] } = Astro.props;
// A lesson is English in every edition, so its chrome reads the English names.
// Ladder levels only: an Inclusive Finances guide is not a step in a series.
const levelLabel = (LADDER_LEVELS as readonly string[]).includes(level) ? dict(DEFAULT_LOCALE).learn.levels[level] : undefined;
const relatedToolId = relatedTool?.url.split('/').filter(Boolean).pop();
const faqIndexLabel = faq && faq.length > 0
  ? (faq.length === 1 ? 'Answer to 1 common question' : `Answers to ${faq.length} common questions`)
  : null;
// The lesson index button opens "In this lesson" again while reading. Every
// line has to lead somewhere, so a lesson with an unlinked takeaway gets none.
const indexItems = takeaways.length > 0 && takeaways.every((t) => typeof t !== 'string')
  ? [
      ...(takeaways as { text: string; href: string }[]),
      ...(faqIndexLabel ? [{ text: faqIndexLabel, href: '#post-faq-h' }] : []),
    ]
  : [];

const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
// Surface "Updated <date>" only when the updated date is meaningfully later
// than the publish date (more than seven days). This avoids noisy "updated"
// labels for fixes made within the publication window, while letting genuine
// freshness signals show through to readers and to SERP CTR.
const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
const showUpdated = !!updatedDate && updatedDate.getTime() - pubDate.getTime() > SEVEN_DAYS_MS;
const updatedStr = showUpdated && updatedDate
  ? updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const siteUrl = 'https://nidhi.today';
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Organization',
    name: 'nidhi',
    url: `${siteUrl}/about/`,
    description:
      'Practitioner and research-led personal finance education. Builds the tools the posts describe and sources every article against cited references.',
    sameAs: ['https://www.instagram.com/nidhi.today'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'nidhi',
    url: `${siteUrl}/`,
  },
  // Point at the generic site OG image for now. PR16 will repoint this
  // at a per-post OG image generator and emit the real dims dynamically.
  image: {
    '@type': 'ImageObject',
    url: `${siteUrl}/brand/social/og-image.png`,
    width: 1200,
    height: 630,
  },
  url: `${siteUrl}/blog/${slug}/`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${siteUrl}/blog/${slug}/`,
  },
  keywords: tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Learn',
      item: `${siteUrl}/blog/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: `${siteUrl}/blog/${slug}/`,
    },
  ],
};
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const howToSchema = howTo ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: howTo.name,
  ...(howTo.totalTime ? { totalTime: howTo.totalTime } : {}),
  step: howTo.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
  })),
} : null;

const allSchemas = [blogPostingSchema, breadcrumbSchema, faqSchema, howToSchema].filter(Boolean);
---

<BaseLayout
  title={`${seoTitle ?? title} | nidhi`}
  description={description}
  article={{
    publishedTime: pubDate,
    modifiedTime: updatedDate,
    tags: tags,
  }}
  prevUrl={prevSlug ? `/blog/${prevSlug}/` : null}
  nextUrl={nextSlug ? `/blog/${nextSlug}/` : null}
  jsonLd={allSchemas}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  {/*
    The lesson index button: once "In this lesson" has scrolled away, a
    button bottom right (a pill in the margin on wide screens) opens
    the same list in a dialog, with the part being read marked. Shown from
    the end of the list to the end of the FAQ (script below); hidden without
    JavaScript and in print, where the list under the title is still there.
  */}
  {indexItems.length > 0 && (
    <>
      <button type="button" class="lesson-index-button" id="lesson-index-button" aria-haspopup="dialog" aria-controls="lesson-index" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11" /><circle cx="4.5" cy="6" r="1" fill="currentColor" /><circle cx="4.5" cy="12" r="1" fill="currentColor" /><circle cx="4.5" cy="18" r="1" fill="currentColor" /></svg>
        <span class="lesson-index-button-text">In this lesson</span><span class="lesson-index-sr" data-lesson-index-now></span>
      </button>
      <dialog class="lesson-index" id="lesson-index" aria-labelledby="lesson-index-h">
        <div class="lesson-index-head">
          <h2 class="lesson-index-title" id="lesson-index-h">In this lesson</h2>
          <button type="button" class="lesson-index-close" aria-label="Close" data-lesson-index-close>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
        <ul class="lesson-index-list">
          {indexItems.map((t) => <li><a href={t.href}>{t.text}</a></li>)}
        </ul>
      </dialog>
    </>
  )}
  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <div class="post-meta">
          <LevelBadge level={level} />
          {seriesPosition && (
            <a class="post-series" href={`/blog/${level}/`} data-attr="post-series-top">
              Lesson {seriesPosition.index} of {seriesPosition.total}
            </a>
          )}
          <span class="post-byline">By <a href="/about/" rel="author">nidhi</a></span>
          {readingTime && (
            <span class="post-reading-time" data-total-minutes={readingTime.total}>
              {readingTime.main} min read
              {readingTime.depth > 0 && <span class="post-reading-depth"> · +{readingTime.depth} min of optional detail</span>}
            </span>
          )}
          <time datetime={pubDate.toISOString()} class="post-date">{dateStr}</time>
          {showUpdated && updatedDate && (
            <span class="post-updated">
              Updated <time datetime={updatedDate.toISOString()}>{updatedStr}</time>
            </span>
          )}
        </div>
        {/* Shown, not swapped in quietly: what was wrong and what the lesson says now. */}
        {corrections.map((c) => (
          <p class="post-correction">
            <strong>Corrected on <time datetime={c.date.toISOString()}>{c.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>:</strong> {c.note}
          </p>
        ))}
        <h1 class="post-title">{title}</h1>
        <div class="post-tldr">
          <span class="tldr-label">TL;DR</span>
          <p>{tldr}</p>
        </div>
        {/*
          What the lesson covers, before the reader commits to it. Plain text
          under a small label, so it reads as a preview and not as a box to
          tick. Outside #post-content, so the TOC and the newsletter skip it.
        */}
        {takeaways.length > 0 && (
          <section class="post-covers" aria-labelledby="post-covers-h">
            <h2 id="post-covers-h" class="post-covers-title">In this lesson</h2>
            <ul class="post-covers-list">
              {takeaways.map((t) => typeof t === 'string'
                ? <li>{t}</li>
                : <li><a href={t.href}>{t.text}</a></li>)}
              {faq && faq.length > 0 && (
                <li><a href="#post-faq-h">{faqIndexLabel}</a></li>
              )}
            </ul>
          </section>
        )}
        {/*
          The lesson's glossary. Not another list like "In this lesson": a
          bordered card with an icon, the terms as tappable pills that are
          always visible, and the definitions folded underneath. A pill, a
          body link to #term-... or #glossary opens the definitions (script
          below). Outside #post-content like "In this lesson", so the
          newsletter skips it and points term links at the web page.
        */}
        {glossary.length > 0 && (
          <section class="post-glossary" id={GLOSSARY_CARD_ID} data-glossary-card aria-labelledby="post-glossary-h">
            <div class="post-glossary-head">
              <span class="post-glossary-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z" /><path d="M8 7h7M8 11h5" /></svg>
              </span>
              <span class="post-glossary-titles">
                <h2 id="post-glossary-h" class="post-glossary-heading">Glossary</h2>
                <span class="post-glossary-count">{glossary.length === 1 ? '1 term' : `${glossary.length} terms`} in this lesson</span>
              </span>
              <a class="post-glossary-all" href="/blog/glossary/">All terms</a>
            </div>
            <ul class="post-glossary-chips">
              {glossary.map((g) => <li><a class="post-glossary-chip" href={`#${termId(g.term)}`}>{g.term}</a></li>)}
            </ul>
            <details class="post-glossary-defs">
              <summary class="disclosure post-glossary-summary"><span class="post-glossary-show">Show all definitions</span><span class="post-glossary-hide">Hide definitions</span></summary>
              <dl class="post-glossary-list">
                {glossary.map((g) => (
                  <div class="post-glossary-item" id={termId(g.term)}>
                    <dt>{g.term}</dt>
                    <dd>{g.definition}</dd>
                  </div>
                ))}
              </dl>
            </details>
          </section>
        )}
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a class="post-tag" href={`/blog/tag/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>
        )}
      </header>

      {regulatoryNote === 'caution' && (
        <div class="notice-caution">
          <strong>Heads up:</strong> This lesson explains general principles. It is not personal advice for your situation.
        </div>
      )}

      {regulatoryNote === 'danger' && (
        <div class="notice-danger">
          <strong>Important:</strong> This article touches on tax-related concepts to help you understand how they work. Tax rules vary by country and situation. Talk to a qualified tax professional before making decisions based on what you read here.
        </div>
      )}
    </div>

    <div class="post-body-wrapper">
      <div class="prose" id="post-content">
        <slot />
      </div>
      {/*
        Wide tables scroll inside their own box on phones instead of making
        the whole page scroll sideways. Runs right after the content, before
        first paint. The box is a labelled, focusable region so keyboard users
        can scroll it too. Styles: .prose .table-scroll in global.css.
      */}
      <script is:inline>
        (function () {
          var tables = document.querySelectorAll('#post-content table');
          for (var i = 0; i < tables.length; i++) {
            var t = tables[i];
            if (t.parentElement && t.parentElement.classList.contains('table-scroll')) continue;
            var box = document.createElement('div');
            box.className = 'table-scroll';
            box.setAttribute('role', 'region');
            box.tabIndex = 0;
            var cap = t.querySelector('caption');
            box.setAttribute('aria-label', cap && cap.textContent.trim() ? cap.textContent.trim() + ' (table)' : 'Table');
            t.parentNode.insertBefore(box, t);
            box.appendChild(t);
          }
        })();
      </script>
    </div>

    <div class="post-bottom-wrapper">
      <div class="post-bottom-content">
        <LocalRules areas={localRules} />

        {/*
          Learn, Understand, Apply: placed straight after the article so a
          reader who just learned the idea can try it on their own numbers.
          The middle step appears when the lesson names its `idea`.
        */}
        {relatedTool && (
          <aside class="post-tool" aria-labelledby="post-tool-h">
            <h2 id="post-tool-h" class="post-tool-title">Now apply it to your money</h2>
            <ol class="post-tool-steps">
              <li class="post-tool-step post-tool-step--done">
                <span class="post-tool-stepLabel">Learn</span>
                <span class="post-tool-stepBody">{title} <span class="post-tool-check">(read)</span></span>
              </li>
              {relatedTool.idea && (
                <li class="post-tool-step">
                  <span class="post-tool-stepLabel">Understand</span>
                  <span class="post-tool-stepBody">{relatedTool.idea}</span>
                </li>
              )}
              <li class="post-tool-step">
                <span class="post-tool-stepLabel">Apply</span>
                <span class="post-tool-stepBody">
                  <a class="post-tool-link" href={relatedTool.url} data-attr={`post-tool-${relatedToolId}`}>
                    {relatedTool.cta} <span aria-hidden="true">→</span>
                  </a>
                  <span class="post-tool-note">{relatedTool.label}. Free, and what you enter stays in your browser.</span>
                </span>
              </li>
            </ol>
          </aside>
        )}

        {/*
          Visible rendering of the same `faq` entries that feed the FAQPage
          JSON-LD above. Structured data must describe content a reader can
          actually see on the page, so the two are driven from one source.
          Each answer folds under its question, as on the homepage and the
          free tools, so the list scans as questions. The answers are still
          in the initial HTML, inside <details>, so the page shows what the
          structured data describes.
        */}
        {faq && faq.length > 0 && (
          <section class="post-faq" aria-labelledby="post-faq-h">
            <h2 id="post-faq-h" class="post-faq-title">Frequently asked questions</h2>
            {faq.map((item) => (
              <details class="post-faq-item">
                <summary class="disclosure"><h3 class="post-faq-q">{item.question}</h3></summary>
                <p class="post-faq-a">{item.answer}</p>
              </details>
            ))}
          </section>
        )}

        {referentialReading && referentialReading.length > 0 && (
          <section class="suggested-reading">
            <h2 class="suggested-reading-title">Suggested Reading</h2>
            <ul class="suggested-reading-list">
              {referentialReading.map((ref) => (
                <li>
                  {/* The word joiner keeps the arrow on the title's last line. */}
                  <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title}&#x2060;<span class="ref-external" aria-hidden="true">↗</span><span class="ref-new-tab"> (opens in a new tab)</span></a>
                  {ref.author && <span class="ref-author"> by {ref.author}</span>}
                  <span class="ref-type">{ref.type}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="disclaimer">
          <strong>A quick note:</strong> This article is educational content, not investment advice or a personal recommendation under MiFID II. Examples, historical figures, and any projections are illustrative and don't predict future results. Tax treatment depends on your country and personal situation. For decisions that meaningfully affect your finances, a qualified or regulated adviser can help apply these ideas to your circumstances.
        </div>

        {seriesPosition && levelLabel && (
          <p class="post-series-foot">
            You are on lesson {seriesPosition.index} of {seriesPosition.total} in {levelLabel}.{' '}
            <a href={`/blog/${level}/`} data-attr="post-series-bottom">See all {levelLabel} lessons</a>
          </p>
        )}

        {(prevSlug || nextSlug) && (
          <nav class="post-nav" aria-label="Adjacent posts">
            {prevSlug && prevTitle && (
              <a class="post-nav-link post-nav-prev" href={`/blog/${prevSlug}/`} data-attr="post-nav-prev">
                <span class="post-nav-direction">Previous</span>
                <span class="post-nav-title">{prevTitle}</span>
              </a>
            )}
            {nextSlug && nextTitle && (
              <a class="post-nav-link post-nav-next" href={`/blog/${nextSlug}/`} data-attr="post-nav-next">
                <span class="post-nav-direction">Next</span>
                <span class="post-nav-title">{nextTitle}</span>
              </a>
            )}
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <aside class="post-related" aria-labelledby="post-related-h">
            <h2 id="post-related-h" class="post-related-title">Keep reading</h2>
            <div class="post-related-grid">
              {relatedPosts.map((rp) => (
                <a
                  class="post-related-card link-card"
                  href={`/blog/${rp.slug}/`}
                  data-attr={`related-${rp.slug}`}
                >
                  <span class="post-related-card-title">{rp.title}</span>
                  <span class="post-related-card-desc">{rp.description}</span>
                </a>
              ))}
            </div>
          </aside>
        )}

        <SubscribeSection variant="full" />
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  // The glossary card is a closed <details>, and a browser cannot scroll to
  // something inside a closed one. Open it before following a link to the
  // card or one of its terms, and when the page loads on such an address.
  (function() {
    function openFor(hash) {
      if (!hash || hash.length < 2) return null;
      var id;
      try { id = decodeURIComponent(hash.slice(1)); } catch (e) { return null; }
      var target = document.getElementById(id);
      if (!target || !target.closest) return null;
      // A term opens the definitions at itself; the card's own address
      // (#glossary) opens them too, since that link promises the definitions.
      var defs = target.closest('[data-glossary-card] details')
        || (target.hasAttribute('data-glossary-card') ? target.querySelector('details') : null);
      if (defs && !defs.open) defs.open = true;
      return defs ? target : null;
    }
    document.addEventListener('click', function(e) {
      var a = e.target.closest && e.target.closest('a[href^="#"]');
      if (a) openFor(a.getAttribute('href'));
    });
    window.addEventListener('hashchange', function() { openFor(location.hash); });
    var initial = openFor(location.hash);
    if (initial) initial.scrollIntoView();
  })();
</script>

<script is:inline>
  // A printed lesson shows every expander, the glossary and FAQ answer open; after
  // printing, each one goes back to how the reader left it.
  (function() {
    var closed = [];
    window.addEventListener('beforeprint', function() {
      closed = Array.prototype.filter.call(
        document.querySelectorAll('#post-content details:not([open]), .post-faq details:not([open]), .post-glossary details:not([open])'),
        function(d) { d.open = true; return true; }
      );
    });
    window.addEventListener('afterprint', function() {
      closed.forEach(function(d) { d.open = false; });
      closed = [];
    });
  })();

  // Auto-mark this post as read
  (function() {
    var path = window.location.pathname;
    var slug = path.split('/').filter(Boolean).pop();
    if (!slug) return;
    var key = 'nidhi-reading-progress';
    try {
      var data = JSON.parse(localStorage.getItem(key) || '[]');
      if (data.indexOf(slug) === -1) {
        data.push(slug);
        localStorage.setItem(key, JSON.stringify(data));
      }
    } catch(e) {}
  })();
</script>

<style>
  .blog-post {
    padding: var(--space-10) 0 var(--space-16);
  }

  .post-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .post-series {
    /* At least 24px tall: the WCAG 2.2 minimum tap target. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: 0.8125rem;
    font-family: var(--font-heading);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }

  .post-series:hover { color: var(--color-teal); }

  /* The way to the Hindi learning path, in the same row as the lesson's other
     meta. Sized and coloured like the series link beside it. */
  .post-series-foot {
    margin-top: var(--space-10);
    margin-bottom: 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .post-series-foot + .post-nav { margin-top: var(--space-4); }

  .post-reading-time {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .post-byline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .post-byline a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-byline a:hover {
    color: var(--color-teal);
  }

  .post-date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-correction {
    margin: var(--space-3) 0 0;
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border-inline-start: 3px solid var(--color-teal);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .post-correction strong {
    color: var(--color-text-primary);
  }

  /* Updated label sits next to the publish date when the post has a
     meaningfully later updatedDate. Visible recency is a CTR signal on
     evergreen finance content; we use the same muted treatment as the
     pubDate so it reads as metadata, not an alert. */
  .post-updated {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .post-updated::before {
    content: '\00b7';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: 2rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .post-tldr {
    background: var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .tldr-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-deep-blue);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .post-tldr p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* "In this lesson": a preview, not a card. The label matches the TL;DR
     label; the topics are plain body-size lines with a small teal dot. */
  .post-covers {
    margin: 0 0 var(--space-5);
    padding: 0 var(--space-5);
  }

  .post-covers-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-2);
  }

  .post-covers-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .post-covers-list li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .post-covers-list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-teal);
  }

  /* A topic that links to its section: the list doubles as the lesson's
     index on every screen; the lesson's FAQ is its last line. */
  .post-covers-list a {
    display: inline-block;
    padding: 0.2rem 0;
    color: var(--color-deep-blue);
    text-decoration: underline;
    text-decoration-color: var(--color-link-edge);
    text-underline-offset: 0.2em;
  }

  .post-covers-list a:hover {
    text-decoration-color: currentColor;
  }

  /* The glossary card. It must not read as a second "In this lesson" (a
     small uppercase label over a list), so it is a bordered card with an
     icon tile, a sentence-case heading, and the terms as pills: a shape
     nothing else at the top of a lesson uses. */
  .post-glossary {
    margin: 0 0 var(--space-5);
    padding: var(--space-4) var(--space-4) var(--space-3);
    background: var(--color-bg-white);
    border: 1px solid var(--color-link-edge);
    border-left: 4px solid var(--color-deep-blue);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--color-deep-blue) 12%, transparent);
  }

  .post-glossary-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .post-glossary-titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .post-glossary-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--color-deep-blue);
    color: var(--color-bg-white);
    flex: none;
  }

  .post-glossary-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .post-glossary-count {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .post-glossary-all {
    margin-left: auto;
    flex: none;
    font-size: 0.9375rem;
    padding: 0.6rem 0;
  }

  .post-glossary-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .post-glossary-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--color-link-edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-deep-blue) 7%, var(--color-bg-white));
    color: var(--color-deep-blue);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .post-glossary-chip:hover {
    border-color: var(--color-deep-blue);
  }

  .post-glossary-defs {
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .post-glossary-summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) 44px var(--space-2) 0;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-deep-blue);
  }

  .post-glossary-hide,
  .post-glossary-defs[open] .post-glossary-show {
    display: none;
  }

  .post-glossary-defs[open] .post-glossary-hide {
    display: inline;
  }

  .post-glossary-summary:focus-visible,
  .post-glossary-chip:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .post-glossary-list {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-1) 0 0;
  }

  .post-glossary-item {
    border-radius: var(--radius-sm);
  }

  .post-glossary-item:target {
    outline: 2px solid var(--color-teal);
    outline-offset: 4px;
  }

  .post-glossary-item dt {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-deep-blue);
  }

  .post-glossary-item dd {
    margin: var(--space-1) 0 0;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  @media print {
    .post-glossary { break-inside: avoid; box-shadow: none; }
  }

  .post-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .post-tag {
    background: var(--color-border-light);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid var(--color-control-edge);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .post-tag:hover {
    background: var(--color-deep-blue);
    color: white;
    border-color: var(--color-deep-blue);
  }

  /* Post body and bottom: one centred column, with the same width and gutter
     as the header's .container, so the text lines up with the title at every
     width. "In this lesson" under the title is the lesson's only index; there
     is no sidebar. */
  .prose,
  .post-bottom-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Paired free tool: one card, teal rule, same spacing as the sections below. */
  .post-tool {
    margin-top: var(--space-10);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-left: 4px solid var(--color-teal);
    border-radius: var(--radius-md);
  }


  .post-tool-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin: 0 0 var(--space-3);
  }

  /* Three steps joined by a line, so the block reads as one path. */
  .post-tool-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-tool-step {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
  }

  .post-tool-step::before {
    content: '';
    position: absolute;
    left: 3px;
    top: calc(var(--space-2) + 0.35em);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--color-teal);
    background: var(--color-bg);
  }

  .post-tool-step--done::before { background: var(--color-teal); }

  .post-tool-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 7px;
    top: calc(var(--space-2) + 0.35em + 13px);
    bottom: calc(-1 * var(--space-2) + 0.35em);
    width: 2px;
    background: color-mix(in srgb, var(--color-teal) 40%, transparent);
  }

  .post-tool-stepLabel {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    padding-top: 0.2em;
  }

  .post-tool-stepBody {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .post-tool-check,
  .post-tool-note {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .post-tool-note {
    display: block;
    margin-top: 2px;
  }

  @media (max-width: 480px) {
    .post-tool-step { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }

  .post-tool-link {
    font-weight: 600;
    color: var(--color-deep-blue);
    text-decoration-color: var(--color-teal);
    text-underline-offset: 3px;
  }

  .post-tool-link:hover,
  .post-tool-link:focus-visible {
    color: var(--color-teal);
  }

  /* FAQ: same section rhythm as suggested reading below it. */
  .post-faq {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .post-faq-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  /* Folded like the homepage FAQ: a rule between questions, the whole
     question row as the tap target, the chevron from .disclosure. */
  .post-faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .post-faq-item > summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--space-3) 40px var(--space-3) 4px;
  }

  /* Mouse users see the row respond (only where hover exists, so a tapped
     question on a phone does not stay blue); an open answer gets room
     before the next question, so the two do not run together. */
  @media (hover: hover) {
    .post-faq-item > summary:hover .post-faq-q {
      color: var(--color-deep-blue);
    }
  }

  .post-faq-item[open] {
    padding-bottom: var(--space-2);
  }

  .post-faq-item > summary:focus-visible {
    outline: 2px solid var(--color-deep-blue);
    outline-offset: -2px;
  }

  .post-faq-q {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .post-faq-a {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0 4px var(--space-4);
    text-wrap: pretty;
  }

  /* Suggested reading */
  .suggested-reading {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .suggested-reading-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  .suggested-reading-list {
    list-style: none;
    padding: 0;
  }

  .suggested-reading-list li {
    padding: var(--space-2) 0;
    font-size: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Every suggested read links out (the schema requires a url), underlined
     like links in the lesson text. The arrow is decoration; screen readers
     hear the new-tab note; neither ends up in a copied title. */
  .suggested-reading-list a {
    color: var(--color-deep-blue);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    /* A little taller to tap, without moving the text. */
    padding-block: 2px;
  }

  /* Inline, so with the word joiner before it the arrow never wraps onto
     a line of its own. */
  .ref-external {
    margin-left: 0.2em;
    font-size: 0.85em;
    user-select: none;
  }

  .ref-new-tab {
    user-select: none;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ref-author {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .ref-type {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-border-light);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  /* Post navigation */
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    max-width: 45%;
    transition: color 0.15s ease;
  }

  .post-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .post-nav-direction {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .post-nav-title {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-deep-blue);
    line-height: 1.35;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--color-teal);
  }

  @media (max-width: 480px) {
    .post-title { font-size: 1.5rem; }
    .post-nav { flex-direction: column; gap: var(--space-3); }
    .post-nav-link { max-width: 100%; }
    .post-nav-next { text-align: left; }
  }

  /* "Keep reading" block. Sits between the prev/next pager and the
     subscribe CTA. Card visuals mirror the related-reads pattern on the
     multi-currency tool and the new tag hub page so the affordance reads
     consistently across the site. */
  .post-related {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .post-related-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 800px) {
    .post-related-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4) 40px var(--space-4) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-link-edge);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    min-height: 100%;
  }

  .post-related-card:hover,
  .post-related-card:focus-visible {
    border-color: var(--color-deep-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    outline: none;
  }

  .post-related-card:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .post-related-card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-deep-blue);
    line-height: 1.3;
  }

  .post-related-card-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The lesson index button. Phones and narrow screens: a round button
     bottom right, within thumb reach, above the safe area. Wide screens: a
     labelled pill in the margin beside the column. Its colours swap with
     the theme (deep blue turns light in dark mode). Below the header
     (z-index 100), its menu sheet and the cookie prompt. */
  .lesson-index-button {
    position: fixed;
    right: var(--space-4);
    bottom: calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 48px;
    height: 48px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: 999px;
    background: var(--color-deep-blue);
    color: var(--color-bg-white);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.18);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0s linear 0.15s;
  }

  .lesson-index-button[data-shown] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .lesson-index-button:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 3px;
  }

  /* On narrow screens the button reads "In this lesson" for six seconds
     after it arrives, then shrinks to the icon so it covers less text. */
  .lesson-index-button-text,
  .lesson-index-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .lesson-index-button[data-labelled] {
    padding: 0 var(--space-4) 0 var(--space-3);
  }

  .lesson-index-button[data-labelled] .lesson-index-button-text {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
  }

  /* The hand-off: as "In this lesson" goes under the header, a copy of it
     shrinks into the button's corner, so the eye follows the list to where
     it now lives. Motion only; skipped for reduced motion. */
  :global(.lesson-index-ghost) {
    position: fixed;
    z-index: 89;
    margin: 0;
    padding: var(--space-3) var(--space-5);
    overflow: hidden;
    background: var(--color-bg-white);
    border: 1px solid var(--color-control-edge);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    transform-origin: top left;
    pointer-events: none;
  }


  @media (min-width: 1200px) {
    .lesson-index-button {
      right: auto;
      left: calc(50% + var(--max-width) / 2 + var(--space-4));
      bottom: var(--space-8);
      padding: 0 var(--space-4) 0 var(--space-3);
    }

    .lesson-index-button .lesson-index-button-text {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
  }

  /* The list, in a modal dialog: a sheet from the bottom on narrow screens,
     a panel above the pill on wide ones. The page behind is dimmed and
     inert; Escape, the close button or a tap outside closes it. */
  .lesson-index {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 75dvh;
    margin: 0;
    padding: var(--space-2) var(--space-4) calc(env(safe-area-inset-bottom, 0px) + var(--space-4));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg-white);
    color: var(--color-text-primary);
    border: 1px solid var(--color-control-edge);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 32px rgb(0 0 0 / 0.16);
  }

  .lesson-index::backdrop {
    background: rgb(0 0 0 / 0.35);
  }

  @media (min-width: 1200px) {
    .lesson-index {
      inset: auto auto calc(var(--space-8) + 56px) auto;
      left: auto;
      right: var(--space-4);
      width: min(24rem, calc(100vw - 2 * var(--space-4)));
      max-height: calc(100dvh - var(--site-header-block-size) - var(--space-8) - 88px);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-control-edge);
      border-radius: var(--radius-md);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
    }

    .lesson-index::backdrop {
      background: rgb(0 0 0 / 0.15);
    }
  }

  .lesson-index-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .lesson-index-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-deep-blue);
  }

  .lesson-index-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: calc(-1 * var(--space-2));
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .lesson-index-close:hover {
    background: var(--color-border-light);
  }

  .lesson-index-close:focus-visible,
  .lesson-index-list a:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .lesson-index-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lesson-index-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .lesson-index-list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: calc(50% - 0.2rem);
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-teal);
  }

  .lesson-index-list li:has(a[aria-current])::before {
    left: 0;
    width: 0.65rem;
    border-radius: 2px;
  }

  .lesson-index-list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0;
    color: var(--color-deep-blue);
    font-size: 1rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .lesson-index-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lesson-index-list a[aria-current] {
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-index-button,
    .lesson-index-button[data-shown] {
      transition: none;
    }
  }

  @media print {
    .lesson-index-button,
    .lesson-index {
      display: none;
    }
  }

  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-teal);
    z-index: 10001;
    width: 0%;
    transition: width 0.1s linear;
  }
</style>

<script is:inline>
  (function() {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;
    var article = document.querySelector('.blog-post');
    if (!article) return;
    var ticking = false;
    function update() {
      var top = article.getBoundingClientRect().top;
      var height = article.offsetHeight;
      var viewH = window.innerHeight;
      var scrolled = Math.max(0, -top);
      var total = height - viewH;
      if (total <= 0) { bar.style.width = '100%'; return; }
      var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', function() {
      if (!ticking) { requestAnimationFrame(function() { update(); ticking = false; }); ticking = true; }
    }, { passive: true });
    update();
  })();
</script>

<script is:inline>
  (function() {
    var button = document.getElementById('lesson-index-button');
    var dialog = document.getElementById('lesson-index');
    var covers = document.querySelector('.post-covers');
    if (!button || !dialog || !covers || typeof dialog.showModal !== 'function') return;
    var links = Array.prototype.slice.call(dialog.querySelectorAll('.lesson-index-list a'));
    var targets = links.map(function(a) {
      try { return document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1))); } catch (e) { return null; }
    });
    if (targets.some(function(t) { return !t; })) return;
    var nowEl = button.querySelector('[data-lesson-index-now]');
    var header = document.querySelector('.site-header');
    // Shown until the FAQ (or, without one, the lesson body) has ended above
    // the middle of the screen, so it never sits over the reading list,
    // related lessons or footer.
    var end = document.querySelector('.post-faq') || document.getElementById('post-content');
    button.hidden = false;

    var shown = false;
    var current = null;
    // The hand-off plays once a page view, and only if the reader saw the
    // list before it went: not on a reload or a link that lands mid-lesson.
    var sawList = false;
    // Seeing counts only once the reader has acted: a page opened on a
    // #section link is scrolled there by the browser, past the list, with
    // the list never read.
    var readerActed = false;
    // Checked at the moment of acting too, so a big jump (End, a link in
    // the list, a fast flick) that clears the list before the next frame
    // still counts.
    function onReaderActed() {
      readerActed = true;
      var box = covers.getBoundingClientRect();
      if (box.bottom > (header ? header.getBoundingClientRect().bottom : 0) && box.top < window.innerHeight) sawList = true;
    }
    ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach(function(type) {
      window.addEventListener(type, onReaderActed, { passive: true, once: true });
    });
    var handedOff = false;
    var flying = false;
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)');

    // The first arrival shows the words for six seconds, then the icon.
    var labelledOnce = false;
    function arrive() {
      button.setAttribute('data-shown', '');
      if (labelledOnce) return;
      labelledOnce = true;
      button.setAttribute('data-labelled', '');
      setTimeout(function() { button.removeAttribute('data-labelled'); }, 6000);
    }

    function handOff(headerBottom) {
      var from = covers.getBoundingClientRect();
      // Land on the labelled pill the button arrives as, not the icon.
      if (!labelledOnce) button.setAttribute('data-labelled', '');
      var to = button.getBoundingClientRect();
      var ghost = covers.cloneNode(true);
      ghost.removeAttribute('id');
      ghost.removeAttribute('aria-labelledby');
      Array.prototype.forEach.call(ghost.querySelectorAll('[id]'), function(el) { el.removeAttribute('id'); });
      ghost.setAttribute('aria-hidden', 'true');
      ghost.inert = true;
      Array.prototype.forEach.call(ghost.querySelectorAll('a'), function(a) { a.setAttribute('tabindex', '-1'); });
      ghost.classList.add('lesson-index-ghost');
      var height = Math.min(from.height + 24, 160);
      ghost.style.left = from.left + 'px';
      ghost.style.top = headerBottom + 'px';
      ghost.style.width = from.width + 'px';
      ghost.style.height = height + 'px';
      document.body.appendChild(ghost);
      flying = true;
      var dx = to.left - from.left;
      var dy = to.top - headerBottom;
      var anim = ghost.animate([
        { transform: 'none', opacity: 1, borderRadius: '8px' },
        { transform: 'translate(' + dx + 'px, ' + dy + 'px) scale(' + (to.width / from.width) + ', ' + (to.height / height) + ')', opacity: 0.3, borderRadius: '999px' }
      ], { duration: 700, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' });
      anim.onfinish = anim.oncancel = function() {
        ghost.remove();
        flying = false;
        if (shown) arrive();
      };
    }

    function update() {
      var headerBottom = header ? header.getBoundingClientRect().bottom : 0;
      var coversBottom = covers.getBoundingClientRect().bottom;
      if (coversBottom > headerBottom && covers.getBoundingClientRect().top < window.innerHeight && readerActed) sawList = true;
      var inRange = coversBottom <= headerBottom && end.getBoundingClientRect().bottom > window.innerHeight / 2;
      if (inRange !== shown) {
        shown = inRange;
        if (shown) {
          if (!handedOff && sawList && !calm.matches && typeof covers.animate === 'function') {
            handedOff = true;
            handOff(headerBottom);
          } else if (!flying) {
            handedOff = true;
            arrive();
          }
        } else {
          button.removeAttribute('data-shown');
        }
      }
      // The part being read: the last linked heading above the line under
      // the header. A heading with no line of its own belongs to the part
      // above it.
      var line = headerBottom + 24;
      var idx = -1;
      var best = -Infinity;
      targets.forEach(function(t, i) {
        var top = t.getBoundingClientRect().top;
        if (top <= line && top > best) { best = top; idx = i; }
      });
      if (idx === current) return;
      current = idx;
      links.forEach(function(a, j) {
        if (j === idx) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      });
      nowEl.textContent = idx < 0 ? '' : ', now reading: ' + links[idx].textContent;
    }

    button.addEventListener('click', function() {
      button.removeAttribute('data-labelled');
      dialog.showModal();
      var mark = dialog.querySelector('a[aria-current]');
      if (mark) { mark.focus(); mark.scrollIntoView({ block: 'nearest' }); }
    });
    dialog.querySelector('[data-lesson-index-close]').addEventListener('click', function() { dialog.close(); });
    // A tap on the dimmed page (the dialog's own box, outside its content).
    dialog.addEventListener('click', function(e) {
      if (e.target !== dialog) return;
      var r = dialog.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();
    });
    links.forEach(function(a) {
      a.addEventListener('click', function() { dialog.close(); });
    });

    var ticking = false;
    function onScroll() {
      if (!ticking) { requestAnimationFrame(function() { update(); ticking = false; }); ticking = true; }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  })();
</script>
