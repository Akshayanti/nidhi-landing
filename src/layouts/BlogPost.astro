---
import BaseLayout from './BaseLayout.astro';
import LevelBadge from '../components/LevelBadge.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
import { DEFAULT_LOCALE, blogPath, blogPostPath, blogTagPath, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  tldr: string;
  pubDate: Date;
  updatedDate?: Date;
  level: string;
  tags: string[];
  readingTime?: number;
  regulatoryNote?: string;
  referentialReading?: Array<{
    title: string;
    author?: string;
    url?: string;
    type: string;
  }>;
  prevSlug?: string | null;
  prevTitle?: string | null;
  nextSlug?: string | null;
  nextTitle?: string | null;
  faq?: Array<{ question: string; answer: string }>;
  howTo?: {
    name: string;
    totalTime?: string;
    steps: Array<{ name: string; text: string }>;
  };
  /**
   * Up to 3 "Keep reading" cards. Resolved upstream in
   * `src/pages/blog/[slug].astro` from the post's `relatedSlugs` plus
   * tag-overlap fallback. Empty array (no block rendered) until either
   * `relatedSlugs` lists a published target or another published post
   * shares at least one tag.
   */
  relatedPosts?: Array<{ slug: string; title: string; description: string }>;
  locale?: Locale;
}

const { title, description, tldr, pubDate, updatedDate, level, tags, readingTime, regulatoryNote, referentialReading, prevSlug, prevTitle, nextSlug, nextTitle, faq, howTo, relatedPosts = [], locale = DEFAULT_LOCALE } = Astro.props;

const dateLocale = locale === 'es' ? 'es-ES' : 'en-US';
const dateStr = pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
// Surface "Updated <date>" only when the updated date is meaningfully later
// than the publish date (more than seven days). This avoids noisy "updated"
// labels for fixes made within the publication window, while letting genuine
// freshness signals show through to readers and to SERP CTR.
const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
const showUpdated = !!updatedDate && updatedDate.getTime() - pubDate.getTime() > SEVEN_DAYS_MS;
const updatedStr = showUpdated && updatedDate
  ? updatedDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const siteUrl = 'https://nidhi.today';
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Organization',
    name: 'nidhi',
    url: `${siteUrl}/about/`,
    description:
      'Practitioner and research-led personal finance education. Builds the tools the posts describe and sources every article against cited references.',
    sameAs: ['https://www.instagram.com/nidhi.today'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'nidhi',
    url: `${siteUrl}/`,
  },
  // Point at the generic site OG image for now. PR16 will repoint this
  // at a per-post OG image generator and emit the real dims dynamically.
  image: {
    '@type': 'ImageObject',
    url: `${siteUrl}/brand/social/og-image.png`,
    width: 1200,
    height: 630,
  },
  url: new URL(blogPostPath(locale, slug), siteUrl).toString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(blogPostPath(locale, slug), siteUrl).toString(),
  },
  keywords: tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: new URL(blogPath(locale), siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: new URL(blogPostPath(locale, slug), siteUrl).toString(),
    },
  ],
};
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const howToSchema = howTo ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: howTo.name,
  ...(howTo.totalTime ? { totalTime: howTo.totalTime } : {}),
  step: howTo.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
  })),
} : null;

const allSchemas = [blogPostingSchema, breadcrumbSchema, faqSchema, howToSchema].filter(Boolean);
---

<BaseLayout
  title={`${title} | nidhi`}
  description={description}
  article={{
    publishedTime: pubDate,
    modifiedTime: updatedDate,
    tags: tags,
  }}
  prevUrl={prevSlug ? blogPostPath(locale, prevSlug) : null}
  nextUrl={nextSlug ? blogPostPath(locale, nextSlug) : null}
  jsonLd={allSchemas}
  locale={locale}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <article class="blog-post">
    <div class="container">
      <header class="post-header">
        <div class="post-meta">
          <LevelBadge level={level} />
          <span class="post-byline">By <a href="/about/" rel="author">nidhi</a></span>
          {readingTime && <span class="post-reading-time">{readingTime} min read</span>}
          <time datetime={pubDate.toISOString()} class="post-date">{dateStr}</time>
          {showUpdated && updatedDate && (
            <span class="post-updated">
              Updated <time datetime={updatedDate.toISOString()}>{updatedStr}</time>
            </span>
          )}
        </div>
        <h1 class="post-title">{title}</h1>
        <div class="post-tldr">
          <span class="tldr-label">TL;DR</span>
          <p>{tldr}</p>
        </div>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a class="post-tag" href={blogTagPath(locale, tag)}>{tag}</a>
            ))}
          </div>
        )}
      </header>

      {regulatoryNote === 'caution' && (
        <div class="notice-caution">
          <strong>Heads up:</strong> This article covers financial projections. We're here to help you understand the concepts, not tell you what to do with your money. For personal advice, talk to a financial professional.
        </div>
      )}

      {regulatoryNote === 'danger' && (
        <div class="notice-danger">
          <strong>Important:</strong> This article touches on tax-related concepts to help you understand how they work. Tax rules vary by country and situation. Talk to a qualified tax professional before making decisions based on what you read here.
        </div>
      )}
    </div>

    <div class="post-body-wrapper">
      <nav class="toc" id="toc" aria-label="Table of Contents">
        <div class="toc-inner">
          <strong class="toc-title">On this page</strong>
          <ul class="toc-list" id="toc-list"></ul>
        </div>
      </nav>
      <div class="prose" id="post-content">
        <slot />
      </div>
    </div>

    <div class="post-bottom-wrapper">
      <div class="post-bottom-content">
        {referentialReading && referentialReading.length > 0 && (
          <section class="suggested-reading">
            <h2 class="suggested-reading-title">Suggested Reading</h2>
            <ul class="suggested-reading-list">
              {referentialReading.map((ref) => (
                <li>
                  {ref.url ? (
                    <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title}</a>
                  ) : (
                    <span>{ref.title}</span>
                  )}
                  {ref.author && <span class="ref-author"> by {ref.author}</span>}
                  <span class="ref-type">{ref.type}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="disclaimer">
          <strong>A quick note:</strong> This article is educational content, not investment advice or a personal recommendation under MiFID II. Examples, historical figures, and any projections are illustrative and don't predict future results. Tax treatment depends on your country and personal situation. For decisions that meaningfully affect your finances, a qualified or regulated adviser can help apply these ideas to your circumstances.
        </div>

        {(prevSlug || nextSlug) && (
          <nav class="post-nav" aria-label="Adjacent posts">
            {prevSlug && prevTitle && (
              <a class="post-nav-link post-nav-prev" href={blogPostPath(locale, prevSlug)} data-attr="post-nav-prev">
                <span class="post-nav-direction">Previous</span>
                <span class="post-nav-title">{prevTitle}</span>
              </a>
            )}
            {nextSlug && nextTitle && (
              <a class="post-nav-link post-nav-next" href={blogPostPath(locale, nextSlug)} data-attr="post-nav-next">
                <span class="post-nav-direction">Next</span>
                <span class="post-nav-title">{nextTitle}</span>
              </a>
            )}
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <aside class="post-related" aria-labelledby="post-related-h">
            <h2 id="post-related-h" class="post-related-title">Keep reading</h2>
            <div class="post-related-grid">
              {relatedPosts.map((rp) => (
                <a
                  class="post-related-card"
                  href={blogPostPath(locale, rp.slug)}
                  data-attr={`related-${rp.slug}`}
                >
                  <span class="post-related-card-title">{rp.title}</span>
                  <span class="post-related-card-desc">{rp.description}</span>
                </a>
              ))}
            </div>
          </aside>
        )}

        <SubscribeSection variant="full" />
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  (function() {
    var content = document.getElementById('post-content');
    var tocList = document.getElementById('toc-list');
    if (!content || !tocList) return;

    var headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) return;

    function slugify(text) {
      return text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    }

    var usedIds = {};
    headings.forEach(function(h) {
      var base = slugify(h.textContent);
      var id = base;
      var counter = 1;
      while (usedIds[id]) { id = base + '-' + counter; counter++; }
      usedIds[id] = true;
      h.id = id;
      var li = document.createElement('li');
      li.className = 'toc-item toc-item--' + h.tagName.toLowerCase();
      var a = document.createElement('a');
      a.href = '#' + id;
      a.textContent = h.textContent;
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Highlight active section on scroll
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        var id = entry.target.id;
        var link = tocList.querySelector('a[href="#' + id + '"]');
        if (link) {
          if (entry.isIntersecting) {
            tocList.querySelectorAll('a').forEach(function(a) { a.classList.remove('toc-active'); });
            link.classList.add('toc-active');
          }
        }
      });
    }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

    headings.forEach(function(h) { observer.observe(h); });
  })();

  // Auto-mark this post as read
  (function() {
    var path = window.location.pathname;
    var slug = path.split('/').filter(Boolean).pop();
    if (!slug) return;
    var key = 'nidhi-reading-progress';
    try {
      var data = JSON.parse(localStorage.getItem(key) || '[]');
      if (data.indexOf(slug) === -1) {
        data.push(slug);
        localStorage.setItem(key, JSON.stringify(data));
      }
    } catch(e) {}
  })();
</script>

<style>
  .blog-post {
    padding: var(--space-10) 0 var(--space-16);
  }

  .post-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .post-reading-time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .post-byline {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 500;
  }

  .post-byline a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-byline a:hover {
    color: var(--color-teal);
  }

  .post-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* Updated label sits next to the publish date when the post has a
     meaningfully later updatedDate. Visible recency is a CTR signal on
     evergreen finance content; we use the same muted treatment as the
     pubDate so it reads as metadata, not an alert. */
  .post-updated {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .post-updated::before {
    content: '\00b7';
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: 2rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .post-tldr {
    background: var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .tldr-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-deep-blue);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .post-tldr p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .post-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .post-tag {
    background: var(--color-border-light);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .post-tag:hover {
    background: var(--color-deep-blue);
    color: white;
    border-color: var(--color-deep-blue);
  }

  /* Post body: wide grid — left gutter | TOC | content | right gutter */
  .post-body-wrapper {
    display: grid;
    grid-template-columns: 1fr 400px minmax(0, 720px) 1fr;
    column-gap: var(--space-6);
    align-items: flex-start;
  }

  .toc {
    grid-column: 2;
    position: sticky;
    top: 80px;
    display: none;
    overflow: hidden;
  }

  .toc-inner {
    border-left: 2px solid var(--color-border-light);
    padding-left: var(--space-4);
  }

  .prose {
    grid-column: 3;
  }

  .toc-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: var(--space-1);
  }

  .toc-item + .toc-item:not(.toc-item--h3) {
    margin-top: var(--space-2);
  }

  .toc-item a {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 3px 0;
    transition: color 0.15s ease;
    line-height: 1.4;
  }

  .toc-item a:hover {
    color: var(--color-text-primary);
  }

  .toc-item a.toc-active {
    color: var(--color-deep-blue);
    font-weight: 600;
  }

  .toc-item--h3 {
    padding-left: var(--space-4);
  }

  .toc-item--h3 a {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .toc-item--h3 a.toc-active {
    font-weight: 500;
  }

  @media (min-width: 1200px) {
    .toc {
      display: block;
    }
  }

  @media (max-width: 1199px) {
    .post-body-wrapper {
      display: block;
    }
    .toc {
      display: none;
    }
    .prose {
      max-width: var(--max-width);
      margin: 0 auto;
    }
  }

  /* Post bottom: same grid as body so content aligns with prose */
  .post-bottom-wrapper {
    display: grid;
    grid-template-columns: 1fr 400px minmax(0, 720px) 1fr;
    column-gap: var(--space-6);
  }

  .post-bottom-content {
    grid-column: 3;
  }

  @media (max-width: 1199px) {
    .post-bottom-wrapper {
      display: block;
    }
    .post-bottom-content {
      max-width: var(--max-width);
      margin: 0 auto;
    }
  }

  /* Suggested reading */
  .suggested-reading {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .suggested-reading-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  .suggested-reading-list {
    list-style: none;
    padding: 0;
  }

  .suggested-reading-list li {
    padding: var(--space-2) 0;
    font-size: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .suggested-reading-list a {
    color: var(--color-deep-blue);
    font-weight: 500;
  }

  .ref-author {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .ref-type {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-border-light);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  /* Post navigation */
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    max-width: 45%;
    transition: color 0.15s ease;
  }

  .post-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .post-nav-direction {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .post-nav-title {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-deep-blue);
    line-height: 1.35;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--color-teal);
  }

  @media (max-width: 480px) {
    .post-title { font-size: 1.5rem; }
    .post-nav { flex-direction: column; gap: var(--space-3); }
    .post-nav-link { max-width: 100%; }
    .post-nav-next { text-align: left; }
  }

  /* "Keep reading" block. Sits between the prev/next pager and the
     subscribe CTA. Card visuals mirror the related-reads pattern on the
     multi-currency tool and the new tag hub page so the affordance reads
     consistently across the site. */
  .post-related {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
  }

  .post-related-title {
    font-size: 1.1rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-4);
  }

  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (max-width: 800px) {
    .post-related-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    min-height: 100%;
  }

  .post-related-card:hover,
  .post-related-card:focus-visible {
    border-color: var(--color-deep-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    outline: none;
  }

  .post-related-card:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  .post-related-card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-deep-blue);
    line-height: 1.3;
  }

  .post-related-card-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-teal);
    z-index: 10001;
    width: 0%;
    transition: width 0.1s linear;
  }
</style>

<script is:inline>
  (function() {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;
    var article = document.querySelector('.blog-post');
    if (!article) return;
    var ticking = false;
    function update() {
      var top = article.getBoundingClientRect().top;
      var height = article.offsetHeight;
      var viewH = window.innerHeight;
      var scrolled = Math.max(0, -top);
      var total = height - viewH;
      if (total <= 0) { bar.style.width = '100%'; return; }
      var pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', function() {
      if (!ticking) { requestAnimationFrame(function() { update(); ticking = false; }); ticking = true; }
    }, { passive: true });
    update();
  })();
</script>
