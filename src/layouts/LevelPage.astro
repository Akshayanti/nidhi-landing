---
/**
 * One level of the learning path (/blog/<level>/), in whichever language it was
 * asked for: what it covers, its lessons in reading order with the Inclusive
 * Finances follow-ups placed after the lesson they build on, and links to the
 * neighbouring levels.
 *
 * A level with no published lessons yet says so and stays out of search
 * (noindex here, and out of the sitemap in astro.config.mjs). There is one
 * lesson library, in English, so that is the same question in every language:
 * a Hindi level page lists the same English lessons and goes live with them.
 *
 * The body lives in this file rather than in `src/components/pages/` for the
 * same shape as the rest of the path: a body both languages render, an English
 * wrapper at the root path (src/pages/blog/<level>.astro), and one mirrored
 * route under src/pages/[locale]/blog/.
 */
import BaseLayout from './BaseLayout.astro';
import { LevelLessons, type PostData } from '../components/LearningPath';
import LessonsInEnglish from '../components/LessonsInEnglish.astro';
import { LADDER_LEVELS } from '../utils/home/startingPoints';
import { getPathPosts } from '../utils/learnPosts';
import { tagChipLabel } from '../utils/tags';
import { DEFAULT_LOCALE, DATE_LOCALE, LOCALES, blogTagPath, dict, format, localizedPath, type Locale } from '../i18n';

interface Props {
  level: (typeof LADDER_LEVELS)[number];
  locale?: Locale;
}

const { level, locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
const { learn, level: levelStrings } = strings;
const meta = learn.levelMeta[level];
const label = learn.levels[level] ?? learn.levelFallback;
const index = LADDER_LEVELS.indexOf(level);

const siteUrl = 'https://nidhi.today';
const levelUrl = new URL(localizedPath(locale, `/blog/${level}/`), siteUrl).href;

const posts = await getPathPosts();
// Cards keep the English addresses `getPathPosts` set; the level's own links
// below are chrome and follow the language.
const levelPosts: PostData[] = posts.filter((p) => p.pathLevel === level);
const core = posts.filter((p) => p.level === level && p.pathLevel);
const liveLevels = LADDER_LEVELS.filter((id) => posts.some((p) => p.level === id && p.pathLevel));
// Neighbours by ladder position, so a level with nothing published yet still
// points back to the published level before it, not round to the first one.
const ladderIndex = LADDER_LEVELS.indexOf(level);
const prev = [...liveLevels].reverse().find((id) => LADDER_LEVELS.indexOf(id) < ladderIndex);
const next = liveLevels.find((id) => LADDER_LEVELS.indexOf(id) > ladderIndex);

// Every tag a card on this page can show needs its own link.
const tagHrefs: Record<string, string> = {};
const tagLabels: Record<string, string> = {};
for (const tag of levelPosts.flatMap((p) => p.tags)) {
  tagHrefs[tag] = blogTagPath(locale, tag);
  tagLabels[tag] = tagChipLabel(tag, learn.tags[tag]?.name, locale === DEFAULT_LOCALE);
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: learn.crumb.learn,
      item: new URL(localizedPath(locale, '/blog/'), siteUrl).href,
    },
    { '@type': 'ListItem', position: 2, name: label, item: levelUrl },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: format(levelStrings.schema.itemListName, { label }),
  numberOfItems: core.length,
  itemListElement: core.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(p.href, siteUrl).href,
    name: p.title,
  })),
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={format(levelStrings.meta.title, { label, summary: learn.summaries[level] })}
  description={core.length > 0 ? format(levelStrings.meta.descriptionWithCount, { description: meta.description, count: core.length }) : meta.description}
  jsonLd={core.length > 0 ? [breadcrumbSchema, itemListSchema] : [breadcrumbSchema]}
  robots={core.length === 0 ? 'noindex,follow' : undefined}
>
  <section class="level-page" style={`--lc: var(--level-${level})`}>
    <div class="container level-page-container">
      <nav class="level-page-crumb" aria-label={strings.a11y.breadcrumb}>
        <a href={localizedPath(locale, '/blog/')} data-attr="level-page-crumb">{learn.crumb.learn}</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{label}</span>
      </nav>
      <header class="level-page-header">
        <p class="level-page-eyebrow">{format(levelStrings.eyebrow, { index: index + 1, total: LADDER_LEVELS.length })}</p>
        <h1>{label}</h1>
        <p class="level-page-desc">{meta.description}</p>
        <details class="level-page-covered">
          <summary data-attr={`level-page-covered-${level}`}>{levelStrings.coveredSummary}</summary>
          <p>{meta.covered}{strings.fullStop}</p>
        </details>
        <p class="level-page-scope">
          {levelStrings.scope}{' '}
          <a href={localizedPath(locale, '/editorial-policy/#any-country')} data-attr="level-page-any-country">{levelStrings.scopeLink}</a>
        </p>
      </header>

      <LessonsInEnglish locale={locale} />

      {core.length > 0 ? (
        <LevelLessons
          client:load
          level={level}
          posts={levelPosts}
          strings={learn.island}
          tagHrefs={tagHrefs}
          tagLabels={tagLabels}
          inclusiveLabel={learn.levels['inclusive-finances'] ?? learn.levelFallback}
          dateLocale={DATE_LOCALE[locale]}
        />
      ) : (
        <p class="level-page-empty">{levelStrings.empty}</p>
      )}

      <nav class="level-page-nav" aria-label={levelStrings.nav.label}>
        {prev ? (
          <a href={localizedPath(locale, `/blog/${prev}/`)} data-attr="level-page-prev">
            <span aria-hidden="true">←</span> {learn.levels[prev]}
          </a>
        ) : <a href={localizedPath(locale, '/blog/')} data-attr="level-page-all">{levelStrings.nav.allLevels}</a>}
        {next ? (
          <a href={localizedPath(locale, `/blog/${next}/`)} data-attr="level-page-next">
            {format(levelStrings.nav.next, { label: learn.levels[next] })} <span aria-hidden="true">→</span>
          </a>
        ) : <a href={localizedPath(locale, '/blog/inclusive-finances/')} data-attr="level-page-inclusive">{levelStrings.nav.inclusive} <span aria-hidden="true">→</span></a>}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .level-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  .level-page-container {
    max-width: 1040px;
  }

  .level-page-crumb {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .level-page-crumb a {
    color: var(--color-deep-blue);
  }

  .level-page-header {
    max-width: 680px;
    margin-bottom: var(--space-6);
  }

  .level-page-eyebrow {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .level-page-header h1 {
    margin: var(--space-1) 0 var(--space-2);
    font-size: 2.4rem;
    line-height: 1.15;
    color: var(--lc);
  }

  .level-page-desc {
    margin: 0 0 var(--space-3);
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .level-page-covered {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .level-page-covered summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .level-page-covered p {
    margin: 0;
  }

  .level-page-scope {
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .level-page-scope a {
    color: var(--color-deep-blue);
    font-weight: 600;
    white-space: nowrap;
  }

  .level-page-empty {
    color: var(--color-text-secondary);
  }

  .level-page-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .level-page-nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-deep-blue);
  }

  @media (max-width: 640px) {
    .level-page { padding: var(--space-5) 0 var(--space-8); }

    .level-page-header h1 { font-size: 2rem; }

    .level-page-desc { font-size: 1rem; }
  }
</style>
