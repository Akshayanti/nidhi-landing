---
/**
 * The learning path's front page (/blog/), in whichever language it was asked
 * for: where to start or continue, the levels with Inclusive Finances alongside
 * them, and search across every lesson. Each level's lessons are on its own
 * page (src/layouts/LevelPage.astro).
 *
 * The body lives in this file rather than in `src/components/pages/` because
 * `astro.config.mjs` dates the page by its git history: the date moves when the
 * page does. English is served from `src/pages/blog/index.astro`, the other
 * languages through `src/pages/[locale]/blog/index.astro`.
 *
 * Every word the reader sees comes from the catalog, including the JSON-LD, and
 * every link is built here with `localizedPath` and handed to the island as a
 * plain string, so `LearnHome.tsx` never has to know about languages.
 */
import BaseLayout from './BaseLayout.astro';
import { LearnHome } from '../components/LearnHome';
import LessonsInEnglish from '../components/LessonsInEnglish.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
import { LADDER_LEVELS } from '../utils/home/startingPoints';
import { getHelperLevels, getPathPosts } from '../utils/learnPosts';
import { DEFAULT_LOCALE, LOCALES, dict, localizedPath, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dict(locale);
const { learn, blogIndex } = strings;

const siteUrl = 'https://nidhi.today';
const blogUrl = new URL(localizedPath(locale, '/blog/'), siteUrl).href;
const levelHref = (id: string) => localizedPath(locale, `/blog/${id}/`);

const posts = await getPathPosts();
const helperLevels = await getHelperLevels();
const ladder = posts.filter((p) => p.level !== 'inclusive-finances' && p.pathLevel);
const inclusive = posts.filter((p) => p.level === 'inclusive-finances');

const levels = LADDER_LEVELS.map((id) => ({
  id,
  label: learn.levels[id],
  summary: learn.summaries[id],
  total: ladder.filter((p) => p.level === id).length,
  href: levelHref(id),
}));

// Ladder lessons in reading order first, then the Inclusive Finances guides.
// `href` is the lesson's own English address, set by `getPathPosts`: a lesson
// is one document, not one per language, while the level links above are chrome.
const lessons = [...ladder, ...inclusive].map(({ id, title, description, level, readingTime, tags, href }) => ({
  id, title, description, level, readingTime, tags, href,
}));

const blogBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: blogIndex.schema.breadcrumbLearn,
      item: blogUrl,
    },
  ],
};

const liveLevels = levels.filter((l) => l.total > 0);
const blogItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: blogIndex.schema.itemListName,
  description: blogIndex.schema.itemListDescription,
  numberOfItems: liveLevels.length,
  itemListElement: liveLevels.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(levelHref(l.id), siteUrl).href,
    name: `${l.label}: ${l.summary}`,
  })),
};
---

<BaseLayout
  locale={locale}
  alternates={LOCALES}
  title={blogIndex.meta.title}
  description={blogIndex.meta.description}
  jsonLd={[blogBreadcrumbSchema, blogItemListSchema]}
>
  <script is:inline>
    // Links from before each level had its own page (/blog/#level-building)
    // go to that page. The target is relative, so one script serves every
    // language: from /hi/blog/ it lands on /hi/blog/<level>/.
    (function () {
      var m = /^#level-(discovery|building|psychology|optimizing|mastery)$/.exec(window.location.hash);
      if (m) window.location.replace(m[1] + '/');
    })();
  </script>
  <section class="blog-index">
    <div class="container blog-index-container">
      <header class="blog-index-header">
        <h1>{blogIndex.header.h1}</h1>
        <p class="blog-index-subtitle">
          {blogIndex.header.subtitle}{' '}
          <a href={localizedPath(locale, '/editorial-policy/#any-country')} data-attr="blog-index-any-country">{blogIndex.header.link}</a>
        </p>
      </header>
      {/* The cards below carry English titles: say so before the list, not after it. */}
      <LessonsInEnglish locale={locale} />
      <LearnHome
        client:load
        levels={levels}
        lessons={lessons}
        inclusiveCount={inclusive.length}
        helperLevels={helperLevels}
        strings={blogIndex.island}
        inclusiveHref={localizedPath(locale, '/blog/inclusive-finances/')}
        topicsHref={localizedPath(locale, '/blog/tag/')}
      />
      <div class="blog-index-subscribe">
        <SubscribeSection variant="compact" locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-container {
    max-width: 820px;
  }

  .blog-index-header {
    margin-bottom: var(--space-8);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .blog-index-subtitle a {
    color: var(--color-deep-blue);
    font-weight: 600;
    white-space: nowrap;
  }

  .blog-index-subscribe {
    margin-top: var(--space-10);
  }

  @media (max-width: 640px) {
    .blog-index { padding: var(--space-6) 0 var(--space-8); }

    .blog-index-header { margin-bottom: var(--space-6); }

    .blog-index-header h1 {
      font-size: 2rem;
      margin-bottom: var(--space-2);
    }

    .blog-index-subtitle { font-size: 1rem; }

    .blog-index-subscribe { margin-top: var(--space-8); }
  }
</style>
