---
/**
 * The learning path's front page (/blog/): where to start or continue, the
 * levels with Inclusive Finances alongside them, and search across every
 * lesson. Each level's lessons are on its own page (src/layouts/LevelPage.astro).
 */
import BaseLayout from './BaseLayout.astro';
import { LearnHome } from '../components/LearnHome';
import SubscribeSection from '../components/SubscribeSection.astro';
import { LADDER_LEVELS, LEVEL_LABELS } from '../utils/home/startingPoints';
import { getHelperLevels, getPathPosts, LEVEL_SUMMARIES } from '../utils/learnPosts';

const posts = await getPathPosts();
const helperLevels = await getHelperLevels();
const ladder = posts.filter((p) => p.level !== 'inclusive-finances' && p.pathLevel);
const inclusive = posts.filter((p) => p.level === 'inclusive-finances');

const levels = LADDER_LEVELS.map((id) => ({
  id,
  label: LEVEL_LABELS[id],
  summary: LEVEL_SUMMARIES[id],
  total: ladder.filter((p) => p.level === id).length,
}));

// Ladder lessons in reading order first, then the Inclusive Finances guides.
const lessons = [...ladder, ...inclusive].map(({ id, title, description, level, readingTime, tags }) => ({
  id, title, description, level, readingTime, tags,
}));

const blogBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Learn',
      item: 'https://nidhi.today/blog/',
    },
  ],
};

const liveLevels = levels.filter((l) => l.total > 0);
const blogItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Learning path levels',
  description: 'A structured learning path through personal finance, in levels from the basics to reviewing a plan.',
  numberOfItems: liveLevels.length,
  itemListElement: liveLevels.map((l, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://nidhi.today/blog/${l.id}/`,
    name: `${l.label}: ${l.summary}`,
  })),
};
---

<BaseLayout
  title="Learn Personal Finance | nidhi"
  description="Free personal finance education: net worth, budgeting, saving, investing, and debt management. Build your financial literacy step by step with practical guides."
  jsonLd={[blogBreadcrumbSchema, blogItemListSchema]}
>
  <script is:inline>
    // Links from before each level had its own page (/blog/#level-building)
    // go to that page.
    (function () {
      var m = /^#level-(discovery|building|psychology|optimizing|mastery)$/.exec(window.location.hash);
      if (m) window.location.replace('/blog/' + m[1] + '/');
    })();
  </script>
  <section class="blog-index">
    <div class="container blog-index-container">
      <header class="blog-index-header">
        <h1>Learn about your money</h1>
        <p class="blog-index-subtitle">
          Short lessons for every kind of household, in any country. Where local rules matter, lessons say what to check.{' '}
          <a href="/editorial-policy/#any-country" data-attr="blog-index-any-country">How lessons are written</a>
        </p>
      </header>
      <LearnHome client:load levels={levels} lessons={lessons} inclusiveCount={inclusive.length} helperLevels={helperLevels} />
      <div class="blog-index-subscribe">
        <SubscribeSection variant="compact" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-container {
    max-width: 820px;
  }

  .blog-index-header {
    margin-bottom: var(--space-8);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    line-height: 1.15;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .blog-index-subtitle a {
    color: var(--color-deep-blue);
    font-weight: 600;
    white-space: nowrap;
  }

  .blog-index-subscribe {
    margin-top: var(--space-10);
  }

  @media (max-width: 640px) {
    .blog-index { padding: var(--space-6) 0 var(--space-8); }

    .blog-index-header { margin-bottom: var(--space-6); }

    .blog-index-header h1 {
      font-size: 2rem;
      margin-bottom: var(--space-2);
    }

    .blog-index-subtitle { font-size: 1rem; }

    .blog-index-subscribe { margin-top: var(--space-8); }
  }
</style>
