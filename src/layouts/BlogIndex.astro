---
import BaseLayout from './BaseLayout.astro';
import { LearningPath } from '../components/LearningPath';
import SubscribeSection from '../components/SubscribeSection.astro';

interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      level: string;
      tags: string[];
    };
    readingTime: number;
  }>;
}

const { posts } = Astro.props;

const serializedPosts = posts.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toISOString(),
  level: p.data.level,
  readingTime: p.readingTime,
  tags: p.data.tags,
}));

const blogBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: 'https://nidhi.today/blog/',
    },
  ],
};

const blogItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Financial Literacy Articles',
  description: 'A structured learning path through personal finance fundamentals.',
  numberOfItems: posts.length,
  itemListElement: posts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://nidhi.today/blog/${p.id}/`,
    name: p.title,
  })),
};
---

<BaseLayout
  title="Personal Finance Blog | nidhi"
  description="Free personal finance education: net worth, budgeting, saving, investing, and debt management. Build your financial literacy step by step with practical guides."
  jsonLd={[blogBreadcrumbSchema, blogItemListSchema]}
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-index-header">
        <h1>Learn about your money</h1>
        <p class="blog-index-subtitle">Financial literacy from the ground up. Start with the basics and build your understanding step by step.</p>
        <p class="blog-index-cadence">New posts every Mon, Wed &amp; Fri</p>
        <p class="blog-index-topics">
          <a href="/blog/tag/" data-attr="blog-index-browse-topics">Browse by topic</a>
        </p>
      </header>
      <SubscribeSection variant="compact" />
      <LearningPath client:load posts={serializedPosts} />
    </div>
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-10) 0 var(--space-16);
  }

  .blog-index-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .blog-index-header h1 {
    font-size: 2.5rem;
    color: var(--color-deep-blue);
    margin-bottom: var(--space-3);
  }

  .blog-index-subtitle {
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .blog-index-cadence {
    display: inline-block;
    margin-top: var(--space-3);
    padding: 4px 12px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-teal);
    background: rgba(0, 121, 107, 0.08);
    border-radius: 9999px;
  }

  /* Lightweight pointer to the new tag-hub. Closes finding 5 by giving
     the `/blog/tag/` route an obvious entry from the blog index. */
  .blog-index-topics {
    margin-top: var(--space-2);
    font-size: 0.85rem;
  }

  .blog-index-topics a {
    color: var(--color-deep-blue);
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .blog-index-topics a:hover,
  .blog-index-topics a:focus-visible {
    color: var(--color-teal);
    text-decoration-style: solid;
    outline: none;
  }
</style>