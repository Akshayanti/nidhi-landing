---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string[];
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
}

const { title, description, image, keywords, article, prevUrl, nextUrl, jsonLd, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} keywords={keywords} article={article} prevUrl={prevUrl} nextUrl={nextUrl} jsonLd={jsonLd} robots={robots} />
    {/*
      Per-page head additions (preconnects, page-specific link tags). The
      slot is empty by default so existing pages are unaffected; the
      multi-currency-net-worth page uses it to preconnect to the
      Frankfurter FX API so the first rates request lands faster.
    */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>