---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { DEFAULT_LOCALE, LOCALE_META, dict, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  /**
   * The language this page is written in. Defaults to English, so an English
   * page that says nothing keeps working exactly as it did.
   */
  locale?: Locale;
  /**
   * The locales this page exists in, including `locale`. It decides the
   * `hreflang` links and whether the header offers a language picker.
   *
   * It defaults to this page's own language, so a page that also exists under
   * another prefix is the one that says so, rather than every other page
   * having to say that it does not. That is the safe default here: a mirrored
   * route that has not been built yet must not be offered as a destination,
   * and claiming it would put a link to a 404 in the header and an `hreflang`
   * pointing nowhere in the head.
   */
  alternates?: readonly Locale[];
  title: string;
  description: string;
  image?: string;
  /** OG image width. See `BaseHead` props. */
  imageWidth?: number;
  /** OG image height. See `BaseHead` props. */
  imageHeight?: number;
  /** Social card alt text. See `BaseHead` props. */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
  /** Optional class on the <main> element. Used by the home page to opt
   *  into the scroll-snap shell without affecting any other page. */
  mainClass?: string;
  /** Optional data-* attributes on <body>. Used by the home page to set
   *  data-page="landing", which the global stylesheet keys off to flip the
   *  header to its fixed/transparent treatment. */
  bodyData?: Record<string, string>;
}

const { locale = DEFAULT_LOCALE, alternates = [locale], title, description, image, imageWidth, imageHeight, imageAlt, article, prevUrl, nextUrl, jsonLd, robots, mainClass, bodyData } = Astro.props;
const strings = dict(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <BaseHead locale={locale} alternates={alternates} title={title} description={description} image={image} imageWidth={imageWidth} imageHeight={imageHeight} imageAlt={imageAlt} article={article} prevUrl={prevUrl} nextUrl={nextUrl} jsonLd={jsonLd} robots={robots} />
    {/*
      Per-page head additions (preconnects, page-specific link tags). The
      slot is empty by default so existing pages are unaffected; the
      multi-currency-net-worth page uses it to preconnect to the
      Frankfurter FX API so the first rates request lands faster.
    */}
    <slot name="head" />
  </head>
  <body {...(bodyData || {})}>
    <a class="skip-link" href="#main-content">{strings.skipToContent}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
    <Analytics />
  </body>
</html>