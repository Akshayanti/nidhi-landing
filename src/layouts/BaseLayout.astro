---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** OG image width. See `BaseHead` props. */
  imageWidth?: number;
  /** OG image height. See `BaseHead` props. */
  imageHeight?: number;
  /** Social card alt text. See `BaseHead` props. */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
  /** Optional class on the <main> element. Used by the home page to opt
   *  into the scroll-snap shell without affecting any other page. */
  mainClass?: string;
  /** Optional data-* attributes on <body>. Used by the home page to set
   *  data-page="landing", which the global stylesheet keys off to flip the
   *  header to its fixed/transparent treatment. */
  bodyData?: Record<string, string>;
}

const { title, description, image, imageWidth, imageHeight, imageAlt, article, prevUrl, nextUrl, jsonLd, robots, mainClass, bodyData } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} imageWidth={imageWidth} imageHeight={imageHeight} imageAlt={imageAlt} article={article} prevUrl={prevUrl} nextUrl={nextUrl} jsonLd={jsonLd} robots={robots} />
    {/*
      Per-page head additions (preconnects, page-specific link tags). The
      slot is empty by default so existing pages are unaffected; the
      multi-currency-net-worth page uses it to preconnect to the
      Frankfurter FX API so the first rates request lands faster.
    */}
    <slot name="head" />
  </head>
  <body {...(bodyData || {})}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <Analytics />
  </body>
</html>