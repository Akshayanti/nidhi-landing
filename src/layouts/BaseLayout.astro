---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { DEFAULT_LOCALE, LOCALE_META, dict, type Locale } from '../i18n';
// The stylesheets are linked by hand, in the order written below, and not
// imported for Astro to place: Astro orders a page's sheets by where they sit
// in the module graph, which put the same two sheets in a different order on
// different pages. The parts' rules follow the global ones they were split
// from (#451), so their order is part of what they mean.
import globalCss from '../styles/global.css?url';
import toolsCss from '../styles/tools.css?url';
import learnCss from '../styles/learn.css?url';

/** The sheets a page can ask for on top of the global one. */
const PART_SHEETS = { tools: toolsCss, learn: learnCss } as const;

interface Props {
  /**
   * The language this page is written in. Defaults to English, so an English
   * page that says nothing keeps working exactly as it did.
   */
  locale?: Locale;
  /**
   * The locales this page exists in, including `locale`. It decides the
   * `hreflang` links and whether the header offers a language picker.
   *
   * It defaults to this page's own language, so a page that also exists under
   * another prefix is the one that says so, rather than every other page
   * having to say that it does not. That is the safe default here: a mirrored
   * route that has not been built yet must not be offered as a destination,
   * and claiming it would put a link to a 404 in the header and an `hreflang`
   * pointing nowhere in the head.
   */
  alternates?: readonly Locale[];
  title: string;
  description: string;
  image?: string;
  /** OG image width. See `BaseHead` props. */
  imageWidth?: number;
  /** OG image height. See `BaseHead` props. */
  imageHeight?: number;
  /** Social card alt text. See `BaseHead` props. */
  imageAlt?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
  /** For the 404, which has no address of its own: see BaseHead. */
  noCanonical?: boolean;
  /** Optional class on the <main> element. Used by the home page to opt
   *  into the scroll-snap shell without affecting any other page. */
  mainClass?: string;
  /** Optional data-* attributes on <body>. Used by the home page to set
   *  data-page="landing", which the global stylesheet keys off to flip the
   *  header to its fixed/transparent treatment. */
  bodyData?: Record<string, string>;
  /**
   * The window property a free tool reads its inputs from, on a page that
   * carries one. It is what lets a language switch keep the tool's values:
   * `ToolStateGuard` moves a shared link's `#` state out of the address in
   * `<head>`, so the header's script, which runs later, has to put it back.
   * See `Header` props.
   *
   * Every other page leaves this empty, which is the safe default: a page that
   * has no tool state must not look for any.
   */
  toolStateGlobal?: string;
  /**
   * The parts of the stylesheet this page needs beyond the global sheet:
   * `tools` on a free tool's page (src/styles/tools.css), `learn` on a page
   * that shows the learning path's cards or the Learn page (learn.css). A
   * page that names none downloads neither.
   */
  sheets?: readonly (keyof typeof PART_SHEETS)[];
}

const { locale = DEFAULT_LOCALE, alternates = [locale], title, description, image, imageWidth, imageHeight, imageAlt, article, prevUrl, nextUrl, jsonLd, robots, noCanonical, mainClass, bodyData, toolStateGlobal = '', sheets = [] } = Astro.props;
const strings = dict(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <BaseHead locale={locale} alternates={alternates} title={title} description={description} image={image} imageWidth={imageWidth} imageHeight={imageHeight} imageAlt={imageAlt} article={article} prevUrl={prevUrl} nextUrl={nextUrl} jsonLd={jsonLd} robots={robots} noCanonical={noCanonical} />
    {/*
      Per-page head additions (preconnects, page-specific link tags). The
      slot is empty by default so existing pages are unaffected; the
      multi-currency-net-worth page uses it to preconnect to the
      Frankfurter FX API so the first rates request lands faster.
    */}
    <link rel="stylesheet" href={globalCss} />
    {sheets.map((sheet) => <link rel="stylesheet" href={PART_SHEETS[sheet]} />)}
    <slot name="head" />
  </head>
  <body {...(bodyData || {})}>
    <a class="skip-link" href="#main-content">{strings.skipToContent}</a>
    <Header locale={locale} alternates={alternates} toolStateGlobal={toolStateGlobal} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieConsent locale={locale} />
    <Analytics />
    <script is:inline>
      // Paper is light: a page printed from the dark theme would come out as
      // pale grey text on white. The theme is switched for the print only and
      // put back afterwards; nothing is stored. A tool's printed report has
      // its own print styles and is left alone.
      (function () {
        var theme = null;
        window.addEventListener('beforeprint', function () {
          // A second beforeprint before the first print ends must not
          // overwrite the theme to go back to.
          if (theme !== null || document.querySelector('.tool-report')) return;
          theme = document.documentElement.getAttribute('data-theme');
          document.documentElement.setAttribute('data-theme', 'light');
        });
        window.addEventListener('afterprint', function () {
          if (theme) document.documentElement.setAttribute('data-theme', theme);
          theme = null;
        });
      })();
    </script>
  </body>
</html>
