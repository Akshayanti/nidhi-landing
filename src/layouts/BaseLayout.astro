---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string[];
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  prevUrl?: string | null;
  nextUrl?: string | null;
  jsonLd?: object[];
  robots?: string;
}

const { title, description, image, keywords, article, prevUrl, nextUrl, jsonLd, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} keywords={keywords} article={article} prevUrl={prevUrl} nextUrl={nextUrl} jsonLd={jsonLd} robots={robots} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>